<Window x:Class="AIEngineerStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Engineer Studio" Width="1600" Height="1000" MinWidth="1120" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBg}">
<Window.Resources>
  <LinearGradientBrush x:Key="RainbowBorderBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
   <GradientStop Color="#FF5CF6" Offset="0"/><GradientStop Color="#FF4D8D" Offset="0.2"/><GradientStop Color="#FFE45C" Offset="0.4"/><GradientStop Color="#5CFFB0" Offset="0.6"/><GradientStop Color="#5CD9FF" Offset="0.8"/><GradientStop Color="#A56CFF" Offset="1"/>
   <LinearGradientBrush.RelativeTransform><RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="ComposerGlowEffect" Color="#9B5CFF" BlurRadius="20" ShadowDepth="0" Opacity="0"/>
  <Style x:Key="ThinkingSendButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Content" Value="Отправить ↵"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=Composer}" Value="False"><Setter Property="Content" Value="Ожидание…"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
 <!-- Custom titlebar -->
 <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Fill="#FF5F56" Width="12" Height="12" Margin="2"/><Ellipse Fill="#FFBD2E" Width="12" Height="12" Margin="2"/><Ellipse Fill="#27C93F" Width="12" Height="12" Margin="2"/></StackPanel><TextBlock Grid.Column="1" Text="✦  AI Engineer Studio" Foreground="{DynamicResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Margin="140,7"><TextBlock Text="Поиск файлов или команд  (Ctrl+K)" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border><TextBlock Grid.Column="3" Text="● API: Подключено" Foreground="{DynamicResource Success}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/><StackPanel Grid.Column="4" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" Width="38" BorderThickness="0"/><Button Content="□" Click="Maximize_Click" Width="38" BorderThickness="0"/><Button Content="×" Click="Close_Click" Width="38" BorderThickness="0"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition x:Name="ContextColumn" Width="0" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="540" MinWidth="330"/></Grid.ColumnDefinitions>
 <!-- Activity --> <Border Grid.Column="0" Background="{DynamicResource SubBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><Button Content="☷" Style="{StaticResource AccentButton}" Margin="7,12,7,4" FontSize="17"/><Button Content="▤" Click="Prompts_Click" Margin="7,4" FontSize="16"/></StackPanel><StackPanel Grid.Row="1"><Button Content="☀" ToolTip="Светлая тема" Click="QuickTheme_Click" Margin="7,4" FontSize="17" Background="{DynamicResource CardBg}" Foreground="{DynamicResource Text}"/><Button Content="⚙" ToolTip="Настройки API и промпта" Click="Settings_Click" Margin="7,4,7,12" FontSize="17" Background="{DynamicResource Accent}" Foreground="White"/></StackPanel></Grid></Border>
 <!-- Context --> <Border Grid.Column="1" Background="{DynamicResource PanelBg}" x:Name="ContextPanel" Visibility="Collapsed" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="КОНТЕКСТ ПРОЕКТА" Foreground="{DynamicResource Text}" FontSize="11" FontWeight="Bold"/><Button Content="⇄ Сменить проект" Click="SwitchProject_Click" Padding="5,3" Margin="0,8,0,6"/></DockPanel><Grid Margin="0,0,0,8"><TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged"/><TextBlock x:Name="FilterPlaceholder" Text="🔍 Поиск по файлам..." Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="9,0" VerticalAlignment="Center"/></Grid><Border Background="{DynamicResource CardBg}" CornerRadius="5" Margin="0,0,0,8" Padding="8"><TextBlock x:Name="ContextInfo" Text="" Foreground="{DynamicResource Body}" FontSize="11" TextWrapping="Wrap"/></Border></StackPanel><TreeView x:Name="ProjectTree" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Body}" BorderThickness="0" MouseDoubleClick="ProjectTree_MouseDoubleClick" ContextMenuOpening="ProjectTree_ContextMenuOpening"/></DockPanel></Border>
 <!-- Chat --> <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeDirection="Columns"/><Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0"><ComboBox x:Name="ModelBox" Width="180" SelectionChanged="ModelBox_SelectionChanged"/><ComboBox x:Name="PromptBox" Width="180" Margin="10,0,0,0"/><TextBlock Text="Контекст: 0 / 1M" Foreground="{DynamicResource Muted}" Margin="20,0" VerticalAlignment="Center" FontSize="10"/><Button Content="+ Новый чат" Click="NewChat_Click" Margin="0,0,0,0"/></StackPanel></Border><ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatPanel" Margin="20,18"/></ScrollViewer><Border x:Name="ComposerGlow" Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" Margin="15,10"><Border x:Name="Composer" CornerRadius="9" Padding="1" Background="Transparent"><Grid Margin="9" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="📎 Прикрепить файл" Click="OpenFolder_Click" Padding="7,3"/><TextBlock x:Name="ComposerStatus" Text="  Режим агента: Автономное внесение правок" Foreground="{DynamicResource Success}" VerticalAlignment="Center" FontSize="11"/></StackPanel><TextBox x:Name="PromptInput" Grid.Row="1" MinHeight="42" MaxHeight="220" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" KeyDown="PromptInput_KeyDown" Padding="4" FontSize="13"/><Grid Grid.Row="2"><TextBlock Text="Ctrl + Enter для отправки · Enter — новая строка" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button x:Name="SendButton" Style="{StaticResource ThinkingSendButton}" Click="Send_Click" HorizontalAlignment="Right" MinWidth="110"/></Grid></Grid></Border></Border></Grid>
 <!-- Inspector --> <Border Grid.Column="4" Background="{DynamicResource PanelBg}"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Background="{DynamicResource SubBg}"><Button Content="Действия агента" Click="AgentTab_Click" BorderThickness="0"/><Button Content="Просмотр Diff" Click="DiffTab_Click" BorderThickness="0"/><Button Content="Живой предпросмотр" Click="PreviewTab_Click" BorderThickness="0"/></StackPanel><ScrollViewer x:Name="AgentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="InspectorPanel" Margin="18"/></ScrollViewer></Grid></Border>
 </Grid>
 <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="ветка:(main*)     UTF-8     ● API: Подключено" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="14,0"/></Border>
</Grid></Window>
