<Window x:Class="AIEngineerStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Engineer Studio" Width="1600" Height="1000" MinWidth="1120" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBg}">
<Window.Resources>
  <LinearGradientBrush x:Key="RainbowBorderBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
   <GradientStop Color="#FF5CF6" Offset="0"/><GradientStop Color="#FF4D8D" Offset="0.2"/><GradientStop Color="#FFE45C" Offset="0.4"/><GradientStop Color="#5CFFB0" Offset="0.6"/><GradientStop Color="#5CD9FF" Offset="0.8"/><GradientStop Color="#A56CFF" Offset="1"/>
   <LinearGradientBrush.RelativeTransform><RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="ComposerGlowEffect" Color="#9B5CFF" BlurRadius="20" ShadowDepth="0" Opacity="0"/>
  <Style x:Key="WindowControlButton" TargetType="Button"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#FFBD2E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Ellipse x:Name="ControlSurface" Fill="{TemplateBinding Background}" Stretch="Fill"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ControlSurface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ControlSurface" Property="Opacity" Value="0.62"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="WindowMinimizeButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Setter Property="Background" Value="#FFBD2E"/></Style>
  <Style x:Key="WindowMaximizeButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Setter Property="Background" Value="#27C93F"/></Style>
  <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Setter Property="Background" Value="#FF5F56"/><Setter Property="Foreground" Value="#5B1714"/></Style>
  <Style x:Key="ThinkingSendButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Content" Value="Отправить ↵"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=Composer}" Value="False"><Setter Property="Content" Value="Ожидание…"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
 <!-- Custom titlebar -->
 <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="✦  AI Engineer Studio" Foreground="{DynamicResource Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0"/><TextBlock Grid.Column="2" Text="● API: Подключено" Foreground="{DynamicResource Success}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"><Button Style="{StaticResource WindowMinimizeButton}" Click="Minimize_Click"/><Button Style="{StaticResource WindowMaximizeButton}" Click="Maximize_Click"/><Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition x:Name="ContextColumn" Width="0" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="540" MinWidth="330"/></Grid.ColumnDefinitions>
 <!-- Activity --> <Border Grid.Column="0" Background="{DynamicResource SubBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><Button Content="☷" Style="{StaticResource AccentButton}" Margin="7,12,7,4" FontSize="17"/><Button Content="▤" Click="Prompts_Click" Margin="7,4" FontSize="16"/></StackPanel><StackPanel Grid.Row="1"><Button Content="☀" ToolTip="Светлая тема" Click="QuickTheme_Click" Margin="7,4" FontSize="17" Background="{DynamicResource CardBg}" Foreground="{DynamicResource Text}"/><Button Content="⚙" ToolTip="Настройки API и промпта" Click="Settings_Click" Margin="7,4,7,12" FontSize="17" Background="{DynamicResource Accent}" Foreground="White"/></StackPanel></Grid></Border>
 <!-- Context --> <Border Grid.Column="1" Background="{DynamicResource PanelBg}" x:Name="ContextPanel" Visibility="Collapsed" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="КОНТЕКСТ ПРОЕКТА" Foreground="{DynamicResource Text}" FontSize="11" FontWeight="Bold"/><Button Content="⇄ Сменить проект" Click="SwitchProject_Click" Padding="5,3" Margin="0,8,0,6"/></DockPanel><Grid Margin="0,0,0,8"><TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged"/><TextBlock x:Name="FilterPlaceholder" Text="🔍 Поиск по файлам..." Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="9,0" VerticalAlignment="Center"/></Grid><Border Background="{DynamicResource CardBg}" CornerRadius="5" Margin="0,0,0,8" Padding="8"><TextBlock x:Name="ContextInfo" Text="" Foreground="{DynamicResource Body}" FontSize="11" TextWrapping="Wrap"/></Border></StackPanel><TreeView x:Name="ProjectTree" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Body}" BorderThickness="0" MouseDoubleClick="ProjectTree_MouseDoubleClick" ContextMenuOpening="ProjectTree_ContextMenuOpening"/></DockPanel></Border>
 <!-- Chat --> <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeDirection="Columns"/><Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0"><ComboBox x:Name="ModelBox" Style="{StaticResource TopSelector}" Width="180" SelectionChanged="ModelBox_SelectionChanged"/><ComboBox x:Name="PromptBox" Style="{StaticResource TopSelector}" Width="180" Margin="10,0,0,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Body}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Контекст 0 / 1M" Foreground="{DynamicResource Muted}" Margin="18,0" VerticalAlignment="Center" FontSize="10"/></StackPanel></Border><ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatPanel" Margin="20,18"/></ScrollViewer><Border x:Name="ComposerGlow" Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" Margin="15,10"><Border x:Name="Composer" CornerRadius="9" Padding="1" Background="Transparent"><Grid Margin="9" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="📎 Прикрепить файл" Click="OpenFolder_Click" Padding="7,3"/><TextBlock x:Name="ComposerStatus" Text="  Режим агента: Автономное внесение правок" Foreground="{DynamicResource Success}" VerticalAlignment="Center" FontSize="11"/></StackPanel><TextBox x:Name="PromptInput" Grid.Row="1" MinHeight="42" MaxHeight="220" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" KeyDown="PromptInput_KeyDown" Padding="4" FontSize="13"/><Grid Grid.Row="2"><TextBlock Text="Ctrl + Enter для отправки · Enter — новая строка" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button x:Name="SendButton" Style="{StaticResource ThinkingSendButton}" Click="Send_Click" HorizontalAlignment="Right" MinWidth="110"/></Grid></Grid></Border></Border></Grid>
 <!-- Inspector --> <GridSplitter Grid.Column="4" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeDirection="Columns"/><Border Grid.Column="5" Background="{DynamicResource PanelBg}"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Background="{DynamicResource SubBg}"><Button Content="Действия агента" Style="{StaticResource InspectorTabButton}" Click="AgentTab_Click"/><Button Content="Просмотр Diff" Style="{StaticResource InspectorTabButton}" Click="DiffTab_Click"/><Button Content="Живой предпросмотр" Style="{StaticResource InspectorTabButton}" Click="PreviewTab_Click"/></StackPanel><ScrollViewer x:Name="AgentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="InspectorPanel" Margin="18"/></ScrollViewer></Grid></Border>
 </Grid>
 <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="ветка:(main*)     UTF-8     ● API: Подключено" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="14,0"/></Border>
</Grid></Window>
