<Window x:Class="AISoftCraftDuck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AISoftCraftDuck.Controls" Title="CORETECH IT DEV" Width="1600" Height="900" MinWidth="1000" MinHeight="650" WindowStyle="None" Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}">
<Grid>
 <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="45"/><ColumnDefinition Width="45"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="  CORETECH IT DEV" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="1" Content="—" Click="Minimize_Click" Padding="0" Margin="0" Background="Transparent"/><Button Grid.Column="2" Content="□" Click="Maximize_Click" Padding="0" Margin="0" Background="Transparent"/><Button Grid.Column="3" Content="×" Click="Close_Click" Padding="0" Margin="0" Background="#C42B1C"/></Grid>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Panel}" Padding="14"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="PROJECTS" FontWeight="Bold" Foreground="{DynamicResource AccentPurple}" Margin="4,4,4,10"/><Button Content="＋ Новый проект" Command="{Binding CreateProjectCommand}"/><Button Content="📂 Открыть папку" Command="{Binding ChooseFolderCommand}"/><Button Content="⚙ Настройки" Command="{Binding ToggleSettingsCommand}"/><TextBlock Text="Мои проекты" Foreground="{DynamicResource TextSecondary}" Margin="4,16,4,5"/><ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding CurrentProject}" DisplayMemberPath="Name" MaxHeight="220"/><StackPanel Orientation="Horizontal"><Button Content="Открыть" Command="{Binding OpenProjectCommand}" Width="110"/><Button Content="Удалить" Command="{Binding DeleteProjectCommand}" Width="100"/></StackPanel><TextBlock Text="Model" Foreground="{DynamicResource TextSecondary}" Margin="4,14,4,2"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/></StackPanel>
   <Border Background="{DynamicResource CardBg}" Padding="7" Margin="0,12,0,0"><ListBox ItemsSource="{Binding Files}" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Border>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource Panel}" Padding="16" CornerRadius="8"><ScrollViewer x:Name="MessagesScroll"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding SenderLabel}" Foreground="{DynamicResource AccentPurple}" FontWeight="SemiBold"/><controls:MarkdownText Markdown="{Binding Content}" Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border><Border Grid.Row="1" Background="{DynamicResource Panel}" Padding="12" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding AttachmentSummary}" Foreground="{DynamicResource TextSecondary}"/><TextBox x:Name="PromptBox" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="150" PreviewKeyDown="PromptBox_PreviewKeyDown"/></StackPanel><StackPanel Grid.Column="1"><Button Content="📎 Прикрепить" Command="{Binding AttachFilesCommand}" Height="34"/><Button Content="Отправить" Command="{Binding SendCommand}" Height="42" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/></StackPanel></Grid></Border></Grid>
 </Grid>
 <Border Grid.RowSpan="2" Background="#99000000" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}" MouseDown="SettingsOverlay_MouseDown"><Border Background="{DynamicResource Panel}" Width="650" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><ScrollViewer><StackPanel><TextBlock Text="Настройки" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentPurple}"/><TextBlock Text="API Base URL"/><TextBox Text="{Binding BaseUrl}"/><TextBlock Text="API Key"/><TextBox Text="{Binding ApiKey}"/><TextBlock Text="Theme"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/><Button Content="Сохранить" Command="{Binding SaveSettingsCommand}" Width="120" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></Border></Border>
</Grid></Window>