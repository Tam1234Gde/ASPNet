<UserControl x:Class="AISoftCraftDuck.Controls.CodeBlockControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Background="#20242D"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="10,5"><TextBlock Text="{Binding Language, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#B8C3D3" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="⧉" ToolTip="Копировать код" Command="{Binding CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="30" Height="26" Padding="0" Margin="0" FontSize="17"/></DockPanel><avalon:TextEditor x:Name="Editor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True" Background="#171A20" Foreground="#DCE4EF"/></Grid></UserControl>