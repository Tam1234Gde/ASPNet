# T-Bank Invest API (прямое соединение, прокси Telegram не применяется)
TINKOFF_INVEST_TOKEN=replace_me
ACCOUNT_ID=replace_me
IS_SANDBOX=true

AI_PROVIDER=anthropic
AI_BASE_URL=https://apiduck.sytes.net
AI_DECISION_PATH=/v1/messages
AI_FEEDBACK_PATH=
AI_API_TOKEN=replace_me
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=512
AI_TIMEOUT_SECONDS=30

DRY_RUN=true
INSTRUMENT_UIDS=replace_with_uid
CANDLE_INTERVAL=1min
ORDERBOOK_DEPTH=20
MAX_SESSION_DRAWDOWN_RUB=10000
MAX_ORDER_LOTS=1
ALLOW_MARKET_ORDERS=false
SANDBOX_INITIAL_RUB=100000
JOURNAL_PATH=state/orders.sqlite3
MAX_SNAPSHOT_AGE_SECONDS=30

# Telegram: только личный чат и numeric ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Xray-core: официальный релиз https://github.com/XTLS/Xray-core/releases
XRAY_PATH=C:\\Tools\\xray\\xray.exe
VPN_CONFIG_PATH=state/telegram_xray.json
# Если Xray запущен отдельно, можно задать локальный HTTP proxy:
# TELEGRAM_PROXY=http://127.0.0.1:10809
