<Window x:Class="AIEngineerStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:chat="clr-namespace:AIEngineerStudio.UI" Title="AI Engineer Studio" Width="1600" Height="1000" MinWidth="1120" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBg}">
<Window.Resources>
  <LinearGradientBrush x:Key="RainbowBorderBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
   <GradientStop Color="#FF5CF6" Offset="0"/><GradientStop Color="#FF4D8D" Offset="0.2"/><GradientStop Color="#FFE45C" Offset="0.4"/><GradientStop Color="#5CFFB0" Offset="0.6"/><GradientStop Color="#5CD9FF" Offset="0.8"/><GradientStop Color="#A56CFF" Offset="1"/>
   <LinearGradientBrush.RelativeTransform><RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="ComposerGlowEffect" Color="#9B5CFF" BlurRadius="20" ShadowDepth="0" Opacity="0"/>
   <LinearGradientBrush x:Key="GenerationBackgroundBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
    <GradientStop Color="#503C8C" Offset="0"/><GradientStop Color="#236A8A" Offset="0.25"/><GradientStop Color="#3D8C73" Offset="0.5"/><GradientStop Color="#8C6A32" Offset="0.75"/><GradientStop Color="#693B8C" Offset="1"/>
    <LinearGradientBrush.RelativeTransform><RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
   </LinearGradientBrush>
  <Style x:Key="WindowControlButton" TargetType="Button"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#FFBD2E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Ellipse x:Name="ControlSurface" Fill="{TemplateBinding Background}" Stretch="Fill"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ControlSurface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ControlSurface" Property="Opacity" Value="0.62"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="WindowMinimizeButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Setter Property="Background" Value="#FFBD2E"/></Style>
  <Style x:Key="WindowMaximizeButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Setter Property="Background" Value="#27C93F"/></Style>
  <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Setter Property="Background" Value="#FF5F56"/><Setter Property="Foreground" Value="#5B1714"/></Style>
  <Style x:Key="ThinkingSendButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Content" Value="Отправить ↵"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=Composer}" Value="False"><Setter Property="Content" Value="Ожидание…"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border x:Name="GenerationBackground" Grid.Row="1" IsHitTestVisible="False" Opacity="0" Background="{StaticResource GenerationBackgroundBrush}"/>
 <!-- Custom titlebar -->
 <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="✦  AI Engineer Studio" Foreground="{DynamicResource Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0"/><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="● API: Подключено" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="TokenBalanceText" Text="Баланс: загрузка…" Foreground="{DynamicResource Muted}" FontSize="9" HorizontalAlignment="Center" ToolTip="Баланс загружается из ApiDuck"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"><Button Style="{StaticResource WindowMinimizeButton}" Click="Minimize_Click"/><Button Style="{StaticResource WindowMaximizeButton}" Click="Maximize_Click"/><Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition x:Name="ContextColumn" Width="0" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="540" MinWidth="330"/></Grid.ColumnDefinitions>
 <!-- Activity --> <Border Grid.Column="0" Background="{DynamicResource SubBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><Button Content="⑂" Style="{StaticResource AccentButton}" Click="Git_Click" ToolTip="Git проекта" Margin="7,12,7,4" FontSize="17"/><Button Content="▤" Click="Prompts_Click" Margin="7,4" FontSize="16"/></StackPanel><StackPanel Grid.Row="1"><Button Content="☀" ToolTip="Светлая тема" Click="QuickTheme_Click" Margin="7,4" FontSize="17" Background="{DynamicResource CardBg}" Foreground="{DynamicResource Text}"/><Button Content="⚙" ToolTip="Настройки API и промпта" Click="Settings_Click" Margin="7,4,7,12" FontSize="17" Background="{DynamicResource Accent}" Foreground="White"/></StackPanel></Grid></Border>
  <!-- Project explorer -->
  <Border Grid.Column="1" Background="{DynamicResource PanelBg}" x:Name="ContextPanel" Visibility="Collapsed" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
   <Grid Margin="10" Keyboard.KeyDown="Explorer_KeyDown">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="2,2,2,10">
     <TextBlock Text="ПРОВОДНИК" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="↻" Click="ExplorerRefresh_Click" ToolTip="Обновить (F5)" Padding="7,3"/>
      <Button Content="⊟" Click="ExplorerCollapse_Click" ToolTip="Свернуть папки и очистить поиск" Padding="7,3" Margin="4,0,0,0"/>
      <Button Content="⇄" Click="SwitchProject_Click" ToolTip="Сменить проект" Padding="7,3" Margin="4,0,0,0"/><Button Content="☁" Click="RemoteProject_Click" ToolTip="Удалённые проекты" Padding="7,3" Margin="4,0,0,0"/>
     </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBg}" CornerRadius="6" Padding="9" Margin="0,0,0,8">
     <TextBlock x:Name="ContextInfo" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" Padding="8,6" ToolTip="Поиск по имени или относительному пути во всём проекте"/>
     <TextBlock x:Name="FilterPlaceholder" Text="Поиск файлов и папок…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="9,0" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Content="×" Click="ExplorerClear_Click" ToolTip="Очистить поиск" Padding="7,3" Margin="4,0,0,0"/>
    </Grid>
    <CheckBox Grid.Row="3" x:Name="ExplorerGenerated" Content="Служебные папки" ToolTip="Показывать .git, bin, obj, node_modules, artifacts и другие служебные каталоги" Click="ExplorerGenerated_Click" Margin="3,0,0,8" Foreground="{DynamicResource Muted}" FontSize="11"/>
    <TreeView Grid.Row="4" x:Name="ProjectTree" Background="Transparent" Foreground="{DynamicResource Body}" BorderThickness="0" MouseDoubleClick="ProjectTree_MouseDoubleClick"
      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
     <TreeView.Resources>
      <Style TargetType="TreeViewItem">
       <Setter Property="Foreground" Value="{DynamicResource Body}"/>
       <Setter Property="Padding" Value="2,1"/>
       <Setter Property="IsTabStop" Value="True"/>
       <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
       <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
       <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Cursor" Value="Hand"/></Trigger>
       </Style.Triggers>
      </Style>
     </TreeView.Resources>
    </TreeView>
    <Border Grid.Row="5" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="3,8,3,0" Margin="0,6,0,0">
     <TextBlock x:Name="ExplorerStatus" Text="Готово" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Border>
   </Grid>
  </Border>
 <!-- Chat --> <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeDirection="Columns"/><Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="15,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="МОДЕЛЬ" Foreground="{DynamicResource Muted}" FontSize="9" FontWeight="Bold"/><Button x:Name="ModelPickerButton" Click="ModelPicker_Click" Margin="0,3,0,0" Padding="8,5" HorizontalContentAlignment="Stretch" ToolTip="Открыть каталог моделей"><DockPanel><TextBlock Text=" ▦" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="ModelName" Text="Выбрать модель" TextTrimming="CharacterEllipsis"/></DockPanel></Button></StackPanel><ComboBox x:Name="PromptBox" Grid.Column="1" Style="{StaticResource TopSelector}" VerticalAlignment="Center" Margin="10,10,0,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Body}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Grid.Column="2" Margin="16,7,0,0" VerticalAlignment="Center"><TextBlock x:Name="SelectedModelInfo" Text="Выберите модель для просмотра описания" Foreground="{DynamicResource Body}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedModelUseCase" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="{DynamicResource SubBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="DevelopmentChatButton" Content="⚙ Разработка" Click="DevelopmentChat_Click" Padding="14,7" Margin="0,0,6,0" FontWeight="SemiBold"/><Button x:Name="ConversationChatButton" Content="💬 Общение" Click="ConversationChat_Click" Padding="14,7" Margin="6,0,0,0"/><Button Content="✦ Новый чат" Click="NewChat_Click" Padding="10,7" Margin="12,0,0,0" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Text}"/></StackPanel></Border><Grid Grid.Row="2"><chat:ChatMessageList x:Name="ChatPanel"/><Button Content="К новым сообщениям ↓" Click="LatestMessages_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"/></Grid><Border x:Name="ComposerGlow" Grid.Row="3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" Margin="15,10"><Border x:Name="Composer" CornerRadius="9" Padding="1" Background="Transparent"><Grid Margin="9" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="📎 Вложения" Click="AttachFiles_Click" Padding="7,3"/><Button Content="✦ Медиа" Click="MediaTools_Click" Padding="7,3" Margin="6,0,0,0"/><TextBlock x:Name="ComposerStatus" Text="  Режим агента: Автономное внесение правок" Foreground="{DynamicResource Success}" VerticalAlignment="Center" FontSize="11"/></StackPanel><StackPanel Grid.Row="1"><WrapPanel x:Name="ClarificationActions" Visibility="Collapsed"><Button Content="Посмотреть контекст" Click="SurveyContext_Click" Margin="0,4,6,4"/><Button Content="Повторить запрос" Click="RetryConversation_Click" Margin="0,4,6,4"/><Button Content="Уточнить задачу" Click="ClarifyTask_Click" Margin="0,4,6,4"/><Button Content="Сформировать промпт" Click="GeneratePrompt_Click" Margin="0,4,0,4"/></WrapPanel><TextBox x:Name="PromptInput" MinHeight="42" MaxHeight="220" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" KeyDown="PromptInput_KeyDown" Padding="4" FontSize="13"/></StackPanel><Grid Grid.Row="2"><TextBlock Text="Ctrl + Enter для отправки · Enter — новая строка" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button x:Name="SendButton" Style="{StaticResource ThinkingSendButton}" Click="Send_Click" HorizontalAlignment="Right" MinWidth="110"/></Grid></Grid></Border></Border></Grid>
 <!-- Inspector --> <GridSplitter Grid.Column="4" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeDirection="Columns"/><Border Grid.Column="5" Background="{DynamicResource PanelBg}"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Background="{DynamicResource SubBg}"><Button Content="Режим агента" Click="ReturnToAgent_Click" ToolTip="Вернуться к инструментам проекта; остановить ожидание медиа"/><Button Content="Действия агента" Style="{StaticResource InspectorTabButton}" Click="AgentTab_Click"/><Button Content="Просмотр Diff" Style="{StaticResource InspectorTabButton}" Click="DiffTab_Click"/><Button Content="Живой предпросмотр" Style="{StaticResource InspectorTabButton}" Click="PreviewTab_Click"/></StackPanel><ScrollViewer x:Name="AgentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="InspectorPanel" Margin="18"/></ScrollViewer></Grid></Border>
 </Grid>
 <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><DockPanel><TextBlock x:Name="StatusText" Text="ветка:(main*)     UTF-8     ● API: Подключено" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="14,0"/><TextBlock Text="AI Engineer Studio · v1.0.20261001.2" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/></DockPanel></Border>
</Grid></Window>
