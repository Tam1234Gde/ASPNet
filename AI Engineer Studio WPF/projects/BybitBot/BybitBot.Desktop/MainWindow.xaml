<Window x:Class="BybitBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BybitBot — настройки" Height="680" Width="760" MinHeight="600" MinWidth="680" Background="#121212" Foreground="#F2F2F2">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="BybitBot" FontSize="30" FontWeight="Bold"/><TextBlock Text="Настройки торговли и AI-фильтра. По умолчанию используется Testnet." Foreground="#BDBDBD" Margin="0,5,0,20"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.Resources><Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,16,12"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="PasswordBox"><Setter Property="Margin" Value="0,4,16,12"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,2"/></Style></Grid.Resources>
   <StackPanel><TextBlock Text="СЕТЬ И BYBIT" FontWeight="Bold" Foreground="#FFD54F"/><TextBlock Text="Среда"/><ComboBox x:Name="EnvironmentBox" SelectedIndex="0" Margin="0,4,16,12"><ComboBoxItem Content="Testnet"/><ComboBoxItem Content="Mainnet"/></ComboBox><TextBlock Text="API Key Bybit"/><TextBox x:Name="BybitKeyBox"/><TextBlock Text="API Secret Bybit"/><PasswordBox x:Name="BybitSecretBox"/><TextBlock Text="Символ"/><TextBox x:Name="SymbolBox" Text="BTCUSDT"/><TextBlock Text="Порог уверенности ONNX (0..1)"/><TextBox x:Name="ConfidenceBox" Text="0.65"/><TextBlock Text="Риск на сделку (доля, например 0.01)"/><TextBox x:Name="RiskBox" Text="0.01"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="AI-ФИЛЬТР API DUCK" FontWeight="Bold" Foreground="#FFD54F"/><CheckBox x:Name="AiEnabledBox" Content="Включить подтверждение сигналов AI" Margin="0,4,0,12"/><TextBlock Text="Токен API Duck"/><PasswordBox x:Name="AiTokenBox"/><TextBlock Text="Модель"/><TextBox x:Name="AiModelBox" Text="claude-sonnet-4-6"/><TextBlock Text="Base URL"/><TextBox x:Name="AiUrlBox" Text="https://apiduck.sytes.net"/><Border Background="#322B14" Padding="12" Margin="0,10,16,0"><TextBlock TextWrapping="Wrap" Foreground="#FFE082" Text="AI — дополнительный консервативный фильтр, не гарантия доходности. При ошибке AI сигнал блокируется. Для Mainnet сначала проверьте стратегию на Testnet."/></Border></StackPanel>
  </Grid>
  <StackPanel Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#BDBDBD" Margin="0,16,0,8"/><Button Content="Сохранить настройки" Click="Save_Click" Width="210" Height="38" HorizontalAlignment="Left"/></StackPanel>
 </Grid></ScrollViewer>
</Window>