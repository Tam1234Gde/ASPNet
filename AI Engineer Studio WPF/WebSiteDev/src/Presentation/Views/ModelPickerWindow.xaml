<Window x:Class="AIEngineerStudio.Views.ModelPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Каталог моделей" Width="1040" Height="740" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}">
 <Window.Resources>
  <Style x:Key="Card" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Модель под вашу задачу" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Найдите подходящий инструмент. Просмотрите подробности и подтвердите выбор." Foreground="{DynamicResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ПОИСК ПО НАЗВАНИЮ, ПРОВАЙДЕРУ И ОПИСАНИЮ" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="10" ToolTip="Поиск моделей" AutomationProperties.Name="Поиск моделей"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="НАЗНАЧЕНИЕ" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="PurposeBox" MinHeight="38" SelectionChanged="PurposeChanged" Padding="8" AutomationProperties.Name="Назначение модели"/></StackPanel></Grid>
  <TextBlock x:Name="ResultCount" Grid.Row="2" Margin="0,14,0,10" Foreground="{DynamicResource Muted}"/>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Grid><ListBox x:Name="ModelList" SelectionChanged="ModelChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Card}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Модели"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding CurrentLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource Success}" FontSize="10"/><TextBlock Text="{Binding Model.Id}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,8"/><TextBlock Text="{Binding Model.BestFor}" Foreground="{DynamicResource Body}" TextWrapping="Wrap"/><TextBlock Text="{Binding PurposeLabel}" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyState" Text="Ничего не найдено. Попробуйте другой запрос или назначение." TextWrapping="Wrap" Margin="18" Visibility="Collapsed" Foreground="{DynamicResource Muted}"/></Grid>
   <Border Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="16,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Details"><TextBlock Text="О МОДЕЛИ" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding Model.Id}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,5"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding Model.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Body}" Margin="0,20,0,0"/><TextBlock Text="ПОДХОДИТ ДЛЯ" FontSize="10" Foreground="{DynamicResource Accent}" Margin="0,22,0,8"/><TextBlock Text="{Binding Model.BestFor}" TextWrapping="Wrap"/><TextBlock Text="{Binding PurposeLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/><TextBlock Text="Коэффициент стоимости указан сервисом, это не цена запроса. Назначения — рекомендации каталога, а не результаты сравнительных тестов." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,24,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <DockPanel Grid.Row="4" Margin="0,20,0,0"><Button Content="Назад в чат" IsCancel="True" Padding="16,9" DockPanel.Dock="Left"/><Button x:Name="ApplyButton" Content="Использовать модель" Click="Apply_Click" Style="{StaticResource AccentButton}" Padding="20,9" HorizontalAlignment="Right" IsEnabled="False"/></DockPanel>
 </Grid>
</Window>