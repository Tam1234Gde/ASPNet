      .replace(/^Генерация картинки /, "Image generation ")
      .replace(/^Редактирование картинки /, "Image editing ")
      .replace(/^Базовая транскрибация /, "Basic transcription ");
  }
  function translateNode(node) {
    if (node.nodeType === Node.TEXT_NODE) {
      if (!node.parentElement || node.parentElement.closest("script,style,pre,code,textarea,.model-name,.model-id,#logs-table tbody,.instruction-manual-text")) return;
      const previous = sources.get(node);
      const source = previous && previous.output === node.nodeValue ? previous.source : node.nodeValue;
      const output = source.replace(/\S[\s\S]*\S|\S/, value => t(value));
      sources.set(node, {source, output});
      if (node.nodeValue !== output) node.nodeValue = output;
    } else if (node.nodeType === Node.ELEMENT_NODE) {
      if (node.matches("script,style,pre,code,textarea")) return;
      for (const attr of ["placeholder", "title", "aria-label"]) {
        const value = node.getAttributeNode(attr);
        if (!value) continue;
        const previous = sources.get(value);
        const source = previous && previous.output === value.value ? previous.source : value.value;
        const output = t(source);
        sources.set(value, {source, output});
        if (value.value !== output) value.value = output;
      }
      for (const child of node.childNodes) translateNode(child);
    }
