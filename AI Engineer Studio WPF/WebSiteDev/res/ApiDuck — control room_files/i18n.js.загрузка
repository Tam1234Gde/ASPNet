      }
      observe();
    });
    function observe() { observer.observe(document.body, {childList:true, subtree:true, characterData:true, attributes:true, attributeFilter:["placeholder","title","aria-label"]}); }
    observe();
    document.addEventListener("click", event => {
      const button = event.target.closest("[data-language]");
      if (!button || button.dataset.language === language) return;
      language = button.dataset.language === "en" ? "en" : "ru";
      try { sessionStorage.setItem("apiduck.language", language); } catch {}
      observer.disconnect();
      apply();
      document.dispatchEvent(new Event("apiduck:language"));
      apply();
      observe();
    });
  });
