  const sources = new WeakMap();
  function t(text) {
    if (language === "ru") return text;
    if (translations[text]) return translations[text];
    return text
      .replace(/^Другие · /, "Others · ")
      .replace(/^(\d+) приложения · выберите среду запуска$/, "$1 apps · choose a client")
      .replace(/^(\d+) доступных систем$/, "$1 operating systems")
      .replace(/^макс (.+) токенов$/, "max $1 tokens")
