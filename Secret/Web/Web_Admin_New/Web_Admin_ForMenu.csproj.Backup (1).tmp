<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HIDE.RestAndRant.Web_Admin_New</AssemblyName>
    <RootNamespace>HIDE.RestAndRant.Web_Admin_New</RootNamespace>
	  <Version>2.26.08.10</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.7.0" />
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Business\Business.csproj" />
    <ProjectReference Include="..\..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HIDE.Crypto_Core">
      <HintPath>..\..\..\HIDE_DLL\HIDE.Crypto_Core\v1\net10.0\HIDE.Crypto_Core.dll</HintPath>
    </Reference>
    <Reference Include="HIDE.Units_Core">
      <HintPath>..\..\..\HIDE_DLL\HIDE.Units_Core\net10.0\HIDE.Units_Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
