<?xml version="1.0" encoding="utf-8" ?>
<log4net debug="true">
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="log/logfile.log" />
		<appendToFile value="true" />
		<rollingStyle value="Size" />
		<maximumFileSize value="8MB" />
		<maxSizeRollBackups value="-1" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{dd.MM.yyyy HH:mm:ss,fff}] (%level) ~%logger - %message %newline" />
		</layout>
	</appender>

	<root>
		<!-- HIDE: уровень сообщений: все события -->
		<level value="ALL" />

		<!-- HIDE: уровень сообщений: только начиная с info -->
		<!-- <level value="INFO" /> -->

		<!-- HIDE: appender указывается для файловой версии -->
		<appender-ref ref="RollingFileAppender" />

	</root>
</log4net>
