@model List<CRestaurant>
@{
    // Таблица > Рестораны
    Layout = null;
}

@* Таблица > Рестораны *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Address)" title="@Html.DisplayNameFor(x=> new CRestaurant().Address)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Address)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().City)" title="@Html.DisplayNameFor(x=> new CRestaurant().City)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().City)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Latitude)" title="@Html.DisplayNameFor(x=> new CRestaurant().Latitude)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Latitude)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Longitude)" title="@Html.DisplayNameFor(x=> new CRestaurant().Longitude)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Longitude)</span>
                </th> 
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Hours_Work)" title="@Html.DisplayNameFor(x=> new CRestaurant().Hours_Work)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Hours_Work)</span>
                </th>  
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Hours_WorkApp)" title="@Html.DisplayNameFor(x=> new CRestaurant().Hours_WorkApp)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Hours_WorkApp)</span>
                </th>   
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Hours_HardWork)" title="@Html.DisplayNameFor(x=> new CRestaurant().Hours_HardWork)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Hours_HardWork)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Hours_BookingWork)" title="@Html.DisplayNameFor(x=> new CRestaurant().Hours_BookingWork)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Hours_BookingWork)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-7.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Delivery_Price)" title="@Html.DisplayNameFor(x=> new CRestaurant().Delivery_Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Delivery_Price)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Incafe)" title="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Incafe)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Flag_Incafe)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Myself)" title="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Myself)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Flag_Myself)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-16.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Delivery)" title="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Delivery)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Flag_Delivery)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Car)" title="@Html.DisplayNameFor(x=> new CRestaurant().Flag_Car)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Flag_Car)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x => new CRestaurant().Flag_Hidden)" title="@Html.DisplayNameFor(x => new CRestaurant().Flag_Hidden)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Flag_Hidden)</span>
                </th>
                <th data-orderable="false" style="min-width: 170px; width: 170px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Address)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.City)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Latitude)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Longitude)
                    </td>  
                    <td>
                        @Html.DisplayFor(modelItem => item.Hours_Work)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Hours_WorkApp)
                    </td>    
                    <td>
                        @Html.DisplayFor(modelItem => item.Hours_HardWork)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Hours_BookingWork)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Delivery_Price)
                    </td>
                    <td>
                        @if (item.Flag_Incafe == true)
                        {
                            <text>Есть возможность поесть в кафе</text>
                        }
                    </td>
                    <td>
                        @if (item.Flag_Myself == true)
                        {
                            <text>Есть возможность забрать с собой</text>
                        }
                    </td>
                    <td>
                        @if (item.Flag_Delivery == true)
                        {
                            <text>Возможна доставка</text>
                        }
                    </td>
                    <td>
                        @if (item.Flag_Car == true)
                        {
                            <text>Есть возможность вынести к машине</text>
                        }
                    </td>
                    <td>
                        @if (item.Flag_Hidden == true)
                        {
                            <text>Отключен</text>
                        }
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-controller="RestaurantMenus" asp-action="RestaurantMenu_Index" asp-route-RestaurantID="@item.ID" class="btn btn-block bg-gradient-primary text-white"><i class="fas fa-book"></i></a>
                        <a asp-controller="RestaurantHalls" asp-action="Index" asp-route-RestaurantID="@item.ID" class="btn btn-block bg-gradient-success text-white" style="margin: 0 5px 0 0;"><i class="fas fa-eye"></i></a>
                        <a asp-controller="RestaurantTables" asp-action="Index" asp-route-RestaurantID="@item.ID" class="btn btn-block bg-gradient-primary text-white" style="margin: 0 5px 0 0;"><i class="fas fa-certificate"></i></a>
                        <a asp-controller="Restaurant_PayTypes" asp-action="Restaurant_PayType_Index" asp-route-RestaurantID="@item.ID" class="btn btn-block bg-gradient-success text-white" style="margin: 0 5px 0 0;"><i class="fas fa-lock"></i></a>
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning" style="margin: 0;"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger" style="margin-top: 0 !important; margin-left: 5px;"><i class="fas fa-times-circle" style="color:#ffffff;"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}