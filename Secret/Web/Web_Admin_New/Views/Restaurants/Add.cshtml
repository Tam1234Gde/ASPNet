@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Restaurants
@model Model_Restaurants_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Restaurants_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить ресторан";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление ресторана *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Город *@
                            @if (Model.List_Cities != null && Model.List_Cities.Count != 0)
                            {
                                <div class="form-group pt-3">
                                    <label asp-for="CityID">Город*</label>
                                    <select asp-for="CityID" id="RestaurantID" class="custom-select HIDE-custom-select rounded-0">
                                        <option selected="selected" value="-1">[Не задано]</option>
                                        @foreach (var item in Model.List_Cities)
                                        {
                                            if (item.ID == Model.CityID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            }

                            @* Адрес *@
                            <div class="form-group">
                                <label asp-for="Adress" class="control-label">Адрес*</label>
                                <textarea asp-for="Adress" class="form-control"></textarea>
                                <span asp-validation-for="Adress" class="text-danger"></span>
                            </div>

                            @* Широта *@
                            <div class="form-group">
                                <label asp-for="Latitude" class="control-label">Широта*</label>
                                <input asp-for="Latitude" class="form-control" type="number" />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>

                            @* Долгота *@
                            <div class="form-group">
                                <label asp-for="Longitude" class="control-label">Долгота*</label>
                                <input asp-for="Longitude" class="form-control" type="number" />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>

                            @* Telegram - Код чата *@
                            <div class="form-group">
                                <label asp-for="TgChatID" class="control-label">Telegram - Обычные заказы(кроме бронирования)</label>
                                <input asp-for="TgChatID" class="form-control" />
                            </div>

                            @* Telegram - Бронирование *@
                            <div class="form-group">
                                <label asp-for="TgChatBookingID" class="control-label">Telegram - Бронирование</label>
                                <input asp-for="TgChatBookingID" class="form-control" />
                            </div>

                            @* Telegram - QR *@
                            <div class="form-group">
                                <label asp-for="TgChatQrID" class="control-label">Telegram - QR(сайт меню)</label>
                                <input asp-for="TgChatQrID" class="form-control" />
                            </div>

                            @* Доставка в минутах *@
                            <div class="form-group">
                                <label asp-for="Delivery_Time" class="control-label">Доставка в минутах</label>
                                <input asp-for="Delivery_Time" class="form-control" type="number" />
                            </div>

                            @* Срочная доставка в минутах *@
                            <div class="form-group">
                                <label asp-for="Express_Delivery_Time" class="control-label">Срочная доставка в минутах</label>
                                <input asp-for="Express_Delivery_Time" class="form-control" type="number" />
                            </div>

                            @* Часы работы ресторана через ; *@
                            <div class="form-group">
                                <label asp-for="Hours_Work" class="control-label">Часы работы ресторана через ;</label>
                                <input asp-for="Hours_Work" class="form-control" />
                                @* <span asp-validation-for="Hours_Work" class="text-danger"></span> *@
                            </div>

                            @* Часы работы ресторана для заказа в приложении через ; *@
                            <div class="form-group">
                                <label asp-for="Hours_WorkApp" class="control-label">Часы работы ресторана для заказа в приложении через ;</label>
                                <input asp-for="Hours_WorkApp" class="form-control" />
                                @* <span asp-validation-for="Hours_WorkApp" class="text-danger"></span> *@
                            </div>

                            @* Часы загрузки работы ресторана через ; *@
                            <div class="form-group">
                                <label asp-for="Hours_HardWork" class="control-label">Часы загрузки работы ресторана через ;</label>
                                <input asp-for="Hours_HardWork" class="form-control" />
                                @* <span asp-validation-for="Hours_WorkApp" class="text-danger"></span> *@
                            </div>

                            @* Часы работы ресторана для заказа бронирования через ; *@
                            <div class="form-group">
                                <label asp-for="Hours_BookingWork" class="control-label">Часы работы ресторана для заказа бронирования через ;</label>
                                <input asp-for="Hours_BookingWork" class="form-control" />
                                @* <span asp-validation-for="Hours_WorkApp" class="text-danger"></span> *@
                            </div>      
                            
                            @* Телефон для переноса времени брони *@
                            <div class="form-group">
                                <label asp-for="BookingPhone" class="control-label">Телефон для переноса времени брони</label>
                                <input asp-for="BookingPhone" class="form-control" />
                                @* <span asp-validation-for="Hours_WorkApp" class="text-danger"></span> *@
                            </div>

                            @* На сколько можно забронировать VIP столик(в часах) *@
                            <div class="form-group">
                                <label asp-for="BookingHour" class="control-label">На сколько можно забронировать VIP столик(в часах)</label>
                                <input asp-for="BookingHour" class="form-control" type="number" />
                            </div>

                            @* Стоимость доставки *@
                            <div class="form-group">
                                <label asp-for="Delivery_Price" class="control-label">Стоимость доставки</label>
                                <input asp-for="Delivery_Price" class="form-control" type="number" />
                            </div>   
                           
                            @* Есть возможность поесть в кафе *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Incafe" /> Есть возможность поесть в кафе
                                </label>
                            </div>

                            @* Есть возможность забрать с собой *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Myself" /> Есть возможность забрать с собой
                                </label>
                            </div>

                            @* Возможна доставка *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Delivery" /> Возможна доставка
                                </label>
                            </div>

                            @* Есть возможность вынести к машине *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Car" /> Есть возможность вынести к машине
                                </label>
                            </div>

                            @* Код системного клиента *@
                            <div class="form-group">
                                <label asp-for="ClientID" class="control-label">Код системного клиента(для заказов с сайта)</label>
                                <input asp-for="ClientID" class="form-control" type="number" />
                            </div>

                            @* Отключен *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Hidden" /> Отключен
                                </label>
                            </div>

                            @* Заголовок в модальном окне при отключенном ресторане *@
                            <div class="form-group">
                                <label asp-for="HiddenTitle" class="control-label">Заголовок в модальном окне при отключенном ресторане </label>
                                <input asp-for="HiddenTitle" class="form-control" />
                            </div>

                            @* Текст в модальном окне при отключенном ресторане *@
                            <div class="form-group">
                                <label asp-for="HiddenText" class="control-label">Текст в модальном окне при отключенном ресторане </label>
                                <textarea asp-for="HiddenText" class="form-control"></textarea>
                            </div>

                            @* Юкасса логин *@
                            <div class="form-group">
                                <label asp-for="YouKassaLogin" class="control-label">Юкасса логин</label>
                                <input asp-for="YouKassaLogin" class="form-control" />
                            </div>

                            @* Юкасса пароль *@
                            <div class="form-group">
                                <label asp-for="YouKassaPassword" class="control-label">Юкасса пароль</label>
                                <input asp-for="YouKassaPassword" class="form-control" />
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }