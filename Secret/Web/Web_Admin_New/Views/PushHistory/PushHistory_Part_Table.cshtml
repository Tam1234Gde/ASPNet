@model List<CClientNotification_History_ForAdmin>
@{
    Layout = null;
}

@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Name)" title="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Name)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Content)" title="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Content)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Content)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Date_Created)" title="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Date_Created)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Date_Created)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Date_Send)" title="@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Date_Send)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientNotification_History_ForAdmin().Date_Send)</span>
                </th>
                <th class="export">
                    <span class="HIDE-jscss-table-head-text">Скачать</span>
                </th>
                <th class="delete">
                    <span class="HIDE-jscss-table-head-text">Удалить</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (CClientNotification_History_ForAdmin item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Content)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date_Created)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date_Send)
                    </td>
                    <td class="text-center">
                        @if (item.Flag_Selected)
                        {
                            <form asp-controller="PushHistory" asp-action="GetFile" asp-route-ID="@item.ID" asp-route-Name="@item.Name" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-download"></i>Скачать Excel
                                </button>
                            </form>
                        }
                    </td>
                    <td>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger" style="margin-top: 0 !important; margin-left: 5px; width: 40px"><i class="fas fa-times-circle" style="color:#ffffff;"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style="border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}