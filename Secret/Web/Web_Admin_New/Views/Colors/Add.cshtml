@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Colors
@model Model_Colors_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Colors_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить цвет";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление цвета *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Наименование EN *@
                            <div class="form-group">
                                <label asp-for="Name_Eng" class="control-label">Наименование - EN*</label>
                                <input asp-for="Name_Eng" class="form-control" />
                                <span asp-validation-for="Name_Eng" class="text-danger"></span>
                            </div>

                            @* Цвет стакана - HEX *@
                            <div class="form-group">
                                <label asp-for="HexColor">Цвет стакана - HEX*</label>
                                <input asp-for="HexColor" type="text" class="form-control my-colorpicker1">
                                <span asp-validation-for="HexColor" class="text-danger"></span>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }