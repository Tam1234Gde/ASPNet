@model List<CColor>
@{
    // Таблица > Цвета
    Layout = null;
}

@* Таблица > Цвета *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CColor().Name)" title="@Html.DisplayNameFor(x=> new CColor().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x=> new CColor().Name)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CColor().Name_Eng)" title="@Html.DisplayNameFor(x=> new CColor().Name_Eng)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x=> new CColor().Name_Eng)</span>
                </th>
                <th class="export" style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CColor().HexColor)" title="@Html.DisplayNameFor(x=> new CColor().HexColor)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CColor().HexColor)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name_Eng)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.HexColor)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}