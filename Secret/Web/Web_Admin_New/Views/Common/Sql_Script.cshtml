@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Common
@model Model_Script
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Выполнить скрипт";
    ViewBag.RazdelNameMobile = "Выполнить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление категории *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Sql_Script">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Скрипт *@
                            <div class="form-group">
                                <label asp-for="Text" class="control-label">Скрипт*</label>
                                <textarea asp-for="Text" class="form-control"></textarea>
                                <span asp-validation-for="Text" class="text-danger"></span>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Выполнить *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <input type="submit" value="Выполнить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}