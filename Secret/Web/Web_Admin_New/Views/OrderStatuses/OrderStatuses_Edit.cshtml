@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.OrderStatuses
@model Model_OrderStatuses_CRUD
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "OrderStatuses_Index";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать статус заказа";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

@* Редактирование статус заказа *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="OrderStatuses_Edit">

                        <input type="hidden" asp-for="ID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Код *@
                            <div class="form-group">
                                <label asp-for="ID" class="control-label">Код*</label>
                                <input asp-for="ID" class="form-control" disabled />
                            </div>

                            @* Имя *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Имя</label>
                                <input asp-for="Name" class="form-control" />
                            </div> 
                            
                            @* Порядок отображения* *@
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label"></label>
                                <input asp-for="OrderNum" class="form-control" />
                            </div>

                            @* Цвет - HEX *@
                            <div class="form-group">
                                <label asp-for="ColorHex">Цвет - HEX*</label>
                                <input asp-for="ColorHex" type="text" class="form-control my-colorpicker1">
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="OrderStatuses_Index">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}