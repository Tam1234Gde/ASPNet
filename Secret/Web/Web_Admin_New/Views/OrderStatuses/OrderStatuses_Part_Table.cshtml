@model List<CCommon_Ordered>
@{
    // Таблица > Статусы заказа
    Layout = null;
}

@* Таблица > Статусы заказа *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="export" style="max-width: 30px; width: 30px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CCommon_Ordered().ID)" title="@Html.DisplayNameFor(x=> new CCommon_Ordered().ID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCommon_Ordered().ID)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CCommon_Ordered().Name)" title="@Html.DisplayNameFor(x=> new CCommon_Ordered().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCommon_Ordered().Name)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-39.png" alt="@Html.DisplayNameFor(x=> new CCommon_Ordered().ColorHex)" title="@Html.DisplayNameFor(x=> new CCommon_Ordered().ColorHex)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCommon_Ordered().ColorHex)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-39.png" alt="@Html.DisplayNameFor(x=> new CCommon_Ordered().OrderNum)" title="@Html.DisplayNameFor(x=> new CCommon_Ordered().OrderNum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCommon_Ordered().OrderNum)</span>
                </th>
                <th data-orderable="false" style="min-width: 85px; width: 85px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        <span style="background-color: @item.ColorHex">@Html.DisplayFor(modelItem => item.ColorHex)</span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderNum)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="OrderStatuses_Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning" style="margin-right: 5px;"><i class="fas fa-edit "></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}