@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Restaurant_PayTypes
@model Model_Restaurant_PayTypes_CRUD
@{
    ViewData["Title"] = "Del";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Restaurant_PayTypes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Удалить вид оплаты";
    ViewBag.RazdelNameMobile = "Удалить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;

}

@* Удалить пользователя *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <form asp-action="Restaurant_PayTypes_Del">

                        <input asp-for="@Model.ID" type="hidden" />
                        <input asp-for="@Model.RestaurantID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить вид оплаты "@Model.Pay_Type" для ресторана "@Model.Restaurant" (Тип заказа: "@Model.Order_Type")? </label>
                            </div>

                        </div>

                        <div class="card-footer">

                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-action="Restaurant_PayType_Index" asp-route-RestaurantID="@Model.RestaurantID">Назад</a>
                            </div>

                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Удалить" class="btn btn-primary" />
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}