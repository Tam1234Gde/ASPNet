@model COrder_ForAdmin
@{
    // Таблица > Заказы
    Layout = null;
}

@* Таблица > Заказы *@
@if (Model != null && Model.List_OrderDatas != null && Model.List_OrderDatas.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="export" style="width: 20px; max-width: 20px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().OrderID)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().OrderID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().OrderID)</span>
                </th>
                <th class="search export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Dish)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Color)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Color)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Dish_Color)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-7.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Price)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Dish_Price)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Count)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Count)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Dish_Count)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-11.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Summ)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_Summ)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Dish_Summ)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-42.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_VolumeValue)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Dish_VolumeValue)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Dish_VolumeValue)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Bonuses_Plus)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Bonuses_Plus)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Bonuses_Plus)</span>
                </th>  
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Bonuses_Minus)" title="@Html.DisplayNameFor(x=> new COrder_Data_ForAdmin().Bonuses_Minus)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_ForAdmin().Bonuses_Minus)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_OrderDatas)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderID)
                    </td>
                    <td>
                        @Html.Raw(item.Dish)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish_Color)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish_Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish_Count)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish_Summ)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish_VolumeValue)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Bonuses_Plus)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Bonuses_Minus)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Order_Details_Ingridients" asp-route-OrderID="@item.OrderID" asp-route-OrderDataID="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}