@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Orders
@model Model_Order_Delivery
@{
    // Таблица > Заказы
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";


    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Доставка";
    ViewBag.RazdelNameMobile = "Доставка";
}



@* Таблица > Заказы *@
@if (Model != null)
{

    <div class="content">

        <div class="container-fluid">
            <div class="invoice p-3 mb-3">

                <div class="row">


                    <div class="col-6">
                        <p class="lead"> Код заказа - @Model.OrderID</p>

                        <div class="table-responsive">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <th style="width:50%">  Адрес доставки:</th>
                                        <td>@Model.Delivery_Address</td>
                                    </tr>
                                    <tr>
                                        <th> Код подъезда:</th>
                                        <td>@Model.Delivery_EntranceCode</td>
                                    </tr>
                                    <tr>
                                        <th>Номер подъезда:</th>
                                        <td>@Model.Delivery_EntranceNumber</td>
                                    </tr>
                                    <tr>
                                        <th> Номер этажа:</th>
                                        <td>@Model.Delivery_Floor</td>
                                    </tr>
                                    <tr>
                                        <th><b>Комментарий к заказу:</b></th>
                                        @if (!string.IsNullOrWhiteSpace(Model.Delivery_Comment))
                                        {
                                            <td>

                                                @if (!string.IsNullOrWhiteSpace(Model.Delivery_Comment))
                                                {
                                                    <text>
                                                        <b>Добавить к заказу:</b>
                                                    </text>
                                                    <br />
                                                    @Model.Delivery_Comment
                                                    <br />
                                                    <br />
                                                }

                                                @if (!string.IsNullOrWhiteSpace(Model.Delivery_Comment))
                                                {
                                                    <text>
                                                        <b>Убрать из заказа:</b>
                                                    </text>
                                                    <br />
                                                    @Model.Delivery_Comment_Remove
                                                }
                                            </td>
                                        }
                                    </tr>
                                    <tr>
                                        <th>Сумма заказа:</th>
                                        <td>@Model.Delivery_Price</td>
                                    </tr>

                                                                        <tr>
                                        <th>Дать сдачи с:</th>
                                        <td>@Model.Delivery_Handing</td>
                                    </tr>
                                                                        <tr>
                                        <th>Доставить к:</th>
                                        <td>@Model.Delivery_To</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>



            </div>
        </div>

    </div>
  
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}