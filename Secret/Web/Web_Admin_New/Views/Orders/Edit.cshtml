@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Orders
@model Model_Orders_AddEdit
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Order_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать заказ";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

@* Редактирование блюда *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Edit">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="ClientID" value="1" />
                        <input type="hidden" asp-for="Pay_TypeID" value="1" />
                        <input type="hidden" asp-for="RestaurantID" value="1" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Дата и время к которому приготовить заказ *@
                            <div class="form-group">
                                <label asp-for="Date_To" class="control-label">Дата и время к которому приготовить заказ</label>
                                <input asp-for="Date_To" class="form-control" type="datetime-local" value="" />
                                <span asp-validation-for="Date_To" class="text-danger"></span>
                            </div>

                            @* Клиент будет кушать в кафе *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Inhouse" /> Клиент будет кушать в кафе
                                </label>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }