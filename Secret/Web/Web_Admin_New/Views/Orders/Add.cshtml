@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Orders
@model Model_Orders_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Order_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить заказ";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление заказа *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <input type="hidden" asp-for="ClientID" value="1" />
                        <input type="hidden" asp-for="Pay_TypeID" value="1" />
                        <input type="hidden" asp-for="RestaurantID" value="1" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Дата и время к которому приготовить заказ *@
                            <div class="form-group">
                                <label asp-for="Date_To" class="control-label">Дата и время к которому приготовить заказ</label>
                                <input asp-for="Date_To" class="form-control" type="datetime-local" value="" />
                                <span asp-validation-for="Date_To" class="text-danger"></span>
                            </div>

                            @* Тип оплаты *@
                            @if (Model.List_Pay_Types != null && Model.List_Pay_Types.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Pay_TypeID">Тип оплаты*</label>
                                    <select asp-for="Pay_TypeID" id="Pay_TypeID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Pay_Types)
                                        {
                                            if (item.ID == Model.Pay_TypeID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Pay_TypeID" class="text-danger"></span>
                                </div>
                            }

                            @* Клиент будет кушать в кафе *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Inhouse" /> Клиент будет кушать в кафе
                                </label>
                            </div>

                        </div>

                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <input type="submit" value="Добавить" class="btn btn-primary" />
                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }