@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.ClientNotifications
@model Model_ClientNotifications_Index
@{
    // Таблица > Уведомления клиента
    Layout = null;
}

@* Таблица > Уведомления клиента *@
@if (Model != null && Model.List_ClientNotifications != null && Model.List_ClientNotifications.Count != 0)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CClient_Notification().Name)" title="@Html.DisplayNameFor(x=> new CClient_Notification().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient_Notification().Name)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new CClient_Notification().Date_Act)" title="@Html.DisplayNameFor(x=> new CClient_Notification().Date_Act)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient_Notification().Date_Act)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CClient_Notification().Flag_Read)" title="@Html.DisplayNameFor(x=> new CClient_Notification().Flag_Read)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient_Notification().Flag_Read)</span>
                </th>
                @* <th data-orderable="false" style="min-width: 70px; width: 70px;"></th> *@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_ClientNotifications)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date_Act)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Flag_Read)
                    </td>
                  @*   <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td> *@
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}