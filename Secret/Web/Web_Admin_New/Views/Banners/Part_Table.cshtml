@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Banners

@model Model_Banners
@{
    // Таблица > Города
    Layout = null;
}

@* Таблица > Города *@
@if (Model != null && Model.List_Banners != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th>
                    Название
                </th>

                <th>
                    Даты показа
                </th>

                <th>
                    Город
                </th>

                <th>
                    Ссылка
                </th>

                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (CBanner item in Model.List_Banners)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date_Start) - @Html.DisplayFor(modelItem => item.Date_End)
                    </td>
                    <td>
                        @* //TODO: MAE - NULLABLE *@
                        @Html.DisplayFor(modelItem => item.City.Name)
                    </td>
                    <td>
                        Категория: @Html.DisplayFor(modelItem => item.Category_ID)
                        Товар: @Html.DisplayFor(modelItem => item.Product_ID)
                    </td>
                    <td class="HIDE-button-actions">

                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a class="btn btn-block bg-gradient-danger HIDE-js-banner-open" data-id="@item.ID"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
           
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}
