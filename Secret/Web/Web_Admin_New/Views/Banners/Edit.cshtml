@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Banners

@model Model_Banner_AddEdit

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Banners_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать баннер";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;

    string id_MediaFile_Big = $"HIDE-js-mediafile_big-{Guid.NewGuid()}";
    string id_MediaFile_Small = $"HIDE-js-mediafile_small-{Guid.NewGuid()}";

    List<CDish> list_product = [];

}

@if (Model != null)
{

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="card card-primary">

                        <div class="card-header">
                            <h3 class="card-title"></h3>
                        </div>

                        <form asp-action="Edit" enctype="multipart/form-data" id="HIDE-form">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="card-body">
                                @* Название *@
                                <div class="form-group">
                                    <label asp-for="Name"  class="control-label">Название</label>
                                    <input asp-for="Name" value="@Model.Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                @* Город *@
                                @if (Model.List_Cities != null)
                                {
                                    <div class="form-group">
                                        <label asp-for="CityID">Город*</label>
                                        <select asp-for="CityID" id="City_ID" class="custom-select HIDE-custom-select rounded-0">
                                            @foreach (CCity item in Model.List_Cities)
                                            {
                                                if (item.ID == Model.CityID)
                                                {
                                                    <option selected value="@item.ID">@item.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.ID">@item.Name</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="CityID" class="text-danger"></span>
                                    </div>
                                }

                                @* Категории *@
                                @if (Model.List_Categories != null)
                                {
                                    <div class="form-group">
                                        <label asp-for="Category_ID">Ссылка на категорию</label>
                                        <select asp-for="Category_ID" id="Category_ID" class="custom-select HIDE-custom-select rounded-0">
                                            <option value="">-</option>
                                            @foreach (CDish_Category item in Model.List_Categories)
                                            {
                                                @if (item.ID == Model.Category_ID)
                                                {
                                                    <option selected value="@item.ID">@item.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.ID">@item.Name</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="Category_ID" class="text-danger"></span>
                                    </div>
                                }

                                <div class="form-group HIDE-js-select_product">
                                    @if (Model.List_Product != null)
                                    {
                                        <div class="form-group">
                                            <label asp-for="Product_ID">Ссылка на товар</label>
                                            <!-- ИЗМЕНИТЕ ID ЗДЕСЬ: был Category_ID, должен быть Product_ID -->
                                            <select asp-for="Product_ID" id="Product_ID" class="custom-select HIDE-custom-select rounded-0">
                                                @foreach (CDish item in Model.List_Product)
                                                {
                                                    @if (item.ID == Model.Product_ID)
                                                    {
                                                        <option selected value="@item.ID">@item.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.ID">@item.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span asp-validation-for="Product_ID" class="text-danger"></span>
                                        </div>
                                    }
                                </div>

                                @* Дата начала показа *@
                                <div class="form-group">
                                    <label asp-for="Date_Start" class="control-label">Дата начала показа*</label>
                                    @{
                                        string? dateStartValue = Model.Date_Start.HasValue ? Model.Date_Start?.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
                                        
                                    }
                                    <input asp-for="Date_Start"
                                           class="form-control"
                                           type="datetime-local"
                                           value="@dateStartValue"
                                           id="Date_Start" />
                                    <span asp-validation-for="Date_Start" class="text-danger"></span>
                                </div>

                                @* Дата окончания показа *@
                                <div class="form-group">
                                    <label asp-for="Date_End" class="control-label">Дата окончания показа</label>
                                    @{
                                        string dateEndValue = Model.Date_End.HasValue ? Model.Date_End.Value.ToString("yyyy-MM-ddTHH:mm") : "";
                                        
                                        
                                    }
                                    <input asp-for="Date_End"
                                           value="@dateEndValue"
                                           class="form-control"
                                           type="datetime-local"
                                           id="Date_End" />
                                    <span asp-validation-for="Date_End" class="text-danger"></span>
                                </div>

                                @* Изображение большое *@
                                <div class="form-group">
                                    <label for="@id_MediaFile_Big">Изображение большое*</label>
                                    <div class="clearfix"></div>
                                    <input id="@id_MediaFile_Big" style="display:block;" asp-for="@Model.Image_Big" type="file" class="btn btn-warning HIDE-js-common-image_show mb-2" accept=".jpg,.jpeg,.png" />
                                    <input type="hidden" asp-for="Image_Big_Byte" value="@Model.Image_Big_Byte" required />

                                    @if (Model != null && !string.IsNullOrWhiteSpace(Model.Image_Big_Url))
                                    {
                                        <div class="d-flex flex-column align-items-start">
                                            @* <a asp-controller="Banners" asp-action="Banners_DelImage" asp-route-id="@Model.ID" asp-route-big="true" class="btn btn-danger mt-2">Удалить изображение</a> *@
                                            <div class="clearfix"></div>
                                            <img style="max-width:250px;max-height:250px;margin-bottom:12px" class="HIDE-js-common-image_show-item" src="@Model.Image_Big_Url" alt="" />
                                        </div>
                                    }
                                </div>

                                @* Изображение маленькое *@
                                <div class="form-group">
                                    <label for="@id_MediaFile_Small">Изображение маленькое*</label>
                                    <div class="clearfix"></div>
                                    @* //TODO: NULLABLE *@
                                    <input id="@id_MediaFile_Small" style="display:block;" asp-for="@Model.Image_Small" type="file" class="btn btn-warning HIDE-js-common-image_show mb-2" accept=".jpg,.jpeg,.png" />
                                    <input type="hidden" asp-for="Image_Small_Byte" value="@Model.Image_Small_Byte" required />

                                    @if (Model != null && !string.IsNullOrWhiteSpace(Model.Image_Small_Url))
                                    {
                                        <div class="d-flex flex-column align-items-start">
                                            @* <a asp-controller="Banners" asp-action="Banners_DelImage" asp-route-id="@Model.ID" asp-route-big="false" class="btn btn-danger mt-2">Удалить изображение</a> *@
                                            <div class="clearfix"></div>
                                            <img style="max-width:250px;max-height:250px;margin-bottom:12px" class="HIDE-js-common-image_show-item" src="@Model.Image_Small_Url" alt="" />
                                        </div>
                                    }
                                </div>

                                @* Подрядок сортировки *@
                                <div class="form-group">
                                    <label asp-for="OrderNum" class="control-label">Порядок сортировки</label>
                                    @* //TODO: NULLABLE *@
                                    <input asp-for="OrderNum" class="form-control" type="number" value="@Model.OrderNum" />
                                    <span asp-validation-for="OrderNum" class="text-danger"></span>
                                </div>
                                <span id="HIDE-error" class="error invalid-feedback" style="display:block"></span>
                            </div>
              
                            @* Кнопки *@
                            <div class="card-footer">
                                <div class="row">

                                    @* Назад *@
                                    <div class="col-md-6">
                                        <div class="form-group mb-0 pt-2">
                                            <a class="text-decoration-none" asp-action="Index">Назад</a>
                                        </div>
                                    </div>

                                    @* Сохранить *@
                                    <div class="col-md-6">
                                        <div class="form-group text-right mb-0">
                                            <input type="submit" value="Сохранить" class="btn btn-primary" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>

    </section>
}

@section Scripts{
    
    <script>
        $(document).ready(function() {
            // Инициализация при загрузке страницы
            initializeProductVisibility();

            $('#Category_ID').change(function() {
                var selectedValue = $(this).val();
                // Показать/скрыть блок с товарами
                if (!selectedValue || selectedValue == "") {
                    $('.HIDE-js-select_product').hide();
                    // Также можно очистить селект товаров при сбросе категории
                    $('#Product_ID').val('');
                } else {
                    $('.HIDE-js-select_product').show();

                    // Делаем AJAX запрос для загрузки товаров выбранной категории
                    $.ajax({
                        url: "@Url.Action("Part_ListDishes", "Banners")",
                        type: 'GET',
                        data: {
                            DishCategoryID: selectedValue,
                            Product_ID: "@Model.Product_ID"    @* //TODO: NULLABLE *@
                        },
                        success: function(data) {
                            $('.HIDE-js-select_product').html(data).show();
                        },
                        error: function(xhr, status, error) {
                            console.error("Ошибка при загрузке товаров:", error);
                        }
                    });
                }
            });

            function initializeProductVisibility() {
                var selectedCategory = $('#Category_ID').val();
                if (!selectedCategory || selectedCategory == "") {
                    $('.HIDE-js-select_product').hide();
                } else {
                    $('.HIDE-js-select_product').show();

                    // Если категория уже выбрана при загрузке, загружаем товары для неё
                    if (selectedCategory && selectedCategory !== "") {
                        $.ajax({
                            url: "@Url.Action("Part_ListDishes", "Banners")",
                            type: 'GET',
                            data: {
                                DishCategoryID: selectedCategory,
                                Product_ID: "@Model.Product_ID"
                            },
                            success: function(data) {
                                $('.HIDE-js-select_product').html(data).show();
                            },
                            error: function(xhr, status, error) {
                                console.error("Ошибка при загрузке товаров:", error);
                            }
                        });
                    }
                }
            }

            // Функция для показа ошибки валидации
            function showValidationError(message) {
                let $errorDiv = $('#HIDE-error');

                if ($errorDiv.length === 0) {
                    // Создаем элемент для ошибки, если его нет
                    $errorDiv = $('<div id="HIDE-error" class="alert alert-danger mt-3 mb-0" style="display: none;"></div>');
                    $('#OrderNum').closest('.form-group').after($errorDiv);
                }

                $errorDiv.html('<i class="fas fa-exclamation-triangle mr-2"></i>' + message)
                        .slideDown(300);

                // Прокручиваем к ошибке
                $('html, body').animate({
                    scrollTop: $errorDiv.offset().top - 100
                }, 500);

                // Автоматически скрываем через 8 секунд
                setTimeout(function() {
                    $errorDiv.slideUp(300, function() {
                        $(this).remove();
                    });
                }, 8000);
            }

            // Функция для скрытия ошибки
            function hideValidationError() {
                $('#HIDE-error').slideUp(300, function() {
                    $(this).remove();
                });
            }

            // Функция для валидации дат
            function validateDates() {
                const dateStart = $('#Date_Start').val();
                const dateEnd = $('#Date_End').val();

                // Удаляем предыдущие inline-ошибки
                $('.date-inline-error').remove();
                $('#Date_Start, #Date_End').removeClass('is-invalid is-valid');

                // Если обе даты заполнены
                if (dateStart && dateEnd) {
                    const startDate = new Date(dateStart);
                    const endDate = new Date(dateEnd);

                    // Проверяем, что дата начала не позже даты окончания
                    if (startDate > endDate) {
                        $('#Date_Start').addClass('is-invalid');
                        $('#Date_End').addClass('is-invalid');

                        // Добавляем inline текст ошибки под полями
                        const errorText = '<span class="text-danger date-inline-error mt-1" style="font-size: 0.875em; display: block;">Дата начала должна быть раньше даты окончания</span>';
                        $('#Date_End').closest('.form-group').append(errorText);

                        return false; // Невалидно
                    } else {
                        // Если даты валидны
                        $('#Date_Start').addClass('is-valid');
                        $('#Date_End').addClass('is-valid');
                        hideValidationError(); // Скрываем общую ошибку
                        return true; // Валидно
                    }
                }

                // Если одна из дат не заполнена - считаем валидным (если не требуется обязательно)
                hideValidationError();
                return true;
            }

            // ВАЛИДАЦИЯ ДАТ ПРИ СУБМИТЕ ФОРМЫ
            $('#HIDE-form').submit(function(e) {
                // Проверяем даты
                if (!validateDates()) {
                    e.preventDefault();

                    // Показываем ошибку
                    showValidationError('Дата начала показа не может быть позже даты окончания');

                    return false;
                }

                // Дополнительные проверки можно добавить здесь
                return true;
            });

            // Динамическая проверка при изменении любой из дат
            $('#Date_Start, #Date_End').on('input change', function() {
                validateDates(); // Проверяем и обновляем состояние

                // Если даты стали корректными, скрываем ошибку
                if (validateDates()) {
                    hideValidationError();
                }
            });

            // Проверяем даты сразу при загрузке страницы
            setTimeout(function() {
                validateDates();
            }, 100);

            // Также проверяем при изменении других полей формы (опционально)
            $('#HIDE-form').on('input', 'input, select, textarea', function() {
                // Если это не поля дат, всё равно проверяем даты
                if ($(this).attr('id') !== 'Date_Start' && $(this).attr('id') !== 'Date_End') {
                    setTimeout(validateDates, 50);
                }
            });

            // Очищаем ошибку при клике на любое поле формы
            $('#HIDE-form').on('focus', 'input, select, textarea', function() {
                hideValidationError();
                $('#Date_Start, #Date_End').removeClass('is-invalid');
                $('.date-inline-error').remove();
            });
        });
    </script>

}
