@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Banners

@model Model_Banners
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Banners_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Баннеры";
    ViewBag.RazdelNameMobile = "Баннеры";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[16].Value;
}

<section class="content HIDE-table HIDE-table_actions">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex">

                        @* Наименование автомата *@
                        <div class="HIDE-table-title HIDE-card-header_left">
                            <h3 class="card-title" style="padding-top:3px">
                                Баннеры
                            </h3>
                        </div>

                        <div class="HIDE-button-add ml-auto">
                            <a asp-controller="Banners" asp-action="Add" class="btn btn-block btn-primary"><i class="fas fa-plus"></i>Добавить</a>
                        </div>
                    </div>

                    @* Таблица *@
                    <div class="HIDE-js-partial_table HIDE-partial-table HIDE-partial-table__scroll">
                        <partial name="Part_Table">
                    </div>

                </div>
            </div>

        </div>
    </div>

</section>


<div class="HIDE-js-modal-part">
    <partial name="Part_ModalDel" />
</div>


@section Scripts {

    <script>
        $('.HIDE-js-banner-open').click(function(){

                let id = $(this).data('id')

             $.ajax(
            {

                url: "@Url.Action("Part_ModalDel", "Banners")",
                type: 'GET',
                data: {
                      ID: id,

                },
                success: function (data) {

                     $('.HIDE-js-modal-part').html(data);

                     $('#HIDE-banner-id').modal('show');

                     $('.HIDE-js-del').attr('data-id', id)

                     Del();

                }
            });


        })

        function Del(){

        $('.HIDE-js-del').click(function(){

              console.log($(this).data('id'))

                 $.ajax(
                 {
                    url: "@Url.Action("Del", "Banners")",
                    type: 'POST',
                    data: {
                          "ID": $(this).data('id'),

                    },
                    success: function (data) {

                    switch (data) {
                            case "+":
                             location.reload()
                            break;

                             case "-":
                                  $('#HIDE-error').text('Ошибка');
                               break;
                          }

                  }
              });

            })
        }

    </script>
}
