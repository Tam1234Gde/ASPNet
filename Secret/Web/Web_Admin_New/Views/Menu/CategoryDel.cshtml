@* Страница подтверждения удаления категории. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Category_AddEdit
@{
    ViewData["Title"] = "CategoryDel";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = "Удалить категорию";
    ViewBag.RazdelNameMobile = "Удалить";

    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <form asp-action="CategoryDel">
                        <input asp-for="ID" type="hidden" />
                        <input asp-for="MenuID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить категорию "@Model.Name"?</label>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-action="CategoryList" asp-route-MenuID="@Model.MenuID">Назад</a>
                            </div>
                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Удалить" class="btn btn-danger" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}