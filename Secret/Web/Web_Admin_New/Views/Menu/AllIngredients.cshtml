@* Страница со списком всех ингредиентов с фильтром по группе и drag-and-drop сортировкой. *@
@using System.Linq
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_AllIngredients
@{
    ViewData["Title"] = "Все ингредиенты";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingredient_List";

    ViewBag.RazdelName = "Все ингредиенты";
    ViewBag.RazdelNameMobile = "Ингредиенты";
}

<style>
    .filter-section {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 12px 18px;
        margin-bottom: 15px;
        border: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }
    .filter-section .filter-label { font-weight: 600; color: #495057; }
    .filter-section select { padding: 5px 10px; border-radius: 4px; border: 1px solid #ced4da; min-width: 200px; }

    .badge-parent { font-size: 12px; background: #e9ecef; color: #495057; padding: 3px 8px; border-radius: 4px; }
    .badge-overridden { font-size: 11px; background: #fff3cd; color: #856404; padding: 2px 6px; border-radius: 3px; margin-left: 5px; }

    .table tbody tr:hover { background-color: rgba(33, 150, 243, 0.05); cursor: pointer; }

    .sort-mode-container {
        display: none;
        background: #fff8e1;
        border: 2px solid #ffc107;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 15px;
    }
    .sort-mode-container.active { display: block; }
    .sort-mode-container h5 { margin: 0 0 10px 0; color: #856404; }
    .sort-list { list-style: none; padding: 0; margin: 0; }
    .sort-list-item {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 15px; background: #fff;
        border: 1px solid #dee2e6; border-radius: 6px;
        margin-bottom: 8px; cursor: grab; user-select: none;
        transition: all 0.15s ease;
    }
    .sort-list-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .sort-list-item.dragging { opacity: 0.4; background: #e3f2fd; border: 2px dashed #2196F3; }
    .sort-list-item.drag-over { border-top: 3px solid #2196F3; }
    .sort-list-item .drag-handle { color: #6c757d; font-size: 18px; cursor: grab; }
    .sort-list-item .order-badge {
        background: #17a2b8; color: #fff; padding: 2px 8px;
        border-radius: 4px; font-size: 12px; min-width: 30px; text-align: center;
    }
    .sort-list-item .item-name { flex: 1; font-weight: 500; }
    .sort-mode-actions { display: flex; gap: 10px; margin-top: 15px; }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6"><h3 class="card-title">Список ингредиентов</h3></div>
                            <div class="col-md-6 text-right">
                                <a asp-action="IngredientAdd" asp-route-Menu_Ingridient_GroupID="@Model.Menu_Ingridient_GroupID" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить</a>
                                @if (Model.Menu_Ingridient_GroupID.HasValue && Model.Menu_Ingridient_GroupID.Value > 0)
                                {
                                    <button type="button" class="btn btn-warning" id="btnSortMode">
                                        <i class="fas fa-arrows-alt"></i> Настроить порядок
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show">
                                <i class="fas fa-check-circle"></i> @TempData["Success"]
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                            </div>
                        }

                        <!-- Фильтр по группе -->
                        <div class="filter-section">
                            <span class="filter-label"><i class="fas fa-layer-group"></i> Фильтр по группе:</span>
                            <select id="groupFilter" onchange="location.href='@Url.Action("AllIngredients", "Menu")?Menu_Ingridient_GroupID=' + this.value">
                                <option value="">Все группы</option>
                                @if (Model.List_Groups != null)
                                {
                                    @foreach (var group in Model.List_Groups)
                                    {
                                        if (group.ID == Model.Menu_Ingridient_GroupID)
                                        {
                                            <option selected value="@group.ID">@group.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@group.ID">@group.Name</option>
                                        }
                                    }
                                }
                            </select>
                            @if (Model.Menu_Ingridient_GroupID.HasValue && Model.Menu_Ingridient_GroupID.Value > 0)
                            {
                                <a asp-action="AllIngredients" class="btn btn-sm btn-outline-secondary"><i class="fas fa-times"></i> Сбросить</a>
                                <span class="badge badge-info">Фильтр: @Model.GroupName</span>
                                <button type="button" class="btn btn-sm btn-outline-success ml-2 js-apply-price-btn"
                                        data-toggle="modal" data-target="#applyPriceModal">
                                    <i class="fas fa-tags"></i> Установить цену для всей группы
                                </button>
                            }
                            <span class="ml-auto text-muted small">Всего: @(Model.List_Ingredients?.Count ?? 0)</span>
                        </div>

                        <!-- SORT MODE -->
                        @if (Model.Menu_Ingridient_GroupID.HasValue && Model.Menu_Ingridient_GroupID.Value > 0)
                        {
                            <div class="sort-mode-container" id="sortModeContainer">
                                <h5><i class="fas fa-arrows-alt"></i> Перетащите ингредиенты в нужном порядке</h5>
                                <ul class="sort-list" id="sortList">
                                    @{
                                        var orderedIngredients = Model.List_Ingredients
                                            .OrderBy(x => x.OrderNum == 0 ? int.MaxValue : x.OrderNum)
                                            .ThenBy(x => x.Name)
                                            .ToList();
                                    }
                                    @foreach (var item in orderedIngredients)
                                    {
                                        <li class="sort-list-item" draggable="true" data-id="@item.ID">
                                            <span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
                                            <span class="order-badge">@item.OrderNum</span>
                                            <span class="item-name">@item.Name</span>
                                            <span class="text-muted small">ID: @item.ID</span>
                                        </li>
                                    }
                                </ul>
                                <div class="sort-mode-actions">
                                    <button type="button" class="btn btn-success" id="btnSaveOrder">
                                        <i class="fas fa-save"></i> Сохранить порядок
                                    </button>
                                    <button type="button" class="btn btn-secondary" id="btnCancelSort">
                                        <i class="fas fa-times"></i> Отмена
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- NORMAL TABLE -->
                        <div id="normalTableWrapper">
                            <div class="table-responsive">
                                <table id="HIDE-all-ingredients" class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width:50px;">ID</th>
                                            <th style="width:80px;">Порядок</th>
                                            <th style="width:200px;">Наименование</th>
                                            <th style="width:100px;">Цена</th>
                                            <th style="width:120px;">Переопределена</th>
                                            <th style="width:200px;">Группа</th>
                                            <th style="width:120px;">Состояние</th>
                                            <th style="min-width:150px;">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.List_Ingredients != null && Model.List_Ingredients.Count > 0)
                                        {
                                            @foreach (var item in Model.List_Ingredients)
                                            {
                                                string groupName = Model.List_Groups?.FirstOrDefault(x => x.ID == item.Menu_Ingridient_GroupID)?.Name ?? "Группа #" + item.Menu_Ingridient_GroupID;
                                                string stateName = item.Menu_OptionStateID switch { 1 => "Включено", 2 => "Необязательно", 3 => "Отключено", _ => "Неизвестно" };
                                                string stateClass = item.Menu_OptionStateID switch { 1 => "badge-success", 2 => "badge-warning", 3 => "badge-danger", _ => "badge-secondary" };
                                                <tr>
                                                    <td>@item.ID</td>
                                                    <td>@item.OrderNum</td>
                                                    <td>
                                                        @item.Name
                                                        @if (item.Image != null && item.Image.Length > 0)
                                                        {
                                                            <br /><img src="data:image/jpeg;base64,@Convert.ToBase64String(item.Image)" style="max-height:30px;" />
                                                        }
                                                    </td>
                                                    <td>@(item.Price.HasValue ? item.Price.Value.ToString("N0") : "-")</td>
                                                    <td>
                                                        @if (item.Flag_Price_Overridden)
                                                        {
                                                            <span class="badge-overridden"><i class="fas fa-pen"></i> Вручную</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">—</span>
                                                        }
                                                    </td>
                                                    <td><span class="badge-parent">@groupName</span></td>
                                                    <td><span class="badge @stateClass">@stateName</span></td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a asp-action="IngredientEdit" asp-route-ID="@item.ID" class="btn btn-outline-warning btn-sm" title="Редактировать"><i class="fas fa-edit"></i></a>
                                                            <a asp-action="IngredientDel" asp-route-ID="@item.ID" class="btn btn-outline-danger btn-sm" title="Удалить"><i class="fas fa-trash"></i></a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="8" class="text-center">Записей не обнаружено</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Модальное окно массового применения цены -->
@if (Model.Menu_Ingridient_GroupID.HasValue && Model.Menu_Ingridient_GroupID.Value > 0)
{
    <div class="modal fade" id="applyPriceModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-tags"></i> Установить цену для всей группы</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form asp-action="IngredientGroupApplyPrice" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GroupID" value="@Model.Menu_Ingridient_GroupID" />
                    <input type="hidden" name="ReturnUrl" value="@Url.Action("AllIngredients", new { Menu_Ingridient_GroupID = Model.Menu_Ingridient_GroupID })" />
                    <div class="modal-body">
                        <div class="form-group">
                            <label>Группа</label>
                            <input class="form-control" value="@Model.GroupName" disabled />
                        </div>
                        <div class="form-group">
                            <label>Новая цена</label>
                            <input name="Price" class="form-control" type="number" step="1" min="0" HIDEholder="Например, 10" />
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SkipOverridden" value="true" id="skipOverriddenList" checked />
                            <label class="form-check-label" for="skipOverriddenList">
                                Пропустить ингредиенты с вручную переопределённой ценой
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Применить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>

    <script>
        // ============ SORT MODE ============
        (function initSortMode() {
            var btnSortMode = document.getElementById('btnSortMode');
            var btnSaveOrder = document.getElementById('btnSaveOrder');
            var btnCancelSort = document.getElementById('btnCancelSort');
            var sortContainer = document.getElementById('sortModeContainer');
            var normalTable = document.getElementById('normalTableWrapper');
            var sortList = document.getElementById('sortList');
            if (!btnSortMode || !sortContainer) return;

            btnSortMode.addEventListener('click', function () {
                sortContainer.classList.add('active');
                normalTable.style.display = 'none';
                updateOrderBadges();
            });

            function disableSortMode() {
                sortContainer.classList.remove('active');
                normalTable.style.display = 'block';
            }
            btnCancelSort.addEventListener('click', disableSortMode);

            function updateOrderBadges() {
                var items = sortList.querySelectorAll('.sort-list-item');
                var order = 10;
                items.forEach(function (item) {
                    var badge = item.querySelector('.order-badge');
                    if (badge) badge.textContent = order;
                    order += 10;
                });
            }

            var draggedItem = null;

            sortList.addEventListener('dragstart', function (e) {
                var item = e.target.closest('.sort-list-item');
                if (!item) return;
                draggedItem = item;
                item.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', item.getAttribute('data-id'));
            });

            sortList.addEventListener('dragend', function (e) {
                var item = e.target.closest('.sort-list-item');
                if (item) item.classList.remove('dragging');
                sortList.querySelectorAll('.drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
                draggedItem = null;
                updateOrderBadges();
            });

            sortList.addEventListener('dragover', function (e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                var target = e.target.closest('.sort-list-item');
                if (!target || target === draggedItem) return;
                sortList.querySelectorAll('.drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
                target.classList.add('drag-over');
                var rect = target.getBoundingClientRect();
                var offset = e.clientY - rect.top;
                var shouldInsertAfter = offset > rect.height / 2;
                if (shouldInsertAfter) {
                    if (target.nextSibling) sortList.insertBefore(draggedItem, target.nextSibling);
                    else sortList.appendChild(draggedItem);
                } else {
                    sortList.insertBefore(draggedItem, target);
                }
            });

            sortList.addEventListener('drop', function (e) {
                e.preventDefault();
                sortList.querySelectorAll('.drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
                updateOrderBadges();
            });

            btnSaveOrder.addEventListener('click', function () {
                var ids = [];
                sortList.querySelectorAll('.sort-list-item').forEach(function (item) {
                    var id = parseInt(item.getAttribute('data-id'));
                    if (!isNaN(id)) ids.push(id);
                });
                if (ids.length === 0) { showToast('Нет элементов для сохранения', 'warning'); return; }

                fetch('@Url.Action("ReorderIngredients", "Menu")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: ids })
                })
                .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        showToast('Порядок сохранён (' + data.updated + ' записей)', 'success');
                        setTimeout(function () { location.reload(); }, 800);
                    } else showToast('Ошибка: ' + (data.message || 'неизвестно'), 'error');
                })
                .catch(function (err) { showToast('Ошибка сети: ' + err.message, 'error'); });
            });
        })();

        // ============ УВЕДОМЛЕНИЯ ============
        function showToast(message, type, duration) {
            type = type || 'success'; duration = duration || 3000;
            var icons = { success: '✅', error: '❌', info: 'ℹ️', warning: '⚠️' };
            var bg = {
                success: 'linear-gradient(135deg,#28a745,#20c997)',
                error: 'linear-gradient(135deg,#dc3545,#e74c3c)',
                info: 'linear-gradient(135deg,#17a2b8,#0dcaf0)',
                warning: 'linear-gradient(135deg,#ffc107,#fd7e14)'
            };
            var toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;top:20px;right:20px;padding:15px 25px;border-radius:8px;color:#fff;font-weight:500;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2);min-width:300px;max-width:500px;background:' + bg[type];
            toast.innerHTML = '<span>' + (icons[type] || 'ℹ️') + '</span> ' + message;
            document.body.appendChild(toast);
            setTimeout(function () { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.5s'; }, duration);
            setTimeout(function () { toast.remove(); }, duration + 500);
        }

        // ============ ИНИЦИАЛИЗАЦИЯ ТАБЛИЦЫ ============
        $(document).ready(function () {
            if ($('#HIDE-all-ingredients').length) {
                $('#HIDE-all-ingredients').DataTable({
                    "paging": true, "lengthChange": true, "searching": true, "ordering": true,
                    "info": true, "autoWidth": false, "responsive": true,
                    "language": { "url": "/lib/datatables/ru.json" },
                    "dom": '<"row"<"col-sm-6"l><"col-sm-6"f>><"row"<"col-sm-12"tr>><"row"<"col-sm-5"i><"col-sm-7"p>>',
                    "columnDefs": [{ "orderable": false, "targets": [7] }]
                });
            }
        });

        // ============ КНОПКА "УСТАНОВИТЬ ЦЕНУ ДЛЯ ВСЕЙ ГРУППЫ" ============
        (function initApplyPriceButton() {
            var btn = document.querySelector('.js-apply-price-btn');
            var modalEl = document.getElementById('applyPriceModal');
            if (!btn || !modalEl) return;

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                // Если jQuery + Bootstrap доступны — штатный API
                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                    window.jQuery(modalEl).modal('show');
                } else {
                    // Fallback: ручное открытие
                    modalEl.style.display = 'block';
                    modalEl.classList.add('show');
                    modalEl.removeAttribute('aria-hidden');
                    document.body.classList.add('modal-open');

                    var backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop fade show';
                    backdrop.id = 'applyPriceModalBackdrop';
                    document.body.appendChild(backdrop);
                }
            });

            // Закрытие по кнопкам внутри модалки
            modalEl.querySelectorAll('[data-dismiss="modal"], .close').forEach(function (el) {
                el.addEventListener('click', function () {
                    if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                        window.jQuery(modalEl).modal('hide');
                    } else {
                        modalEl.style.display = 'none';
                        modalEl.classList.remove('show');
                        modalEl.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('modal-open');
                        var bd = document.getElementById('applyPriceModalBackdrop');
                        if (bd) bd.remove();
                    }
                });
            });
        })();
    </script>
}