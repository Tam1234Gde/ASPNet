@* Страница редактирования подкатегории. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Subcategory_AddEdit
@{
    ViewData["Title"] = "SubcategoryEdit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";
    ViewBag.RazdelName = "Редактировать подкатегорию";
    ViewBag.RazdelNameMobile = "Редактировать";
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Редактирование подкатегории "@Model.Name"</h3>
                    </div>
                    <form asp-action="SubcategoryEdit">
                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Menu_CategoryID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            @if (Model.List_Parents != null && Model.List_Parents.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="ParentID">Родитель</label>
                                    <select asp-for="ParentID" class="custom-select HIDE-custom-select rounded-0">
                                        <option value="">Нет</option>
                                        @foreach (var item in Model.List_Parents)
                                        {
                                            if (item.ID == Model.ParentID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ParentID" class="text-danger"></span>
                                </div>
                            }
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label"></label>
                                <input asp-for="OrderNum" class="form-control" type="number" min="0" />
                                <small class="form-text text-muted">
                                    Чем меньше число — тем выше в списке.
                                </small>
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="SubcategoryList" asp-route-Menu_CategoryID="@Model.Menu_CategoryID">Назад</a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}