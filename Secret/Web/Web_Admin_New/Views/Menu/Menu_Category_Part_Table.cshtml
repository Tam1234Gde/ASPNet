@* Частичное представление для отображения таблицы категорий. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Category_List
@{
    Layout = null;
}

@if (Model != null && Model.List_Menu_Categories != null && Model.List_Menu_Categories.Any())
{
    <table id="HIDE-categories" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th style="width: 50px;">ID</th>
                <th style="width: 300px;">Наименование</th>
                <th style="min-width: 200px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Menu_Categories)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Name</td>
                    <td class="HIDE-button-actions">
                        <div style="display:flex; gap:4px;">
                            <a asp-action="SubcategoryList" asp-route-Menu_CategoryID="@item.ID" class="btn btn-block bg-gradient-info btn-sm">
                                <i class="fas fa-list"></i> Подкатегории
                            </a>
                            <a asp-action="CategoryEdit" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="CategoryDel" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-danger btn-sm">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style="border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px;">
            Записей не обнаружено
        </h3>
    </div>
}