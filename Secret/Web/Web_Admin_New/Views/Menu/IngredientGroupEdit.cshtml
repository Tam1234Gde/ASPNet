@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Ingredient_Group_AddEdit
@{
    ViewData["Title"] = "IngredientGroupEdit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingredient_Group_List";

    ViewBag.RazdelName = "Редактировать группу ингредиентов";
    ViewBag.RazdelNameMobile = "Редактировать";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Редактирование группы ингредиентов "@Model.Name"</h3>
                    </div>

                    <form asp-action="IngredientGroupEdit">
                        <input type="hidden" asp-for="ID" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group form-check">
                                <input class="form-check-input" asp-for="IsSelectable" />
                                <label class="form-check-label" asp-for="IsSelectable"></label>
                            </div>

                            <div class="form-group">
                                <label asp-for="Default_Price" class="control-label"></label>
                                <input asp-for="Default_Price" class="form-control" type="number" step="1" min="0" />
                                <small class="form-text text-muted">
                                    Подставляется автоматически при создании нового ингредиента в этой группе.
                                </small>
                                <span asp-validation-for="Default_Price" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label"></label>
                                <input asp-for="OrderNum" class="form-control" type="number" min="0" />
                                <small class="form-text text-muted">
                                    Чем меньше число — тем выше в списке.
                                </small>
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                            @if (Model.List_Menu_OptionStates != null && Model.List_Menu_OptionStates.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Menu_OptionStateID">Состояние*</label>
                                    <select asp-for="Menu_OptionStateID" class="custom-select">
                                        @foreach (var item in Model.List_Menu_OptionStates)
                                        {
                                            if (item.ID == Model.Menu_OptionStateID)
                                            {
                                                <option selected value="@item.ID">@item.DisplayName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.DisplayName</option>
                                            }
                                        }
                                    </select>
                                    <small class="form-text text-muted">
                                        <strong>Включено</strong> — доступно всем.
                                        <strong>Необязательно</strong> — дополнительная опция.
                                        <strong>Отключено</strong> — скрыто из приложения.
                                    </small>
                                    <span asp-validation-for="Menu_OptionStateID" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        <div class="card-footer">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="AllIngredientGroups">Назад</a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}