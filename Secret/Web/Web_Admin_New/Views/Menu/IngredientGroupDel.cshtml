@* Страница подтверждения удаления группы ингредиентов.
   Для каждого ингредиента можно выбрать: удалить или перенести в другую группу. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Ingredient_Group_Del
@{
    ViewData["Title"] = "IngredientGroupDel";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingredient_Group_List";

    ViewBag.RazdelName = "Удалить группу ингредиентов";
    ViewBag.RazdelNameMobile = "Удалить";

    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;

    int ingredientCount = Model.Ingredients?.Count ?? 0;
    bool hasTargetGroups = Model.Target_Groups != null && Model.Target_Groups.Count > 0;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle"></i>
                            Удаление группы ингредиентов «@Model.Name»
                        </h3>
                    </div>

                    <form asp-action="IngredientGroupDel" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Name" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <!-- Предупреждение -->
                            <div class="alert alert-danger">
                                <h5><i class="fas fa-exclamation-triangle"></i> Внимание!</h5>
                                <p class="mb-0">
                                    Группа <strong>«@Model.Name»</strong> будет удалена.
                                    @if (ingredientCount > 0)
                                    {
                                        <text>
                                            В ней <strong>@ingredientCount</strong> ингредиент(ов).
                                            По умолчанию они будут <strong>удалены</strong>.
                                            Вы можете указать для каждого ингредиента отдельно —
                                            удалить его или перенести в другую группу.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>В этой группе нет ингредиентов.</text>
                                    }
                                </p>
                            </div>

                            @if (!hasTargetGroups && ingredientCount > 0)
                            {
                                <div class="alert alert-warning">
                                    <i class="fas fa-info-circle"></i>
                                    В системе нет других групп — перенос невозможен. Все ингредиенты будут удалены.
                                </div>
                            }

                            @if (ingredientCount > 0)
                            {
                                <div class="mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="setAllAction('delete')">
                                        <i class="fas fa-trash"></i> Пометить все на удаление
                                    </button>
                                    @if (hasTargetGroups)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success ml-2" onclick="setAllAction('migrate')">
                                            <i class="fas fa-exchange-alt"></i> Пометить все на перенос
                                        </button>
                                    }
                                </div>

                                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                    <table class="table table-sm table-bordered table-hover">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="width: 60px;">ID</th>
                                                <th>Наименование</th>
                                                <th style="width: 100px;">Цена</th>
                                                <th style="width: 130px;">Действие</th>
                                                <th style="width: 250px;">Перенести в группу</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Ingredients.Count; i++)
                                            {
                                                var ing = Model.Ingredients[i];
                                                var decision = Model.Decisions.FirstOrDefault(d => d.IngredientID == ing.ID)
                                                    ?? new IngredientDeleteDecision { IngredientID = ing.ID, Action = "delete" };
                                                var action = decision.Action ?? "delete";
                                                var rowId = $"row_{ing.ID}";

                                                <tr id="@rowId">
                                                    <td>@ing.ID</td>
                                                    <td>@ing.Name</td>
                                                    <td>@(ing.Price.HasValue ? ing.Price.Value.ToString("N0") : "—")</td>
                                                    <td>
                                                        <input type="hidden"
                                                               name="Decisions[@i].IngredientID"
                                                               value="@ing.ID" />

                                                        <div class="form-check">
                                                            <input class="form-check-input action-radio"
                                                                   type="radio"
                                                                   name="Decisions[@i].Action"
                                                                   id="del_@ing.ID"
                                                                   value="delete"
                                                                   data-ingredient="@ing.ID"
                                                                   @(action == "delete" ? "checked" : "") />
                                                            <label class="form-check-label text-danger" for="del_@ing.ID">
                                                                <i class="fas fa-trash"></i> Удалить
                                                            </label>
                                                        </div>

                                                        <div class="form-check">
                                                            <input class="form-check-input action-radio"
                                                                   type="radio"
                                                                   name="Decisions[@i].Action"
                                                                   id="mig_@ing.ID"
                                                                   value="migrate"
                                                                   data-ingredient="@ing.ID"
                                                                   @(action == "migrate" ? "checked" : "")
                                                                   @(hasTargetGroups ? "" : "disabled") />
                                                            <label class="form-check-label text-success" for="mig_@ing.ID">
                                                                <i class="fas fa-exchange-alt"></i> Перенести
                                                            </label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <select name="Decisions[@i].TargetGroupID"
                                                                class="custom-select custom-select-sm target-group-select"
                                                                data-ingredient="@ing.ID"
                                                                @(action == "migrate" ? "" : "disabled")>
                                                            <option value="">— не выбрано —</option>
                                                            @foreach (var g in Model.Target_Groups)
                                                            {
                                                                if (g.ID == decision.TargetGroupID)
                                                                {
                                                                    <option selected value="@g.ID">@g.Name</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@g.ID">@g.Name</option>
                                                                }
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted text-center">Нет ингредиентов для переноса.</p>
                            }
                        </div>

                        <div class="card-footer">
                            <div class="row">
                                <div class="col-md-6">
                                    <a asp-action="AllIngredientGroups" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i> Отмена
                                    </a>
                                </div>
                                <div class="col-md-6 text-right">
                                    <button type="submit" class="btn btn-danger"
                                            onclick="return confirm('Подтвердите удаление группы «@Model.Name»?');">
                                        <i class="fas fa-trash"></i> Удалить группу
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Включение/выключение select при выборе "Перенести".
        function syncRow(ingredientId) {
            var migrateRadio = document.getElementById('mig_' + ingredientId);
            var select = document.querySelector('select.target-group-select[data-ingredient="' + ingredientId + '"]');
            if (!migrateRadio || !select) return;

            select.disabled = !migrateRadio.checked;
            if (!migrateRadio.checked) {
                select.value = '';
            }
        }

        // Общий обработчик: при клике на radio — синхронизируем select в этой строке.
        document.addEventListener('change', function (e) {
            if (e.target.classList && e.target.classList.contains('action-radio')) {
                var ingId = e.target.getAttribute('data-ingredient');
                syncRow(ingId);
            }
        });

        // Установить всем одно действие.
        function setAllAction(action) {
            var radios = document.querySelectorAll('.action-radio[value="' + action + '"]');
            radios.forEach(function (r) {
                if (!r.disabled) {
                    r.checked = true;
                    var ingId = r.getAttribute('data-ingredient');
                    syncRow(ingId);
                }
            });
        }

        // Инициализация при загрузке
        document.addEventListener('DOMContentLoaded', function () {
            var allRadios = document.querySelectorAll('.action-radio');
            allRadios.forEach(function (r) {
                var ingId = r.getAttribute('data-ingredient');
                syncRow(ingId);
            });
        });
    </script>
}