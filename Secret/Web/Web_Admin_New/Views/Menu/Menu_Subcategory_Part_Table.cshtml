@* Частичное представление для отображения таблицы подкатегорий. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Subcategory_List
@{
    Layout = null;
}

@if (Model != null && Model.List_Menu_Subcategories != null && Model.List_Menu_Subcategories.Any())
{
    <table id="HIDE-subcategories" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th style="width: 50px;">ID</th>
                <th style="width: 250px;">Наименование</th>
                <th style="width: 150px;">Родитель</th>
                <th style="min-width: 150px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Menu_Subcategories)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Name</td>
                    <td>
                        @{
                            var parent = Model.List_Menu_Subcategories.FirstOrDefault(x => x.ID == item.ParentID);
                            @(parent != null ? parent.Name : "-")
                        }
                    </td>
                    <td class="HIDE-button-actions">
                        <div style="display:flex; gap:4px;">
                            <a asp-action="DishList" asp-route-Menu_SubcategoryID="@item.ID" class="btn btn-block bg-gradient-info btn-sm">
                                <i class="fas fa-list"></i> Блюда
                            </a>
                            <a asp-action="SubcategoryEdit" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="SubcategoryDel" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-danger btn-sm">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style="border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px;">
            Записей не обнаружено
        </h3>
    </div>
}