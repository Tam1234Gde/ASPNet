@* Страница редактирования ингредиента. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Ingredient_AddEdit
@{
    ViewData["Title"] = "IngredientEdit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = "Редактировать ингредиент";
    ViewBag.RazdelNameMobile = "Редактировать";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Редактирование ингредиента "@Model.Name"</h3>
                    </div>

                    <form asp-action="IngredientEdit" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ID" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="ImageFile" class="control-label"></label>
                                @if (Model.Image != null && Model.Image.Length > 0)
                                {
                                    <div class="mb-2">
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Image)" alt="Текущее изображение" style="max-height: 100px;" />
                                        <br />
                                        <small class="text-muted">Текущее изображение</small>
                                    </div>
                                }
                                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Price" class="control-label"></label>
                                <input asp-for="Price" class="form-control" type="number" step="1" min="0" />
                                <small class="form-text text-muted">
                                    Явно указанная цена помечается как «переопределена вручную».
                                </small>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @if (Model.List_Groups != null && Model.List_Groups.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Menu_Ingridient_GroupID">Группа*</label>
                                    <select asp-for="Menu_Ingridient_GroupID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Groups)
                                        {
                                            if (item.ID == Model.Menu_Ingridient_GroupID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Menu_Ingridient_GroupID" class="text-danger"></span>
                                </div>
                            }

                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label"></label>
                                <input asp-for="OrderNum" class="form-control" type="number" min="0" />
                                <small class="form-text text-muted">
                                    Чем меньше число — тем выше в списке.
                                </small>
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                            @if (Model.List_Menu_OptionStates != null && Model.List_Menu_OptionStates.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Menu_OptionStateID">Состояние*</label>
                                    <select asp-for="Menu_OptionStateID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Menu_OptionStates)
                                        {
                                            if (item.ID == Model.Menu_OptionStateID)
                                            {
                                                <option selected value="@item.ID">@item.DisplayName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.DisplayName</option>
                                            }
                                        }
                                    </select>
                                    <small class="form-text text-muted">
                                        <strong>Включено</strong> — доступно всем.
                                        <strong>Необязательно</strong> — дополнительный ингредиент.
                                        <strong>Отключено</strong> — скрыто из приложения.
                                    </small>
                                    <span asp-validation-for="Menu_OptionStateID" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        <div class="card-footer">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="AllIngredients" asp-route-Menu_Ingridient_GroupID="@Model.Menu_Ingridient_GroupID">Назад</a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}