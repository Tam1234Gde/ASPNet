@* Страница добавления ингредиента. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Ingredient_AddEdit
@{
    ViewData["Title"] = "IngredientAdd";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingredient_List";

    ViewBag.RazdelName = "Добавить ингредиент";
    ViewBag.RazdelNameMobile = "Добавить";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Добавление ингредиента</h3>
                    </div>

                    <form asp-action="IngredientAdd" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="ImageFile" class="control-label"></label>
                                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Price" class="control-label"></label>
                                <input asp-for="Price" class="form-control" type="number" step="1" min="0" />
                                <small class="form-text text-muted">
                                    Если оставить пустым — подставится цена по умолчанию из выбранной группы.
                                </small>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @if (Model.List_Groups != null && Model.List_Groups.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Menu_Ingridient_GroupID">Группа*</label>
                                    <select asp-for="Menu_Ingridient_GroupID" class="form-control" id="groupSelect">
                                        @foreach (var item in Model.List_Groups)
                                        {
                                            if (item.ID == Model.Menu_Ingridient_GroupID)
                                            {
                                                <option selected value="@item.ID" data-default-price="@(item.Default_Price?.ToString() ?? "")">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID" data-default-price="@(item.Default_Price?.ToString() ?? "")">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Menu_Ingridient_GroupID" class="text-danger"></span>
                                </div>
                            }

                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label"></label>
                                <input asp-for="OrderNum" class="form-control" type="number" min="0" />
                                <small class="form-text text-muted">
                                    Если оставить 0 — запись добавится в конец группы.
                                </small>
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                            @if (Model.List_Menu_OptionStates != null && Model.List_Menu_OptionStates.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Menu_OptionStateID">Состояние*</label>
                                    <select asp-for="Menu_OptionStateID" class="form-control">
                                        @foreach (var item in Model.List_Menu_OptionStates)
                                        {
                                            if (item.ID == Model.Menu_OptionStateID)
                                            {
                                                <option selected value="@item.ID">@item.DisplayName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.DisplayName</option>
                                            }
                                        }
                                    </select>
                                    <small class="form-text text-muted">
                                        <strong>Включено</strong> — доступно всем.
                                        <strong>Необязательно</strong> — дополнительный ингредиент.
                                        <strong>Отключено</strong> — скрыто из приложения.
                                    </small>
                                    <span asp-validation-for="Menu_OptionStateID" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <input type="submit" value="Добавить" class="btn btn-primary" />
                                <a asp-action="AllIngredients" asp-route-Menu_Ingridient_GroupID="@Model.Menu_Ingridient_GroupID" class="btn btn-default">Отмена</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function() {
            var groupSelect = document.getElementById('groupSelect');
            var priceInput = document.getElementById('Price');
            if (!groupSelect || !priceInput) return;
            groupSelect.addEventListener('change', function() {
                var sel = groupSelect.options[groupSelect.selectedIndex];
                var def = sel.getAttribute('data-default-price');
                if (!priceInput.value && def) { priceInput.value = def; }
            });
        })();
    </script>
}