@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Category_AddEdit
@{
    ViewData["Title"] = "CategoryAdd";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";
    ViewBag.RazdelName = "Добавить категорию";
    ViewBag.RazdelNameMobile = "Добавить";
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Добавление категории в меню "@Model.MenuName"</h3>
                    </div>
                    <form asp-action="CategoryAdd">
                        <input type="hidden" asp-for="MenuID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label"></label>
                                <input asp-for="OrderNum" class="form-control" type="number" min="0" />
                                <small class="form-text text-muted">
                                    Если оставить 0 — категория добавится в конец списка.
                                    Шаг 10: 10, 20, 30...
                                </small>
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <input type="submit" value="Добавить" class="btn btn-primary" />
                                <a asp-action="CategoryList" asp-route-MenuID="@Model.MenuID" class="btn btn-default">Отмена</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}