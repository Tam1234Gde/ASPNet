@* Частичное представление для отображения таблицы привязок к ресторанам. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Restaurant_List
@{
    Layout = null;
}

@if (Model != null && Model.List_Menu_Restaurants != null && Model.List_Menu_Restaurants.Any())
{
    <table id="HIDE-restaurants" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th style="width: 50px;">ID</th>
                <th style="width: 150px;">Ресторан</th>
                <th style="width: 150px;">Дата начала</th>
                <th style="width: 150px;">Дата окончания</th>
                <th style="width: 120px;">Состояние</th>
                <th style="min-width: 150px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Menu_Restaurants)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.RestaurantID</td>
                    <td>@(item.DateFrom.HasValue ? item.DateFrom.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                    <td>@(item.DateTo.HasValue ? item.DateTo.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                    <td>
                        @{
                            string stateName = item.Menu_OptionStateID switch
                            {
                                1 => "Активно",
                                2 => "Опционально",
                                3 => "Отключено",
                                _ => "Неизвестно"
                            };
                            string stateClass = item.Menu_OptionStateID switch
                            {
                                1 => "badge-success",
                                2 => "badge-warning",
                                3 => "badge-danger",
                                _ => "badge-secondary"
                            };
                        }
                        <span class="badge @stateClass">@stateName</span>
                    </td>
                    <td class="HIDE-button-actions">
                        <div style="display:flex; gap:4px;">
                            <a asp-action="RestaurantEdit" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="RestaurantDel" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-danger btn-sm">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style="border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px;">
            Записей не обнаружено
        </h3>
    </div>
}