@* Страница редактирования блюда (аналогична DishAdd). *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Dish_AddEdit
@{
    ViewData["Title"] = "DishEdit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = "Редактировать блюдо";
    ViewBag.RazdelNameMobile = "Редактировать";
}

<style>
    .ingredient-group {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px 15px;
        margin-bottom: 12px;
        background: #f8f9fa;
    }

        .ingredient-group .group-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            user-select: none;
        }

            .ingredient-group .group-header .group-name {
                font-weight: 600;
                font-size: 15px;
                color: #495057;
            }

            .ingredient-group .group-header .group-actions {
                display: flex;
                gap: 10px;
                align-items: center;
            }

                .ingredient-group .group-header .group-actions .badge {
                    font-size: 12px;
                    padding: 3px 8px;
                }

        .ingredient-group .group-body {
            display: none;
            padding-top: 10px;
            flex-wrap: wrap;
            gap: 8px;
        }

            .ingredient-group .group-body.show {
                display: flex;
            }

            .ingredient-group .group-body .form-check {
                margin-right: 15px;
                min-width: 150px;
            }

                .ingredient-group .group-body .form-check .form-check-input {
                    cursor: pointer;
                    width: 16px;
                    height: 16px;
                }

                .ingredient-group .group-body .form-check .form-check-label {
                    cursor: pointer;
                    font-size: 14px;
                    margin-left: 5px;
                }

                .ingredient-group .group-body .form-check .ingredient-price {
                    font-size: 12px;
                    color: #6c757d;
                    margin-left: 3px;
                }

                    .ingredient-group .group-body .form-check .ingredient-price::before {
                        content: "(";
                    }

                    .ingredient-group .group-body .form-check .ingredient-price::after {
                        content: ")";
                    }

    .toggle-icon {
        transition: transform 0.3s ease;
        font-size: 14px;
        color: #6c757d;
    }

        .toggle-icon.rotated {
            transform: rotate(90deg);
        }

    .btn-select-all {
        font-size: 12px;
        padding: 2px 10px;
        border: 1px solid #6c757d;
        border-radius: 4px;
        background: transparent;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-select-all:hover {
            background: #6c757d;
            color: #fff;
        }

        .btn-select-all.selected {
            background: #28a745;
            border-color: #28a745;
            color: #fff;
        }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Редактирование блюда "@Model.Name"</h3>
                    </div>

                    <form asp-action="DishEdit" enctype="multipart/form-data" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Menu_SubcategoryID" />
                        <input type="hidden" asp-for="SubcategoryName" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <!-- Основная информация (аналогично DishAdd) -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name" class="control-label"></label>
                                        <input asp-for="Name" class="form-control" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teaser" class="control-label"></label>
                                        <input asp-for="Teaser" class="form-control" />
                                        <span asp-validation-for="Teaser" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Text" class="control-label"></label>
                                        <textarea asp-for="Text" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Text" class="text-danger"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Cooking_Minutes" class="control-label"></label>
                                                <input asp-for="Cooking_Minutes" class="form-control" type="number" />
                                                <span asp-validation-for="Cooking_Minutes" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Price" class="control-label"></label>
                                                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                                <span asp-validation-for="Price" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="OrderNum" class="control-label"></label>
                                                <input asp-for="OrderNum" class="form-control" type="number" />
                                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Menu_OptionStateID">Состояние*</label>
                                                <select asp-for="Menu_OptionStateID" class="custom-select">
                                                    @if (Model.List_Menu_OptionStates != null)
                                                    {
                                                        @foreach (var item in Model.List_Menu_OptionStates)
                                                        {
                                                            if (item.ID == Model.Menu_OptionStateID)
                                                            {
                                                                <option selected value="@item.ID">@item.Value</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.ID">@item.Value</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                                <span asp-validation-for="Menu_OptionStateID" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="ImageFile" class="control-label"></label>
                                        @if (Model.Image != null && Model.Image.Length > 0)
                                        {
                                            <div class="mb-2">
                                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Image)" alt="Текущее изображение" style="max-height: 100px;" />
                                                <br />
                                                <small class="text-muted">Текущее изображение</small>
                                            </div>
                                        }
                                        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="Flag_AllowColors" />
                                        <label class="form-check-label" asp-for="Flag_AllowColors"></label>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="Flag_Bonus" />
                                        <label class="form-check-label" asp-for="Flag_Bonus"></label>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Bonuses" class="control-label"></label>
                                        <input asp-for="Bonuses" class="form-control" type="number" step="0.01" />
                                        <span asp-validation-for="Bonuses" class="text-danger"></span>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="FlagNew" />
                                        <label class="form-check-label" asp-for="FlagNew"></label>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="New_DateFrom" class="control-label"></label>
                                        <input asp-for="New_DateFrom" class="form-control" type="date" />
                                        <span asp-validation-for="New_DateFrom" class="text-danger"></span>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="FlagNoActive" />
                                        <label class="form-check-label" asp-for="FlagNoActive"></label>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="RecommendDishIDs" class="control-label"></label>
                                        <input asp-for="RecommendDishIDs" class="form-control" HIDEholder="например: 1;2;3" />
                                        <span asp-validation-for="RecommendDishIDs" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Объемы -->
                            <div class="row">
                                <div class="col-md-12">
                                    <h5 class="mt-3">Объемы</h5>
                                    <hr />
                                </div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var volField = typeof(Model_Menu_Dish_AddEdit).GetProperty($"Vol{i}");
                                    var priceField = typeof(Model_Menu_Dish_AddEdit).GetProperty($"Vol{i}_Price");

                                    if (volField != null && priceField != null)
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Объем @i (мл)</label>
                                                <input asp-for="@volField.Name" class="form-control" type="number" />
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Цена @i</label>
                                                <input asp-for="@priceField.Name" class="form-control" type="number" />
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- ===== ИНГРЕДИЕНТЫ (аналогично DishAdd) ===== -->
                            <div class="row">
                                <div class="col-md-12">
                                    <h5 class="mt-3">Ингредиенты</h5>
                                    <hr />

                                    @if (Model.IngredientGroups != null && Model.IngredientGroups.Count > 0)
                                    {
                                        <div class="mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="expandAllGroups()">
                                                <i class="fas fa-expand"></i> Развернуть все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="collapseAllGroups()">
                                                <i class="fas fa-compress"></i> Свернуть все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="selectAllIngredients()">
                                                <i class="fas fa-check-double"></i> Выбрать все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deselectAllIngredients()">
                                                <i class="fas fa-times"></i> Снять все
                                            </button>
                                        </div>

                                        <div id="ingredientsContainer">
                                            @foreach (var group in Model.IngredientGroups)
                                            {
                                                <div class="ingredient-group" data-group-id="@group.GroupId">
                                                    <div class="group-header" onclick="toggleGroup(@group.GroupId)">
                                                        <span class="group-name">
                                                            <i class="fas fa-chevron-right toggle-icon" id="icon_@group.GroupId"></i>
                                                            @group.GroupName
                                                            <span class="badge badge-secondary">@group.Ingredients.Count</span>
                                                        </span>
                                                        <div class="group-actions">
                                                            @if (group.IsSelectable)
                                                            {
                                                                <span class="badge badge-warning">На выбор одна</span>
                                                            }
                                                            <button type="button" class="btn-select-all" onclick="toggleGroupSelection(@group.GroupId, event)">
                                                                Выбрать все
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="group-body" id="group_@group.GroupId">
                                                        @foreach (var ingredient in group.Ingredients)
                                                        {
                                                            <div class="form-check">
                                                                <input class="form-check-input ingredient-checkbox"
                                                                       type="checkbox"
                                                                       name="SelectedIngredientIDs"
                                                                       value="@ingredient.Id"
                                                                       id="ing_@ingredient.Id"
                                                                       data-group="@group.GroupId"
                                                                @(ingredient.IsChecked ? "checked" : "")
                                                                @(group.IsSelectable ? "onclick=\"handleSingleSelect(this, @group.GroupId)\"" : "") />
                                                                <label class="form-check-label" for="ing_@ingredient.Id">
                                                                    @ingredient.Name
                                                                    @if (ingredient.Price.HasValue)
                                                                    {
                                                                        <span class="ingredient-price">@ingredient.Price.Value.ToString("N0")</span>
                                                                    }
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <input type="hidden" id="SelectedIngredientIDs_Hidden" name="SelectedIngredientIDs_Hidden" value="" />
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle"></i> Нет доступных ингредиентов.
                                            <a asp-action="AllIngredients">Создайте ингредиенты</a> и добавьте их в группы.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Сохранить
                                </button>
                                <a asp-action="DishList" asp-route-Menu_SubcategoryID="@Model.Menu_SubcategoryID" class="btn btn-default">Отмена</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Все те же скрипты, что и в DishAdd
        function toggleGroup(groupId) {
            var body = document.getElementById('group_' + groupId);
            var icon = document.getElementById('icon_' + groupId);

            if (body) {
                body.classList.toggle('show');
                if (icon) {
                    icon.classList.toggle('rotated');
                }
            }
        }

        function expandAllGroups() {
            var bodies = document.querySelectorAll('.group-body');
            var icons = document.querySelectorAll('.toggle-icon');

            bodies.forEach(function(el) {
                el.classList.add('show');
            });
            icons.forEach(function(el) {
                el.classList.add('rotated');
            });
        }

        function collapseAllGroups() {
            var bodies = document.querySelectorAll('.group-body');
            var icons = document.querySelectorAll('.toggle-icon');

            bodies.forEach(function(el) {
                el.classList.remove('show');
            });
            icons.forEach(function(el) {
                el.classList.remove('rotated');
            });
        }

        function toggleGroupSelection(groupId, event) {
            if (event) event.stopPropagation();

            var checkboxes = document.querySelectorAll('.ingredient-checkbox[data-group="' + groupId + '"]');
            var allChecked = true;

            checkboxes.forEach(function(cb) {
                if (!cb.checked) {
                    allChecked = false;
                }
            });

            checkboxes.forEach(function(cb) {
                if (allChecked) {
                    cb.checked = false;
                } else {
                    cb.checked = true;
                }
            });

            updateGroupSelectButton(groupId);
            updateSelectedIngredients();
        }

        function handleSingleSelect(checkbox, groupId) {
            var group = document.querySelector('.ingredient-group[data-group-id="' + groupId + '"]');
            var isSelectable = group ? group.querySelector('.badge-warning') !== null : false;

            if (isSelectable && checkbox.checked) {
                var checkboxes = document.querySelectorAll('.ingredient-checkbox[data-group="' + groupId + '"]');
                checkboxes.forEach(function(cb) {
                    if (cb !== checkbox) {
                        cb.checked = false;
                    }
                });
            }

            updateGroupSelectButton(groupId);
            updateSelectedIngredients();
        }

        function updateGroupSelectButton(groupId) {
            var checkboxes = document.querySelectorAll('.ingredient-checkbox[data-group="' + groupId + '"]');
            var checkedCount = 0;
            var totalCount = checkboxes.length;

            checkboxes.forEach(function(cb) {
                if (cb.checked) {
                    checkedCount++;
                }
            });

            var group = document.querySelector('.ingredient-group[data-group-id="' + groupId + '"]');
            if (group) {
                var btn = group.querySelector('.btn-select-all');
                if (btn) {
                    if (checkedCount === totalCount && totalCount > 0) {
                        btn.classList.add('selected');
                        btn.textContent = 'Снять все';
                    } else {
                        btn.classList.remove('selected');
                        btn.textContent = 'Выбрать все';
                    }
                }
            }
        }

        function selectAllIngredients() {
            var checkboxes = document.querySelectorAll('.ingredient-checkbox');
            checkboxes.forEach(function(cb) {
                cb.checked = true;
            });

            var groups = document.querySelectorAll('.ingredient-group');
            groups.forEach(function(group) {
                var groupId = group.getAttribute('data-group-id');
                if (groupId) {
                    updateGroupSelectButton(parseInt(groupId));
                }
            });
            updateSelectedIngredients();
        }

        function deselectAllIngredients() {
            var checkboxes = document.querySelectorAll('.ingredient-checkbox');
            checkboxes.forEach(function(cb) {
                cb.checked = false;
            });

            var groups = document.querySelectorAll('.ingredient-group');
            groups.forEach(function(group) {
                var groupId = group.getAttribute('data-group-id');
                if (groupId) {
                    updateGroupSelectButton(parseInt(groupId));
                }
            });
            updateSelectedIngredients();
        }

        function updateSelectedIngredients() {
            var checkboxes = document.querySelectorAll('.ingredient-checkbox:checked');
            var ids = [];
            checkboxes.forEach(function(cb) {
                ids.push(cb.value);
            });

            var hidden = document.getElementById('SelectedIngredientIDs_Hidden');
            if (hidden) {
                hidden.value = ids.join(',');
            }
        }

        $(document).ready(function() {
            var firstGroup = document.querySelector('.ingredient-group');
            if (firstGroup) {
                var firstGroupId = firstGroup.getAttribute('data-group-id');
                if (firstGroupId) {
                    toggleGroup(parseInt(firstGroupId));
                }
            }

            var groups = document.querySelectorAll('.ingredient-group');
            groups.forEach(function(group) {
                var groupId = group.getAttribute('data-group-id');
                if (groupId) {
                    updateGroupSelectButton(parseInt(groupId));
                }
            });

            document.querySelectorAll('.ingredient-checkbox').forEach(function(cb) {
                cb.addEventListener('change', function() {
                    var groupId = this.getAttribute('data-group');
                    if (groupId) {
                        updateGroupSelectButton(parseInt(groupId));
                        updateSelectedIngredients();
                    }
                });
            });

            updateSelectedIngredients();
        });
    </script>
}