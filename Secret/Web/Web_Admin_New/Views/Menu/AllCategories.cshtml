@* Страница со списком всех категорий с полным функционалом: фильтр, добавление, копирование, удаление, drag-and-drop. *@
@using System.Linq
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_AllCategories
@{
    ViewData["Title"] = "Все категории";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Category_List";

    ViewBag.RazdelName = "Все категории";
    ViewBag.RazdelNameMobile = "Категории";

    bool hasFilter = Model.MenuID.HasValue && Model.MenuID.Value > 0;
}

<style>
    .filter-section {
        background: #f8f9fa; border-radius: 8px; padding: 12px 18px;
        margin-bottom: 15px; border: 1px solid #dee2e6;
        display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    }
    .filter-section .filter-label { font-weight: 600; color: #495057; }
    .filter-section select { padding: 5px 10px; border-radius: 4px; border: 1px solid #ced4da; min-width: 200px; }

    .badge-parent { font-size: 12px; background: #e9ecef; color: #495057; padding: 3px 8px; border-radius: 4px; }

    .table tbody tr:hover { background-color: rgba(33, 150, 243, 0.05); cursor: pointer; }
    .table tbody tr.selected { background-color: #e3f2fd !important; }
    .table tbody tr.table-secondary { background-color: #f5f5f5; }

    .checkbox-select-all { width: 18px; height: 18px; cursor: pointer; }
    .checkbox-item { width: 18px; height: 18px; cursor: pointer; }

    .bulk-actions {
        display: none; background: #e3f2fd; border: 2px solid #2196F3;
        border-radius: 8px; padding: 10px 15px; margin-bottom: 15px;
        align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 10px;
    }
    .bulk-actions.show { display: flex; }
    .bulk-actions .count { font-weight: 600; color: #1976D2; }
    .bulk-actions .btn-bulk-copy {
        background: #2196F3; color: #fff; border: none;
        padding: 8px 20px; border-radius: 5px; cursor: pointer;
        transition: all 0.3s ease;
    }
    .bulk-actions .btn-bulk-copy:hover { background: #1976D2; transform: scale(1.05); }
    .bulk-actions .btn-bulk-delete {
        background: #dc3545; color: #fff; border: none;
        padding: 8px 20px; border-radius: 5px; cursor: pointer;
        transition: all 0.3s ease; margin-left: 10px;
    }
    .bulk-actions .btn-bulk-delete:hover { background: #c82333; transform: scale(1.05); }
    .bulk-actions .btn-bulk-restore {
        background: #28a745; color: #fff; border: none;
        padding: 8px 20px; border-radius: 5px; cursor: pointer;
        transition: all 0.3s ease;
    }
    .bulk-actions .btn-bulk-restore:hover { background: #218838; transform: scale(1.05); }
    .bulk-actions .btn-bulk-clear {
        background: #6c757d; color: #fff; border: none;
        padding: 8px 15px; border-radius: 5px; cursor: pointer;
        transition: all 0.3s ease; margin-left: 10px;
    }
    .bulk-actions .btn-bulk-clear:hover { background: #5a6268; }

    .paste-section {
        background: #f8f9fa; border: 2px dashed #6c757d; border-radius: 8px;
        padding: 15px 20px; margin-bottom: 15px;
        display: flex; align-items: center; justify-content: space-between;
        transition: all 0.3s ease; cursor: pointer; flex-wrap: wrap; gap: 10px;
    }
    .paste-section:hover { border-color: #17a2b8; background: #e9ecef; }
    .paste-section.has-copied { border-color: #28a745; background: #d4edda; }
    .paste-section .paste-icon { font-size: 24px; margin-right: 10px; }

    .sort-mode-container {
        display: none; background: #fff8e1; border: 2px solid #ffc107;
        border-radius: 8px; padding: 15px 20px; margin-bottom: 15px;
    }
    .sort-mode-container.active { display: block; }
    .sort-mode-container h5 { margin: 0 0 10px 0; color: #856404; }
    .sort-list { list-style: none; padding: 0; margin: 0; }
    .sort-list-item {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 15px; background: #fff; border: 1px solid #dee2e6;
        border-radius: 6px; margin-bottom: 8px; cursor: grab;
        user-select: none; transition: all 0.15s ease;
    }
    .sort-list-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .sort-list-item.dragging { opacity: 0.4; background: #e3f2fd; border: 2px dashed #2196F3; }
    .sort-list-item.drag-over { border-top: 3px solid #2196F3; }
    .sort-list-item .drag-handle { color: #6c757d; font-size: 18px; cursor: grab; }
    .sort-list-item .order-badge { background: #17a2b8; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 12px; min-width: 30px; text-align: center; }
    .sort-list-item .item-name { flex: 1; font-weight: 500; }
    .sort-mode-actions { display: flex; gap: 10px; margin-top: 15px; }

    .undo-toast {
        position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
        background: #333; color: #fff; padding: 15px 25px; border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3); z-index: 10000;
        display: flex; align-items: center; gap: 15px;
    }
    .undo-toast .undo-btn { background: #28a745; border: none; color: #fff; padding: 5px 12px; border-radius: 4px; cursor: pointer; }
    .undo-toast .undo-close { background: none; border: none; color: #fff; font-size: 20px; cursor: pointer; }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6"><h3 class="card-title">Список всех категорий</h3></div>
                            <div class="col-md-6 text-right">
                                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-reply"></i> Назад</a>

                                <!-- Кнопка "Добавить" — dropdown с меню -->
                                <div class="dropdown d-inline-block">
                                    <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-plus"></i> Добавить
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right" style="max-height: 400px; overflow-y: auto;">
                                        <h6 class="dropdown-header">Выберите меню:</h6>
                                        @if (Model.List_Menus != null && Model.List_Menus.Count > 0)
                                        {
                                            foreach (var menu in Model.List_Menus)
                                            {
                                                <a class="dropdown-item" asp-action="CategoryAdd" asp-route-MenuID="@menu.ID">
                                                    <i class="fas fa-utensils"></i> @menu.Name
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="dropdown-item text-muted">Нет меню</span>
                                        }
                                    </div>
                                </div>

                                @if (hasFilter)
                                {
                                    <button type="button" class="btn btn-warning" id="btnSortMode">
                                        <i class="fas fa-arrows-alt"></i> Настроить порядок
                                    </button>
                                }

                                <a href="@Url.Action("AllCategories", new { MenuID = Model.MenuID, showDeleted = !Model.ShowDeleted })"
                                   class="btn @(Model.ShowDeleted ? "btn-warning" : "btn-outline-secondary")">
                                    @(Model.ShowDeleted ? "Скрыть удалённые" : "Показать удалённые")
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show">
                                <i class="fas fa-check-circle"></i> @TempData["Success"]
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                            </div>
                        }

                        <!-- Фильтр по меню -->
                        <div class="filter-section">
                            <span class="filter-label"><i class="fas fa-filter"></i> Фильтр по меню:</span>
                            <select id="menuFilter" onchange="location.href='@Url.Action("AllCategories", "Menu")?MenuID=' + this.value + '&showDeleted=@Model.ShowDeleted.ToString().ToLower()'">
                                <option value="">Все меню</option>
                                @if (Model.List_Menus != null)
                                {
                                    foreach (var menu in Model.List_Menus)
                                    {
                                        if (menu.ID == Model.MenuID)
                                        {
                                            <option selected value="@menu.ID">@menu.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@menu.ID">@menu.Name</option>
                                        }
                                    }
                                }
                            </select>
                            @if (hasFilter)
                            {
                                <a asp-action="AllCategories" asp-route-showDeleted="@Model.ShowDeleted" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-times"></i> Сбросить
                                </a>
                                <span class="badge badge-info">Фильтр: @Model.MenuName</span>
                            }
                            <span class="ml-auto text-muted small">Всего: @(Model.List_Categories?.Count ?? 0)</span>
                        </div>

                        <!-- Paste section -->
                        <div class="paste-section" id="pasteSection">
                            <div style="display:flex; align-items:center; flex-wrap:wrap; gap:10px;">
                                <i class="fas fa-clipboard paste-icon" id="pasteIcon"></i>
                                <span id="pasteText" style="font-weight: 500;">
                                    <i class="fas fa-info-circle"></i> Вставьте скопированные категории
                                </span>
                            </div>
                            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                <span id="clipboardStatus" class="badge badge-secondary">
                                    <i class="fas fa-circle" style="font-size:8px;color:#6c757d;"></i> Буфер пуст
                                </span>
                                <span id="clipboardCount" class="badge badge-secondary" style="display:none;">
                                    <i class="fas fa-folder-open"></i> <span id="copiedCount">0</span>
                                </span>
                            </div>
                        </div>

                        <!-- Bulk actions -->
                        <div class="bulk-actions" id="bulkActions">
                            <div>
                                <i class="fas fa-check-circle" style="color:#2196F3;"></i>
                                Выбрано: <span class="count" id="selectedCount">0</span>
                            </div>
                            <div>
                                <button type="button" class="btn-bulk-copy" onclick="copySelected()">
                                    <i class="fas fa-copy"></i> Копировать
                                </button>
                                @if (Model.ShowDeleted)
                                {
                                    <button type="button" class="btn-bulk-restore" onclick="bulkRestore()">
                                        <i class="fas fa-undo"></i> Восстановить
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn-bulk-delete" onclick="bulkDelete()">
                                        <i class="fas fa-trash"></i> Удалить
                                    </button>
                                }
                                <button type="button" class="btn-bulk-clear" onclick="clearAllSelections()">
                                    <i class="fas fa-times"></i> Очистить
                                </button>
                            </div>
                        </div>

                        <!-- Sort mode -->
                        @if (hasFilter)
                        {
                            <div class="sort-mode-container" id="sortModeContainer">
                                <h5><i class="fas fa-arrows-alt"></i> Перетащите категории в нужном порядке</h5>
                                <p class="text-muted small">
                                    Порядок сохранится после нажатия «Сохранить порядок». Только внутри этого меню.
                                </p>
                                <ul class="sort-list" id="sortList">
                                    @{
                                        var ordered = Model.List_Categories?
                                            .OrderBy(x => x.OrderNum == 0 ? int.MaxValue : x.OrderNum)
                                            .ThenBy(x => x.Name)
                                            .ToList() ?? new List<CMenu_Category>();
                                    }
                                    @foreach (var item in ordered)
                                    {
                                        <li class="sort-list-item" draggable="true" data-id="@item.ID">
                                            <span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
                                            <span class="order-badge">@item.OrderNum</span>
                                            <span class="item-name">@item.Name</span>
                                            <span class="text-muted small">ID: @item.ID</span>
                                        </li>
                                    }
                                </ul>
                                <div class="sort-mode-actions">
                                    <button type="button" class="btn btn-success" id="btnSaveOrder">
                                        <i class="fas fa-save"></i> Сохранить порядок
                                    </button>
                                    <button type="button" class="btn btn-secondary" id="btnCancelSort">
                                        <i class="fas fa-times"></i> Отмена
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- Таблица -->
                        <div id="normalTableWrapper">
                            <div class="table-responsive">
                                <table id="HIDE-all-categories" class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width:40px;"><input type="checkbox" class="checkbox-select-all" id="selectAll" onchange="toggleAllCheckboxes()" /></th>
                                            <th style="width:50px;">ID</th>
                                            <th style="width:80px;">Порядок</th>
                                            <th style="width:250px;">Наименование</th>
                                            <th style="width:200px;">Меню</th>
                                            <th style="min-width:200px;">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.List_Categories != null && Model.List_Categories.Count > 0)
                                        {
                                            foreach (var item in Model.List_Categories)
                                            {
                                                string menuName = Model.List_Menus?.FirstOrDefault(x => x.ID == item.MenuID)?.Name ?? "Меню #" + item.MenuID;
                                                <tr class="@(Model.ShowDeleted ? "table-secondary" : "")">
                                                    <td><input type="checkbox" class="checkbox-item" data-id="@item.ID" onchange="updateBulkActions()" /></td>
                                                    <td>@item.ID</td>
                                                    <td>@item.OrderNum</td>
                                                    <td>@item.Name</td>
                                                    <td><span class="badge-parent">@menuName</span></td>
                                                    <td>
                                                        @if (Model.ShowDeleted)
                                                        {
                                                            <button type="button" class="btn btn-success btn-sm restore-one-btn" data-id="@item.ID">
                                                                <i class="fas fa-undo"></i> Восстановить
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <div class="btn-group" role="group">
                                                                <button type="button" class="btn btn-outline-info btn-sm copy-one-btn" data-id="@item.ID" data-name="@item.Name" title="Копировать"><i class="fas fa-copy"></i></button>
                                                                <a asp-action="SubcategoryList" asp-route-Menu_CategoryID="@item.ID" class="btn btn-outline-info btn-sm" title="Подкатегории"><i class="fas fa-list"></i></a>
                                                                <a asp-action="CategoryEdit" asp-route-ID="@item.ID" class="btn btn-outline-warning btn-sm" title="Редактировать"><i class="fas fa-edit"></i></a>
                                                                <a asp-action="CategoryDel" asp-route-ID="@item.ID" class="btn btn-outline-danger btn-sm" title="Удалить"><i class="fas fa-trash"></i></a>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="6" class="text-center">Записей не обнаружено</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Модалка: Выбор цели вставки -->
<div class="modal fade" id="pasteTargetModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-paste"></i> Куда вставить категории?</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Целевое меню:</label>
                    <select id="pasteTargetMenuId" class="custom-select">
                        <option value="">— выберите меню —</option>
                        @if (Model.List_Menus != null)
                        {
                            foreach (var menu in Model.List_Menus)
                            {
                                <option value="@menu.ID">@menu.Name</option>
                            }
                        }
                    </select>
                </div>
                <div id="pastePreview"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-success" id="btnConfirmPaste">
                    <i class="fas fa-check"></i> Вставить
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>

    <script>
        // ==========================================
        // ===== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ =====
        // ==========================================
        var copiedCategories = [];
        var hasFilter = @hasFilter.ToString().ToLower();

        // ==========================================
        // ===== УВЕДОМЛЕНИЯ =====
        // ==========================================
        function showToast(message, type) {
            type = type || 'success';
            var bg = {
                success: 'linear-gradient(135deg,#28a745,#20c997)',
                error: 'linear-gradient(135deg,#dc3545,#e74c3c)',
                info: 'linear-gradient(135deg,#17a2b8,#0dcaf0)',
                warning: 'linear-gradient(135deg,#ffc107,#fd7e14)'
            };
            var toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;top:20px;right:20px;padding:15px 25px;border-radius:8px;color:#fff;font-weight:500;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2);min-width:300px;background:' + bg[type];
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(function () { toast.remove(); }, 3000);
        }

        // ==========================================
        // ===== UNDO TOAST =====
        // ==========================================
        function showUndoToast(count, actionFn) {
            var toast = document.createElement('div');
            toast.className = 'undo-toast';
            toast.innerHTML =
                '<span>Удалено: ' + count + '</span>' +
                '<button type="button" class="undo-btn"><i class="fas fa-undo"></i> Отменить</button>' +
                '<button type="button" class="undo-close">&times;</button>';
            document.body.appendChild(toast);

            var timer = setTimeout(function () { if (toast.parentElement) toast.remove(); }, 8000);

            toast.querySelector('.undo-btn').addEventListener('click', function () {
                clearTimeout(timer);
                actionFn();
                toast.remove();
            });
            toast.querySelector('.undo-close').addEventListener('click', function () {
                clearTimeout(timer);
                toast.remove();
            });
        }

        // ==========================================
        // ===== BULK ACTIONS =====
        // ==========================================
        function toggleAllCheckboxes() {
            var selectAll = document.getElementById('selectAll');
            document.querySelectorAll('.checkbox-item').forEach(function (cb) {
                cb.checked = selectAll.checked;
                var row = cb.closest('tr');
                if (row) {
                    if (cb.checked) row.classList.add('selected'); else row.classList.remove('selected');
                }
            });
            updateBulkActions();
        }

        function updateBulkActions() {
            var count = document.querySelectorAll('.checkbox-item:checked').length;
            document.getElementById('selectedCount').textContent = count;
            var bulkActions = document.getElementById('bulkActions');
            if (count > 0) bulkActions.classList.add('show'); else bulkActions.classList.remove('show');
        }

        function clearAllSelections() {
            var sa = document.getElementById('selectAll');
            if (sa) sa.checked = false;
            document.querySelectorAll('.checkbox-item').forEach(function (cb) {
                cb.checked = false;
                var row = cb.closest('tr');
                if (row) row.classList.remove('selected');
            });
            updateBulkActions();
        }

        function getSelectedIds() {
            var ids = [];
            document.querySelectorAll('.checkbox-item:checked').forEach(function (cb) {
                var id = parseInt(cb.getAttribute('data-id'));
                if (!isNaN(id)) ids.push(id);
            });
            return ids;
        }

        // ==========================================
        // ===== КОПИРОВАНИЕ =====
        // ==========================================
        function copySelected() {
            var ids = getSelectedIds();
            if (ids.length === 0) { showToast('Не выбрано ни одной категории', 'warning'); return; }

            copiedCategories = [];
            ids.forEach(function (id) {
                var cb = document.querySelector('.checkbox-item[data-id="' + id + '"]');
                var row = cb ? cb.closest('tr') : null;
                var name = row ? row.querySelector('td:nth-child(4)').textContent.trim() : 'Категория #' + id;
                copiedCategories.push({ id: id, name: name });
            });

            saveToClipboard();
            updatePasteSection();
            showToast('Скопировано ' + ids.length + ' категорий', 'success');
            clearAllSelections();
        }

        function saveToClipboard() {
            try {
                localStorage.setItem('copiedCategories', JSON.stringify({
                    categories: copiedCategories,
                    timestamp: Date.now(),
                    type: 'categories'
                }));
            } catch (e) { }
        }

        function loadFromClipboard() {
            try {
                var saved = localStorage.getItem('copiedCategories');
                if (saved) {
                    var parsed = JSON.parse(saved);
                    if (parsed && parsed.type === 'categories' && parsed.categories) {
                        if (Date.now() - parsed.timestamp < 3600000) {
                            copiedCategories = parsed.categories;
                            updatePasteSection();
                            return true;
                        }
                    }
                }
            } catch (e) { }
            return false;
        }

        function updatePasteSection() {
            var section = document.getElementById('pasteSection');
            var icon = document.getElementById('pasteIcon');
            var text = document.getElementById('pasteText');
            var status = document.getElementById('clipboardStatus');
            var countBadge = document.getElementById('clipboardCount');
            var countText = document.getElementById('copiedCount');

            if (copiedCategories && copiedCategories.length > 0) {
                section.classList.add('has-copied');
                icon.className = 'fas fa-clipboard-check paste-icon';
                var count = copiedCategories.length;
                var names = copiedCategories.map(function (c) { return c.name; }).join(', ');
                if (names.length > 60) names = names.substring(0, 60) + '...';
                text.innerHTML = '<i class="fas fa-arrow-right"></i> Вставить <strong>' + count + '</strong>: ' + names;
                status.className = 'badge badge-success';
                status.innerHTML = '<i class="fas fa-check-circle"></i> Категории в буфере';
                countBadge.style.display = 'inline-block';
                countText.textContent = count;
            } else {
                section.classList.remove('has-copied');
                icon.className = 'fas fa-clipboard paste-icon';
                text.innerHTML = '<i class="fas fa-info-circle"></i> Вставьте скопированные категории';
                status.className = 'badge badge-secondary';
                status.innerHTML = '<i class="fas fa-circle" style="font-size:8px;color:#6c757d;"></i> Буфер пуст';
                countBadge.style.display = 'none';
            }
        }

        // ==========================================
        // ===== ВСТАВКА (модалка) ==========================================
        function openPasteModal() {
            if (!copiedCategories || copiedCategories.length === 0) {
                if (!loadFromClipboard()) {
                    showToast('Буфер пуст. Сначала скопируйте категории.', 'warning');
                    return;
                }
            }
            var preview = document.getElementById('pastePreview');
            preview.innerHTML = '<small class="text-muted">Будет вставлено: <strong>' + copiedCategories.length + '</strong> категорий</small>';
            $('#pasteTargetModal').modal('show');
        }

        function confirmPaste() {
            var targetId = parseInt(document.getElementById('pasteTargetMenuId').value);
            if (!targetId || targetId <= 0) { showToast('Выберите целевое меню', 'warning'); return; }

            var idsString = copiedCategories.map(function (c) { return c.id; }).join(',');

            var formData = new FormData();
            formData.append('categoryIds', idsString);
            formData.append('targetMenuId', targetId);

            fetch('@Url.Action("BulkPasteCategories", "Menu")', {
                method: 'POST',
                body: formData
            })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (data) {
                if (data.success) {
                    showToast(data.message, 'success');
                    copiedCategories = [];
                    try { localStorage.removeItem('copiedCategories'); } catch (e) { }
                    $('#pasteTargetModal').modal('hide');
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    showToast('Ошибка: ' + data.message, 'error');
                }
            })
            .catch(function (err) { showToast('Ошибка: ' + err.message, 'error'); });
        }

        // ==========================================
        // ===== BULK DELETE / RESTORE =====
        // ==========================================
        function bulkDelete() {
            var ids = getSelectedIds();
            if (ids.length === 0) return;
            if (!confirm('Удалить ' + ids.length + ' категорий?')) return;

            fetch('@Url.Action("BulkDeleteCategories", "Menu")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids })
            })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (data) {
                if (data.success) {
                    showToast('Удалено: ' + data.deleted, 'success');
                    showUndoToast(data.deleted, function () {
                        fetch('@Url.Action("BulkRestoreCategories", "Menu")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ ids: data.ids })
                        })
                        .then(function (r) { return r.json(); })
                        .then(function (res) {
                            if (res.success) {
                                showToast('Восстановлено: ' + res.restored, 'success');
                                setTimeout(function () { location.reload(); }, 800);
                            }
                        });
                    });
                    setTimeout(function () { location.reload(); }, 9000);
                }
            });
        }

        function bulkRestore() {
            var ids = getSelectedIds();
            if (ids.length === 0) return;
            if (!confirm('Восстановить ' + ids.length + ' категорий?')) return;

            fetch('@Url.Action("BulkRestoreCategories", "Menu")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids })
            })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (data) {
                if (data.success) {
                    showToast('Восстановлено: ' + data.restored, 'success');
                    setTimeout(function () { location.reload(); }, 800);
                }
            });
        }

        function restoreOne(id) {
            fetch('@Url.Action("BulkRestoreCategories", "Menu")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: [id] })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) { showToast('Восстановлено', 'success'); setTimeout(function () { location.reload(); }, 500); }
            });
        }

        function copyOne(id, name) {
            copiedCategories = [{ id: id, name: name }];
            saveToClipboard();
            updatePasteSection();
            showToast('Категория "' + name + '" скопирована', 'success');
        }

        // ==========================================
        // ===== DRAG-AND-DROP (только при фильтре) =====
        // ==========================================
        (function initSortMode() {
            if (!hasFilter) return;
            var btnSortMode = document.getElementById('btnSortMode');
            var btnSaveOrder = document.getElementById('btnSaveOrder');
            var btnCancelSort = document.getElementById('btnCancelSort');
            var sortContainer = document.getElementById('sortModeContainer');
            var normalTable = document.getElementById('normalTableWrapper');
            var sortList = document.getElementById('sortList');

            if (!btnSortMode || !sortContainer) return;

            btnSortMode.addEventListener('click', function () {
                sortContainer.classList.add('active');
                normalTable.style.display = 'none';
                updateOrderBadges();
            });

            function disableSortMode() {
                sortContainer.classList.remove('active');
                normalTable.style.display = 'block';
            }
            btnCancelSort.addEventListener('click', disableSortMode);

            function updateOrderBadges() {
                var items = sortList.querySelectorAll('.sort-list-item');
                var order = 10;
                items.forEach(function (item) {
                    var badge = item.querySelector('.order-badge');
                    if (badge) badge.textContent = order;
                    order += 10;
                });
            }

            var draggedItem = null;

            sortList.addEventListener('dragstart', function (e) {
                var item = e.target.closest('.sort-list-item');
                if (!item) return;
                draggedItem = item;
                item.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
            });

            sortList.addEventListener('dragend', function (e) {
                var item = e.target.closest('.sort-list-item');
                if (item) item.classList.remove('dragging');
                sortList.querySelectorAll('.drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
                draggedItem = null;
                updateOrderBadges();
            });

            sortList.addEventListener('dragover', function (e) {
                e.preventDefault();
                var target = e.target.closest('.sort-list-item');
                if (!target || target === draggedItem) return;
                sortList.querySelectorAll('.drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
                target.classList.add('drag-over');
                var rect = target.getBoundingClientRect();
                var offset = e.clientY - rect.top;
                if (offset > rect.height / 2) {
                    if (target.nextSibling) sortList.insertBefore(draggedItem, target.nextSibling);
                    else sortList.appendChild(draggedItem);
                } else {
                    sortList.insertBefore(draggedItem, target);
                }
            });

            sortList.addEventListener('drop', function (e) {
                e.preventDefault();
                sortList.querySelectorAll('.drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
                updateOrderBadges();
            });

            btnSaveOrder.addEventListener('click', function () {
                var ids = [];
                sortList.querySelectorAll('.sort-list-item').forEach(function (item) {
                    var id = parseInt(item.getAttribute('data-id'));
                    if (!isNaN(id)) ids.push(id);
                });
                if (ids.length === 0) { showToast('Нет элементов', 'warning'); return; }

                fetch('@Url.Action("ReorderCategories", "Menu")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: ids })
                })
                .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        showToast('Порядок сохранён (' + data.updated + ')', 'success');
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        showToast('Ошибка: ' + data.message, 'error');
                    }
                })
                .catch(function (err) { showToast('Ошибка: ' + err.message, 'error'); });
            });
        })();

        // ==========================================
        // ===== ИНИЦИАЛИЗАЦИЯ =====
        // ==========================================
        $(document).ready(function () {
            loadFromClipboard();

            // === Принудительное открытие dropdown ===
            $(document).on('click', '.dropdown-toggle', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var parent = $(this).closest('.dropdown');
                var menu = parent.find('.dropdown-menu');
                var isOpen = menu.hasClass('show');

                // Закрываем все
                $('.dropdown-menu').removeClass('show');
                $('.dropdown').removeClass('show');

                // Открываем текущее, если было закрыто
                if (!isOpen) {
                    menu.addClass('show');
                    parent.addClass('show');
                }
            });

            // === Закрытие при клике вне dropdown ===
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu').removeClass('show');
                    $('.dropdown').removeClass('show');
                }
            });

            // === Paste section ===
            document.getElementById('pasteSection').addEventListener('click', openPasteModal);

            // === Confirm paste ===
            document.getElementById('btnConfirmPaste').addEventListener('click', confirmPaste);

            // === Copy one / Restore one ===
            document.querySelectorAll('.copy-one-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var id = parseInt(btn.getAttribute('data-id'));
                    var name = btn.getAttribute('data-name');
                    copyOne(id, name);
                });
            });

            document.querySelectorAll('.restore-one-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var id = parseInt(btn.getAttribute('data-id'));
                    restoreOne(id);
                });
            });

            // Клик по строке — toggle checkbox
            $('#HIDE-all-categories tbody').on('click', 'tr', function (e) {
                if (e.target.type === 'checkbox' || e.target.closest('.btn-group') || e.target.closest('button') || e.target.closest('a')) return;
                var cb = $(this).find('.checkbox-item')[0];
                if (cb) {
                    cb.checked = !cb.checked;
                    if (cb.checked) $(this).addClass('selected'); else $(this).removeClass('selected');
                    updateBulkActions();
                }
            });

            // DataTable
            var table = $('#HIDE-all-categories').DataTable({
                "paging": true, "lengthChange": true, "searching": true, "ordering": true,
                "info": true, "autoWidth": false, "responsive": true,
                "language": {
                    "processing": "Подождите...",
                    "search": "Поиск:",
                    "lengthMenu": "Показать _MENU_ записей",
                    "info": "Записи с _START_ по _END_ из _TOTAL_",
                    "infoEmpty": "Записи с 0 по 0 из 0",
                    "infoFiltered": "(отфильтровано из _MAX_ записей)",
                    "loadingRecords": "Загрузка...",
                    "zeroRecords": "Записей не найдено",
                    "emptyTable": "Нет данных в таблице",
                    "paginate": {
                        "first": "Первая",
                        "previous": "Предыдущая",
                        "next": "Следующая",
                        "last": "Последняя"
                    }
                },
                "dom": '<"row"<"col-sm-4"l><"col-sm-4"B><"col-sm-4"f>>' +
                       '<"row"<"col-sm-12"tr>>' +
                       '<"row"<"col-sm-5"i><"col-sm-7"p>>',
                "buttons": [
                    { extend: 'excelHtml5', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn btn-success btn-sm', exportOptions: { columns: [1,2,3,4] }, title: 'Категории' },
                    { extend: 'pdfHtml5', text: '<i class="fas fa-file-pdf"></i> PDF', className: 'btn btn-danger btn-sm', exportOptions: { columns: [1,2,3,4] }, title: 'Категории' },
                    { extend: 'print', text: '<i class="fas fa-print"></i> Печать', className: 'btn btn-secondary btn-sm', exportOptions: { columns: [1,2,3,4] } }
                ],
                "columnDefs": [{ "orderable": false, "targets": [0, 5] }]
            });

            table.on('draw', function () {
                document.querySelectorAll('.checkbox-item').forEach(function (cb) {
                    var row = cb.closest('tr');
                    if (row) {
                        if (cb.checked) row.classList.add('selected'); else row.classList.remove('selected');
                    }
                });
                updateBulkActions();
            });
        });
    </script>
}