@* Страница добавления нового блюда с выбором ингредиентов по группам и поиском в старой БД. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Dish_AddEdit
@{
    ViewData["Title"] = "DishAdd";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = "Добавить блюдо";
    ViewBag.RazdelNameMobile = "Добавить";
}

<style>
    .ingredient-group {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px 15px;
        margin-bottom: 12px;
        background: #f8f9fa;
    }

        .ingredient-group .group-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            user-select: none;
        }

            .ingredient-group .group-header .group-name {
                font-weight: 600;
                font-size: 15px;
                color: #495057;
            }

            .ingredient-group .group-header .group-actions {
                display: flex;
                gap: 10px;
                align-items: center;
            }

                .ingredient-group .group-header .group-actions .badge {
                    font-size: 12px;
                    padding: 3px 8px;
                }

        .ingredient-group .group-body {
            display: none;
            padding-top: 10px;
            flex-wrap: wrap;
            gap: 8px;
        }

            .ingredient-group .group-body.show {
                display: flex;
            }

            .ingredient-group .group-body .form-check {
                margin-right: 15px;
                min-width: 150px;
            }

                .ingredient-group .group-body .form-check .form-check-input {
                    cursor: pointer;
                    width: 16px;
                    height: 16px;
                }

                .ingredient-group .group-body .form-check .form-check-label {
                    cursor: pointer;
                    font-size: 14px;
                    margin-left: 5px;
                }

                .ingredient-group .group-body .form-check .ingredient-price {
                    font-size: 12px;
                    color: #6c757d;
                    margin-left: 3px;
                }

                    .ingredient-group .group-body .form-check .ingredient-price::before {
                        content: "(";
                    }

                    .ingredient-group .group-body .form-check .ingredient-price::after {
                        content: ")";
                    }

    .toggle-icon {
        transition: transform 0.3s ease;
        font-size: 14px;
        color: #6c757d;
    }

        .toggle-icon.rotated {
            transform: rotate(90deg);
        }

    .btn-select-all {
        font-size: 12px;
        padding: 2px 10px;
        border: 1px solid #6c757d;
        border-radius: 4px;
        background: transparent;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-select-all:hover {
            background: #6c757d;
            color: #fff;
        }

        .btn-select-all.selected {
            background: #28a745;
            border-color: #28a745;
            color: #fff;
        }

    /* === Поиск в старой БД === */
    .old-dish-result-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
        background: #fff;
    }

        .old-dish-result-item:hover {
            border-color: #17a2b8;
            background: #e9f6f8;
            transform: translateX(2px);
        }

        .old-dish-result-item .result-img {
            width: 48px;
            height: 48px;
            border-radius: 6px;
            background: #f1f3f5;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            flex-shrink: 0;
        }

        .old-dish-result-item .result-main {
            flex: 1;
            min-width: 0;
        }

        .old-dish-result-item .result-name {
            font-weight: 600;
            color: #212529;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .old-dish-result-item .result-meta {
            font-size: 13px;
            color: #6c757d;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .old-dish-result-item .result-price {
            font-weight: 600;
            color: #28a745;
            flex-shrink: 0;
        }

    .old-dish-empty {
        text-align: center;
        padding: 30px 15px;
        color: #6c757d;
    }

    .preview-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .preview-table th,
        .preview-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #e9ecef;
            text-align: left;
            vertical-align: top;
        }

        .preview-table th {
            width: 40%;
            color: #495057;
            font-weight: 600;
            background: #f8f9fa;
        }

    .preview-image {
        max-width: 100%;
        max-height: 180px;
        border-radius: 6px;
        border: 1px solid #dee2e6;
    }

    .preview-empty {
        color: #adb5bd;
        font-style: italic;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Добавление блюда в подкатегорию "@Model.SubcategoryName"</h3>
                    </div>

                    <form asp-action="DishAdd" enctype="multipart/form-data" id="dishAddForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Menu_SubcategoryID" />
                        <input type="hidden" asp-for="SubcategoryName" />
                        <input type="hidden" asp-for="ImageBase64" id="ImageBase64_Hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <!-- Основная информация -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name" class="control-label"></label>
                                        <div class="input-group">
                                            <input asp-for="Name" class="form-control" id="dishNameInput" />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-info" id="btnSearchOldDish" title="Найти блюдо в старой БД">
                                                    <i class="fas fa-search"></i> Найти в старой БД
                                                </button>
                                            </div>
                                        </div>
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teaser" class="control-label"></label>
                                        <input asp-for="Teaser" class="form-control" id="dishTeaserInput" />
                                        <span asp-validation-for="Teaser" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Text" class="control-label"></label>
                                        <textarea asp-for="Text" class="form-control" rows="3" id="dishTextInput"></textarea>
                                        <span asp-validation-for="Text" class="text-danger"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Cooking_Minutes" class="control-label"></label>
                                                <input asp-for="Cooking_Minutes" class="form-control" type="number" id="dishCookingInput" />
                                                <span asp-validation-for="Cooking_Minutes" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Price" class="control-label"></label>
                                                <input asp-for="Price" class="form-control" type="number" step="0.01" id="dishPriceInput" />
                                                <span asp-validation-for="Price" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="OrderNum" class="control-label"></label>
                                                <input asp-for="OrderNum" class="form-control" type="number" />
                                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Menu_OptionStateID">Состояние*</label>
                                                <select asp-for="Menu_OptionStateID" class="custom-select">
                                                    @if (Model.List_Menu_OptionStates != null)
                                                    {
                                                        @foreach (var item in Model.List_Menu_OptionStates)
                                                        {
                                                            if (item.ID == Model.Menu_OptionStateID)
                                                            {
                                                                <option selected value="@item.ID">@item.DisplayName</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.ID">@item.DisplayName</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                                <span asp-validation-for="Menu_OptionStateID" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="ImageFile" class="control-label"></label>
                                        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" id="dishImageFile" />
                                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                                        <div id="imagePreviewWrapper" style="display:none; margin-top:8px;">
                                            <img id="imagePreview" class="preview-image" alt="Превью изображения" />
                                            <div><small class="text-muted">Изображение из старой БД будет использовано, если не выбрать новый файл</small></div>
                                        </div>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="Flag_AllowColors" id="dishFlagAllowColors" />
                                        <label class="form-check-label" asp-for="Flag_AllowColors"></label>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="Flag_Bonus" id="dishFlagBonus" />
                                        <label class="form-check-label" asp-for="Flag_Bonus"></label>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Bonuses" class="control-label"></label>
                                        <input asp-for="Bonuses" class="form-control" type="number" step="0.01" id="dishBonusesInput" />
                                        <span asp-validation-for="Bonuses" class="text-danger"></span>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="FlagNew" id="dishFlagNew" />
                                        <label class="form-check-label" asp-for="FlagNew"></label>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="New_DateFrom" class="control-label"></label>
                                        <input asp-for="New_DateFrom" class="form-control" type="date" id="dishNewDateFrom" />
                                        <span asp-validation-for="New_DateFrom" class="text-danger"></span>
                                    </div>

                                    <div class="form-group form-check">
                                        <input class="form-check-input" asp-for="FlagNoActive" id="dishFlagNoActive" />
                                        <label class="form-check-label" asp-for="FlagNoActive"></label>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="RecommendDishIDs" class="control-label"></label>
                                        <input asp-for="RecommendDishIDs" class="form-control" HIDEholder="например: 1;2;3" />
                                        <span asp-validation-for="RecommendDishIDs" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Объемы -->
                            <div class="row">
                                <div class="col-md-12">
                                    <h5 class="mt-3">Объемы</h5>
                                    <hr />
                                </div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var volField = typeof(Model_Menu_Dish_AddEdit).GetProperty($"Vol{i}");
                                    var priceField = typeof(Model_Menu_Dish_AddEdit).GetProperty($"Vol{i}_Price");

                                    if (volField != null && priceField != null)
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Объем @i (мл)</label>
                                                <input asp-for="@volField.Name" class="form-control" type="number" id="dishVol@(i)" />
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Цена @i</label>
                                                <input asp-for="@priceField.Name" class="form-control" type="number" id="dishVol@(i)_Price" />
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- ===== ИНГРЕДИЕНТЫ С ГРУППИРОВКОЙ ===== -->
                            <div class="row">
                                <div class="col-md-12">
                                    <h5 class="mt-3">Ингредиенты</h5>
                                    <hr />

                                    @if (Model.IngredientGroups != null && Model.IngredientGroups.Count > 0)
                                    {
                                        <div class="mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="expandAllGroups()">
                                                <i class="fas fa-expand"></i> Развернуть все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="collapseAllGroups()">
                                                <i class="fas fa-compress"></i> Свернуть все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="selectAllIngredients()">
                                                <i class="fas fa-check-double"></i> Выбрать все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deselectAllIngredients()">
                                                <i class="fas fa-times"></i> Снять все
                                            </button>
                                        </div>

                                        <div id="ingredientsContainer">
                                            @foreach (var group in Model.IngredientGroups)
                                            {
                                                <div class="ingredient-group" data-group-id="@group.GroupId">
                                                    <div class="group-header" onclick="toggleGroup(@group.GroupId)">
                                                        <span class="group-name">
                                                            <i class="fas fa-chevron-right toggle-icon" id="icon_@group.GroupId"></i>
                                                            @group.GroupName
                                                            <span class="badge badge-secondary">@group.Ingredients.Count</span>
                                                        </span>
                                                        <div class="group-actions">
                                                            @if (group.IsSelectable)
                                                            {
                                                                <span class="badge badge-warning">На выбор одна</span>
                                                            }
                                                            <button type="button" class="btn-select-all" onclick="toggleGroupSelection(@group.GroupId, event)">
                                                                Выбрать все
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="group-body" id="group_@group.GroupId">
                                                        @foreach (var ingredient in group.Ingredients)
                                                        {
                                                            <div class="form-check">
                                                                <input class="form-check-input ingredient-checkbox"
                                                                       type="checkbox"
                                                                       name="SelectedIngredientIDs"
                                                                       value="@ingredient.Id"
                                                                       id="ing_@ingredient.Id"
                                                                       data-group="@group.GroupId"
                                                                @(ingredient.IsChecked ? "checked" : "")
                                                                @(group.IsSelectable ? "onclick=\"handleSingleSelect(this, @group.GroupId)\"" : "") />
                                                                <label class="form-check-label" for="ing_@ingredient.Id">
                                                                    @ingredient.Name
                                                                    @if (ingredient.Price.HasValue)
                                                                    {
                                                                        <span class="ingredient-price">@ingredient.Price.Value.ToString("N0")</span>
                                                                    }
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <input type="hidden" id="SelectedIngredientIDs_Hidden" name="SelectedIngredientIDs" value="" />
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle"></i> Нет доступных ингредиентов.
                                            <a asp-action="AllIngredients">Создайте ингредиенты</a> и добавьте их в группы.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Добавить
                                </button>
                                <a asp-action="DishList" asp-route-Menu_SubcategoryID="@Model.Menu_SubcategoryID" class="btn btn-default">Отмена</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Модалка 1: результаты поиска -->
<div class="modal fade" id="oldDishSearchModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-search"></i> Поиск в старой БД</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="oldDishSearchQuery" class="form-control" HIDEholder="Часть наименования блюда..." />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-primary" id="btnOldDishSearchRun">
                            <i class="fas fa-search"></i> Искать
                        </button>
                    </div>
                </div>
                <div id="oldDishSearchResults" style="max-height: 400px; overflow-y: auto; min-height: 100px;">
                    <div class="old-dish-empty">
                        <i class="fas fa-info-circle"></i> Введите часть наименования и нажмите «Искать»
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модалка 2: предпросмотр -->
<div class="modal fade" id="oldDishPreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-clipboard-check"></i> Что будет заполнено</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" id="oldDishPreviewBody">
                <div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Загрузка...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-success" id="btnApplyOldDish">
                    <i class="fas fa-check"></i> Применить
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // ==========================================
        // ===== УПРАВЛЕНИЕ ГРУППАМИ (существующее) =====
        // ==========================================

        function toggleGroup(groupId) {
            var body = document.getElementById('group_' + groupId);
            var icon = document.getElementById('icon_' + groupId);

            if (body) {
                body.classList.toggle('show');
                if (icon) {
                    icon.classList.toggle('rotated');
                }
            }
        }

        function expandAllGroups() {
            document.querySelectorAll('.group-body').forEach(function (el) { el.classList.add('show'); });
            document.querySelectorAll('.toggle-icon').forEach(function (el) { el.classList.add('rotated'); });
        }

        function collapseAllGroups() {
            document.querySelectorAll('.group-body').forEach(function (el) { el.classList.remove('show'); });
            document.querySelectorAll('.toggle-icon').forEach(function (el) { el.classList.remove('rotated'); });
        }

        function toggleGroupSelection(groupId, event) {
            if (event) event.stopPropagation();

            var checkboxes = document.querySelectorAll('.ingredient-checkbox[data-group="' + groupId + '"]');
            var allChecked = true;

            checkboxes.forEach(function (cb) { if (!cb.checked) allChecked = false; });
            checkboxes.forEach(function (cb) { cb.checked = !allChecked; });

            updateGroupSelectButton(groupId);
            updateSelectedIngredients();
        }

        function handleSingleSelect(checkbox, groupId) {
            var group = document.querySelector('.ingredient-group[data-group-id="' + groupId + '"]');
            var isSelectable = group ? group.querySelector('.badge-warning') !== null : false;

            if (isSelectable && checkbox.checked) {
                document.querySelectorAll('.ingredient-checkbox[data-group="' + groupId + '"]').forEach(function (cb) {
                    if (cb !== checkbox) cb.checked = false;
                });
            }

            updateGroupSelectButton(groupId);
            updateSelectedIngredients();
        }

        function updateGroupSelectButton(groupId) {
            var checkboxes = document.querySelectorAll('.ingredient-checkbox[data-group="' + groupId + '"]');
            var checkedCount = 0;
            checkboxes.forEach(function (cb) { if (cb.checked) checkedCount++; });

            var group = document.querySelector('.ingredient-group[data-group-id="' + groupId + '"]');
            if (group) {
                var btn = group.querySelector('.btn-select-all');
                if (btn) {
                    if (checkedCount === checkboxes.length && checkboxes.length > 0) {
                        btn.classList.add('selected');
                        btn.textContent = 'Снять все';
                    } else {
                        btn.classList.remove('selected');
                        btn.textContent = 'Выбрать все';
                    }
                }
            }
        }

        function selectAllIngredients() {
            document.querySelectorAll('.ingredient-checkbox').forEach(function (cb) { cb.checked = true; });
            document.querySelectorAll('.ingredient-group').forEach(function (g) {
                var gid = g.getAttribute('data-group-id');
                if (gid) updateGroupSelectButton(parseInt(gid));
            });
            updateSelectedIngredients();
        }

        function deselectAllIngredients() {
            document.querySelectorAll('.ingredient-checkbox').forEach(function (cb) { cb.checked = false; });
            document.querySelectorAll('.ingredient-group').forEach(function (g) {
                var gid = g.getAttribute('data-group-id');
                if (gid) updateGroupSelectButton(parseInt(gid));
            });
            updateSelectedIngredients();
        }

        function updateSelectedIngredients() {
            var ids = [];
            document.querySelectorAll('.ingredient-checkbox:checked').forEach(function (cb) { ids.push(cb.value); });
            var hidden = document.getElementById('SelectedIngredientIDs_Hidden');
            if (hidden) hidden.value = ids.join(',');
        }

        // ==========================================
        // ===== ПОИСК В СТАРОЙ БД =====
        // ==========================================

        var _oldDishSelectedId = null;
        var _oldDishDetails = null;

        function showOldDishSearchModal() {
            // Предзаполняем поисковый запрос из поля Name
            var nameVal = document.getElementById('dishNameInput').value || '';
            document.getElementById('oldDishSearchQuery').value = nameVal;

            // Очищаем результаты
            document.getElementById('oldDishSearchResults').innerHTML =
                '<div class="old-dish-empty"><i class="fas fa-info-circle"></i> Введите часть наименования и нажмите «Искать»</div>';

            $('#oldDishSearchModal').modal('show');

            if (nameVal.trim().length > 0) {
                runOldDishSearch();
            }
        }

        function runOldDishSearch() {
            var query = document.getElementById('oldDishSearchQuery').value || '';
            var results = document.getElementById('oldDishSearchResults');

            if (query.trim().length < 2) {
                results.innerHTML = '<div class="old-dish-empty"><i class="fas fa-info-circle"></i> Введите хотя бы 2 символа</div>';
                return;
            }

            results.innerHTML = '<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Поиск...</div>';

            fetch('/DishSearch/Search?query=' + encodeURIComponent(query) + '&limit=30')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data || data.length === 0) {
                        results.innerHTML = '<div class="old-dish-empty"><i class="fas fa-search"></i> Ничего не найдено</div>';
                        return;
                    }
                    renderOldDishResults(data);
                })
                .catch(function (err) {
                    results.innerHTML = '<div class="old-dish-empty text-danger"><i class="fas fa-exclamation-triangle"></i> Ошибка: ' + err.message + '</div>';
                });
        }

        function renderOldDishResults(items) {
            var container = document.getElementById('oldDishSearchResults');
            container.innerHTML = '';

            items.forEach(function (item) {
                var div = document.createElement('div');
                div.className = 'old-dish-result-item';
                div.setAttribute('data-id', item.id);

                var imgHtml = item.hasImage
                    ? '<i class="fas fa-image"></i>'
                    : '<i class="fas fa-utensils"></i>';

                div.innerHTML =
                    '<div class="result-img">' + imgHtml + '</div>' +
                    '<div class="result-main">' +
                        '<div class="result-name">' + escapeHtml(item.name || '(без названия)') + '</div>' +
                        '<div class="result-meta">' +
                            'ID: ' + item.id +
                            (item.categoryName ? ' • ' + escapeHtml(item.categoryName) : '') +
                            (item.teaser ? ' • ' + escapeHtml(item.teaser) : '') +
                        '</div>' +
                    '</div>' +
                    '<div class="result-price">' + (item.price != null ? item.price + ' ₽' : '') + '</div>';

                div.addEventListener('click', function () { loadOldDishDetails(item.id); });

                container.appendChild(div);
            });
        }

        function loadOldDishDetails(id) {
            _oldDishSelectedId = id;

            // Переходим к модалке предпросмотра
            $('#oldDishSearchModal').modal('hide');
            document.getElementById('oldDishPreviewBody').innerHTML =
                '<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Загрузка...</div>';
            $('#oldDishPreviewModal').modal('show');

            fetch('/DishSearch/Details?id=' + id)
                .then(function (r) { return r.json(); })
                .then(function (resp) {
                    if (!resp || !resp.success) {
                        document.getElementById('oldDishPreviewBody').innerHTML =
                            '<div class="alert alert-danger mb-0">Ошибка: ' + escapeHtml(resp && resp.message ? resp.message : 'не удалось загрузить') + '</div>';
                        return;
                    }
                    _oldDishDetails = resp.data;
                    renderOldDishPreview(resp.data);
                })
                .catch(function (err) {
                    document.getElementById('oldDishPreviewBody').innerHTML =
                        '<div class="alert alert-danger mb-0">Ошибка: ' + escapeHtml(err.message) + '</div>';
                });
        }

        function renderOldDishPreview(d) {
            var html = '<table class="preview-table">';

            function row(label, value, isFlag) {
                var display;
                if (isFlag) {
                    display = value ? '<span class="text-success"><i class="fas fa-check"></i> Да</span>'
                                    : '<span class="text-muted"><i class="fas fa-minus"></i> Нет</span>';
                } else {
                    display = (value === null || value === undefined || value === '')
                        ? '<span class="preview-empty">— пусто —</span>'
                        : escapeHtml(String(value));
                }
                html += '<tr><th>' + label + '</th><td>' + display + '</td></tr>';
            }

            row('Наименование', d.name);
            row('Краткое описание', d.teaser);
            row('Полное описание', d.text);
            row('Стоимость', d.price != null ? d.price + ' ₽' : null);
            row('Время приготовления', d.cookingMinutes != null ? d.cookingMinutes + ' мин' : null);
            row('Разрешить цвета', d.flagAllowColors, true);
            row('Можно за бонусы', d.flagBonus, true);
            row('Бонусы', d.bonuses);
            row('Новинка', d.flagNew, true);
            row('Отключить отображение', d.flagNoActive, true);
            row('Новинка до', d.newDateFrom ? formatDate(d.newDateFrom) : null);

            if (d.volumes && d.volumes.length > 0) {
                d.volumes.forEach(function (v, idx) {
                    var label = 'Объём ' + (idx + 1);
                    var val = (v.volume != null ? v.volume + ' мл' : '—') +
                              ' / ' + (v.price != null ? v.price + ' ₽' : '—');
                    html += '<tr><th>' + label + '</th><td>' + escapeHtml(val) + '</td></tr>';
                });
            } else {
                html += '<tr><th>Объёмы</th><td><span class="preview-empty">— не найдены —</span></td></tr>';
            }

            // Картинка
            if (d.imageBase64) {
                html += '<tr><th>Изображение</th><td><img src="data:image/jpeg;base64,' + d.imageBase64 + '" class="preview-image" /></td></tr>';
            } else {
                html += '<tr><th>Изображение</th><td><span class="preview-empty">— нет —</span></td></tr>';
            }

            html += '</table>';

            document.getElementById('oldDishPreviewBody').innerHTML = html;
        }

        function formatDate(iso) {
            try {
                var dt = new Date(iso);
                if (isNaN(dt.getTime())) return iso;
                var dd = String(dt.getDate()).padStart(2, '0');
                var mm = String(dt.getMonth() + 1).padStart(2, '0');
                var yyyy = dt.getFullYear();
                return dd + '.' + mm + '.' + yyyy;
            } catch (e) { return iso; }
        }

        function applyOldDish() {
            var d = _oldDishDetails;
            if (!d) return;

            // Текстовые поля
            setVal('dishNameInput', d.name);
            setVal('dishTeaserInput', d.teaser);
            setVal('dishTextInput', d.text);
            setVal('dishPriceInput', d.price);
            setVal('dishCookingInput', d.cookingMinutes);
            setVal('dishBonusesInput', d.bonuses);

            // Флаги
            setCheck('dishFlagAllowColors', d.flagAllowColors);
            setCheck('dishFlagBonus', d.flagBonus);
            setCheck('dishFlagNew', d.flagNew);
            setCheck('dishFlagNoActive', d.flagNoActive);

            // Дата
            if (d.newDateFrom) {
                document.getElementById('dishNewDateFrom').value = toDateInputValue(d.newDateFrom);
            }

            // Объёмы
            for (var i = 1; i <= 5; i++) {
                setVal('dishVol' + i, null);
                setVal('dishVol' + i + '_Price', null);
            }
            if (d.volumes && d.volumes.length > 0) {
                d.volumes.forEach(function (v) {
                    setVal('dishVol' + v.slot, v.volume);
                    setVal('dishVol' + v.slot + '_Price', v.price);
                });
            }

            // Картинка
            if (d.imageBase64) {
                document.getElementById('ImageBase64_Hidden').value = d.imageBase64;
                var wrapper = document.getElementById('imagePreviewWrapper');
                var img = document.getElementById('imagePreview');
                img.src = 'data:image/jpeg;base64,' + d.imageBase64;
                wrapper.style.display = 'block';
            }

            // Обновляем скрытое поле выбранных ингредиентов
            updateSelectedIngredients();

            $('#oldDishPreviewModal').modal('hide');

            // Небольшая вспышка подсветки полей
            flashForm();
        }

        function setVal(id, value) {
            var el = document.getElementById(id);
            if (!el) return;
            el.value = (value === null || value === undefined) ? '' : value;
        }

        function setCheck(id, value) {
            var el = document.getElementById(id);
            if (!el) return;
            el.checked = !!value;
        }

        function toDateInputValue(iso) {
            try {
                var dt = new Date(iso);
                if (isNaN(dt.getTime())) return '';
                var dd = String(dt.getDate()).padStart(2, '0');
                var mm = String(dt.getMonth() + 1).padStart(2, '0');
                var yyyy = dt.getFullYear();
                return yyyy + '-' + mm + '-' + dd;
            } catch (e) { return ''; }
        }

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .reHIDE(/&/g, '&amp;')
                .reHIDE(/</g, '&lt;')
                .reHIDE(/>/g, '&gt;')
                .reHIDE(/"/g, '&quot;')
                .reHIDE(/'/g, '&#39;');
        }

        function flashForm() {
            var form = document.getElementById('dishAddForm');
            form.classList.add('border', 'border-success');
            setTimeout(function () { form.classList.remove('border', 'border-success'); }, 1500);
        }

        // ==========================================
        // ===== ИНИЦИАЛИЗАЦИЯ =====
        // ==========================================

        $(document).ready(function () {
            // Разворачиваем первую группу ингредиентов
            var firstGroup = document.querySelector('.ingredient-group');
            if (firstGroup) {
                var fgid = firstGroup.getAttribute('data-group-id');
                if (fgid) toggleGroup(parseInt(fgid));
            }

            // Обновляем состояние кнопок групп
            document.querySelectorAll('.ingredient-group').forEach(function (g) {
                var gid = g.getAttribute('data-group-id');
                if (gid) updateGroupSelectButton(parseInt(gid));
            });

            // Обработчики чекбоксов
            document.querySelectorAll('.ingredient-checkbox').forEach(function (cb) {
                cb.addEventListener('change', function () {
                    var gid = this.getAttribute('data-group');
                    if (gid) {
                        updateGroupSelectButton(parseInt(gid));
                        updateSelectedIngredients();
                    }
                });
            });

            updateSelectedIngredients();

            // ===== Поиск в старой БД =====

            document.getElementById('btnSearchOldDish').addEventListener('click', showOldDishSearchModal);
            document.getElementById('btnOldDishSearchRun').addEventListener('click', runOldDishSearch);
            document.getElementById('btnApplyOldDish').addEventListener('click', applyOldDish);

            // Enter в поиске запускает поиск
            document.getElementById('oldDishSearchQuery').addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    runOldDishSearch();
                }
            });

            // Если пользователь выбрал файл — сбрасываем ImageBase64 из старой БД
            var imgFileInput = document.getElementById('dishImageFile');
            if (imgFileInput) {
                imgFileInput.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        document.getElementById('ImageBase64_Hidden').value = '';
                        document.getElementById('imagePreviewWrapper').style.display = 'none';
                    }
                });
            }
        });
    </script>
}