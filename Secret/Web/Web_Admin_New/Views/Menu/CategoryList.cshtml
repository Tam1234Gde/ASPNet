@* Страница списка категорий конкретного меню с массовыми операциями и drag-and-drop сортировкой. *@
@using System.Linq
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Category_List
@{
    ViewData["Title"] = "Категории меню";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = $"Категории меню - {Model.MenuName}";
    ViewBag.RazdelNameMobile = "Категории";
    bool showDeleted = ViewBag.ShowDeleted ?? false;
}

<style>
    .checkbox-select-all { width: 18px; height: 18px; cursor: pointer; }
    .checkbox-item { width: 18px; height: 18px; cursor: pointer; }

    .bulk-actions {
        display: none;
        background: #e3f2fd;
        border: 2px solid #2196F3;
        border-radius: 8px;
        padding: 10px 15px;
        margin-bottom: 15px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .bulk-actions.show { display: flex; }
    .bulk-actions .count { font-weight: 600; color: #1976D2; }
    .bulk-actions .btn-bulk-copy {
        background: #2196F3; color: #fff; border: none;
        padding: 8px 20px; border-radius: 5px; cursor: pointer;
        transition: all 0.3s ease;
    }
    .bulk-actions .btn-bulk-copy:hover { background: #1976D2; transform: scale(1.05); }
    .bulk-actions .btn-bulk-clear {
        background: #6c757d; color: #fff; border: none;
        padding: 8px 15px; border-radius: 5px; cursor: pointer;
        transition: all 0.3s ease; margin-left: 10px;
    }
    .bulk-actions .btn-bulk-clear:hover { background: #5a6268; }

    .table tbody tr.selected { background-color: #e3f2fd !important; }
    .table-hover tbody tr:hover { background-color: rgba(33, 150, 243, 0.05); cursor: pointer; }

    /* ==== SORT MODE ==== */
    .sort-mode-container {
        display: none;
        background: #fff8e1;
        border: 2px solid #ffc107;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 15px;
    }
    .sort-mode-container.active { display: block; }
    .sort-mode-container h5 {
        margin: 0 0 10px 0;
        color: #856404;
    }
    .sort-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .sort-list-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 15px;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        margin-bottom: 8px;
        cursor: grab;
        user-select: none;
        transition: all 0.15s ease;
    }
    .sort-list-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .sort-list-item.dragging {
        opacity: 0.4;
        background: #e3f2fd;
        border: 2px dashed #2196F3;
    }
    .sort-list-item.drag-over {
        border-top: 3px solid #2196F3;
    }
    .sort-list-item .drag-handle {
        color: #6c757d;
        font-size: 18px;
        cursor: grab;
    }
    .sort-list-item .order-badge {
        background: #17a2b8;
        color: #fff;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
        min-width: 30px;
        text-align: center;
    }
    .sort-list-item .item-name { flex: 1; font-weight: 500; }

    .sort-mode-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6"><h3 class="card-title">Список категорий</h3></div>
                            <div class="col-md-6 text-right">
                                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-reply"></i> Назад</a>
                                <a asp-action="CategoryAdd" asp-route-MenuID="@Model.MenuID" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить</a>
                                <button type="button" class="btn btn-warning" id="btnSortMode">
                                    <i class="fas fa-arrows-alt"></i> Настроить порядок
                                </button>
                                <a href="@Url.Action("CategoryList", new { MenuID = Model.MenuID, showDeleted = !showDeleted })"
                                   class="btn @(showDeleted ? "btn-warning" : "btn-outline-secondary")">
                                    @(showDeleted ? "Скрыть удалённые" : "Показать удалённые")
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show">
                                <i class="fas fa-check-circle"></i> @TempData["Success"]
                                <button type="button" class="close" data-dismiss="alert">&times;</button>
                            </div>
                        }

                        <!-- ============ SORT MODE ============ -->
                        <div class="sort-mode-container" id="sortModeContainer">
                            <h5><i class="fas fa-arrows-alt"></i> Перетащите категории в нужном порядке</h5>
                            <p class="text-muted small">
                                Зажмите элемент и перетащите его выше или ниже.
                                Порядок сохранится после нажатия «Сохранить порядок».
                            </p>

                            <ul class="sort-list" id="sortList">
                                @{
                                    var orderedCategories = Model.List_Menu_Categories
                                        .OrderBy(x => x.OrderNum == 0 ? int.MaxValue : x.OrderNum)
                                        .ThenBy(x => x.Name)
                                        .ToList();
                                }
                                @foreach (var item in orderedCategories)
                                {
                                    <li class="sort-list-item" draggable="true" data-id="@item.ID">
                                        <span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
                                        <span class="order-badge">@item.OrderNum</span>
                                        <span class="item-name">@item.Name</span>
                                        <span class="text-muted small">ID: @item.ID</span>
                                    </li>
                                }
                            </ul>

                            <div class="sort-mode-actions">
                                <button type="button" class="btn btn-success" id="btnSaveOrder">
                                    <i class="fas fa-save"></i> Сохранить порядок
                                </button>
                                <button type="button" class="btn btn-secondary" id="btnCancelSort">
                                    <i class="fas fa-times"></i> Отмена
                                </button>
                                <span class="ml-auto text-muted small" id="sortModeInfo">
                                    Позиция обновится: 10, 20, 30...
                                </span>
                            </div>
                        </div>

                        <!-- ============ NORMAL TABLE ============ -->
                        <div id="normalTableWrapper">
                            <!-- Секция вставки -->
                            <div class="paste-section" id="pasteSection" onclick="pasteCategories()">
                                <div style="display:flex; align-items:center; flex-wrap:wrap; gap:10px;">
                                    <i class="fas fa-clipboard paste-icon" id="pasteIcon"></i>
                                    <span id="pasteText" style="font-weight: 500;"><i class="fas fa-info-circle"></i> Вставьте скопированные категории (Ctrl+V)</span>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                    <span id="clipboardStatus" class="badge badge-secondary"><i class="fas fa-circle" style="font-size:8px;color:#6c757d;"></i> Буфер пуст</span>
                                    <span id="clipboardCount" class="badge badge-secondary" style="display:none;"><i class="fas fa-folder-open"></i> <span id="copiedCount">0</span> категорий</span>
                                </div>
                            </div>

                            <!-- Панель массовых действий -->
                            <div class="bulk-actions" id="bulkActions">
                                <div><i class="fas fa-check-circle" style="color:#2196F3;"></i> Выбрано: <span class="count" id="selectedCount">0</span> категорий</div>
                                <div>
                                    <button class="btn-bulk-copy" id="btnBulkCopy" onclick="copySelectedCategoriesToClipboard()"><i class="fas fa-copy"></i> Копировать в буфер</button>
                                    <button class="btn-bulk-clear" onclick="clearAllSelections()"><i class="fas fa-times"></i> Очистить</button>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="HIDE-categories" class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width:40px;"><input type="checkbox" class="checkbox-select-all" id="selectAll" onchange="toggleAllCheckboxes()" /></th>
                                            <th style="width:50px;">ID</th>
                                            <th style="width:80px;">Порядок</th>
                                            <th style="width:300px;">Наименование</th>
                                            <th style="min-width:200px;">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.List_Menu_Categories != null && Model.List_Menu_Categories.Count > 0)
                                        {
                                            @foreach (var item in Model.List_Menu_Categories)
                                            {
                                                <tr class="@(showDeleted ? "table-secondary" : "")">
                                                    <td><input type="checkbox" class="checkbox-item" data-id="@item.ID" onchange="updateBulkActions()" /></td>
                                                    <td>@item.ID</td>
                                                    <td>@item.OrderNum</td>
                                                    <td>@item.Name</td>
                                                    <td>
                                                        @if (showDeleted)
                                                        {
                                                            <button class="btn btn-success btn-sm restore-btn" data-id="@item.ID" data-type="Category">
                                                                <i class="fas fa-undo"></i> Восстановить
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <div class="btn-group" role="group">
                                                                <button type="button" class="btn btn-outline-info btn-sm btn-copy" onclick="copySingleCategory(@item.ID, '@item.Name.ReHIDE("'", "\\'")')" title="Копировать в буфер"><i class="fas fa-copy"></i></button>
                                                                <a asp-action="SubcategoryList" asp-route-Menu_CategoryID="@item.ID" class="btn btn-outline-info btn-sm" title="Подкатегории"><i class="fas fa-list"></i></a>
                                                                <a asp-action="CategoryEdit" asp-route-ID="@item.ID" class="btn btn-outline-warning btn-sm" title="Редактировать"><i class="fas fa-edit"></i></a>
                                                                <a asp-action="CategoryDel" asp-route-ID="@item.ID" class="btn btn-outline-danger btn-sm" title="Удалить"><i class="fas fa-trash"></i></a>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="5" class="text-center">Записей не обнаружено</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Модальное окно копирования категории -->
<div class="modal fade" id="copyCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-copy"></i> Копирование категории</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Выберите режим копирования:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="copyModeCategory" id="copyWithContentCategory" value="with" checked>
                        <label class="form-check-label" for="copyWithContentCategory">
                            <i class="fas fa-copy text-success"></i> Копировать с содержимым
                            <br /><small class="text-muted">Будут скопированы все подкатегории и блюда</small>
                        </label>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="radio" name="copyModeCategory" id="copyWithoutContentCategory" value="without">
                        <label class="form-check-label" for="copyWithoutContentCategory">
                            <i class="fas fa-file text-warning"></i> Копировать без содержимого
                            <br /><small class="text-muted">Будет скопирована только категория</small>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="confirmCopyCategory"><i class="fas fa-copy"></i> Копировать</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        // ==========================================
        // ===== ПЕРЕМЕННЫЕ =====
        // ==========================================
        var copiedCategories = [];
        var selectedCategories = [];
        var pendingCategoryIds = [];
        var sortModeActive = false;

        // ==========================================
        // ===== SORT MODE (DRAG AND DROP) =====
        // ==========================================
        (function initSortMode() {
            var btnSortMode = document.getElementById('btnSortMode');
            var btnSaveOrder = document.getElementById('btnSaveOrder');
            var btnCancelSort = document.getElementById('btnCancelSort');
            var sortContainer = document.getElementById('sortModeContainer');
            var normalTable = document.getElementById('normalTableWrapper');
            var sortList = document.getElementById('sortList');

            if (!btnSortMode || !sortContainer) return;

            // === Включить режим сортировки ===
            btnSortMode.addEventListener('click', function () {
                sortModeActive = true;
                sortContainer.classList.add('active');
                normalTable.style.display = 'none';
                updateOrderBadges();
            });

            // === Отключить режим сортировки ===
            function disableSortMode() {
                sortModeActive = false;
                sortContainer.classList.remove('active');
                normalTable.style.display = 'block';
            }

            btnCancelSort.addEventListener('click', disableSortMode);

            // === Обновление счётчиков порядка ===
            function updateOrderBadges() {
                var items = sortList.querySelectorAll('.sort-list-item');
                var order = 10;
                items.forEach(function (item) {
                    var badge = item.querySelector('.order-badge');
                    if (badge) badge.textContent = order;
                    order += 10;
                });
            }

            // === DRAG AND DROP ===
            var draggedItem = null;

            sortList.addEventListener('dragstart', function (e) {
                var item = e.target.closest('.sort-list-item');
                if (!item) return;
                draggedItem = item;
                item.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', item.getAttribute('data-id'));
            });

            sortList.addEventListener('dragend', function (e) {
                var item = e.target.closest('.sort-list-item');
                if (item) item.classList.remove('dragging');
                sortList.querySelectorAll('.drag-over').forEach(function (el) {
                    el.classList.remove('drag-over');
                });
                draggedItem = null;
                updateOrderBadges();
            });

            sortList.addEventListener('dragover', function (e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';

                var target = e.target.closest('.sort-list-item');
                if (!target || target === draggedItem) return;

                // Убираем старую подсветку
                sortList.querySelectorAll('.drag-over').forEach(function (el) {
                    el.classList.remove('drag-over');
                });
                target.classList.add('drag-over');

                // Вставка: смотрим, ниже или выше мышки
                var rect = target.getBoundingClientRect();
                var offset = e.clientY - rect.top;
                var shouldInsertAfter = offset > rect.height / 2;

                if (shouldInsertAfter) {
                    if (target.nextSibling) {
                        sortList.insertBefore(draggedItem, target.nextSibling);
                    } else {
                        sortList.appendChild(draggedItem);
                    }
                } else {
                    sortList.insertBefore(draggedItem, target);
                }
            });

            sortList.addEventListener('dragleave', function (e) {
                var target = e.target.closest('.sort-list-item');
                if (target) target.classList.remove('drag-over');
            });

            sortList.addEventListener('drop', function (e) {
                e.preventDefault();
                sortList.querySelectorAll('.drag-over').forEach(function (el) {
                    el.classList.remove('drag-over');
                });
                updateOrderBadges();
            });

            // === Сохранить порядок ===
            btnSaveOrder.addEventListener('click', function () {
                var ids = [];
                sortList.querySelectorAll('.sort-list-item').forEach(function (item) {
                    var id = parseInt(item.getAttribute('data-id'));
                    if (!isNaN(id)) ids.push(id);
                });

                if (ids.length === 0) {
                    showToast('Нет элементов для сохранения', 'warning');
                    return;
                }

                // Антифорджери токен
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var headers = { 'Content-Type': 'application/json' };
                if (token) headers['RequestVerificationToken'] = token.value;

                fetch('@Url.Action("ReorderCategories", "Menu")', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ ids: ids })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        showToast('Порядок сохранён (' + data.updated + ' записей)', 'success');
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        showToast('Ошибка: ' + (data.message || 'неизвестно'), 'error');
                    }
                })
                .catch(function (err) {
                    showToast('Ошибка сети: ' + err.message, 'error');
                });
            });
        })();

        // ==========================================
        // ===== УВЕДОМЛЕНИЯ =====
        // ==========================================
        function showToast(message, type, duration) {
            type = type || 'success';
            duration = duration || 3000;
            var icons = { success: '✅', error: '❌', info: 'ℹ️', warning: '⚠️' };
            var bg = {
                success: 'linear-gradient(135deg,#28a745,#20c997)',
                error: 'linear-gradient(135deg,#dc3545,#e74c3c)',
                info: 'linear-gradient(135deg,#17a2b8,#0dcaf0)',
                warning: 'linear-gradient(135deg,#ffc107,#fd7e14)'
            };
            var toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;top:20px;right:20px;padding:15px 25px;border-radius:8px;color:#fff;font-weight:500;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2);min-width:300px;max-width:500px;background:' + bg[type];
            toast.innerHTML = '<span>' + (icons[type] || 'ℹ️') + '</span> ' + message;
            document.body.appendChild(toast);
            setTimeout(function () { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.5s'; }, duration);
            setTimeout(function () { toast.remove(); }, duration + 500);
        }

        // ==========================================
        // ===== КОПИРОВАНИЕ (сохранены прежние функции) =====
        // ==========================================
        function copySingleCategory(id, name) {
            pendingCategoryIds = [id];
            document.getElementById('selectedCountCategoryModal').textContent = '1 (' + name + ')';
            $('#copyCategoryModal').modal('show');
        }

        function copySelectedCategoriesToClipboard() {
            if (selectedCategories.length === 0) {
                showToast('Не выбрано ни одной категории!', 'warning');
                return;
            }
            pendingCategoryIds = selectedCategories.slice(0);
            $('#copyCategoryModal').modal('show');
        }

        $('#confirmCopyCategory').on('click', function () {
            var copyMode = document.querySelector('input[name="copyModeCategory"]:checked').value;
            var withContent = (copyMode === 'with');
            $('#copyCategoryModal').modal('hide');

            var categoriesToCopy = [];
            var existingIds = new Set(copiedCategories.map(function (c) { return c.id; }));

            pendingCategoryIds.forEach(function (id) {
                if (!existingIds.has(id)) {
                    var row = document.querySelector('tr[data-category-id="' + id + '"]');
                    var name = row ? row.getAttribute('data-category-name') : 'Категория #' + id;
                    categoriesToCopy.push({ id: id, name: name, withContent: withContent });
                }
            });

            if (categoriesToCopy.length === 0) {
                showToast('Все выбранные категории уже скопированы!', 'warning');
                return;
            }

            copiedCategories = copiedCategories.concat(categoriesToCopy);
            saveCategoriesToClipboard();
            updateCategoryPasteSection();
            showToast('Добавлено ' + categoriesToCopy.length + ' категорий', 'success', 3000);
            clearAllSelections();
            pendingCategoryIds = [];
        });

        // ==========================================
        // ===== ВЫБОР В ТАБЛИЦЕ =====
        // ==========================================
        function toggleAllCheckboxes() {
            var selectAll = document.getElementById('selectAll');
            var checkboxes = document.querySelectorAll('.checkbox-item');
            checkboxes.forEach(function (cb) {
                cb.checked = selectAll.checked;
                var row = cb.closest('tr');
                if (row) {
                    if (cb.checked) row.classList.add('selected'); else row.classList.remove('selected');
                }
            });
            updateBulkActions();
        }

        function updateBulkActions() {
            var checkboxes = document.querySelectorAll('.checkbox-item:checked');
            var count = checkboxes.length;
            document.getElementById('selectedCount').textContent = count;
            var bulkActions = document.getElementById('bulkActions');
            if (count > 0) bulkActions.classList.add('show'); else bulkActions.classList.remove('show');
            selectedCategories = [];
            checkboxes.forEach(function (cb) {
                var id = parseInt(cb.getAttribute('data-id'));
                if (!isNaN(id)) selectedCategories.push(id);
            });
        }

        function clearAllSelections() {
            var selectAll = document.getElementById('selectAll');
            if (selectAll) selectAll.checked = false;
            document.querySelectorAll('.checkbox-item').forEach(function (cb) {
                cb.checked = false;
                var row = cb.closest('tr');
                if (row) row.classList.remove('selected');
            });
            updateBulkActions();
        }

        // ==========================================
        // ===== ВОССТАНОВЛЕНИЕ =====
        // ==========================================
        $(document).on('click', '.restore-btn', function () {
            var id = $(this).data('id');
            var type = $(this).data('type');
            var url = '/Menu/Restore' + type;
            $.post(url, { id: id }, function (data) {
                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(function () { window.location.reload(true); }, 500);
                } else {
                    showToast(data.message, 'error');
                }
            }).fail(function () {
                showToast('Ошибка соединения', 'error');
            });
        });

        // ==========================================
        // ===== ИНИЦИАЛИЗАЦИЯ =====
        // ==========================================
        $(document).ready(function () {
            var table = $('#HIDE-categories').DataTable({
                "paging": true, "lengthChange": true, "searching": true, "ordering": true,
                "info": true, "autoWidth": false, "responsive": true,
                "language": { "url": "/lib/datatables/ru.json" },
                "dom": '<"row"<"col-sm-4"l><"col-sm-4"B><"col-sm-4"f>>' +
                       '<"row"<"col-sm-12"tr>>' +
                       '<"row"<"col-sm-5"i><"col-sm-7"p>>',
                "buttons": [],
                "columnDefs": [{ "orderable": false, "targets": [0, 4] }]
            });

            table.on('draw', function () {
                document.querySelectorAll('.checkbox-item').forEach(function (cb) {
                    var row = cb.closest('tr');
                    if (row) {
                        if (cb.checked) row.classList.add('selected'); else row.classList.remove('selected');
                    }
                });
                updateBulkActions();
            });

            $('#HIDE-categories tbody').on('click', 'tr', function (e) {
                if (e.target.type === 'checkbox' || e.target.closest('.btn-group')) return;
                var cb = $(this).find('.checkbox-item')[0];
                if (cb) {
                    cb.checked = !cb.checked;
                    if (cb.checked) $(this).addClass('selected'); else $(this).removeClass('selected');
                    updateBulkActions();
                }
            });
        });
    </script>
}