@* Страница списка блюд конкретной подкатегории с массовыми операциями. *@
@using System.Linq
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Dish_List
@{
    ViewData["Title"] = "Блюда меню";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = $"Блюда - {Model.SubcategoryName}";
    ViewBag.RazdelNameMobile = "Блюда";
    bool showDeleted = ViewBag.ShowDeleted ?? false;
}

<style>
    .checkbox-select-all {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .checkbox-item {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .bulk-actions {
        display: none;
        background: #e3f2fd;
        border: 2px solid #2196F3;
        border-radius: 8px;
        padding: 10px 15px;
        margin-bottom: 15px;
        align-items: center;
        justify-content: space-between;
        animation: slideDown 0.3s ease;
        flex-wrap: wrap;
        gap: 10px;
    }

        .bulk-actions.show {
            display: flex;
        }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .bulk-actions .count {
        font-weight: 600;
        color: #1976D2;
    }

    .bulk-actions .btn-bulk-copy {
        background: #2196F3;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .bulk-actions .btn-bulk-copy:hover {
            background: #1976D2;
            transform: scale(1.05);
        }

        .bulk-actions .btn-bulk-copy:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

    .bulk-actions .btn-bulk-clear {
        background: #6c757d;
        color: #fff;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-left: 10px;
    }

        .bulk-actions .btn-bulk-clear:hover {
            background: #5a6268;
        }

    .btn-copy {
        transition: all 0.3s ease;
    }

        .btn-copy:hover {
            transform: scale(1.1);
        }

        .btn-copy.copied {
            background-color: #28a745 !important;
            border-color: #28a745 !important;
            color: #fff !important;
        }

            .btn-copy.copied i {
                animation: bounceIn 0.5s ease;
            }

    @@keyframes bounceIn {
        0% {
            transform: scale(0);
        }

        50% {
            transform: scale(1.3);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
        }
    }

    .toast-notification {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 15px 25px;
        border-radius: 8px;
        color: #fff;
        font-weight: 500;
        z-index: 9999;
        transform: translateX(120%);
        transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 300px;
        max-width: 500px;
    }

        .toast-notification.show {
            transform: translateX(0);
        }

        .toast-notification.success {
            background: linear-gradient(135deg, #28a745, #20c997);
        }

        .toast-notification.error {
            background: linear-gradient(135deg, #dc3545, #e74c3c);
        }

        .toast-notification.info {
            background: linear-gradient(135deg, #17a2b8, #0dcaf0);
        }

        .toast-notification.warning {
            background: linear-gradient(135deg, #ffc107, #fd7e14);
        }

        .toast-notification .close-btn {
            cursor: pointer;
            background: none;
            border: none;
            color: #fff;
            font-size: 20px;
        }

    .paste-section {
        background: #f8f9fa;
        border: 2px dashed #6c757d;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.3s ease;
        cursor: pointer;
        flex-wrap: wrap;
        gap: 10px;
    }

        .paste-section:hover {
            border-color: #17a2b8;
            background: #e9ecef;
        }

        .paste-section.has-copied {
            border-color: #28a745;
            background: #d4edda;
        }

        .paste-section .paste-icon {
            font-size: 24px;
            margin-right: 10px;
        }

    .badge-new {
        background: linear-gradient(135deg, #ff6b6b, #ee5a24);
        color: #fff;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    @@keyframes pulse-badge {
        0% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.7;
            transform: scale(0.95);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .table tbody tr.selected {
        background-color: #e3f2fd !important;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(33, 150, 243, 0.05);
        cursor: pointer;
    }

    .table tbody tr.selected td:first-child {
        border-left: 3px solid #2196F3;
    }

    .copied-list {
        max-height: 100px;
        overflow-y: auto;
        font-size: 13px;
        background: #fff;
        border-radius: 4px;
        padding: 5px 10px;
        border: 1px solid #dee2e6;
        margin-top: 5px;
    }

        .copied-list .badge {
            margin: 2px;
        }

    .table-secondary {
        background-color: #f5f5f5;
    }

    .undo-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        background: #f8f9fa;
        border-left: 4px solid #28a745;
        padding: 15px;
        border-radius: 4px;
        box-shadow: 0 0 15px rgba(0,0,0,0.2);
        min-width: 250px;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                                <h3 class="card-title">Список блюд</h3>
                            </div>
                            <div class="col-md-6 text-right">
                                <a asp-action="SubcategoryList" asp-route-Menu_CategoryID="@ViewBag.Menu_CategoryID" class="btn btn-secondary">
                                    <i class="fas fa-reply"></i> Назад
                                </a>
                                <a asp-action="DishAdd" asp-route-Menu_SubcategoryID="@Model.Menu_SubcategoryID" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Добавить
                                </a>
                                <a href="@Url.Action("DishList", new { Menu_SubcategoryID = Model.Menu_SubcategoryID, showDeleted = !showDeleted })"
                                   class="btn @(showDeleted ? "btn-warning" : "btn-outline-secondary")">
                                    @(showDeleted ? "Скрыть удалённые" : "Показать удалённые")
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Секция вставки -->
                        <div class="paste-section" id="pasteSection" onclick="pasteDishes()">
                            <div style="display:flex; align-items:center; flex-wrap:wrap; gap:10px;">
                                <i class="fas fa-clipboard paste-icon" id="pasteIcon"></i>
                                <span id="pasteText" style="font-weight: 500;">
                                    <i class="fas fa-info-circle"></i> Вставьте скопированные блюда (Ctrl+V)
                                </span>
                            </div>
                            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                <span id="clipboardStatus" class="badge badge-secondary">
                                    <i class="fas fa-circle" style="font-size: 8px; color: #6c757d;"></i> Буфер пуст
                                </span>
                                <span id="clipboardCount" class="badge badge-secondary" style="display:none;">
                                    <i class="fas fa-utensils"></i> <span id="copiedCount">0</span> блюд
                                </span>
                            </div>
                        </div>

                        <div id="copiedDishesPreview" style="display:none; margin-bottom:15px;">
                            <div class="copied-list" id="copiedListContainer"></div>
                        </div>

                        <!-- Панель массовых действий -->
                        <div class="bulk-actions" id="bulkActions">
                            <div>
                                <i class="fas fa-check-circle" style="color: #2196F3;"></i>
                                Выбрано: <span class="count" id="selectedCount">0</span> блюд
                            </div>
                            <div>
                                <button class="btn-bulk-copy" id="btnBulkCopy" onclick="copySelectedToClipboard()">
                                    <i class="fas fa-copy"></i> Копировать в буфер
                                </button>
                                <button class="btn-bulk-clear" onclick="clearAllSelections()">
                                    <i class="fas fa-times"></i> Очистить
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="HIDE-dishes" class="table table-bordered table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;">
                                            <input type="checkbox" class="checkbox-select-all" id="selectAll" onchange="toggleAllCheckboxes()" />
                                        </th>
                                        <th style="width: 50px;">ID</th>
                                        <th style="width: 200px;">Наименование</th>
                                        <th style="width: 100px;">Цена</th>
                                        <th style="width: 80px;">Порядок</th>
                                        <th style="width: 100px;">Состояние</th>
                                        <th style="width: 120px;">Новинка</th>
                                        <th style="width: 130px;">Действует до</th>
                                        <th style="min-width: 200px;">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.List_Menu_Dishes != null && Model.List_Menu_Dishes.Count > 0)
                                    {
                                        @foreach (var item in Model.List_Menu_Dishes)
                                        {
                                            <tr class="@(showDeleted ? "table-secondary" : "")">
                                                <td>
                                                    <input type="checkbox" class="checkbox-item" data-id="@item.ID" onchange="updateBulkActions()" />
                                                </td>
                                                <td>@item.ID</td>
                                                <td>
                                                    @item.Name
                                                    @if (!string.IsNullOrEmpty(item.Teaser))
                                                    {
                                                        <br /><small class="text-muted">@item.Teaser</small>
                                                    }
                                                </td>
                                                <td>@item.Price.ToString("N0")</td>
                                                <td>@item.OrderNum</td>
                                                <td>
                                                    @{
                                                        string stateName = item.Menu_OptionStateID switch
                                                        {
                                                            1 => "Активно",
                                                            2 => "Опционально",
                                                            3 => "Отключено",
                                                            _ => "Неизвестно"
                                                        };
                                                        string stateClass = item.Menu_OptionStateID switch
                                                        {
                                                            1 => "badge-success",
                                                            2 => "badge-warning",
                                                            3 => "badge-danger",
                                                            _ => "badge-secondary"
                                                        };
                                                    }
                                                    <span class="badge @stateClass">@stateName</span>
                                                </td>
                                                <td>
                                                    @if (item.FlagNew)
                                                    {
                                                        <span class="badge badge-new">Новинка</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.FlagNew && item.New_DateFrom.HasValue)
                                                    {
                                                        <span>@item.New_DateFrom.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (showDeleted)
                                                    {
                                                        <button class="btn btn-success btn-sm restore-btn" data-id="@item.ID" data-type="Dish">
                                                            <i class="fas fa-undo"></i> Восстановить
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <div class="btn-group" role="group">
                                                            <button type="button"
                                                                    class="btn btn-outline-info btn-sm btn-copy"
                                                                    onclick="copySingleDish(@item.ID, '@item.Name.ReHIDE("'", "\\'")', @item.Price.ToString().ReHIDE(",", "."))"
                                                                    title="Копировать в буфер">
                                                                <i class="fas fa-copy"></i>
                                                            </button>

                                                            <a asp-action="DishEdit" asp-route-ID="@item.ID"
                                                               class="btn btn-outline-warning btn-sm" title="Редактировать">
                                                                <i class="fas fa-edit"></i>
                                                            </a>

                                                            <a asp-action="DishDel" asp-route-ID="@item.ID"
                                                               class="btn btn-outline-danger btn-sm" title="Удалить">
                                                                <i class="fas fa-trash"></i>
                                                            </a>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center">Записей не обнаружено</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        // ==========================================
        // ===== ПЕРЕМЕННЫЕ =====
        // ==========================================
        var copiedDishes = [];
        var selectedDishes = [];

        // ==========================================
        // ===== УВЕДОМЛЕНИЯ =====
        // ==========================================
        function showToast(message, type, duration) {
            type = type || 'success';
            duration = duration || 3000;
            var icons = { success: '✅', error: '❌', info: 'ℹ️', warning: '⚠️' };
            var toast = document.createElement('div');
            toast.className = 'toast-notification ' + type;
            toast.innerHTML = '<span>' + (icons[type] || 'ℹ️') + '</span><span>' + message + '</span><button class="close-btn" onclick="this.parentElement.remove()">&times;</button>';
            document.body.appendChild(toast);
            setTimeout(function() { toast.classList.add('show'); }, 100);
            setTimeout(function() { toast.classList.remove('show'); setTimeout(function() { toast.remove(); }, 500); }, duration);
        }

        // ==========================================
        // ===== КОПИРОВАНИЕ =====
        // ==========================================
        function copySingleDish(id, name, price) {
            var dishData = { id: id, name: name, price: price };
            copiedDishes = [dishData];
            saveToClipboard();
            var btn = event ? event.target.closest('.btn-copy') : null;
            if (btn) {
                btn.classList.add('copied');
                setTimeout(function() { btn.classList.remove('copied'); }, 1500);
            }
            updatePasteSection();
            showToast('Блюдо "' + name + '" (ID: ' + id + ') скопировано в буфер!', 'success');
        }

        function copySelectedToClipboard() {
            if (selectedDishes.length === 0) {
                showToast('Не выбрано ни одного блюда!', 'warning');
                return;
            }
            var dishesToCopy = [];
            var checkboxes = document.querySelectorAll('.checkbox-item:checked');
            checkboxes.forEach(function(cb) {
                var row = cb.closest('tr');
                if (row) {
                    var id = parseInt(row.getAttribute('data-dish-id'));
                    var name = row.getAttribute('data-dish-name');
                    var priceText = row.querySelector('td:nth-child(4)')?.innerText || '0';
                    var price = parseFloat(priceText.reHIDE(/\s/g, '').reHIDE(',', '.'));
                    if (!isNaN(id) && name) {
                        dishesToCopy.push({ id: id, name: name, price: price || 0 });
                    }
                }
            });
            if (dishesToCopy.length === 0) {
                showToast('Не удалось получить данные о блюдах', 'warning');
                return;
            }
            copiedDishes = dishesToCopy;
            saveToClipboard();
            var count = dishesToCopy.length;
            var names = dishesToCopy.map(d => d.name).join(', ');
            if (names.length > 50) names = names.substring(0, 50) + '...';
            updatePasteSection();
            showToast(count + ' блюд скопировано в буфер: ' + names, 'success', 4000);
            clearAllSelections();
        }

        function saveToClipboard() {
            var text = '=== СКОПИРОВАННЫЕ БЛЮДА ===\nКоличество: ' + copiedDishes.length + '\n----------------------------------------\n';
            copiedDishes.forEach(function(dish, index) {
                text += (index + 1) + '. ID: ' + dish.id + ' | ' + dish.name + ' | Цена: ' + dish.price + '\n';
            });
            text += '----------------------------------------\n';
            try {
                localStorage.setItem('copiedDishes', JSON.stringify({
                    dishes: copiedDishes,
                    timestamp: Date.now(),
                    type: 'dishes'
                }));
            } catch (e) { }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).catch(function() { fallbackCopy(text); });
            } else {
                fallbackCopy(text);
            }
        }

        function fallbackCopy(text) {
            var textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.select();
            try { document.execCommand('copy'); } catch (e) { }
            document.body.removeChild(textArea);
        }

        // ==========================================
        // ===== ВСТАВКА =====
        // ==========================================
        function pasteDishes() {
            try {
                var saved = localStorage.getItem('copiedDishes');
                if (saved && (!copiedDishes || copiedDishes.length === 0)) {
                    var parsed = JSON.parse(saved);
                    if (parsed && parsed.type === 'dishes' && parsed.dishes && parsed.dishes.length > 0) {
                        if (Date.now() - parsed.timestamp < 3600000) {
                            copiedDishes = parsed.dishes;
                            updatePasteSection();
                        }
                    }
                }
            } catch (e) { }
            if (!copiedDishes || copiedDishes.length === 0) {
                showToast('Нет скопированных блюд!', 'warning');
                return;
            }
            var count = copiedDishes.length;
            var names = copiedDishes.map(d => d.name).join(', ');
            if (names.length > 50) names = names.substring(0, 50) + '...';
            if (!confirm('Вставить ' + count + ' блюд в текущую подкатегорию?\n\n' + names)) {
                return;
            }
            var currentSubcategoryId = @Model.Menu_SubcategoryID;
            var dishIdsString = copiedDishes.map(d => d.id).join(',');
            $.ajax({
                url: '@Url.Action("BulkPasteDishes", "Menu")',
                type: 'POST',
                data: {
                    dishIds: dishIdsString,
                    targetSubcategoryId: currentSubcategoryId
                },
                beforeSend: function() {
                    showToast('⏳ Копирование ' + count + ' блюд...', 'info', 2000);
                },
                success: function(response) {
                    if (response.success) {
                        showToast(response.message, 'success');
                        copiedDishes = [];
                        try {
                            localStorage.removeItem('copiedDishes');
                            if (navigator.clipboard && navigator.clipboard.writeText) {
                                navigator.clipboard.writeText('');
                            }
                        } catch (e) { }
                        updatePasteSection();
                        setTimeout(function() { location.reload(); }, 2000);
                    } else {
                        showToast('❌ ' + response.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Ошибка:', xhr.responseText);
                    showToast('❌ Ошибка при вставке: ' + error, 'error');
                }
            });
        }

        // ==========================================
        // ===== ОБНОВЛЕНИЕ СЕКЦИИ ВСТАВКИ =====
        // ==========================================
        function updatePasteSection() {
            var section = document.getElementById('pasteSection');
            var icon = document.getElementById('pasteIcon');
            var text = document.getElementById('pasteText');
            var status = document.getElementById('clipboardStatus');
            var countBadge = document.getElementById('clipboardCount');
            var countText = document.getElementById('copiedCount');
            var preview = document.getElementById('copiedDishesPreview');
            var listContainer = document.getElementById('copiedListContainer');

            if (copiedDishes && copiedDishes.length > 0) {
                section.classList.add('has-copied');
                icon.className = 'fas fa-clipboard-check paste-icon';
                var count = copiedDishes.length;
                var names = copiedDishes.map(d => d.name).join(', ');
                if (names.length > 40) names = names.substring(0, 40) + '...';
                text.innerHTML = '<i class="fas fa-arrow-right"></i> Вставить <strong>' + count + '</strong> блюд: ' + names;
                status.className = 'badge badge-success';
                status.innerHTML = '<i class="fas fa-check-circle"></i> Блюда в буфере';
                countBadge.style.display = 'inline-block';
                countText.textContent = count;
                preview.style.display = 'block';
                listContainer.innerHTML = '';
                copiedDishes.forEach(function(dish, index) {
                    var badge = document.createElement('span');
                    badge.className = 'badge badge-info';
                    badge.textContent = (index + 1) + '. ' + dish.name + ' (ID: ' + dish.id + ')';
                    listContainer.appendChild(badge);
                    listContainer.appendChild(document.createTextNode(' '));
                });
            } else {
                section.classList.remove('has-copied');
                icon.className = 'fas fa-clipboard paste-icon';
                text.innerHTML = '<i class="fas fa-info-circle"></i> Вставьте скопированные блюда (Ctrl+V)';
                status.className = 'badge badge-secondary';
                status.innerHTML = '<i class="fas fa-circle" style="font-size: 8px; color: #6c757d;"></i> Буфер пуст';
                countBadge.style.display = 'none';
                preview.style.display = 'none';
            }
        }

        // ==========================================
        // ===== ВЫБОР =====
        // ==========================================
        function toggleAllCheckboxes() {
            var selectAll = document.getElementById('selectAll');
            var checkboxes = document.querySelectorAll('.checkbox-item');
            checkboxes.forEach(function(cb) {
                cb.checked = selectAll.checked;
                var row = cb.closest('tr');
                if (row) {
                    if (cb.checked) { row.classList.add('selected'); } else { row.classList.remove('selected'); }
                }
            });
            updateBulkActions();
        }

        function updateBulkActions() {
            var checkboxes = document.querySelectorAll('.checkbox-item:checked');
            var count = checkboxes.length;
            document.getElementById('selectedCount').textContent = count;
            var bulkActions = document.getElementById('bulkActions');
            if (count > 0) { bulkActions.classList.add('show'); } else { bulkActions.classList.remove('show'); }
            selectedDishes = [];
            checkboxes.forEach(function(cb) {
                var id = parseInt(cb.getAttribute('data-id'));
                if (!isNaN(id)) { selectedDishes.push(id); }
            });
        }

        function clearAllSelections() {
            var selectAll = document.getElementById('selectAll');
            selectAll.checked = false;
            var checkboxes = document.querySelectorAll('.checkbox-item');
            checkboxes.forEach(function(cb) {
                cb.checked = false;
                var row = cb.closest('tr');
                if (row) { row.classList.remove('selected'); }
            });
            updateBulkActions();
        }

        // ==========================================
        // ===== ВОССТАНОВЛЕНИЕ =====
        // ==========================================
        $(document).on('click', '.restore-btn', function() {
            var id = $(this).data('id');
            var type = $(this).data('type');
            var url = '/Menu/Restore' + type;
            $.post(url, { id: id }, function(data) {
                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(function() {
                        window.location.reload(true);
                    }, 500);
                } else {
                    showToast(data.message, 'error');
                }
            }).fail(function() {
                showToast('Ошибка соединения', 'error');
            });
        });


        function showUndoToast(type, id, name) {
            var toastHtml = `
                                <div class="undo-toast" data-id="${id}" data-type="${type}">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <strong>Удаление</strong>
                                        <span class="timer" style="font-weight:bold;">10</span>
                                        <button class="close undo-close" style="background:none; border:none; font-size:20px;">&times;</button>
                                    </div>
                                    <div style="margin-top:5px;">
                                        Запись "${name}" удалена. <a href="#" class="undo-restore-link">Отменить</a>
                                    </div>
                                </div>
                            `;
            $('body').append(toastHtml);
            var toast = $('.undo-toast').last();
            var timer = 10;
            var interval = setInterval(function() {
                timer--;
                toast.find('.timer').text(timer);
                if (timer <= 0) {
                    clearInterval(interval);
                    toast.fadeOut(500, function() { $(this).remove(); });
                }
            }, 1000);

            toast.find('.undo-restore-link').on('click', function(e) {
                e.preventDefault();
                clearInterval(interval);
                restoreEntity(type, id, function() {
                    toast.find('.timer').text('Восстановлено!');
                    setTimeout(function() {
                        toast.fadeOut(500, function() { $(this).remove(); });
                        window.location.reload(true);
                    }, 1500);
                });
            });

            toast.find('.undo-close').on('click', function() {
                clearInterval(interval);
                toast.fadeOut(500, function() { $(this).remove(); });
            });
        }

        function restoreEntity(type, id, callback) {
            var url = '/Menu/Restore' + type;
            $.post(url, { id: id }, function(data) {
                if (data.success) {
                    if (callback) callback();
                } else {
                    alert('Ошибка восстановления: ' + data.message);
                }
            }).fail(function() {
                alert('Ошибка соединения');
            });
        }

        // ==========================================
        // ===== ИНИЦИАЛИЗАЦИЯ =====
        // ==========================================
        $(document).ready(function() {
            try {
                var saved = localStorage.getItem('copiedDishes');
                if (saved) {
                    var parsed = JSON.parse(saved);
                    if (parsed && parsed.type === 'dishes' && parsed.dishes && parsed.dishes.length > 0) {
                        if (Date.now() - parsed.timestamp < 3600000) {
                            copiedDishes = parsed.dishes;
                            updatePasteSection();
                        } else {
                            localStorage.removeItem('copiedDishes');
                        }
                    }
                }
            } catch (e) { }

            $(document).on('keydown', function(e) {
                if (e.ctrlKey && e.key === 'v') {
                    var tag = document.activeElement.tagName.toLowerCase();
                    if (tag !== 'input' && tag !== 'textarea') {
                        e.preventDefault();
                        pasteDishes();
                    }
                }
            });

            var table = $('#HIDE-dishes').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "language": {
                    "url": "/lib/datatables/ru.json"
                },
                "dom": '<"row"<"col-sm-4"l><"col-sm-4"B><"col-sm-4"f>>' +
                    '<"row"<"col-sm-12"tr>>' +
                    '<"row"<"col-sm-5"i><"col-sm-7"p>>',
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel"></i> Excel',
                        className: 'btn btn-success btn-sm',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 7],
                            format: {
                                body: function(data) {
                                    return $('<div>').html(data).text();
                                }
                            }
                        },
                        title: 'Блюда'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fas fa-file-pdf"></i> PDF',
                        className: 'btn btn-danger btn-sm',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 7],
                            format: {
                                body: function(data) {
                                    return $('<div>').html(data).text();
                                }
                            }
                        },
                        title: 'Блюда',
                        customize: function(doc) {
                            doc.styles.title = {
                                fontSize: '18',
                                alignment: 'center'
                            };
                            doc.content[0].text = 'Список блюд';
                        }
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print"></i> Печать',
                        className: 'btn btn-secondary btn-sm',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 7],
                            format: {
                                body: function(data) {
                                    return $('<div>').html(data).text();
                                }
                            }
                        }
                    }
                ],
                "columnDefs": [
                    { "orderable": false, "targets": 0 }
                ]
            });

            table.on('draw', function() {
                var checkboxes = document.querySelectorAll('.checkbox-item');
                checkboxes.forEach(function(cb) {
                    var row = cb.closest('tr');
                    if (row) {
                        if (cb.checked) { row.classList.add('selected'); } else { row.classList.remove('selected'); }
                    }
                });
                updateBulkActions();
            });

            $('#HIDE-dishes tbody').on('click', 'tr', function(e) {
                if (e.target.type === 'checkbox' || e.target.closest('.btn-group')) {
                    return;
                }
                var cb = $(this).find('.checkbox-item')[0];
                if (cb) {
                    cb.checked = !cb.checked;
                    if (cb.checked) { $(this).addClass('selected'); } else { $(this).removeClass('selected'); }
                    updateBulkActions();
                }
            });
        });
    </script>
}