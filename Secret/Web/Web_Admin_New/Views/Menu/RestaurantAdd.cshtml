@* Страница добавления привязки меню к ресторану. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Restaurant_AddEdit
@{
    ViewData["Title"] = "RestaurantAdd";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = "Добавить привязку к ресторану";
    ViewBag.RazdelNameMobile = "Добавить";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Добавление привязки меню "@Model.MenuName" к ресторану</h3>
                    </div>

                    <form asp-action="RestaurantAdd">
                        <input type="hidden" asp-for="MenuID" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            @if (Model.List_Restaurants != null && Model.List_Restaurants.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="RestaurantID">Ресторан*</label>
                                    <select asp-for="RestaurantID" class="custom-select">
                                        @foreach (var item in Model.List_Restaurants)
                                        {
                                            if (item.ID == Model.RestaurantID)
                                            {
                                                <option selected value="@item.ID">@item.Address</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Address</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="RestaurantID" class="text-danger"></span>
                                </div>
                            }

                            <div class="form-group">
                                <label asp-for="DateFrom" class="control-label"></label>
                                <input asp-for="DateFrom" class="form-control" type="datetime-local" />
                                <span asp-validation-for="DateFrom" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DateTo" class="control-label"></label>
                                <input asp-for="DateTo" class="form-control" type="datetime-local" />
                                <span asp-validation-for="DateTo" class="text-danger"></span>
                            </div>

                            @if (Model.List_Menu_OptionStates != null && Model.List_Menu_OptionStates.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Menu_OptionStateID">Состояние*</label>
                                    <select asp-for="Menu_OptionStateID" class="custom-select">
                                        @foreach (var item in Model.List_Menu_OptionStates)
                                        {
                                            if (item.ID == Model.Menu_OptionStateID)
                                            {
                                                <option selected value="@item.ID">@item.DisplayName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Value</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Menu_OptionStateID" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <input type="submit" value="Добавить" class="btn btn-primary" />
                                <a asp-action="RestaurantList" asp-route-MenuID="@Model.MenuID" class="btn btn-default">Отмена</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}