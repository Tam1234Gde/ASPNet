@* Страница списка ингредиентов конкретного меню с массовыми операциями. *@
@using System.Linq
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Ingredient_List
@{
    ViewData["Title"] = "Ингредиенты";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = $"Ингредиенты - {Model.MenuName}";
    ViewBag.RazdelNameMobile = "Ингредиенты";
    bool showDeleted = ViewBag.ShowDeleted ?? false;
}

<style>
    .checkbox-select-all {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .checkbox-item {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .bulk-actions {
        display: none;
        background: #e3f2fd;
        border: 2px solid #2196F3;
        border-radius: 8px;
        padding: 10px 15px;
        margin-bottom: 15px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        opacity: 0;
        transform: translateY(-10px);
        transition: all 0.3s ease;
        max-height: 0;
        overflow: hidden;
        padding: 0 15px;
    }

        .bulk-actions.show {
            display: flex;
            opacity: 1;
            transform: translateY(0);
            max-height: 100px;
            padding: 10px 15px;
            animation: slideDownBulk 0.4s ease forwards;
        }

    @@keyframes slideDownBulk {
        0% {
            opacity: 0;
            transform: translateY(-20px);
            max-height: 0;
            padding: 0 15px;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            opacity: 1;
            transform: translateY(0);
            max-height: 100px;
            padding: 10px 15px;
        }
    }

    .bulk-actions .count {
        font-weight: 600;
        color: #1976D2;
    }

    .bulk-actions .btn-bulk-copy {
        background: #2196F3;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .bulk-actions .btn-bulk-copy:hover {
            background: #1976D2;
            transform: scale(1.05);
        }

    .bulk-actions .btn-bulk-clear {
        background: #6c757d;
        color: #fff;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-left: 10px;
    }

        .bulk-actions .btn-bulk-clear:hover {
            background: #5a6268;
        }

    .btn-copy {
        transition: all 0.3s ease;
    }

        .btn-copy:hover {
            transform: scale(1.1);
        }

        .btn-copy.copied {
            background-color: #28a745 !important;
            border-color: #28a745 !important;
            color: #fff !important;
        }

            .btn-copy.copied i {
                animation: bounceIn 0.5s ease;
            }

    @@keyframes bounceIn {
        0% {
            transform: scale(0);
        }

        50% {
            transform: scale(1.3);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
        }
    }

    .toast-notification {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 15px 25px;
        border-radius: 8px;
        color: #fff;
        font-weight: 500;
        z-index: 9999;
        transform: translateX(120%);
        transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 300px;
        max-width: 500px;
    }

        .toast-notification.show {
            transform: translateX(0);
        }

        .toast-notification.success {
            background: linear-gradient(135deg, #28a745, #20c997);
        }

        .toast-notification.error {
            background: linear-gradient(135deg, #dc3545, #e74c3c);
        }

        .toast-notification.info {
            background: linear-gradient(135deg, #17a2b8, #0dcaf0);
        }

        .toast-notification.warning {
            background: linear-gradient(135deg, #ffc107, #fd7e14);
        }

        .toast-notification .close-btn {
            cursor: pointer;
            background: none;
            border: none;
            color: #fff;
            font-size: 20px;
        }

    .paste-section {
        background: #f8f9fa;
        border: 2px dashed #6c757d;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.3s ease;
        cursor: pointer;
        flex-wrap: wrap;
        gap: 10px;
    }

        .paste-section:hover {
            border-color: #17a2b8;
            background: #e9ecef;
        }

        .paste-section.has-copied {
            border-color: #28a745;
            background: #d4edda;
        }

        .paste-section .paste-icon {
            font-size: 24px;
            margin-right: 10px;
        }

    .table tbody tr.selected {
        background-color: #e3f2fd !important;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(33, 150, 243, 0.05);
        cursor: pointer;
    }

    .table tbody tr.selected td:first-child {
        border-left: 3px solid #2196F3;
    }

    .copied-list {
        max-height: 100px;
        overflow-y: auto;
        font-size: 13px;
        background: #fff;
        border-radius: 4px;
        padding: 5px 10px;
        border: 1px solid #dee2e6;
        margin-top: 5px;
    }

        .copied-list .badge {
            margin: 2px;
        }

    .table-secondary {
        background-color: #f5f5f5;
    }

    .undo-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        background: #f8f9fa;
        border-left: 4px solid #28a745;
        padding: 15px;
        border-radius: 4px;
        box-shadow: 0 0 15px rgba(0,0,0,0.2);
        min-width: 250px;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6"><h3 class="card-title">Список ингредиентов</h3></div>
                            <div class="col-md-6 text-right">
                                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-reply"></i> Назад</a>
                                <a asp-action="IngredientAdd" asp-route-MenuID="@Model.MenuID" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить</a>
                                <a href="@Url.Action("IngredientList", new { MenuID = Model.MenuID, showDeleted = !showDeleted })"
                                   class="btn @(showDeleted ? "btn-warning" : "btn-outline-secondary")">
                                    @(showDeleted ? "Скрыть удалённые" : "Показать удалённые")
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Секция вставки -->
                        <div class="paste-section" id="pasteSection" onclick="pasteIngredients()">
                            <div style="display:flex; align-items:center; flex-wrap:wrap; gap:10px;">
                                <i class="fas fa-clipboard paste-icon" id="pasteIcon"></i>
                                <span id="pasteText" style="font-weight: 500;"><i class="fas fa-info-circle"></i> Вставьте скопированные ингредиенты (Ctrl+V)</span>
                            </div>
                            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                <span id="clipboardStatus" class="badge badge-secondary"><i class="fas fa-circle" style="font-size:8px;color:#6c757d;"></i> Буфер пуст</span>
                                <span id="clipboardCount" class="badge badge-secondary" style="display:none;"><i class="fas fa-egg"></i> <span id="copiedCount">0</span> ингредиентов</span>
                                <button id="clearClipboardBtn" class="btn btn-sm btn-outline-danger" style="display:none;" onclick="clearIngredientClipboard(event)"><i class="fas fa-trash"></i> Очистить буфер</button>
                            </div>
                        </div>

                        <div id="copiedIngredientsPreview" style="display:none; margin-bottom:15px;">
                            <div class="copied-list" id="copiedListContainer"></div>
                        </div>

                        <!-- Панель массовых действий -->
                        <div class="bulk-actions" id="bulkActions">
                            <div><i class="fas fa-check-circle" style="color:#2196F3;"></i> Выбрано: <span class="count" id="selectedCount">0</span> ингредиентов</div>
                            <div>
                                <button class="btn-bulk-copy" id="btnBulkCopy" onclick="copySelectedIngredientsToClipboard()"><i class="fas fa-copy"></i> Копировать в буфер</button>
                                <button class="btn-bulk-clear" onclick="clearAllSelections()"><i class="fas fa-times"></i> Очистить</button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="HIDE-ingredients" class="table table-bordered table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th style="width:40px;"><input type="checkbox" class="checkbox-select-all" id="selectAll" onchange="toggleAllCheckboxes()" /></th>
                                        <th style="width:50px;">ID</th>
                                        <th style="width:200px;">Наименование</th>
                                        <th style="width:100px;">Цена</th>
                                        <th style="width:150px;">Группа</th>
                                        <th style="width:120px;">Состояние</th>
                                        <th style="min-width:150px;">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.List_Ingredients != null && Model.List_Ingredients.Count > 0)
                                    {
                                        @foreach (var item in Model.List_Ingredients)
                                        {
                                            <tr class="@(showDeleted ? "table-secondary" : "")">
                                                <td><input type="checkbox" class="checkbox-item" data-id="@item.ID" onchange="updateBulkActions()" /></td>
                                                <td>@item.ID</td>
                                                <td>
                                                    @item.Name
                                                    @if (item.Image != null && item.Image.Length > 0)
                                                    {
                                                        <br /><img src="data:image/jpeg;base64,@Convert.ToBase64String(item.Image)" style="max-height:30px;" />
                                                    }
                                                </td>
                                                <td>@(item.Price.HasValue ? item.Price.Value.ToString("N0") : "-")</td>
                                                <td>@item.Menu_Ingridient_GroupID</td>
                                                <td>
                                                    @{
                                                        string stateName = item.Menu_OptionStateID switch { 1 => "Активно", 2 => "Опционально", 3 => "Отключено", _ => "Неизвестно" };
                                                        string stateClass = item.Menu_OptionStateID switch { 1 => "badge-success", 2 => "badge-warning", 3 => "badge-danger", _ => "badge-secondary" };
                                                    }
                                                    <span class="badge @stateClass">@stateName</span>
                                                </td>
                                                <td>
                                                    @if (showDeleted)
                                                    {
                                                        <button class="btn btn-success btn-sm restore-btn" data-id="@item.ID" data-type="Ingredient">
                                                            <i class="fas fa-undo"></i> Восстановить
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-outline-info btn-sm btn-copy" onclick="copySingleIngredient(@item.ID, '@item.Name.ReHIDE("'", "\\'")')" title="Копировать"><i class="fas fa-copy"></i></button>
                                                            <a asp-action="IngredientEdit" asp-route-ID="@item.ID" class="btn btn-outline-warning btn-sm" title="Редактировать"><i class="fas fa-edit"></i></a>
                                                            <a asp-action="IngredientDel" asp-route-ID="@item.ID" class="btn btn-outline-danger btn-sm" title="Удалить"><i class="fas fa-trash"></i></a>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="7" class="text-center">Записей не обнаружено</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Модальное окно -->
<div class="modal fade" id="copyIngredientModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-copy"></i> Копирование ингредиента</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Выберите режим копирования:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="copyModeIngredient" id="copyWithContentIngredient" value="with" checked>
                        <label class="form-check-label" for="copyWithContentIngredient">
                            <i class="fas fa-copy text-success"></i> Копировать с изображением
                            <br /><small class="text-muted">Будет скопировано изображение ингредиента</small>
                        </label>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="radio" name="copyModeIngredient" id="copyWithoutContentIngredient" value="without">
                        <label class="form-check-label" for="copyWithoutContentIngredient">
                            <i class="fas fa-file text-warning"></i> Копировать без изображения
                            <br /><small class="text-muted">Будет скопирован только ингредиент</small>
                        </label>
                    </div>
                </div>
                <div id="copyPreviewIngredient" class="mt-2">
                    <small class="text-muted">Выбрано: <span id="selectedCountIngredientModal">0</span> ингредиентов</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="confirmCopyIngredient"><i class="fas fa-copy"></i> Копировать</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        // ==========================================
        // ===== ПЕРЕМЕННЫЕ =====
        // ==========================================
        var copiedIngredients = [];
        var selectedIngredients = [];
        var pendingIngredientIds = [];

        // ==========================================
        // ===== УВЕДОМЛЕНИЯ =====
        // ==========================================
        function showToast(message, type, duration) {
            type = type || 'success';
            duration = duration || 3000;
            var icons = { success: '✅', error: '❌', info: 'ℹ️', warning: '⚠️' };
            var toast = document.createElement('div');
            toast.className = 'toast-notification ' + type;
            toast.innerHTML = '<span>' + (icons[type] || 'ℹ️') + '</span><span>' + message + '</span><button class="close-btn" onclick="this.parentElement.remove()">&times;</button>';
            document.body.appendChild(toast);
            setTimeout(function() { toast.classList.add('show'); }, 100);
            setTimeout(function() { toast.classList.remove('show'); setTimeout(function() { toast.remove(); }, 500); }, duration);
        }

        // ==========================================
        // ===== ОБНОВЛЕНИЕ СЕКЦИИ ВСТАВКИ =====
        // ==========================================
        function updateIngredientPasteSection() {
            var section = document.getElementById('pasteSection');
            var icon = document.getElementById('pasteIcon');
            var text = document.getElementById('pasteText');
            var status = document.getElementById('clipboardStatus');
            var countBadge = document.getElementById('clipboardCount');
            var countText = document.getElementById('copiedCount');
            var preview = document.getElementById('copiedIngredientsPreview');
            var listContainer = document.getElementById('copiedListContainer');
            var clearBtn = document.getElementById('clearClipboardBtn');

            if (copiedIngredients && copiedIngredients.length > 0) {
                section.classList.add('has-copied');
                icon.className = 'fas fa-clipboard-check paste-icon';
                var count = copiedIngredients.length;
                var names = copiedIngredients.map(function(s) { return s.name; }).join(', ');
                if (names.length > 40) names = names.substring(0, 40) + '...';
                var hasContent = copiedIngredients.some(function(s) { return s.withContent; });
                var contentLabel = hasContent ? ' с изображением' : ' без изображения';
                text.innerHTML = '<i class="fas fa-arrow-right"></i> Вставить <strong>' + count + '</strong> ингредиентов' + contentLabel + ': ' + names;
                status.className = 'badge badge-success';
                status.innerHTML = '<i class="fas fa-check-circle"></i> Ингредиенты в буфере';
                countBadge.style.display = 'inline-block';
                countText.textContent = count;
                clearBtn.style.display = 'inline-block';
                preview.style.display = 'block';
                listContainer.innerHTML = '';
                for (var i = 0; i < copiedIngredients.length; i++) {
                    var ing = copiedIngredients[i];
                    var mode = ing.withContent ? '📦' : '📄';
                    var badge = document.createElement('span');
                    badge.className = 'badge badge-info';
                    badge.textContent = (i + 1) + '. ' + mode + ' ' + ing.name + ' (ID: ' + ing.id + ')';
                    listContainer.appendChild(badge);
                    listContainer.appendChild(document.createTextNode(' '));
                }
            } else {
                section.classList.remove('has-copied');
                icon.className = 'fas fa-clipboard paste-icon';
                text.innerHTML = '<i class="fas fa-info-circle"></i> Вставьте скопированные ингредиенты (Ctrl+V)';
                status.className = 'badge badge-secondary';
                status.innerHTML = '<i class="fas fa-circle" style="font-size:8px;color:#6c757d;"></i> Буфер пуст';
                countBadge.style.display = 'none';
                preview.style.display = 'none';
                clearBtn.style.display = 'none';
            }
        }

        // ==========================================
        // ===== КОПИРОВАНИЕ =====
        // ==========================================
        function copySingleIngredient(id, name) {
            pendingIngredientIds = [id];
            document.getElementById('selectedCountIngredientModal').textContent = '1 (' + name + ')';
            $('#copyIngredientModal').modal('show');
        }

        function copySelectedIngredientsToClipboard() {
            if (selectedIngredients.length === 0) {
                showToast('Не выбрано ни одного ингредиента!', 'warning');
                return;
            }
            pendingIngredientIds = selectedIngredients.slice(0);
            document.getElementById('selectedCountIngredientModal').textContent = pendingIngredientIds.length + ' ингредиентов';
            $('#copyIngredientModal').modal('show');
        }

        $('#confirmCopyIngredient').on('click', function() {
            var copyMode = document.querySelector('input[name="copyModeIngredient"]:checked').value;
            var withContent = (copyMode === 'with');
            $('#copyIngredientModal').modal('hide');
            var ingredientsToCopy = [];
            var existingIds = new Set();
            if (copiedIngredients && copiedIngredients.length > 0) {
                for (var i = 0; i < copiedIngredients.length; i++) {
                    existingIds.add(copiedIngredients[i].id);
                }
            }
            for (var i = 0; i < pendingIngredientIds.length; i++) {
                var id = pendingIngredientIds[i];
                if (!existingIds.has(id)) {
                    var row = document.querySelector('tr[data-ingredient-id="' + id + '"]');
                    var name = row ? row.getAttribute('data-ingredient-name') : 'Ингредиент #' + id;
                    ingredientsToCopy.push({ id: id, name: name, withContent: withContent });
                }
            }
            if (ingredientsToCopy.length === 0) {
                showToast('Все выбранные ингредиенты уже скопированы!', 'warning');
                return;
            }
            if (copiedIngredients && copiedIngredients.length > 0) {
                copiedIngredients = copiedIngredients.concat(ingredientsToCopy);
            } else {
                copiedIngredients = ingredientsToCopy;
            }
            saveIngredientsToClipboard();
            updateIngredientPasteSection();
            var count = ingredientsToCopy.length;
            var totalCount = copiedIngredients.length;
            var modeText = withContent ? 'с изображением' : 'без изображения';
            showToast('Добавлено ' + count + ' ингредиентов (' + modeText + '), всего ' + totalCount, 'success', 3000);
            clearAllSelections();
            pendingIngredientIds = [];
        });

        // ==========================================
        // ===== СОХРАНЕНИЕ В БУФЕР =====
        // ==========================================
        function saveIngredientsToClipboard() {
            var text = '=== СКОПИРОВАННЫЕ ИНГРЕДИЕНТЫ ===\nКоличество: ' + copiedIngredients.length + '\n----------------------------------------\n';
            for (var i = 0; i < copiedIngredients.length; i++) {
                var ing = copiedIngredients[i];
                text += (i + 1) + '. ID: ' + ing.id + ' | ' + ing.name + ' | ' + (ing.withContent ? 'с изображением' : 'без изображения') + '\n';
            }
            text += '----------------------------------------\n';
            try {
                localStorage.setItem('copiedIngredients', JSON.stringify({ ingredients: copiedIngredients, timestamp: Date.now(), type: 'ingredients' }));
            } catch (e) { }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).catch(function() { fallbackCopy(text); });
            } else {
                fallbackCopy(text);
            }
            updateIngredientPasteSection();
        }

        function fallbackCopy(text) {
            var textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.select();
            try { document.execCommand('copy'); } catch (e) { }
            document.body.removeChild(textArea);
        }

        // ==========================================
        // ===== ВСТАВКА =====
        // ==========================================
        function pasteIngredients() {
            try {
                var saved = localStorage.getItem('copiedIngredients');
                if (saved && (!copiedIngredients || copiedIngredients.length === 0)) {
                    var parsed = JSON.parse(saved);
                    if (parsed && parsed.type === 'ingredients' && parsed.ingredients && parsed.ingredients.length > 0) {
                        if (Date.now() - parsed.timestamp < 3600000) {
                            copiedIngredients = parsed.ingredients;
                            updateIngredientPasteSection();
                        }
                    }
                }
            } catch (e) { }
            if (!copiedIngredients || copiedIngredients.length === 0) {
                showToast('Нет скопированных ингредиентов!', 'warning');
                return;
            }
            var count = copiedIngredients.length;
            var names = '';
            for (var i = 0; i < copiedIngredients.length; i++) {
                if (i > 0) names += ', ';
                names += copiedIngredients[i].name;
            }
            if (names.length > 50) names = names.substring(0, 50) + '...';
            var hasContent = copiedIngredients.some(function(s) { return s.withContent; });
            var contentInfo = hasContent ? ' (с изображением)' : ' (без изображения)';
            if (!confirm('Вставить ' + count + ' ингредиентов' + contentInfo + '?\n\n' + names)) {
                return;
            }
            var currentMenuId = @Model.MenuID;
            var ingredientIdsString = '';
            for (var i = 0; i < copiedIngredients.length; i++) {
                if (i > 0) ingredientIdsString += ',';
                ingredientIdsString += copiedIngredients[i].id + ':' + (copiedIngredients[i].withContent ? 'with' : 'without');
            }
            $.ajax({
                url: '@Url.Action("BulkPasteIngredients", "Menu")',
                type: 'POST',
                data: { ingredientIds: ingredientIdsString, targetMenuId: currentMenuId },
                beforeSend: function() { showToast('⏳ Копирование ' + count + ' ингредиентов...', 'info', 2000); },
                success: function(response) {
                    if (response.success) {
                        showToast(response.message, 'success');
                        copiedIngredients = [];
                        try { localStorage.removeItem('copiedIngredients'); if (navigator.clipboard) navigator.clipboard.writeText(''); } catch (e) { }
                        updateIngredientPasteSection();
                        setTimeout(function() { location.reload(); }, 2000);
                    } else {
                        showToast('❌ ' + response.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Ошибка:', xhr.responseText);
                    showToast('❌ Ошибка при вставке: ' + error, 'error');
                }
            });
        }

        // ==========================================
        // ===== ОЧИСТКА БУФЕРА =====
        // ==========================================
        function clearIngredientClipboard(event) {
            if (event) event.stopPropagation();
            if (!copiedIngredients || copiedIngredients.length === 0) return;
            if (!confirm('Очистить буфер (' + copiedIngredients.length + ' ингредиентов)?')) return;
            copiedIngredients = [];
            try { localStorage.removeItem('copiedIngredients'); if (navigator.clipboard) navigator.clipboard.writeText(''); } catch (e) { }
            updateIngredientPasteSection();
            showToast('🗑️ Буфер очищен', 'info');
        }

        // ==========================================
        // ===== ВЫБОР =====
        // ==========================================
        function toggleAllCheckboxes() {
            var selectAll = document.getElementById('selectAll');
            var checkboxes = document.querySelectorAll('.checkbox-item');
            for (var i = 0; i < checkboxes.length; i++) {
                var cb = checkboxes[i];
                cb.checked = selectAll.checked;
                var row = cb.closest('tr');
                if (row) {
                    if (cb.checked) { row.classList.add('selected'); } else { row.classList.remove('selected'); }
                }
            }
            updateBulkActions();
        }

        function updateBulkActions() {
            var checkboxes = document.querySelectorAll('.checkbox-item:checked');
            var count = checkboxes.length;
            document.getElementById('selectedCount').textContent = count;
            var bulkActions = document.getElementById('bulkActions');
            if (count > 0) { bulkActions.classList.add('show'); } else { bulkActions.classList.remove('show'); }
            selectedIngredients = [];
            for (var i = 0; i < checkboxes.length; i++) {
                var id = parseInt(checkboxes[i].getAttribute('data-id'));
                if (!isNaN(id)) { selectedIngredients.push(id); }
            }
        }

        function clearAllSelections() {
            var selectAll = document.getElementById('selectAll');
            selectAll.checked = false;
            var checkboxes = document.querySelectorAll('.checkbox-item');
            for (var i = 0; i < checkboxes.length; i++) {
                var cb = checkboxes[i];
                cb.checked = false;
                var row = cb.closest('tr');
                if (row) { row.classList.remove('selected'); }
            }
            updateBulkActions();
        }

        // ==========================================
        // ===== ВОССТАНОВЛЕНИЕ =====
        // ==========================================
        $(document).on('click', '.restore-btn', function() {
            var id = $(this).data('id');
            var type = $(this).data('type');
            var url = '/Menu/Restore' + type;
            $.post(url, { id: id }, function(data) {
                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(function() {
                        window.location.reload(true);
                    }, 500);
                } else {
                    showToast(data.message, 'error');
                }
            }).fail(function() {
                showToast('Ошибка соединения', 'error');
            });
        });



        function showUndoToast(type, id, name) {
            var toastHtml = `
                                <div class="undo-toast" data-id="${id}" data-type="${type}">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <strong>Удаление</strong>
                                        <span class="timer" style="font-weight:bold;">10</span>
                                        <button class="close undo-close" style="background:none; border:none; font-size:20px;">&times;</button>
                                    </div>
                                    <div style="margin-top:5px;">
                                        Запись "${name}" удалена. <a href="#" class="undo-restore-link">Отменить</a>
                                    </div>
                                </div>
                            `;
            $('body').append(toastHtml);
            var toast = $('.undo-toast').last();
            var timer = 10;
            var interval = setInterval(function() {
                timer--;
                toast.find('.timer').text(timer);
                if (timer <= 0) {
                    clearInterval(interval);
                    toast.fadeOut(500, function() { $(this).remove(); });
                }
            }, 1000);

            toast.find('.undo-restore-link').on('click', function(e) {
                e.preventDefault();
                clearInterval(interval);
                restoreEntity(type, id, function() {
                    toast.find('.timer').text('Восстановлено!');
                    setTimeout(function() {
                        toast.fadeOut(500, function() { $(this).remove(); });
                        window.location.reload(true);
                    }, 1500);
                });
            });

            toast.find('.undo-close').on('click', function() {
                clearInterval(interval);
                toast.fadeOut(500, function() { $(this).remove(); });
            });
        }

        function restoreEntity(type, id, callback) {
            var url = '/Menu/Restore' + type;
            $.post(url, { id: id }, function(data) {
                if (data.success) {
                    if (callback) callback();
                } else {
                    alert('Ошибка восстановления: ' + data.message);
                }
            }).fail(function() {
                alert('Ошибка соединения');
            });
        }

        // ==========================================
        // ===== ИНИЦИАЛИЗАЦИЯ =====
        // ==========================================
        $(document).ready(function() {
            try {
                var saved = localStorage.getItem('copiedIngredients');
                if (saved) {
                    var parsed = JSON.parse(saved);
                    if (parsed && parsed.type === 'ingredients' && parsed.ingredients && parsed.ingredients.length > 0) {
                        if (Date.now() - parsed.timestamp < 3600000) {
                            copiedIngredients = parsed.ingredients;
                            updateIngredientPasteSection();
                        } else {
                            localStorage.removeItem('copiedIngredients');
                        }
                    }
                }
            } catch (e) { }

            $(document).on('keydown', function(e) {
                if (e.ctrlKey && e.key === 'v') {
                    var tag = document.activeElement.tagName.toLowerCase();
                    if (tag !== 'input' && tag !== 'textarea') {
                        e.preventDefault();
                        pasteIngredients();
                    }
                }
            });

            var table = $('#HIDE-ingredients').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "language": {
                    "processing": "Подождите...",
                    "search": "Поиск:",
                    "lengthMenu": "Показать _MENU_ записей",
                    "info": "Записи с _START_ по _END_ из _TOTAL_",
                    "infoEmpty": "Записи с 0 по 0 из 0",
                    "infoFiltered": "(отфильтровано из _MAX_ записей)",
                    "loadingRecords": "Загрузка...",
                    "zeroRecords": "Записей не найдено",
                    "emptyTable": "Нет данных в таблице",
                    "paginate": { "first": "Первая", "previous": "Предыдущая", "next": "Следующая", "last": "Последняя" },
                    "buttons": { "excel": "Excel", "pdf": "PDF", "print": "Печать" }
                },
                "dom": '<"row"<"col-sm-4"l><"col-sm-4"B><"col-sm-4"f>>' +
                    '<"row"<"col-sm-12"tr>>' +
                    '<"row"<"col-sm-5"i><"col-sm-7"p>>',
                "buttons": [
                    { extend: 'excelHtml5', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn btn-success btn-sm', exportOptions: { columns: [1, 2, 3, 4, 5] }, title: 'Ингредиенты' },
                    { extend: 'pdfHtml5', text: '<i class="fas fa-file-pdf"></i> PDF', className: 'btn btn-danger btn-sm', exportOptions: { columns: [1, 2, 3, 4, 5] }, title: 'Ингредиенты', customize: function(doc) { doc.styles.title = { fontSize: '18', alignment: 'center' }; doc.content[0].text = 'Список ингредиентов'; } },
                    { extend: 'print', text: '<i class="fas fa-print"></i> Печать', className: 'btn btn-secondary btn-sm', exportOptions: { columns: [1, 2, 3, 4, 5] } }
                ],
                "columnDefs": [{ "orderable": false, "targets": [0, 6] }]
            });

            var searchInput = document.querySelector('.dataTables_filter input');
            if (searchInput) { searchInput.HIDEholder = 'Поиск по ингредиентам...'; }

            table.on('draw', function() {
                var checkboxes = document.querySelectorAll('.checkbox-item');
                for (var i = 0; i < checkboxes.length; i++) {
                    var cb = checkboxes[i];
                    var row = cb.closest('tr');
                    if (row) {
                        if (cb.checked) { row.classList.add('selected'); } else { row.classList.remove('selected'); }
                    }
                }
                updateBulkActions();
            });

            $('#HIDE-ingredients tbody').on('click', 'tr', function(e) {
                if (e.target.type === 'checkbox' || e.target.closest('.btn-group')) return;
                var cb = $(this).find('.checkbox-item')[0];
                if (cb) {
                    cb.checked = !cb.checked;
                    if (cb.checked) { $(this).addClass('selected'); } else { $(this).removeClass('selected'); }
                    updateBulkActions();
                }
            });
        });
    </script>

    <script>
        // Ручное открытие модалки — не полагаемся на Bootstrap data-API
        document.addEventListener('DOMContentLoaded', function () {
            var btn = document.querySelector('.js-apply-price-btn');
            var modalEl = document.getElementById('applyPriceModal');
            if (!btn || !modalEl) return;

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                // Если jQuery + Bootstrap доступны — используем штатный API
                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                    window.jQuery(modalEl).modal('show');
                } else {
                    // Fallback: показываем вручную
                    modalEl.style.display = 'block';
                    modalEl.classList.add('show');
                    modalEl.removeAttribute('aria-hidden');
                    document.body.classList.add('modal-open');

                    // затемнение
                    var backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop fade show';
                    backdrop.id = 'applyPriceModalBackdrop';
                    document.body.appendChild(backdrop);
                }
            });

            // Закрытие
            var closeEls = modalEl.querySelectorAll('[data-dismiss="modal"], .close');
            closeEls.forEach(function (el) {
                el.addEventListener('click', function () {
                    if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                        window.jQuery(modalEl).modal('hide');
                    } else {
                        modalEl.style.display = 'none';
                        modalEl.classList.remove('show');
                        modalEl.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('modal-open');
                        var bd = document.getElementById('applyPriceModalBackdrop');
                        if (bd) bd.remove();
                    }
                });
            });
        });
    </script>
}