@* Частичное представление для отображения таблицы блюд. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Dish_List
@{
    Layout = null;
}

@if (Model != null && Model.List_Menu_Dishes != null && Model.List_Menu_Dishes.Any())
{
    <table id="HIDE-dishes" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th style="width: 50px;">ID</th>
                <th style="width: 200px;">Наименование</th>
                <th style="width: 100px;">Цена</th>
                <th style="width: 80px;">Порядок</th>
                <th style="width: 100px;">Состояние</th>
                <th style="width: 80px;">Новинка</th>
                <th style="min-width: 150px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Menu_Dishes)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>
                        @item.Name
                        @if (!string.IsNullOrEmpty(item.Teaser))
                        {
                            <br /><small class="text-muted">@item.Teaser</small>
                        }
                    </td>
                    <td>@item.Price.ToString("N0")</td>
                    <td>@item.OrderNum</td>
                    <td>
                        @{
                            string stateName = item.Menu_OptionStateID switch
                            {
                                1 => "Активно",
                                2 => "Опционально",
                                3 => "Отключено",
                                _ => "Неизвестно"
                            };
                            string stateClass = item.Menu_OptionStateID switch
                            {
                                1 => "badge-success",
                                2 => "badge-warning",
                                3 => "badge-danger",
                                _ => "badge-secondary"
                            };
                        }
                        <span class="badge @stateClass">@stateName</span>
                    </td>
                    <td>
                        @if (item.FlagNew)
                        {
                            <span class="badge badge-info">Новинка</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td class="HIDE-button-actions">
                        <div style="display:flex; gap:4px;">
                            <a asp-action="DishEdit" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="DishDel" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-danger btn-sm">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style="border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px;">
            Записей не обнаружено
        </h3>
    </div>
}