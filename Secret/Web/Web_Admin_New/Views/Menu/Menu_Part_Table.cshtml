@* Частичное представление для отображения таблицы меню. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_List
@{
    Layout = null;
}

@if (Model != null && Model.List_Menu != null && Model.List_Menu.Any())
{
    <table id="HIDE-menu" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th style="width: 50px;">ID</th>
                <th style="width: 300px;">Наименование</th>
                <th style="width: 150px;">Состояние</th>
                <th style="min-width: 280px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Menu)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Name</td>
                    <td>
                        @{
                            string stateName = item.Menu_OptionStateID switch
                            {
                                1 => "Активно",
                                2 => "Опционально",
                                3 => "Отключено",
                                _ => "Неизвестно"
                            };
                            string stateClass = item.Menu_OptionStateID switch
                            {
                                1 => "badge-success",
                                2 => "badge-warning",
                                3 => "badge-danger",
                                _ => "badge-secondary"
                            };
                        }
                        <span class="badge @stateClass">@stateName</span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="CategoryList" asp-route-MenuID="@item.ID" class="btn btn-info">
                                <i class="fas fa-list"></i>
                            </a>
                            <a asp-action="IngredientGroupList" asp-route-MenuID="@item.ID" class="btn btn-primary">
                                <i class="fas fa-layer-group"></i>
                            </a>
                            <a asp-action="IngredientList" asp-route-MenuID="@item.ID" class="btn btn-secondary">
                                <i class="fas fa-egg"></i>
                            </a>
                            <a asp-action="RestaurantList" asp-route-MenuID="@item.ID" class="btn btn-teal">
                                <i class="fas fa-store"></i>
                            </a>
                            <a asp-action="Edit" asp-route-ID="@item.ID" class="btn btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Del" asp-route-ID="@item.ID" class="btn btn-danger">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="text-center py-3">
        <h5>Записей не обнаружено</h5>
    </div>
}