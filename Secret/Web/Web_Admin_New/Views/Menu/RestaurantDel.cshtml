@* Страница подтверждения удаления привязки. *@
@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Menu
@model Model_Menu_Restaurant_AddEdit
@{
    ViewData["Title"] = "RestaurantDel";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Menu_List";

    ViewBag.RazdelName = "Удалить привязку к ресторану";
    ViewBag.RazdelNameMobile = "Удалить";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">Подтверждение удаления</h3>
                    </div>
                    <form asp-action="RestaurantDel">
                        <input asp-for="ID" type="hidden" />
                        <input asp-for="MenuID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить эту привязку?</label>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-action="RestaurantList" asp-route-MenuID="@Model.MenuID">Назад</a>
                            </div>
                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Удалить" class="btn btn-danger" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}