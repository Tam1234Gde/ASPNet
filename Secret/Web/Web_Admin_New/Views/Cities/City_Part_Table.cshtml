@model List<CCity>
@{
    // Таблица > Города
    Layout = null;
}

@* Таблица > Города *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CCity().Name)" title="@Html.DisplayNameFor(x=> new CCity().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCity().Name)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CCity().NameDeclension)" title="@Html.DisplayNameFor(x=> new CCity().NameDeclension)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCity().NameDeclension)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CCity().OrderNum)" title="@Html.DisplayNameFor(x=> new CCity().OrderNum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CCity().OrderNum)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x => new CRestaurant().Flag_Hidden)" title="@Html.DisplayNameFor(x => new CRestaurant().Flag_Hidden)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant().Flag_Hidden)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NameDeclension)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderNum)
                    </td>
                    <td>
                        @if (item.Flag_Hidden == true)
                        {
                            <text>Отключен</text>
                        }
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="City_Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="City_Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}