@using HIDE.RestAndRant.Common.Consts
@model List<CSetup>
@{
    // Таблица > Настройки
    Layout = null;
}

@* Таблица > Настройки *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CSetup().Key)" title="@Html.DisplayNameFor(x => new CSetup().Key)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Key)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x => new CSetup().Val)" title="@Html.DisplayNameFor(x => new CSetup().Val)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x => new CSetup().Val_Comment)" title="@Html.DisplayNameFor(x => new CSetup().Val_Comment)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val_Comment)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x => new CSetup().Val2)" title="@Html.DisplayNameFor(x => new CSetup().Val2)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val2)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x => new CSetup().Val2_Comment)" title="@Html.DisplayNameFor(x => new CSetup().Val2_Comment)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val2_Comment)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-16.png" alt="@Html.DisplayNameFor(x => new CSetup().Val3)" title="@Html.DisplayNameFor(x => new CSetup().Val3)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val3)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x => new CSetup().Val3_Comment)" title="@Html.DisplayNameFor(x => new CSetup().Val3_Comment)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val3_Comment)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x => new CSetup().Val4)" title="@Html.DisplayNameFor(x => new CSetup().Val4)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val4)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x => new CSetup().Val4_Comment)" title="@Html.DisplayNameFor(x => new CSetup().Val4_Comment)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CSetup().Val4_Comment)</span>
                </th>
                <th data-orderable="false" style="min-width: 20px; width: 20px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var elem in Model)
            {
                <tr>
                    <td>@elem.Key</td>
                    <td>@elem.Val</td>
                    <td>@elem.Val_Comment</td>
                    <td>@elem.Val2</td>
                    <td>@elem.Val2_Comment</td>
                    <td>@elem.Val3</td>
                    <td>@elem.Val3_Comment</td>
                    <td>@elem.Val4</td>
                    <td>@elem.Val4_Comment</td>
                    <td>
                        <a asp-action="Setups_Edit" asp-route-Key="@elem.Key" class="btn btn-warning btn-sm">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}