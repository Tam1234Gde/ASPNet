@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantTableStatuses
@model Model_RestaurantTableStatuses_AddEdit
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "RestaurantTableStatuses_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать зал в ресторане";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;

    string id_MediaFile = $"HIDE-js-mediafile-{Guid.NewGuid()}";
}

@* Редактирование ресторана *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="RestaurantTable_Image" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Название*</label>
                                <textarea asp-for="Name" class="form-control"></textarea>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Изображение *@
                            <div class="form-group pt-2">
                                <label for="@id_MediaFile">Изображение*</label>
                                <div class="clearfix"></div>
                                <input id="@id_MediaFile" style="display:block;" asp-for="@Model.UploadImge" type="file" class="btn btn-warning HIDE-js-common-image_show" accept=".png,.jpg,.svg" />
                                @if (Model != null && Model.RestaurantTable_Image != null)
                                {
                                    <img style="max-width:250px;max-height:250px;background: #f3f3f3;" class="HIDE-js-common-image_show-item" src="@Url.Action("GetImage", "RestaurantTableStatuses", new { ID = Model.ID })" alt="" />
                                    <div class="clearfix"></div>
                                }
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}