@{
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";

    // Ошибка
    @if (string.IsNullOrWhiteSpace(ViewBag.StatusCode))
    {
        ViewData["Title"] = "Ошибка";
    }
    else
    {
        ViewData["Title"] = $"Ошибка {ViewBag.StatusCode}";
    }
}

@* Контент *@
<div class="content-wrapper pt-3" style="margin-left: 0px !important;">

    @* Контент > Содержимое *@
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-danger">
                        @* Контент > Содержимое > Заголовок *@
                        <div class="card-header">
                            @if (string.IsNullOrWhiteSpace(ViewBag.StatusCode))
                            {
                                <h3 class="card-title">Информация об ошибке</h3>
                            }
                            else
                            {
                                <h3 class="card-title">Информация об ошибке @ViewBag.StatusCode</h3>
                            }
                        </div>

                        @* Контент > Содержимое > Текст *@
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(ViewBag.Text))
                            {
                                <p>@ViewBag.Text</p>
                            }
                            <p>Обратитесь к разработчикам <a href="mailto:support@HIDEerv.ru">support@HIDEerv.ru</a>:</p>
                            <ol>
                                <li>Приложите скриншот и описание после чего возникла ошибка;</li>
                                <li>Заявка будет рассмотрена в течение 24 часов;</li>
                                <li>После рассмотрения заявки вам будет отправлено письмо на почту.</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>