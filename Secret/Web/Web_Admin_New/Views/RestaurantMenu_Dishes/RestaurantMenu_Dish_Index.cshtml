@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantMenu_Dishes
@model Model_RestaurantMenu_Dishes_Index
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "RestaurantMenu_Dishes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Блюда ресторана";
    ViewBag.RazdelNameMobile = "Блюда";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[8].Value;
}

@* Меню *@
<section class="content HIDE-table HIDE-table_actions">
    <div class="container-fluid">
        <div class="row">

            @* Левый блок *@
            <div class="col-2">
                <div class="card">

                    @* Заголовок > Список автоматов *@
                    <div class="card-header HIDE-card-header_left">
                        <h3 class="card-title">Список категорий</h3>
                    </div>

                    @* Поиск по левой таблице *@
                    <div class="HIDE-header-search HIDE-mobile_none">
                        <input HIDEholder="Поиск" class="HIDE-js-search-avtomats" />
                    </div>

                    @* Левая таблица > Выбор категории *@
                    <div class="HIDE-scroll HIDE-mobile_none">
                        <div class="HIDE-table-left">
                            <table id="HIDE-table-avtomats" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th class="search">

                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.List_Categories != null)
                                    {
                                        @foreach (CCommon elem in Model.List_Categories)
                                        {
                                            @if (Model.Dish_CategoryID.HasValue && Model.Dish_CategoryID > 0 && elem.ID == Model.Dish_CategoryID)
                                            {
                                                <tr>
                                                    <td>
                                                        <a style="color:#007bff" asp-action="RestaurantMenu_Dish_Index" asp-controller="RestaurantMenu_Dishes" asp-route-RestaurantMenuID="@Model.RestaurantMenuID" asp-route-Dish_CategoryID="@elem.ID">@elem.Name</a>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td>
                                                        <a asp-action="RestaurantMenu_Dish_Index" asp-controller="RestaurantMenu_Dishes" asp-route-RestaurantMenuID="@Model.RestaurantMenuID" asp-route-Dish_CategoryID="@elem.ID">@elem.Name</a>
                                                    </td>
                                                </tr>
                                            }

                                        }
                                    }
                                </tbody>

                            </table>
                        </div>
                    </div>

                    @* Выбор категории > мобильная версия *@
                    <div class="HIDE-mobile_block HIDE-js-select_search">
                        <select asp-for="Dish_CategoryID" asp-items="Model.List_Categories_ForSelect" id="HIDE-js-left-table">
                            <option selected="selected" value="-1">Выберите категорию</option>
                        </select>
                    </div>

                </div>
            </div>

            <div class="col-10">
                <div class="card">

                    @if (Model.Dish_CategoryID > 0)
                    {
                        <div class="card-header HIDE-card-header">

                            @* Наименование блюда *@
                            <div class="HIDE-table-title HIDE-card-header_left">
                                <h3 class="card-title" style="padding-top:3px">
                                    Список записей
                                </h3>
                            </div>

                            @* Параметры *@
                            <div class="HIDE-card-options">

                                @* Поиск по таблице *@
                                <div class="HIDE-button-search">
                                    <input HIDEholder="Поиск по наименованию" class="HIDE-js-search-avtomats_right" />
                                    <div class="HIDE-jscss-button-show"><button type="button"></button></div>
                                </div>

                                @* Общий блок с сортировками *@
                                <div class="HIDE-header-slide">

                                    @* Обновление (60 сек.) + Экспорт *@
                                    <div class="HIDE-right-buttons">

                                        @* Показать заголовки в таблице head *@
                                        <div class="HIDE-button-reload">
                                            <label for="HIDE-show-title">
                                                <span style="color:#3c8dbc;padding:5px"> Показать заголовки </span>
                                            </label>
                                            <input type="checkbox" id="HIDE-show-title" class="HIDE-js-show_title">
                                        </div>

                                        @* Экспорт *@
                                        <div class="HIDE-button-wrapp">
                                            <button type="button" class="HIDE-js-open_button"> Экспорт </button>
                                            <div class="HIDE-table-buttons">
                                            </div>
                                        </div>

                                        @* Пагинация *@
                                        <div class="HIDE-right-buttons-pagination"></div>

                                        @* Скрыть товары с данной категории *@
                                        <form asp-action="RestaurantMenu_DishCategory_Del" method="POST" class="HIDE-button-add mr-2">
                                            <input type="hidden" asp-for="RestaurantMenuID" />
                                            <input type="hidden" asp-for="Dish_CategoryID" />

                                            <div class="HIDE-button-add">
                                                <button type="submit" class="btn btn-block btn-danger btn-sm"><i class="fas fa-remove"></i>Скрыть все товары категории</button>
                                            </div>
                                        </form>

                                        @* Открыть товары с данной категории *@
                                        <form asp-action="RestaurantMenu_DishCategory_Open" method="POST" class="HIDE-button-add mr-2">
                                            <input type="hidden" asp-for="RestaurantMenuID" />
                                            <input type="hidden" asp-for="Dish_CategoryID" />

                                            <div class="HIDE-button-add">
                                                <button type="submit" class="btn btn-block btn-success btn-sm"><i class="fas fa-remove"></i>Открыть все товары категории</button>
                                            </div>
                                        </form>

                                        @* Добавить блюдо *@
                                        <div class="HIDE-button-add">
                                            <a asp-controller="RestaurantMenu_Dishes" asp-action="RestaurantMenu_Dish_Add" asp-route-RestaurantMenuID="@Model.RestaurantMenuID" asp-route-Dish_CategoryID="@Model.Dish_CategoryID" class="btn btn-block btn-primary"><i class="fas fa-plus"></i>Добавить</a>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                    @* Таблица *@
                    <div class="HIDE-js-partial_table HIDE-partial-table HIDE-partial-table__scroll">
                        <partial name="RestaurantMenu_Dish_Part_Table">
                    </div>

                </div>
            </div>

        </div>

    </div>

</section>

@section scripts {

@* Таблицы *@
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.searchBuilder.min.js"></script>

@* Датапикер *@
    <script src="~/lib/bootstrap-daterangepicker/moment.min.js"></script>
    <script src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>

@* Общий js для страницы *@
    <script src="~/js/Views/RestaurantMenu_Dishes/RestaurantMenu_DishIndex.js"></script>

}