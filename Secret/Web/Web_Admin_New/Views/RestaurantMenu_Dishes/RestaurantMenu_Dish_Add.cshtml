@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantMenu_Dishes
@model Model_RestaurantMenu_Dishes_CRUD
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "RestaurantMenu_Dishes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить блюдо";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление пользователя *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    @if (Model.List_Dishes != null && Model.List_Dishes.Count != 0)
                    {
                        <form asp-action="RestaurantMenu_Dish_Add">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Restaurant_MenuID" />
                            <input type="hidden" asp-for="Dish_CategoryID" />

                            <div class="card-body">

                                @* Блюдо *@
                                @if (Model.List_Dishes != null && Model.List_Dishes.Count != 0)
                                {
                                    <div class="form-group pt-3">
                                        <label asp-for="DishID">Блюдо*</label>
                                        <select asp-for="DishID" id="DishID" class="custom-select HIDE-custom-select rounded-0">
                                            @foreach (var item in Model.List_Dishes)
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @* Стоимость *@
                                <div class="form-group">
                                    <label asp-for="Price" class="control-label">Стоимость*</label>
                                    <input asp-for="Price" class="form-control" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>

                                @* Порядок отображения *@
                                <div class="form-group">
                                    <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                    <input asp-for="OrderNum" class="form-control" type="number" />
                                    <span asp-validation-for="OrderNum" class="text-danger"></span>
                                </div>

                                @* Новинка *@
                                <div class="form-group form-check">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="FlagNew" /> Новинка
                                    </label>
                                </div>
                                
                                @* Доступно *@
                                <div class="form-group form-check">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="Flag_Available" /> Доступно
                                    </label>
                                </div>

                            </div>

                            @* Кнопки *@
                            <div class="card-footer">
                                <div class="row">

                                    @* Назад *@
                                    <div class="col-md-6">
                                        <div class="form-group mb-0 pt-2">
                                            <a class="text-decoration-none" asp-action="RestaurantMenu_Dish_Index" asp-route-RestaurantMenuID="@Model.Restaurant_MenuID"
                                            asp-route-Dish_CategoryID="@Model.Dish_CategoryID">Назад</a>
                                        </div>
                                    </div>

                                    @* Добавить *@
                                    <div class="col-md-6">
                                        <div class="form-group text-right mb-0">
                                            <input type="submit" value="Добавить" class="btn btn-primary" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </form>
                    }
                    else
                    {
                        <div class="card-body">

                            <div class="callout callout-success mt-4">
                                <b>Основное меню полностью совпадает с меню ресторана.</b>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="RestaurantMenu_Dish_Index" asp-route-RestaurantMenuID="@Model.Restaurant_MenuID"
                                           asp-route-Dish_CategoryID="@Model.Dish_CategoryID">Назад</a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}