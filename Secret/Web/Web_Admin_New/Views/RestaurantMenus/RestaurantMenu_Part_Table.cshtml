@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantMenus
@model Model_RestaurantMenus_Index
@{
    // Таблица > Меню ресторана
    Layout = null;
}

@* Таблица > Меню ресторана *@
@if (Model != null && Model.List_Restaurant_Menus != null && Model.List_Restaurant_Menus.Count != 0)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu().Restaurant)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu().Restaurant)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu().Restaurant)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu().Name)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu().Name)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu().Flag_Active)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu().Flag_Active)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu().Flag_Active)</span>
                </th>
                <th data-orderable="false" style="min-width: 110px; width: 110px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Restaurant_Menus)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td> 
                    <td>
                        @Html.DisplayFor(modelItem => item.Flag_Active)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-controller="RestaurantMenu_Dishes" asp-action="RestaurantMenu_Dish_Index" asp-route-RestaurantMenuID="@item.ID" class="btn btn-block bg-gradient-primary text-white"><i class="fas fa-book"></i></a>
                        <a asp-action="RestaurantMenu_Migrator" asp-route-ID="@item.ID" class="btn btn-block bg-gradient-info text-white" style="margin: 0 5px 0 0;"><i class="fas fa-database"></i></a>
                        <a asp-action="RestaurantMenu_Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning" style="margin: 0 5px 0 0;"><i class="fas fa-edit "></i></a>
                        <a asp-action="RestaurantMenu_Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger" style="margin-top: 0 !important;"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}