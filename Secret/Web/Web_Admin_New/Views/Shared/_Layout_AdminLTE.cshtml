@{
    Layout = null;

    // Соль
    string s_Salt = "11022022_1000";

    // Получение имени пользователя
    string id_FIO = "HIDE-js-header-fio-" + Guid.NewGuid();

    // Активый элемент меню
    string? s_sidebar_active = ViewData["Sidebar"]?.ToString();

}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HIDE.RestAndRant.Web_Admin_ForMenu</title>

    <!-- Шрифты > Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Иконки -->
    <link href="~/lib/font-awesome/css/all.min.css?@s_Salt" rel="stylesheet" />

    <!-- Выпадающий список -->
    <link href="~/lib/select2/css/select2.min.css?@s_Salt" rel="stylesheet" />

    <!-- Редактор -->
    <link href="~/lib/summernote/summernote-bs4.css?@s_Salt" rel="stylesheet" />

    <!-- admin-lte > Главный CSS -->
    <link href="~/lib/admin-lte/css/adminlte.min.css?@s_Salt" rel="stylesheet" />

    <link href="~/HIDE/color.css?@s_Salt" rel="stylesheet" />

    <style>
        .HIDE-td-mobile { display: none; }
        .HIDE-display_none { display: none !important; }
        .table.table-bordered.dataTable tbody .HIDE-display_none { display: none !important; }

        table.table-bordered.dataTable .group td {
            font-size: 1.1em;
            font-weight: bold;
        }

        .HIDE-bg_noactive td { color: #978888; }
        .HIDE-bg_noactive td a { color: #978888 !important; }

        /* Строка с удалённой категорией */
        .HIDE-bg-category-deleted {
            background-color: #fff3cd !important;
            opacity: 0.85;
        }
        .HIDE-bg-category-deleted td { color: #856404 !important; }
        .HIDE-bg-category-deleted td a { color: #856404 !important; }
        .HIDE-bg-category-deleted .btn { opacity: 0.7; }

        .text-danger i.fa-exclamation-triangle {
            margin-right: 5px;
            color: #dc3545;
        }

        .badge.badge-danger {
            font-size: 10px;
            margin-left: 5px;
            padding: 3px 6px;
            vertical-align: middle;
        }

        .HIDE-bg-deleted {
            background-color: #f8d7da;
            opacity: 0.85;
        }

        /* ====== Компактное плоское меню сайдбара ====== */
        .sidebar .nav-sidebar .nav-link {
            padding: 6px 12px;
        }
        .sidebar .nav-sidebar .nav-link p {
            font-size: 14px;
            line-height: 1.2;
        }
        .sidebar .nav-header {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #c2c7d0;
            padding: 8px 12px 4px 12px;
            margin-top: 4px;
            border-top: 1px solid #4b545c;
        }
        .sidebar .nav-header:first-child {
            border-top: none;
            margin-top: 0;
        }
    </style>

    <!-- HIDE >  CSS -->
    <link href="~/HIDE/base_2.css?@s_Salt" rel="stylesheet" />
    <link href="~/HIDE/select.css?@s_Salt" rel="stylesheet" />

    <!-- Таблицы -->
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap4.min.css">

    <!-- Датапикер -->
    <link rel="stylesheet" href="~/lib/bootstrap-daterangepicker/daterangepicker.css">

</head>
<body class="hold-transition sidebar-mini layout-fixed layout-footer-fixed">

    <div class="wrapper">

        <!-- Боковое меню -->
        @* При наведении на боковое меню не раскрывать его - sidebar-no-expand *@
        <aside class="main-sidebar sidebar-dark-primary elevation-4 sidebar-no-expand">

            <!-- Меню > Левое -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <!-- Боковое меню > Меню -->
            <div class="sidebar">
                <nav class="mt-2">
                    @* Плоское меню — без treeview, без выпадающих списков *@
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">

                        <!-- ============ Раздел: Меню ============ -->
                        <li class="nav-header">Меню</li>

                        <li class="nav-item">
                            <a asp-controller="Menu" asp-action="Index" class="nav-link @(s_sidebar_active == "Menu_List" ? "active" : "")">
                                <i class="nav-icon fas fa-utensils"></i>
                                <p>Список меню</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Menu" asp-action="AllCategories" class="nav-link @(s_sidebar_active == "Category_List" ? "active" : "")">
                                <i class="nav-icon fas fa-folder-open"></i>
                                <p>Все категории</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Menu" asp-action="AllSubcategories" class="nav-link @(s_sidebar_active == "Subcategory_List" ? "active" : "")">
                                <i class="nav-icon fas fa-folder"></i>
                                <p>Все подкатегории</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Menu" asp-action="AllDishes" class="nav-link @(s_sidebar_active == "Dish_List" ? "active" : "")">
                                <i class="nav-icon fas fa-utensil-spoon"></i>
                                <p>Все блюда</p>
                            </a>
                        </li>

                        <!-- ============ Раздел: Ингредиенты ============ -->
                        <li class="nav-header">Ингредиенты</li>

                        <li class="nav-item">
                            <a asp-controller="Menu" asp-action="AllIngredientGroups" class="nav-link @(s_sidebar_active == "Ingredient_Group_List" ? "active" : "")">
                                <i class="nav-icon fas fa-layer-group"></i>
                                <p>Группы ингредиентов</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Menu" asp-action="AllIngredients" class="nav-link @(s_sidebar_active == "Ingredient_List" ? "active" : "")">
                                <i class="nav-icon fas fa-egg"></i>
                                <p>Все ингредиенты</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="" asp-controller="MenuImportExport" asp-action="Index" class="nav-link @(s_sidebar_active == "ImportExport_List" ? "active" : "")">
                                <i class="nav-icon fas fa-file-excel"></i>
                                <p>Импорт/Экспорт</p>
                            </a>
                        </li>

                        <!-- ============ Раздел: Заказы и клиенты ============ -->
                        <li class="nav-header">Заказы</li>

                        <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Index" class="nav-link @(s_sidebar_active == "Order_List" ? "active" : "")">
                                <i class="nav-icon fas fa-shopping-cart"></i>
                                <p>Заказы</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="OrderStatuses" asp-action="OrderStatuses_Index" class="nav-link @(s_sidebar_active == "OrderStatuses_Index" ? "active" : "")">
                                <i class="nav-icon fas fa-tag"></i>
                                <p>Статусы заказов</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Bonuses" asp-action="Bonuses_Index" class="nav-link @(s_sidebar_active == "Bonuses_List" ? "active" : "")">
                                <i class="nav-icon fas fa-gift"></i>
                                <p>Бонусы</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Clients" asp-action="Index" class="nav-link @(s_sidebar_active == "Clients_List" ? "active" : "")">
                                <i class="nav-icon fas fa-male"></i>
                                <p>Клиенты</p>
                            </a>
                        </li>

                        <!-- ============ Раздел: Рестораны ============ -->
                        <li class="nav-header">Рестораны</li>

                        <li class="nav-item">
                            <a asp-controller="Restaurants" asp-action="Index" class="nav-link @(s_sidebar_active == "Restaurants_List" ? "active" : "")">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Рестораны</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="RestaurantTables" asp-action="Index" class="nav-link @(s_sidebar_active == "Restaurant_Tables_List" ? "active" : "")">
                                <i class="nav-icon fas fa-certificate"></i>
                                <p>Столики в ресторане</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="RestaurantTableStatuses" asp-action="Index" class="nav-link @(s_sidebar_active == "RestaurantTableStatuses_List" ? "active" : "")">
                                <i class="nav-icon fas fa-ellipsis-v"></i>
                                <p>Статусы столиков</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Cities" asp-action="City_Index" class="nav-link @(s_sidebar_active == "Cities_List" ? "active" : "")">
                                <i class="nav-icon fas fa-bank"></i>
                                <p>Города</p>
                            </a>
                        </li>

                        <!-- ============ Раздел: Контент ============ -->
                        <li class="nav-header">Контент</li>

                        <li class="nav-item">
                            <a asp-controller="Banners" asp-action="Index" class="nav-link @(s_sidebar_active == "Banners_List" ? "active" : "")">
                                <i class="nav-icon fas fa-panorama"></i>
                                <p>Баннеры</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Pushes" asp-action="Pushes_Index" class="nav-link @(s_sidebar_active == "Pushes_List" ? "active" : "")">
                                <i class="nav-icon fas fa-commenting"></i>
                                <p>Пуши</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Ratings" asp-action="Index" class="nav-link @(s_sidebar_active == "Ratings_List" ? "active" : "")">
                                <i class="nav-icon fas fa-star"></i>
                                <p>Оценка приложения</p>
                            </a>
                        </li>

                        <!-- ============ Раздел: Система ============ -->
                        <li class="nav-header">Система</li>

                        <li class="nav-item">
                            <a asp-controller="Users" asp-action="Index" class="nav-link @(s_sidebar_active == "Users_List" ? "active" : "")">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Пользователи</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Setups" asp-action="Setups_List" class="nav-link @(s_sidebar_active == "Setups_List" ? "active" : "")">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>Настройки</p>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>

        </aside>

        @* Шапка *@
        <div class="content-wrapper content-wrapper__operator">

            @* Мобильная версия *@
            <nav class="main-header navbar navbar-expand navbar-white navbar-light HIDE-menu-mobile">

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                    </li>
                </ul>

                <h4 style="padding-top: 11px;">@Html.Raw(ViewBag.Icon) @ViewBag.RazdelNameMobile</h4>

                <nav class="main-header navbar navbar-expand navbar-white navbar-light">

                    <div class="input-group-prepend ml-auto navbar-nav HIDE-menu" style="position:relative;">

                        <div class="user-panel d-flex">
                            <div class="image">
                                <i class="nav-icon fa fa-user"></i>
                            </div>
                            <div class="info">
                                <a href="#" class="d-block"><span class="@id_FIO"></span></a>
                            </div>
                        </div>

                        <div class="HIDE-submenu">
                            <ul>

                                <li>
                                    <a href="#">Настройки</a>
                                </li>

                                <li>
                                    <a href="/Auth/LogOut">Выйти</a>
                                </li>
                            </ul>
                        </div>

                    </div>

                </nav>

                <div class="HIDE-clear"></div>

            </nav>

            @* Десктопная версия *@
            <nav class="main-header navbar navbar-expand navbar-white navbar-light main-header-operator">

                <h4>@Html.Raw(ViewBag.Icon) @ViewBag.RazdelName</h4>

                <div class="input-group-prepend navbar-nav HIDE-menu" style="position:relative; padding-left: 0; padding-right: 16px;">

                    @* Пользователь *@
                    <div class="user-panel d-flex">
                        <div class="image">
                            <i class="nav-icon fa fa-user" style="padding-top: 8px;"></i>
                        </div>
                        <div class="info">
                            <a href="#" class="d-block"><span class="@id_FIO"></span></a>
                        </div>
                    </div>

                    @* Выпадающий список *@
                    <div class="HIDE-submenu">
                        <ul>

                            <li>
                                <a href="#">Настройки</a>
                            </li>

                            <li>
                                <a asp-controller="Auth" asp-action="LogOut">Выйти</a>
                            </li>
                        </ul>
                    </div>

                </div>

                <div class="HIDE-clear"></div>

            </nav>

            @RenderBody()

        </div>

        @* Подвал *@
        <footer class="main-footer">
            Copyright &copy; @DateTime.Now.Year <a href="https://adminlte.io">AdminLTE.io</a>.
            All rights reserved.
        </footer>

    </div>

    <!-- jquery -->
    <script src="~/lib/jquery/jquery.min.js?@s_Salt"></script>

    <!-- bootstrap -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js?@s_Salt"></script>

    <!-- Выпадающий список -->
    <script src="~/lib/select2/js/select2.full.min.js?@s_Salt"></script>

    <!-- Редактор -->
    <script src="~/lib/summernote/summernote-bs4.min.js?@s_Salt"></script>
    <script src="~/lib/summernote/lang/summernote-ru-RU.min.js?@s_Salt"></script>

    <!-- admin-lte > Главный JS -->
    <script src="~/lib/admin-lte/js/adminlte.min.js?@s_Salt"></script>

    <!-- admin-lte > Главный JS -->
    <script src="~/HIDE/jquery.maskedinput.js?"></script>
    <script src="~/HIDE/apexcharts.js?"></script>
    <script src="~/HIDE/select2.min.js?"></script>

    <script src="~/HIDE/color.js?"></script>

    @RenderSection("scripts", required: false)

    <script>
        $(document).ready(function () {

            /* Инициализация выпадающих списков */
            $('.HIDE-js-select2').select2({
                language: "ru",
                "language": {
                    "noResults": function () {
                        return "Не найдено";
                    }
                }
            });

            // Select - Multiple - При выборе пунктов меню не закрывается
            $('.HIDE-js-multiple-select').select2({
                closeOnSelect: false
            });

            /* Настройка отображения выбранного изображения */
            $(".HIDE-js-common-image_show").change(function () {
                var $this = $(this);
                var $item = $this.parent().find(".HIDE-js-common-image_show-item");
                if ($item !== undefined && $item.length > 0) {
                    $item.remove();
                }

                $this.parent().find('.HIDE-file-error').remove();

                if (this.files.length > 0) {

                    if( this.files[0].size  < 10000000){

                        var reader = new FileReader();

                        reader.onload = function (e) {
                            $this.parent().append("<img style=\"max-width:250px;max-height:250px; margin-bottom:12px\" class=\"HIDE-js-common-image_show-item\" src=" + e.target.result + " alt=\"\" />");
                        };

                        reader.readAsDataURL(this.files[0]);

                    } else {

                        $this.val('');

                        $this.parent().append("<span class='text-danger HIDE-file-error'>Изображение слишком большое (макс. 10 МБ)</span>");
                    }

                }
            });

            /* Настройка отображения выбранного изображения */
            $(".HIDE-js-common-image_show").change(function () {
                var $this = $(this);
                var $item = $this.parent().find(".HIDE-js-common-image_show-item");

                if (this.files.length > 0) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $item.attr('src', e.target.result)
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });

            //Colorpicker
            $('.my-colorpicker1').colorpicker();

            $(".HIDE-menu").click(function () {

                let Submenu = $(this).find('.HIDE-submenu');

                if (Submenu.is(':visible')) {
                    Submenu.slideUp()
                }
                else {
                    Submenu.slideDown();
                }

            })

            /**
             * Главные элемент
             * */
            let $Elem = $('.HIDE-js-select_search');
            /**
             * Селектор
             * */
            let $ElemSelect = $Elem.find("select");

            $ElemSelect.select2();

            // Получение имени пользователя
            $.ajax({
                type: "GET",
                cache: false,
                contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                url: "@Url.Action(controller: "Users", action: "Get_UserName")",
                success: function (data) {
                    if (data !== undefined && data !== null && data !== "") {
                        $(".@id_FIO").html(data);
                    }
                },
                error: function (req, status, error) { }
            });

        });

    </script>
    <script>
        // Универсальные обработчики закрытия модальных окон.
        // Обходят проблемы с data-dismiss="modal".
        $(document).on('click', '[data-dismiss="modal"]', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).closest('.modal').modal('hide');
        });

        $(document).on('click', '.modal', function (e) {
            if (e.target === this) {
                $(this).modal('hide');
            }
        });

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' || e.key === 'Esc') {
                $('.modal.show').modal('hide');
            }
        });
    </script>
</body>
</html>