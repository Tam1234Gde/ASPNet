@model List<CRating>
@{
    // Таблица > Оценка приложения
    Layout = null;
}

@* Таблица > Оценка приложения *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRating().Client)" title="@Html.DisplayNameFor(x=> new CRating().Client)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRating().Client)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRating().Grade)" title="@Html.DisplayNameFor(x=> new CRating().Grade)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRating().Grade)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x=> new CRating().Text)" title="@Html.DisplayNameFor(x=> new CRating().Text)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRating().Text)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x=> new CRating().Phone)" title="@Html.DisplayNameFor(x=> new CRating().Phone)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRating().Phone)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new CRating().Date_Action)" title="@Html.DisplayNameFor(x=> new CRating().Date_Action)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRating().Date_Action)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Grade)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Text)
                    </td>   
                    <td>
                        @Html.DisplayFor(modelItem => item.Phone)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date_Action)
                    </td>
                    <td class="HIDE-button-actions">
                        @* <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a> *@
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}