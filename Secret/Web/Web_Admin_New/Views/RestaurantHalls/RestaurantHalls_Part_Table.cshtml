@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantHalls
@model Model_RestaurantHalls_Index
@{
    // Таблица > Залы в ресторане
    Layout = null;
}

@* Таблица > Залы в ресторане *@
@if (Model != null && Model.List_Restaurant_Halls != null && Model.List_Restaurant_Halls.Count != 0)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Hall().Restaurant)" title="@Html.DisplayNameFor(x=> new CRestaurant_Hall().Restaurant)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Hall().Restaurant)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Hall().Restaurant_Table_Type)" title="@Html.DisplayNameFor(x=> new CRestaurant_Hall().Restaurant_Table_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Hall().Restaurant_Table_Type)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Restaurant_Halls)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant_Table_Type)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff;"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}