@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantHalls
@model Model_RestaurantHalls_Index
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Restaurants_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Залы в ресторане";
    ViewBag.RazdelNameMobile = "Залы";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[9].Value;
}

@* Блюда *@
<section class="content HIDE-table HIDE-table_actions">
    <div class="container-fluid">
        <div class="row">

            <div class="col-12">
                <div class="card">

                    <div class="card-header HIDE-card-header">

                        @* Наименование столика *@
                        <div class="HIDE-table-title HIDE-card-header_left">
                            <h3 class="card-title" style="padding-top:3px">
                                Список записей
                            </h3>
                        </div>

                        @* Параметры *@
                        <div class="HIDE-card-options">

                            @* Поиск по таблице *@
                            <div class="HIDE-button-search">
                                <input HIDEholder="Поиск по наименованию" class="HIDE-js-search-avtomats_right" />
                                <div class="HIDE-jscss-button-show"><button type="button"></button></div>
                            </div>

                            @* Общий блок с сортировками *@
                            <div class="HIDE-header-slide">

                                @* Обновление (60 сек.) + Экспорт *@
                                <div class="HIDE-right-buttons">

                                    @* Показать заголовки в таблице head *@
                                    <div class="HIDE-button-reload">
                                        <label for="HIDE-show-title">
                                            <span style="color:#3c8dbc;padding:5px"> Показать заголовки </span>
                                        </label>
                                        <input type="checkbox" id="HIDE-show-title" class="HIDE-js-show_title">
                                    </div>

                                    @* Экспорт *@
                                    <div class="HIDE-button-wrapp">
                                        <button type="button" class="HIDE-js-open_button"> Экспорт </button>
                                        <div class="HIDE-table-buttons">
                                        </div>
                                    </div>

                                    @* Пагинация *@
                                    <div class="HIDE-right-buttons-pagination"></div>

                                    @* Добавить *@
                                    <div class="HIDE-button-add">
                                        <a asp-action="Add" asp-controller="RestaurantHalls" asp-route-RestaurantID="@Model?.Restaurant?.ID" class="btn btn-block btn-primary"><i class="fas fa-plus"></i>Добавить</a>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Таблица *@
                    <div class="HIDE-js-partial_table HIDE-partial-table HIDE-partial-table__scroll">
                        <partial name="RestaurantHalls_Part_Table">
                    </div>

                </div>
            </div>

        </div>

    </div>

</section>

@section scripts {

    @* Таблицы *@
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.searchBuilder.min.js"></script>

    @* Датапикер *@
    <script src="~/lib/bootstrap-daterangepicker/moment.min.js"></script>
    <script src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>

    @* Общий js для страницы *@
    <script src="~/js/Views/RestaurantHalls/RestaurantHallsIndex.js"></script>

}