@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantHalls
@model Model_RestaurantHalls_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Restaurants_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить зал в ресторане";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;

    string id_MediaFile = $"HIDE-js-mediafile-{Guid.NewGuid()}";
}

@* Добавление зала в ресторане *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование планировки *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование планировки*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Ресторан *@
                            @if (Model.List_Restaurants != null && Model.List_Restaurants.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="RestaurantID">Ресторан*</label>
                                    <select asp-for="RestaurantID" id="RestaurantID" class="custom-select HIDE-custom-select rounded-0">
                                        <option selected="selected" disabled="disabled" value="-1">[Не задано]</option>
                                        @foreach (var item in Model.List_Restaurants)
                                        {
                                            <option value="@item.ID">@item.Address</option>
                                        }
                                    </select>
                                    <span asp-validation-for="RestaurantID" class="text-danger"></span>
                                </div>
                            }

                            @* Тип столика *@
                            @if (Model.List_Restaurant_Table_Types != null && Model.List_Restaurant_Table_Types.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Restaurant_Table_TypeID">Тип столика*</label>
                                    <select asp-for="Restaurant_Table_TypeID" id="Restaurant_Table_TypeID" class="custom-select HIDE-custom-select rounded-0">
                                        <option selected="selected" disabled="disabled" value="-1">[Не задано]</option>
                                        @foreach (var item in Model.List_Restaurant_Table_Types)
                                        {
                                            <option value="@item.ID">@item.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Restaurant_Table_TypeID" class="text-danger"></span>
                                </div>
                            }

                            @* Изображение *@
                            <div class="form-group">
                                <label for="@id_MediaFile">Изображение</label>
                                <div class="clearfix"></div>
                                <input id="@id_MediaFile" style="display:block;" asp-for="@Model.UploadImge" type="file" class="btn btn-warning HIDE-js-common-image_show" accept=".jpg,.jpeg,.png" />
                            </div>

                            @* Активен *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Active" /> Активен
                                </label>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}