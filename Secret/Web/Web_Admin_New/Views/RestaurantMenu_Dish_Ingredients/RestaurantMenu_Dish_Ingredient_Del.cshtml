@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantMenu_Dish_Ingredients
@model Model_RestaurantMenu_Dish_Ingredients_CRUD
@{
    ViewData["Title"] = "Del";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Удалить ингредиент";
    ViewBag.RazdelNameMobile = "Удалить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;

}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <form asp-action="RestaurantMenu_Dish_Ingredient_Del">

                        <input asp-for="@Model.ID" type="hidden" />
                        <input asp-for="@Model.Dish_CategoryID" type="hidden" />
                        <input asp-for="@Model.Restaurant_Menu_DishID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить ингредиент "@Model.Ingridient"? </label>
                            </div>

                        </div>

                        <div class="card-footer">

                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-action="RestaurantMenu_Dish_Ingredient_Index" asp-route-Restaurant_Menu_DishID="@Model.Restaurant_Menu_DishID"
                                                                                     asp-route-Dish_CategoryID="@Model.Dish_CategoryID">Назад</a>
                            </div>

                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Удалить" class="btn btn-primary" />
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}