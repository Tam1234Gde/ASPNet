@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.RestaurantMenu_Dish_Ingredients
@model Model_RestaurantMenu_Dish_Ingredients_Index
@{
    // Таблица > Ингредиенты блюда
    Layout = null;
}

@* Таблица > Ингредиенты блюда *@
@if (Model != null && Model.List_Restaurant_Menu_Dish_Ingredients != null && Model.List_Restaurant_Menu_Dish_Ingredients.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search">
                    <img src="/img/icon-fields-dopfield-42.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().Ingridient)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().Ingridient)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish_Ingredient().Ingridient)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().Price)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish_Ingredient().Price)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().Cooking_Minutes)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().Cooking_Minutes)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish_Ingredient().Cooking_Minutes)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().IngridientGroupID)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish_Ingredient().IngridientGroupID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish_Ingredient().IngridientGroupID)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Restaurant_Menu_Dish_Ingredients)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ingridient)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Cooking_Minutes)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IngridientGroupID)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="RestaurantMenu_Dish_Ingredient_Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="RestaurantMenu_Dish_Ingredient_Del" asp-route-id="@item.ID" asp-route-Dish_CategoryID="@Model.Dish_CategoryID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}