@using HIDE.RestAndRant.Web_Admin_ForMenu.Models.Users
@model Model_Users_AddEdit
@{
	ViewData["Title"] = "Edit";
	Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
	ViewData["Sidebar"] = "Users_List";

	// Заголовки страницы(Основная и мобильная версия)
	ViewBag.RazdelName = "Редактировать пользователя";
	ViewBag.RazdelNameMobile = "Редактировать";

	// Иконки перед заголовком страницы
	List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
	ViewBag.Icon = test[5].Value;
}

@* Редактирование пользователя *@
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-6">
				<div class="card card-primary">

					<div class="card-header">
						<h3 class="card-title"></h3>
					</div>

					<form asp-action="Edit">

						<input type="hidden" asp-for="ID" />
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>

						<div class="card-body">

							@* Имя *@
							<div class="form-group">
								<label asp-for="Name" class="control-label">Имя</label>
								<input asp-for="Name" class="form-control" />
							</div>
                            
							@* Логин *@
							<div class="form-group">
								<label asp-for="Login" class="control-label">Логин*</label>
								<input asp-for="Login" class="form-control" />
								<span asp-validation-for="Login" class="text-danger"></span>
							</div>

							@* Пароль *@
							<div class="form-group">
								<label asp-for="Password" class="control-label">Пароль*</label>
								<input asp-for="Password" value="" class="form-control" />
								<span asp-validation-for="Password" class="text-danger"></span>
							</div>

							@* Суперадмин *@
							<div class="form-group form-check">
								<label class="form-check-label">
									<input class="form-check-input" asp-for="Flag_Root" /> Суперадмин
								</label>
							</div>
                            
							@* Админ *@
							<div class="form-group form-check">
								<label class="form-check-label">
									<input class="form-check-input" asp-for="Flag_Admin" /> Админ
								</label>
							</div>
                            
							@* Оператор *@
							<div class="form-group form-check">
								<label class="form-check-label">
									<input class="form-check-input" asp-for="Flag_Oper" /> Оператор
								</label>
							</div>

							@* Ресторан *@
							@if (Model.List_Restaurants != null && Model.List_Restaurants.Count != 0)
							{
								<div class="form-group pt-3">
									<label asp-for="RestaurantID">Ресторан</label>
									<select asp-for="RestaurantID" id="RestaurantID" class="custom-select HIDE-custom-select rounded-0">
										<option selected="selected" value="-1">[Не задано]</option>
										@foreach (var item in Model.List_Restaurants)
										{
											if (item.ID == Model.RestaurantID)
											{
												<option selected value="@item.ID">@item.Address</option>
											}
											else
											{
												<option value="@item.ID">@item.Address</option>
											}
										}
									</select>
									<span asp-validation-for="RestaurantID" class="text-danger"></span>
								</div>
							}

						</div>

						@* Кнопки *@
						<div class="card-footer">
							<div class="row">

								@* Назад *@
								<div class="col-md-6">
									<div class="form-group mb-0 pt-2">
										<a class="text-decoration-none" asp-action="Index">Назад</a>
									</div>
								</div>

								@* Сохранить *@
								<div class="col-md-6">
									<div class="form-group text-right mb-0">
										<input type="submit" value="Сохранить" class="btn btn-primary" />
									</div>
								</div>

							</div>
						</div>

					</form>

				</div>
			</div>
		</div>
	</div>

</section>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}