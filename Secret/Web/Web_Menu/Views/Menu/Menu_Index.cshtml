@using HIDE.RestAndRant.Web_Site_Menu.Models.Menu
@model Model_Menu
@{
    // Меню
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE - Блюда";
    ViewData["Sidebar"] = "Menu";

    int index = 0;
}

@* Блюда категории *@
@if (Model.List_Dishes != null && Model.List_Dishes.Count != 0)
{
    <div class="HIDE-menu-scroll HIDE-js-menu-fixed">
        <div class="HIDE-menu-scroll-block HIDE-js-menu-scroll">
            @foreach (CSiteMenu category in Model.List_Dishes)
            {
                index++;
                <div class="HIDE-menu-scroll-block-elem HIDE-js-menu-scroll-elem @Html.Raw(index == 1 ? "HIDE-menu-scroll-block-elem_active" : "")">
                    <a href="#Category_@category.CategoryID">
                        @category.Category
                    </a>
                </div>
            }
        </div>
    </div>

    @* Поиск *@
    <div class="HIDE-common-global" style="min-height:32px;">
        <div class="HIDE-search HIDE-js-menu-fixed HIDE-js-search">
            <div class="HIDE-search-input">
                <form asp-controller="Search" asp-action="Search_Index" method="GET">
                    <input asp-for="Search" type="text" required HIDEholder="Найти продукты" />
                    <button type="submit"></button>
                </form>
            </div>
        </div>
    </div>

    @* Контент *@
    <main>
        <div class="HIDE-common-global">
            <div class="HIDE-menu">

                @* <div class="HIDE-menu-back"><a asp-controller="Home" asp-action="Index"></a></div> *@

                @foreach (CSiteMenu? dish_category in Model.List_Dishes)
                {
                    <div class="HIDE-anchor HIDE-js-anchor" id="Category_@dish_category.CategoryID"></div>

                    @* Категория *@
                    <div class="HIDE-menu-title">
                        @dish_category.Category
                    </div>

                    @* Список блюд *@
                    @if (dish_category.ListDishes != null && dish_category.ListDishes.Count != 0)
                    {
                        <div class="HIDE-menu-block">
                            @foreach (CDish_ForAdmin dish in dish_category.ListDishes)
                            {
                                <div class="HIDE-menu-block-elem">

                                    @* Изображение блюда *@
                                    @if (dish.Image_Url != null)
                                    {
                                        <div class="HIDE-menu-block-elem-img">
                                            <a asp-controller="Menu" asp-action="Dish_More" asp-route-Dish_ID="@dish.ID">
                                                <img src="@dish.Image_Url" class="HIDE-menu__image">
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="HIDE-menu-block-elem-img">
                                            <a asp-controller="Menu" asp-action="Dish_More" asp-route-Dish_ID="@dish.ID">
                                                <img src="/_i/no_image.png" class="HIDE-menu__image">
                                            </a>
                                        </div>
                                    }

                                    @* Название блюда *@
                                    @if (!string.IsNullOrWhiteSpace(dish.Name))
                                    {
                                        <div class="HIDE-menu-block-elem-title">
                                            @Html.Raw(dish.Name)
                                        </div>
                                    }

                                    @* Объём *@
                                    @if (!string.IsNullOrWhiteSpace(dish.Teaser))
                                    {
                                        <div class="HIDE-menu-block-elem-size">@Html.Raw(dish.Teaser)</div>
                                    }

                                    @* Объём *@
                                    @*    @if (dish.List_Dish_Volumes != null && dish.List_Dish_Volumes.Count != 0 && dish.Price > 0)
                                    {
                                        <div class="HIDE-menu-block-elem-size">@Html.Raw(Math.Round(dish.List_Dish_Volumes.FirstOrDefault()?.VolumeValue ?? 0, 0) / 1000)?.ToString()?.ReHIDE(",", ".")  <text>мл</text></div>
                                    } *@

                                    @* Количество блюд в корзине *@
                                    @*    @if (Model.List_Dishes_Cart != null && Model.List_Dishes_Cart.Count != 0 && Model.List_Dishes_Cart.Where(p => p.DishID == dish.ID).Select(p => p.Dish_Count).FirstOrDefault() > 0)
                                    {
                                        <span class="HIDE-menu__items-count">
                                            @Math.Round(Model.List_Dishes_Cart.Where(p => p.DishID == dish.ID).Select(p => p.Dish_Count).Sum(), 0)
                                        </span>
                                    } *@

                                    <div class="HIDE-menu-block-elem-bottom">

                                        @* Цена блюда *@
                                        @if (dish.Price > 0)
                                        {
                                            <div class="HIDE-menu-block-elem-bottom-left">@Math.Round(dish.Price, 0) <text>₽</text></div>
                                        }
                                        else
                                        {
                                            if (dish.List_Dish_Volumes != null && dish.List_Dish_Volumes.Count != 0)
                                            {
                                                <div class="HIDE-menu-block-elem-bottom-left">@Math.Round(dish.List_Dish_Volumes.FirstOrDefault()?.VolumePrice ?? 0, 0) <text>₽</text></div>
                                            }
                                        }

                                        <div class="HIDE-menu-block-elem-bottom-right">
                                            <a asp-controller="Menu" asp-action="Dish_More" asp-route-Dish_ID="@dish.ID" asp-route-Url="Test">
                                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M5.17162 10.8C5.17162 11.0761 5.39548 11.3 5.67162 11.3C5.94777 11.3 6.17162 11.0761 6.17162 10.8V6.32857H10.9859C11.2621 6.32857 11.4859 6.10471 11.4859 5.82857C11.4859 5.55242 11.2621 5.32857 10.9859 5.32857H6.17162V0.514282C6.17162 0.238139 5.94777 0.0142822 5.67162 0.0142822C5.39548 0.0142822 5.17162 0.238139 5.17162 0.514282V5.32857H0.700195C0.424053 5.32857 0.200195 5.55242 0.200195 5.82857C0.200195 6.10471 0.424053 6.32857 0.700195 6.32857H5.17162V10.8Z" fill="white" />
                                                </svg>
                                            </a>
                                        </div>

                                    </div>

                                </div>
                            }
                        </div>
                    }
                }

            </div>
        </div>
    </main>
}