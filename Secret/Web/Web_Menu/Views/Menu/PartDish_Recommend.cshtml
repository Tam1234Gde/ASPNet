@using HIDE.RestAndRant.Web_Site_Menu.Models.Home
@model Model_Home_Dish
@{
    // Рекомендованные товары
    Layout = null;
}

@* Рекомендуемые товары *@
@if (Model.List_DishRecommended != null && Model.List_DishRecommended.Count != 0)
{
    <div class="HIDE-recommend">

        <div class="HIDE-menu__item-list-title">
            Рекомендуем к заказу
        </div>

        <div class="HIDE-recommend-block_scroll">
            <div class="HIDE-recommend-block">

                @foreach (CDish_ForAdmin dish in Model.List_DishRecommended)
                {
                    <div class="HIDE-recommend-block-elem @Html.Raw((Model.List_Dishes != null && Model.List_Dishes.Count != 0 && !Model.List_Dishes.Select(p => p.DishID).Contains(dish.ID)) || (Model.List_Dishes != null && Model.List_Dishes.Count == 0) ? "" : "HIDE-recommend-block-elem_active")">

                        <div class="HIDE-recommend-block-elem-img">
                            <img src="/_i/img-product-water.png" alt="Продукт" title="Продукт">
                        </div>

                        <div class="HIDE-recommend-block-elem-right">

                            <div class="HIDE-recommend-block-elem-right-title">
                                @Html.Raw(dish.Name)
                            </div>

                            @* Объём *@
                            @if (dish.List_Dish_Volumes != null && dish.List_Dish_Volumes.Count != 0 && dish.Price > 0)
                            {
                                <div class="HIDE-recommend-block-elem-right-volume">@Html.Raw(Math.Round(dish.List_Dish_Volumes.FirstOrDefault()?.VolumeValue ?? 0, 0) / 1000)?.ToString()?.ReHIDE(",", ".")  <text>мл</text></div>
                            }

                            <div class="HIDE-recommend-block-elem-right-bottom">

                                @* Цена блюда *@
                                @if (dish.Price > 0)
                                {
                                    <div class="HIDE-recommend-block-elem-right-bottom-price" data-price="@Math.Round(dish.Price, 0)">@Math.Round(dish.Price, 0) ₽</div>
                                }
                                else
                                {
                                    if (dish.List_Dish_Volumes != null && dish.List_Dish_Volumes.Count != 0)
                                    {
                                        <div class="HIDE-recommend-block-elem-right-bottom-price" data-price="@Math.Round(dish.Price, 0)">@Math.Round(dish.List_Dish_Volumes.FirstOrDefault()?.VolumePrice ?? 0, 0) ₽</div>
                                    }
                                }

                                @* @if ((Model.List_Dishes != null && Model.List_Dishes.Count != 0 && !Model.List_Dishes.Select(p => p.DishID).Contains(dish.ID)) || (Model.List_Dishes != null && Model.List_Dishes.Count == 0))
                                { *@
                                    <div class="HIDE-recommend-block-elem-right-bottom-button">
                                        <button type="button" class="HIDE-js-add_cart_recommend" data-id="@dish.ID">+</button>
                                    </div>
                                @* } *@

                            </div>

                        </div>

                    </div>
                }

            </div>
        </div>

    </div>
}