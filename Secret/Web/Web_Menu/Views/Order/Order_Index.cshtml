@using HIDE.RestAndRant.Common.ENums
@using HIDE.RestAndRant.Web_Site_Menu.Models.Common
@using HIDE.RestAndRant.Web_Site_Menu.Models.Order
@model Model_Order
@{
    // Заказ
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE - Заказ";
    ViewData["Sidebar"] = "Home";

    int? orderID = Model.OrderID.HasValue ? Model.OrderID.Value : 0;
}

@* Заказ *@
<div class="HIDE-about">

    <div class="HIDE-about-back">
        <a asp-controller="Home" asp-action="Index">
            <svg width="48" height="49" viewBox="0 0 48 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="48" height="48.1116" rx="8" fill="#30323A" />
                <path d="M12 24.0516L16.632 28.1116L18.1808 26.7606L16.1888 25.019H36V23.1038H16.184L18.1968 21.3552L16.6528 20L12 24.0516Z" fill="white" />
            </svg>
            Вернуться назад
        </a>
    </div>

    <div class="HIDE-about-content">

        <div class="HIDE-about-content_wrapp HIDE-js-about">
            <div class="HIDE-about-content-title">
                Введите номер,
            </div>

            <div class="HIDE-about-content-text">
                Чтобы увидеть детали заказа
            </div>

            @* HIDE-input-error *@
            <div class="HIDE-table-bottom-input">
                <input HIDEholder="ХХХХ" class="HIDE-js-about-input HIDE-js-order_value" inputmode="numeric" pattern="[0-9]*" maxlength="4">

                <span class="HIDE-error HIDE-js-error"></span>
            </div>

            <div class="HIDE-table-button HIDE-table-button_color">
                <button type="button" class="HIDE-js-order_button HIDE-js-open-order" disabled onclick="ym(99522310,'reachGoal','View-the-order'); return true;">
                    Посмотреть заказ
                </button>
            </div>

            <div class="HIDE-about-content-bottom">
                Забыли номер заказа? Спросите официанта, кликнув на кнопку "Позвать официанта”
            </div>

        </div>

    </div>

</div>

@* Модальное окно > Подробности заказа *@
<div id="HIDE-modal-order" class="HIDE-modal_custom" style="display: none;">
    <div class="HIDE-modal-content">

        <div class="HIDE-modal-content-top" id="HIDE-js-swipe">
            <div class="HIDE-close" id="HIDE-close"></div>
        </div>

        <div class="HIDE-js-partial_modal">
            <partial name="Part_OrderMore" />
        </div>

    </div>
</div>

@* Модальное окно > Подтверждение оплаты счета *@
<div class="modal fade HIDE-modal-clear" id="HIDE-order_confirm" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">

                <button type="button" class="HIDE-modal-close" data-dismiss="modal">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1.59681 0.273902C1.51051 0.184545 1.40727 0.113271 1.29313 0.064238C1.17898 0.0152052 1.05621 -0.0106039 0.931989 -0.0116834C0.807764 -0.0127629 0.684567 0.0109086 0.569588 0.0579504C0.454609 0.104992 0.35015 0.174462 0.262306 0.262306C0.174462 0.35015 0.104992 0.454609 0.0579504 0.569588C0.0109086 0.684567 -0.0127629 0.807764 -0.0116834 0.931989C-0.0106039 1.05621 0.0152052 1.17898 0.064238 1.29313C0.113271 1.40727 0.184545 1.51051 0.273902 1.59681L5.67687 6.99978L0.273902 12.4027C0.184545 12.489 0.113271 12.5923 0.064238 12.7064C0.0152052 12.8206 -0.0106039 12.9433 -0.0116834 13.0676C-0.0127629 13.1918 0.0109086 13.315 0.0579504 13.43C0.104992 13.5449 0.174462 13.6494 0.262306 13.7373C0.35015 13.8251 0.454609 13.8946 0.569588 13.9416C0.684567 13.9886 0.807764 14.0123 0.931989 14.0112C1.05621 14.0102 1.17898 13.9844 1.29313 13.9353C1.40727 13.8863 1.51051 13.815 1.59681 13.7257L6.99978 8.32269L12.4027 13.7257C12.489 13.815 12.5923 13.8863 12.7064 13.9353C12.8206 13.9844 12.9433 14.0102 13.0676 14.0112C13.1918 14.0123 13.315 13.9886 13.43 13.9416C13.5449 13.8946 13.6494 13.8251 13.7373 13.7373C13.8251 13.6494 13.8946 13.5449 13.9416 13.43C13.9886 13.315 14.0123 13.1918 14.0112 13.0676C14.0102 12.9433 13.9844 12.8206 13.9353 12.7064C13.8863 12.5923 13.815 12.489 13.7257 12.4027L8.32269 6.99978L13.7257 1.59681C13.815 1.51051 13.8863 1.40727 13.9353 1.29313C13.9844 1.17898 14.0102 1.05621 14.0112 0.931989C14.0123 0.807764 13.9886 0.684567 13.9416 0.569588C13.8946 0.454609 13.8251 0.35015 13.7373 0.262306C13.6494 0.174462 13.5449 0.104992 13.43 0.0579504C13.315 0.0109086 13.1918 -0.0127629 13.0676 -0.0116834C12.9433 -0.0106039 12.8206 0.0152052 12.7064 0.064238C12.5923 0.113271 12.489 0.184545 12.4027 0.273902L6.99978 5.67687L1.59681 0.273902Z" fill="#76787D" />
                    </svg>
                </button>

                <div class="HIDE-modal-content">

                    <div class="HIDE-modal-content__title">
                        Оплатить счет
                    </div>

                    <div class="HIDE-modal-content__text">
                        Вы действительно хотите завершить заказ и оплатить счет?
                    </div>

                    <div class="HIDE-modal-content-buttons">
                        <button class="HIDE-modal-content-buttons-gray" type="button" data-dismiss="modal">Отмена</button>
                        <button class="HIDE-modal-content-buttons-color HIDE-js-send_telegram" data-id="@ETgTypeMessage.Pay" data-orderid="@orderID" onclick="ym(99522310,'reachGoal','Pay-the-bill'); return true;">Оплатить</button>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>

        // Проверка введенного номера заказа
        function CheckOrder() {

            $(".HIDE-js-order_button").click(function () {

                let id = $(".HIDE-js-order_value").val();

                if (id != undefined && id != null && id != "")
                {
                    data_json = {
                       "OrderID": id
                    };

                    $.ajax({
                        type: 'GET',
                        cache: false,
                        data: data_json,
                        url: "@Url.Action("CheckOrder", "Order")",
                        success: function (data) {
                            if (data == @((int)ModelJsonResult.OK)) {
                                   $.ajax({
                                    type: 'GET',
                                    cache: false,
                                    data: data_json,
                                    url: "@Url.Action("Part_OrderMore", "Order")",
                                    success: function (data) {
                                        $(".HIDE-js-send_telegram").attr('data-orderid', id);
                                        $(".HIDE-js-partial_modal").html(data);
                                        var modal = document.getElementById("HIDE-modal-order");
                                        modal.style.display = "block";
                                        //$("#HIDE-modal-order_more").modal("show");
                                        SendMessage();
                                        CheckInput();
                                    }
                                 });
                            }
                            else {
                                $("#HIDE-modal-order").hide();
                                $(".HIDE-js-error").html('Заказ не найден. Проверьте правильность ввода. <br /> Или позовите официанта.');
                                $(".HIDE-js-about-input").addClass('HIDE-input-error');
                                CheckInput();
                            }
                         }
                     });
                  }
            });
        };

        CheckOrder();

        function CheckInput() {
            $(".HIDE-js-about-input").focus(function(){
                $(".HIDE-js-error").html('');
                $(".HIDE-js-about-input").removeClass('HIDE-input-error');
            });
        }

        // Посмотреть подробности
        function SendMessage() {

            $(".HIDE-js-send_telegram").click(function () {
                let $this = $(this);
                let id = $this.data("id");
                let order_id = $this.data("orderid");

                $this.addClass("HIDE-loader");

                data_json = {
                    "Type": id,
                    "OrderID": order_id
                };

                $.ajax({
                    type: 'POST',
                    cache: false,
                    data: data_json,
                    url: "@Url.Action("TgSend", "Common")",
                    success: function (data) {
                        if (data == @((int)ModelJsonResult.OK)) {
                            window.location.href = "/Rating/Rating_Index?OrderID=" + order_id;
                        }
                        else {
                            // $("#HIDE-modal-login_code_email").text('Ошибка отправки');
                        }
                    }
                });
            });

        };

        //SendMessage();

        const productBtnInput = document.querySelector('.HIDE-js-order_value');

        if (productBtnInput != null && productBtnInput != undefined) {
            productBtnInput.addEventListener('input',
                function (e) {
                    this.value = this.value.reHIDE(/[^\d.]/g, '');
                }
            )
        }

    </script>
}