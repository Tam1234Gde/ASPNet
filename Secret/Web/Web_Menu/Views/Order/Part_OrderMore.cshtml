@using HIDE.RestAndRant.Common.ENums
@using HIDE.RestAndRant.Web_Site_Menu.Models.Order
@model Model_Order
@{
    // Модальное окно > Подробности заказа
    Layout = null;

    // Код заказа
    int? orderID = Model.OrderID.HasValue ? Model.OrderID.Value : 0;
}

@* Модальное окно > Подробности заказа *@
<div class="HIDE-modal-content-block">

    <div class="HIDE-modal-content-block-title">
        Детали заказа № @orderID
    </div>

    @if (Model.Order != null && Model.Order.List_OrderDatas != null && Model.Order.List_OrderDatas.Count != 0)
    {
        <div class="HIDE-modal-content-block-description">
            Столик @ViewData["Restaurant_Table"] (зал)
        </div>

        <div class="HIDE-modal-content-block-list">
            @foreach (COrder_Data dish in Model.Order.List_OrderDatas)
            {
                <div class="HIDE-modal-content-block-elem">

                    <div class="HIDE-modal-content-block-elem-img">
                        <img src="@Url.Action("GetImageDish", "Menu", new { DishID = dish.DishID })" />
                    </div>

                    <div class="HIDE-modal-content-block-elem-middle">

                        <div class="HIDE-modal-content-block-elem-middle-name">
                            @Html.Raw(dish.Dish_Name)
                        </div>

                        <div class="HIDE-modal-content-block-elem-middle-dop">
                            @Html.Raw(dish.List_Dish_Ingridients != null && dish.List_Dish_Ingridients.Count != 0 ? "Есть добавки" : "Без добавок")
                        </div>

                    </div>

                    <div class="HIDE-modal-content-block-elem-right">
                        @if (dish.Dish_VolumeValue.HasValue)
                        {
                            @dish.Dish_VolumeValue.Value.ToString("#,#") <text> мл</text>

                            <br />
                        }
                        @dish.Dish_Count.ToString("#,#") шт
                    </div>

                </div>
            }
        </div>

        <div class="HIDE-modal-content-block-price">

            <div class="HIDE-modal-content-block-info-price">
                Количество: @Model.Order.List_OrderDatas.Sum(p => p.Dish_Count).ToString("#,#") позиции
            </div>

            @if (Model.Sum.HasValue)
            {
                <div class="HIDE-modal-content-block-info-price">
                    Итог: <span>@Model.Sum.Value.ToString("#,#")</span> ₽
                </div>
            }

        </div>

        @if (Model.Order.Order_StatusID != EOrder_Status.Complete && Model.Order.Order_StatusID != EOrder_Status.Cancelled)
        {
            <div class="HIDE-modal-content-block-info">

                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M6.92901 1.92669C7.72652 1.78607 8.54392 1.80391 9.33455 1.97918C10.1252 2.15446 10.8735 2.48374 11.5369 2.94824C12.2003 3.41273 12.7656 4.00333 13.2008 4.68633C13.6359 5.36932 13.9322 6.13133 14.0728 6.92884C14.2134 7.72636 14.1956 8.54376 14.0203 9.33438C13.8451 10.125 13.5158 10.8734 13.0513 11.5367C12.5868 12.2001 11.9962 12.7655 11.3132 13.2006C10.6302 13.6357 9.86818 13.932 9.07067 14.0727C8.27315 14.2133 7.45575 14.1954 6.66513 14.0202C5.87451 13.8449 5.12615 13.5156 4.46278 13.0511C3.79942 12.5866 3.23404 11.996 2.79892 11.313C2.36381 10.63 2.06748 9.86802 1.92686 9.07051C1.78623 8.27299 1.80407 7.45559 1.97934 6.66496C2.15462 5.87434 2.48391 5.12599 2.9484 4.46262C3.41289 3.79926 4.00349 3.23388 4.68649 2.79876C5.36948 2.36365 6.13149 2.06732 6.92901 1.92669ZM9.55099 1.00289C8.63216 0.799186 7.6822 0.778458 6.75536 0.941886C5.82852 1.10531 4.94294 1.4497 4.14919 1.95537C3.35544 2.46104 2.66906 3.11811 2.12925 3.88904C1.58943 4.65998 1.20675 5.52969 1.00305 6.44853C0.799349 7.36736 0.778622 8.31731 0.942048 9.24415C1.10548 10.171 1.44986 11.0566 1.95553 11.8503C2.46121 12.6441 3.11827 13.3305 3.88921 13.8703C4.66014 14.4101 5.52986 14.7928 6.44869 14.9965C7.36752 15.2002 8.31748 15.2209 9.24432 15.0575C10.1712 14.894 11.0567 14.5497 11.8505 14.044C12.6442 13.5383 13.3306 12.8812 13.8704 12.1103C14.4102 11.3394 14.7929 10.4697 14.9966 9.55083C15.2003 8.63199 15.2211 7.68204 15.0576 6.7552C14.8942 5.82835 14.5498 4.94278 14.0441 4.14903C13.5385 3.35528 12.8814 2.6689 12.1105 2.12908C11.3395 1.58927 10.4698 1.20659 9.55099 1.00289Z" fill="white" />
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8 4.16699C7.72386 4.16699 7.5 4.39085 7.5 4.66699L7.5 8.66699C7.5 8.94314 7.72386 9.16699 8 9.16699C8.27614 9.16699 8.5 8.94314 8.5 8.66699L8.5 4.66699C8.5 4.39085 8.27614 4.16699 8 4.16699Z" fill="white" />
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8 12.5C8.27614 12.5 8.5 12.2761 8.5 12L8.5 11.3333C8.5 11.0572 8.27614 10.8333 8 10.8333C7.72386 10.8333 7.5 11.0572 7.5 11.3333L7.5 12C7.5 12.2761 7.72386 12.5 8 12.5Z" fill="white" />
                </svg>

                Ваш заказ может быть задержан на 10 мин. из-за большого числа заказов.
            </div>

            <div class="HIDE-modal-content-block-button">
                <div class="HIDE-table-button HIDE-table-button_color">
                    <button data-toggle="modal" data-target="#HIDE-order_confirm">
                        Оплатить заказ
                    </button>
                </div>
            </div>
        }
    }

</div>