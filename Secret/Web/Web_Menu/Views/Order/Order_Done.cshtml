@using HIDE.RestAndRant.Web_Site_Menu.Models.Order
@model Model_Order
@{
    // Заказ оформлен
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE";
    ViewData["Sidebar"] = "Cart";
}

@* Заказ оформлен *@
<div class="HIDE-cart">
    <div class="HIDE-cart-empty">
        <div class="HIDE-cart-empty_wrapp">

            <div class="HIDE-cart-empty-top">
                Столик @ViewData["Restaurant_Table"] (зал)
            </div>

            <div class="HIDE-cart-empty-title">
                Спасибо за заказ!
            </div>

            <div class="HIDE-cart-empty-number">
                Ваш номер заказа:<br />
                @Model.OrderID
            </div>

            <div class="HIDE-cart-empty-descriptions">
                Используйте номер для просмотра деталей вашего заказа на Главной странице
            </div>

            <div class="HIDE-button">
                <a asp-controller="Home" asp-action="Index">
                    Вернуться на Главную
                </a>
            </div>

            <div class="HIDE-cart-empty-bottom">
                Официант подойдет к вам, чтобы подтвердить детали заказа через 3 мин.
            </div>

        </div>
    </div>
</div>