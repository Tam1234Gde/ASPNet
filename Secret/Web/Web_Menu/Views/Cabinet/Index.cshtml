@using HIDE.RestAndRant.Web_Site_Menu.Models.Cabinet
@using HIDE.RestAndRant.Web_Site_Menu.Models.Clients
@using HIDE.RestAndRant.Web_Site_Menu.Models.Restaurants
@model Model_Cabinet_Index
@{
    // Личный кабинет
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE - Личный кабинет";

    // Получение клиента
    Model_Client? client = Helper_Client.GetClient(Context.User);

    // Получение ресторана
    Model_Restaurant? restaurant = Helper_Common.GetRestaurant(Context.Request.Cookies[Consts.Cookies_Restaurant]);
}

@* Личный кабинет *@
<main>
    <div class="HIDE-common-global">
        @if (Model != null && Model.List_Orders != null && Model.List_Orders.Count != 0)
        {
            <div class="HIDE-profile">

                <div class="HIDE-profile-title">
                    Активные заказы
                </div>

                @foreach (COrder_ForAdmin order in Model.List_Orders)
                {
                    @if (order.Date_To > DateTime.Now)
                    {
                        <div class="HIDE-profile-block">

                            <div class="HIDE-profile-block_wrapp">
                                <div class="HIDE-profile-block-bold">
                                    Статус заказа: @order.Order_Status
                                </div>

                                <div class="HIDE-profile-block-normal">
                                    Будет ожидать через @(Math.Round((order.Date_To.Value - DateTime.Now).TotalMinutes, 0)) мин.
                                </div>
                            </div>

                            <div class="HIDE-profile-block-img">
                                <img src="/_i/img-box.png" alt="" title="" />
                            </div>

                        </div>
                    }

                    <div class="HIDE-profile-block HIDE-profile-block_order">

                        <div class="HIDE-profile-block-normal">
                            Заказ от @order.Date_Act.ToString("M")
                        </div>

                        <div class="HIDE-profile-block-bold">
                            Номер заказа: @order.ID
                        </div>

                        @if (order.List_OrderDatas != null && order.List_OrderDatas.Count != 0)
                        {
                            <div class="HIDE-profile-block-list">
                                @foreach (var dish in order.List_OrderDatas)
                                {
                                    @if (dish.Dish_Image != null)
                                    {
                                        <div class="HIDE-profile-block-list-elem">
                                            <img src="data:image/png;base64,@Convert.ToBase64String(dish.Dish_Image)">
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @{
                            decimal sum = 0;
                            sum = order.List_OrderDatas != null && order.List_OrderDatas.Count != 0 ? order.List_OrderDatas.Select(p => p.Dish_Price * p.Dish_Count).Sum() : 0;

                            if (order.List_OrderDatas != null && order.List_OrderDatas.Count != 0)
                            {
                                foreach (var elem in order.List_OrderDatas)
                                {
                                    if (elem.List_OrderDataIngridients != null && elem.List_OrderDataIngridients.Count != 0)
                                    {
                                        sum += elem.List_OrderDataIngridients.Select(p => p.Ingridient_Price * p.Ingridient_Count).Sum();
                                    }
                                }
                            }
                        }

                        <div class="HIDE-profile-block-text">
                            Оплата при получении - <span>@Math.Round(sum, 0) ₽</span>
                        </div>

                    </div>

                }

            </div>
        }
    </div>
</main>