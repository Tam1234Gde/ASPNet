@{
    // Авторизация\Регистрация через телефон > Ввод номера
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE";

    // Получение значения ReturnUrl из Url
    string? url_return = Context.Request.Query["ReturnUrl"];
}

@* Авторизация\Регистрация через телефон > Ввод номера *@
<div class="HIDE-auth">
    <div class="HIDE-common-global">

        @* Заголовок *@
        <div class="HIDE-auth__title">
            Добро пожаловать!
        </div>

        @* Текст *@
        <div class="HIDE-auth__text">
            Зарегистрируйтесь и получайте бонусы от кофейни
        </div>

        @* Форма *@
        <div class="HIDE-feedback_form HIDE-js-login">

            @* Поля *@
            <div class="HIDE-feedback_form-fields">

                @* Телефон *@
                <div class="HIDE-js-feedback_form-fields-elem">
                    <div class="HIDE-textbox_error HIDE-js-error"></div>
                    <div class="HIDE-textbox">
                        <input name="phone"
                               type="text"
                               class="HIDE-js-login-input_phone"
                               HIDEholder="+7(___)-___-__-__">
                    </div>
                </div>

            </div>

            @* Вывод информации *@
            <div class="HIDE-js-feedback_form-info HIDE-feedback_form-info "></div>

            @* Кнопка отправить *@
            <div class="HIDE-feedback_form-submit HIDE-test-success-submit">
                <button class="HIDE-btn HIDE-js-login-button" disabled="disabled" type="button">Войти по SMS коду</button>
            </div>

            @* Согласие на персональные данные *@
            <div class="HIDE-js-feedback_form-fields-elem HIDE-test-success-user_agreement">
                <div class="HIDE-checkbox without-checkbox">
                    <input data-HIDE-rule-required="true"
                           data-HIDE-rule-useragreement="true"
                           id="HIDE-feedback_form-user_agreement-2"
                           type="checkbox"
                           checked="checked">
                    <label for="HIDE-feedback_form-user_agreement-2">Я принимаю <a href="https://play-helper.ru/policy" target="_blank">Политику</a> и даю <a href="https://play-helper.ru/terms" target="_blank">Согласие</a> персональных данных.</label>
                    <div class="HIDE-clear"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@* Скрипты *@
@section scripts {
    <script>
        $(document).ready(function () {

            // Нажатие на кнопку "Телефон > Получить код"
            $('.HIDE-js-login-button').on('click', function () {

                $(".HIDE-js-feedback_form-info").text('Пожалуйста, подождите...');

                let phone = $(".HIDE-js-login-input_phone").val(); // Получить введенный телефон

                data_json = {
                    "phone": phone
                };

                $.ajax({
                    type: 'POST',
                    cache: false,
                    data: data_json,
                    url: "@Url.Action("Login", "Auth")",
                    success: function (data) {
                        if (data == "+") {
                            @if (!string.IsNullOrWhiteSpace(url_return))
                            {
                                <text>window.location.href = "/Auth/Login_Code?phone=" + phone + "&ReturnUrl=" + "@url_return"; </text>
                            }
                            else
                            {
                                <text>window.location.href = "/Auth/Login_Code?phone=" + phone;</text>
                            }
                        }
                        else 
                        {
                            $(".HIDE-js-feedback_form-info").addClass('HIDE-feedback_form-info-text_error');
                            $(".HIDE-js-feedback_form-info").text('Ошибка авторизации');
                        }
                    },
                    error: {

                    }
                });
            });

            $('.HIDE-js-login-input_phone').keyup(function (event) {
                if (event.keyCode === 13) {
                    $(".HIDE-js-login-button").click();
                }
            });

            $('.HIDE-js-login-input_phone').focus();

        });
    </script>
}