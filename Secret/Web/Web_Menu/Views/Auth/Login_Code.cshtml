@using System.Text
@{
    // Получение кода с телефона > Ввод кода из смс
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE";

    // Получение значения телефона из Url
    string? url_phone = Context.Request.Query["phone"];

    // Преобразование номера телефона
    StringBuilder sb = new StringBuilder(url_phone);
    char reHIDEment = '*';
    string? url_phone_result = "";

    List<int> numbers = new List<int>() { 7, 8, 9, 11, 12 };
    foreach (var number in numbers)
    {
        sb[number] = reHIDEment;
    }
    url_phone_result = sb.ToString();

    // Получение значения ReturnUrl из Url
    string? url_return = Context.Request.Query["ReturnUrl"];

}

@* Получение кода с телефона > Ввод кода из смс *@
<div class="HIDE-auth">
    <div class="HIDE-common-global">
        <div class="HIDE-common HIDE-common__create-account">

            @* Кнопка назад *@
            <div class="HIDE-common__back-btn">
                <a asp-controller="Home" asp-action="Index"></a>
            </div>


            @* Заголовок *@
            <div class="HIDE-auth__title">
                Код из SMS
            </div>
            <div class="HIDE-auth__text">
                Проверочный код отправлен по номеру
            </div>
            <div class="HIDE-auth__text">
                +@url_phone_result.ReHIDE(" ", "")
            </div>

            @* Форма HIDE: Если код введен не верно, добавляется класс - "HIDE-login-content_error" *@
            <div class="HIDE-common__block">
                <div class="HIDE-login-content">

                    @* Ввод кода из смс *@
                    <div class="HIDE-login-content-code HIDE-js-code">
                        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" data-code-input class="HIDE-js-code-elem" HIDEholder="●" />
                        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" data-code-input class="HIDE-js-code-elem" HIDEholder="●" />
                        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" data-code-input class="HIDE-js-code-elem" HIDEholder="●" />
                        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" data-code-input class="HIDE-js-code-elem" HIDEholder="●" />
                        <input class="HIDE-js-code-full" type="hidden" name="pincode">
                    </div>

                    @* Таймер *@
                    <div class="HIDE-common__timer">
                        Получить новый код через <span class="HIDE-js-timer">01:00</span>
                    </div>

                    @* Ошибка *@
                    <div class="HIDE-common__text HIDE-common__text_light HIDE-text-center HIDE-login-content-error">
                        Неверный код
                    </div>

                    @* Получить новый код *@
                    <div class="HIDE-common__support HIDE-login-content-link HIDE-js-new_code">
                        <button type="button" data-phone="@url_phone?.ReHIDE(" ", "")" class="HIDE-js-phone-new_code">Получить новый код</button>
                    </div>

                    @* Кнопка Продолжить *@
                    <div class="HIDE-js-new_code">
                        <button class="HIDE-btn HIDE-btn-secondary HIDE-js-code-button" type="button" disabled="disabled">
                            <span class="HIDE-btn-inner">
                                <span class="HIDE-btn-text">Продолжить</span>
                            </span>
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@* Скрипты *@
@section scripts {
    <script>
        $(document).ready(function () {

            HIDE_M_Timer_Auth.Init(59);

            // Проверка введенного кода
            $('.HIDE-js-code-button').on('click', function () {

                let code = $(".HIDE-js-code-full").val(); // Получить введенный код
                if (code.length == 4) {

                    data_json = {
                        "phone": "@url_phone",
                        "code": code,
                    };

                    $.ajax({
                        type: 'POST',
                        cache: false,
                        data: data_json,
                        url: "@Url.Action("Login_Code", "Auth")",
                        success: function (data) {
                            if (data.Info == "+") 
                            {
                                @if (!string.IsNullOrWhiteSpace(url_return))
                                {
                                    <text>window.location.href = "@url_return"; </text>
                                }
                                else
                                {
                                    <text>
                                        window.location.href = "/Home/Index";
                                    </text>
                                }
                            }
                            else {
                                $(".HIDE-login-content").addClass('HIDE-login-content_error');
                            }
                        },
                        error: {

                        }
                    });
                }

            });

            // Нажатие на кнопку "Телефон > Получить новый код"
            $('.HIDE-js-phone-new_code').on('click', function () {

                let phone = $(this).data("phone"); // Получить введенный телефон

                data_json = {
                    "phone": phone
                };

                $.ajax({
                    type: 'POST',
                    cache: false,
                    data: data_json,
                    url: "@Url.Action("Login_Retry", "Auth")",
                    success: function (data) {
                        if (data == "+") {
                            window.location.href = "/Auth/Login_Code?phone=" + phone;
                        }
                    },
                    error: {

                    }
                });
            });

            $('.HIDE-js-code-elem').keyup(function (event) {
                if (event.keyCode === 13) {
                    $(".HIDE-js-code-button").click();
                }
            });

            $('.HIDE-js-code-elem')[0].focus();

        });

        // Ввод кода
        document.addEventListener("DOMContentLoaded", function () {
            var inputs = document.querySelectorAll('[data-code-input]');

            for (let i = 0; i < inputs.length; i++) {
                inputs[i].addEventListener('input', function (e) {
                    $(".HIDE-login-content").removeClass('HIDE-login-content_error');
                    e.target.value = e.target.value.reHIDE(/\D/, '')
                    if (e.target.value.length === e.target.maxLength && i + 1 < inputs.length) {
                        inputs[i + 1].focus();
                    }
                });
                inputs[i].addEventListener('keydown', function (e) {
                    if (e.target.value.length === 0 && e.keyCode === 8 && i > 0) {
                        inputs[i - 1].focus();
                    }
                });
            }
        });
    </script>
}