@{
    // Модальное окно > Требуется авторизация
    Layout = null;
}

@* Модальное окно > Требуется авторизация *@
<div class="modal fade HIDE-modal-login" id="HIDE-modal-guid-1" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="HIDE-modal-content">

                    <div class="HIDE-modal-content__title">
                        Требуется авторизация.
                    </div>

                    <div class="HIDE-modal-content__text">
                        Для продолжения авторизуйтесь.
                    </div>

                    <div class="HIDE-modal-content-buttons">
                        <a asp-controller="Auth" asp-action="Login" id="link2" class="HIDE-modal-content-buttons-gray">Войти</a>
                        <button class="HIDE-modal-content-buttons-color" type="button" data-dismiss="modal">Отмена</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>