@using HIDE.RestAndRant.Web_Site_Menu.Models.Common
@using HIDE.RestAndRant.Web_Site_Menu.Models.Home
@{
    // Соль для файлов css и js
    string s_Salt = "17012025_1130";

    string? seo_Title = null;
    try
    {
        seo_Title = ViewBag.Title;
    }
    catch { }

    // Определение робота google speed
    string Robot_GooglePageSpeed = "Chrome-Lighthouse"; // Наименование робота сервиса google speed
    string Request_HTTP_USER_AGENT = "";
    bool Flag_isCheck_SpeedInsights = false;
    if (ViewContext.HttpContext.Request.Headers["User-Agent"] != "")
    {
        Request_HTTP_USER_AGENT = ViewContext.HttpContext.Request.Headers["User-Agent"].ToString();
        if (!string.IsNullOrWhiteSpace(Request_HTTP_USER_AGENT) && Request_HTTP_USER_AGENT.Contains(Robot_GooglePageSpeed))
        {
            Flag_isCheck_SpeedInsights = true;
        }
    }

    // Активый элемент меню
    string? s_sidebar_active = ViewData["Sidebar"]?.ToString();

    // Url
    string url = Context.Request.Path;

}

<!DOCTYPE html>
<html>
<head>

    @* system *@
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="msapplication-tap-highlight" content="no" />
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1,minimum-scale=1.0,maximum-scale=1.0,user-scalable=yes" name="viewport" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="format-detection" content="address=no" />
    @* /system *@

    @* favicon *@
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest.json" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="theme-color" content="#ffffff" />
    @* favicon *@

    @* headers *@
    @if (string.IsNullOrWhiteSpace(seo_Title))
    {
        <title>HIDE HIDE</title>
    }
    else
    {
        <title>@seo_Title</title>
    }
    @* /headers *@

    @RenderSection("Head_Top", required: false)

    @* Стили css *@
    <style>

        .HIDE-screensaver-description-conteiner-load {
            font-size: 20px;
            font-weight: normal;
            font-style: normal;
            color: #727C8E;
            line-height: 1.3;
            text-align: center;
        }

        .HIDE-preloader {
            position: fixed;
            z-index: 9999;
            width: 100%;
            height: 100%;
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
        }

        .HIDE-preloader_search {
            position: fixed;
            z-index: 9999;
            width: 100%;
            height: 100%;
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            display: block;
            background: #fff;
            opacity: 0;
        }

            .HIDE-preloader_search .HIDE-screensaver-description-conteiner-gif {
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                bottom: 0;
                width: 50px;
                height: 50px;
                background: transparent;
                animation-name: rotation;
                animation-duration: 2s;
                animation-iteration-count: infinite;
                animation-timing-function: linear;
                margin: auto;
            }

    </style>

    @* CSS *@
    <link href="~/_c/base.min.css?@s_Salt" rel="stylesheet" />

</head>
<body @* class="HIDE-body_full" *@>

    @* Яндекс Метрика *@
    @if (!Flag_isCheck_SpeedInsights)
    {
        <script type="text/javascript">
            (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
            (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

            ym(99522310, "init", {
            clickmap:true,
            trackLinks:true,
            accurateTrackBounce:true,
            webvisor:true
            });
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/99522310" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    }

    @* Шапка *@
    <partial name="_Header" />

    @RenderBody()

    @* Модальное окно > Товар успешно добавлен в корзину *@
    <partial name="_Modal_CartAdd" />

    @* Нижняя плашка *@
    <div class="HIDE-js-partial_bottombar">
        @Html.Action("Part_BottomBar", "Home", parameters: new Model_BottomBar { Menu = s_sidebar_active }) @*TODO:MAE - не вижу! KMI - Использование HTMLHelper тут*@
    </div>

    @* Отсканируйте QR-код *@
    <partial name="_Modal_QR" />

    @* Скрипты *@
    @RenderSection("scripts_top", required: false)
    @Html.PageScripts_Top()
    <script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU"></script>
    <script src="~/scripts/bundle.min.js?@s_Salt"></script>
    @RenderSection("scripts", required: false)
    @Html.PageScripts()

    <script>

        $(document).ready(function () {

            // Проверка, что столик выбран
            function CheckTable() {

                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: "@Url.Action("CheckRestaurantTable", "Common")",
                    success: function (data) {
                        if (data !== @((int)ModelJsonResult.OK)) {
                            $("#HIDE-modal-qr").modal("show");
                        }
                    }
                });

            }

            CheckTable();

        });

    </script>

</body>
</html>