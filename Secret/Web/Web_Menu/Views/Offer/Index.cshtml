@using HIDE.RestAndRant.Common.ENums
@using HIDE.RestAndRant.Web_Site_Menu.Models.Clients
@using HIDE.RestAndRant.Web_Site_Menu.Models.Offer
@using HIDE.RestAndRant.Web_Site_Menu.Models.Restaurants
@model Model_Offer_Index
@{
    // Оформление заказа
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE - Оформление заказа";

    // Получение клиента
    Model_Client? client = Helper_Client.GetClient(Context.User);

    // Получение ресторана
    Model_Restaurant? restaurant = Helper_Common.GetRestaurant(Context.Request.Cookies[Consts.Cookies_Restaurant]);

    int index = 0;

        long phone_long = (long)Convert.ToDouble(Model.Client?.Phone);
        string phone_result = (phone_long.ToString("+# (###) ###-##-##"));

    string dish_count = "товар";
    if (Model.Dish_Count == 2 || Model.Dish_Count == 3 || Model.Dish_Count == 4)
    {
        dish_count = "товара";
    }
      if (Model.Dish_Count >= 5)
    {
        dish_count = "товаров";
    }


}

    <main>
        <div class="HIDE-common-global">

            <div class="HIDE-menu-back"><a asp-controller="Cart" asp-action="Index"></a></div>

            <div class="HIDE-order_child">
                 
                <div class="HIDE-order-block">

                    <div class="HIDE-order-block-title">
                        Контактные данные
                    </div>

                    <div class="HIDE-order-block-elem">
                        <input type="text" class="HIDE-js-client_name" value="@Model.Client?.Name" />
                    </div>

                    <div class="HIDE-order-block-elem">
                        <input type="text" class="HIDE-js-client_phone" readonly value="@phone_result" />
                    </div>

                </div>


                @if (Model.List_PayTypes != null && Model.List_PayTypes.Count != 0)
                {
                  <div class="HIDE-order-block">

                      <div class="HIDE-order-block-title">
                        Способы оплаты
                    </div>

                            <div class="HIDE-order-block-tab HIDE-js-tabs">
                                
                                <div class="HIDE-order-block-tab-buttons">
                                           @foreach (var elem in Model.List_PayTypes.Where(p => p.ID != (int)EPayType.CardInApp))
                        {
                        index++;

                            <div class="HIDE-order-block-tab-buttons-elem @Html.Raw(index == 1 ? "HIDE-order-block-tab-buttons-elem_active": "") HIDE-js-tabs-button" data-id="@elem.ID">
                                    @if (elem.Name == "Оплата через терминал")
                                    {
                                        <text>Оплата картой</text>
                                    }
                                    else
                                    {
                                                                         @elem.Name   
                                    }
                            </div>
                            }

                        </div>

                                <div class="HIDE-order-block-tab-block HIDE-js-tabs-block" data-id="@((int)EPayType.Money)">

                            <div class="HIDE-order-block-tab-block-radio">
                                <div class="HIDE-order-block-tab-block-radio-text">
                                    Нужна сдача?
                                </div>
                                <input type="checkbox" id="HIDE-handing" />
                                <label for="HIDE-handing">

                                    <span class="HIDE-switch-button">

                                    </span>
                                </label>
                            </div>

                            <div class="HIDE-order-block-elem HIDE-js-block-handing" style="display:none;">
                                <label for="">
                                    Купюра 
                                </label>
                                <input type="number" class="HIDE-js-handing" HIDEholder="" />
                            </div>

                        </div>

                            </div>
              
                    </div>
                }

                <div class="HIDE-order-block HIDE-order-block_flex">
                    <div class="HIDE-order-block-left">
                        <div class="HIDE-order-block-left-count">
                            @Model.Dish_Count @dish_count
                        </div>
                        <div class="HIDE-order-block-left-text">
                            Заказ ожидает вас через @Model.Cooking_Ready мин
                        </div>
                    </div>

                    <div class="HIDE-order-block-right">
                        <div class="HIDE-order-block-right-price">
                            @Math.Round(HIDE_Convert.ToDecimal(Model.Sum), 0) ₽
                        </div>

                        <div class="HIDE-order-block-right-text">
                            Итого на сумму
                        </div>

                    </div>

                </div>

                <div class="HIDE-order-policy">
                    <input type="checkbox" id="HIDE-policy" />

                    <label for="HIDE-policy">
                        Согласен с условиями <a href="#">Политики обработки персональных данных</a> и <a href="#">Правилами пользования торговой площадкой</a>
                    </label>

                </div>

            </div>
              
        </div>
    </main>

    @* Заказать *@
    <div class="HIDE-fixed-button">
        <button type="submit" class="HIDE-js-policy-button HIDE-js-offer" disabled>
            Заказать
        </button>
    </div>

@section scripts {
    <script>

        // Прелоадер
function Preloader() {
    $("body").append(
        `<div class="HIDE-js-preloader_search HIDE-preloader_search">
            <div class="HIDE-screensaver">
                <div class="HIDE-screensaver-description-conteiner-gif_2" style=" width: 32px; height: 32px; margin: auto ;  position: absolute; left: 0; right: 0; top: 0; bottom: 0; animation-name: rotation; animation-duration: 2s; animation-iteration-count: infinite; animation-timing-function: linear;">
                    <img src="/_i/loading.gif" />
                </div>
            </div>
        </div>`
    );

    const $preloader_search = $('.HIDE-js-preloader_search');
    $preloader_search.animate({ opacity: "0.8" }, 500, undefined);
};

        // Нажатие на кнопку "Заказать"
        $('.HIDE-js-offer').on('click', function () {

            //Preloader();

            let client_name = $(".HIDE-js-client_name").val();
            let client_phone = $(".HIDE-js-client_phone").val();
            let handing = $(".HIDE-js-handing").val();
            let pay_type = 0;
                 $('.HIDE-js-tabs-button').each(function () {
                    let atrr_value2 = $(this).data("id");
                    if ($(this).hasClass("HIDE-order-block-tab-buttons-elem_active")) {
                        pay_type = $(this).data("id");
                    }
                });

            data_json = {
                "Pay_TypeID": pay_type,
                "Name": client_name,
                "Phone": client_phone,
                "RestaurantID": @restaurant?.RestaurantID,
                "Cooking_Ready": @Model?.Cooking_Ready,
                "Restaurant_TableID": null,
                "Date_BookingStart": null,
                "Date_BookingEnd": null,
                "Handing": handing,
            };

            $.ajax({
                type: 'POST',
                cache: false,
                data: data_json,
                url: "@Url.Action("Offer", "Offer")",
                success: function (data) {
                    if (data == "+") {
                                   // Прелоадер
                    // const $preloader_search = $('.HIDE-js-preloader_search');
                    // $preloader_search.animate({ opacity: "0" }, 500, undefined);
                    // $preloader_search.hide();
                    // $preloader_search.remove();

                        window.location.href = "/Cabinet/Index";
                    }
                    else {

                    }
                },
                error: {

                }
            });
        });


        // Нажатие на кнопку "Изменить ресторан"
        $('.HIDE-js-restaurant').on('click', function () {
            let id = $(this).data("id");

            data_json = {
                "RestaurantID": id
            };

            $.ajax({
                type: 'GET',
                cache: false,
                data: data_json,
                url: "@Url.Action("ChooseRestaurant", "Home")",
                success: function (data) {
                    window.location.reload();
                }
            });
        }); 
        
         // Нажатие на кнопку "Изменить ресторан"
        $('.HIDE-js-cart-offer_auth').on('click', function () {
            var strLink = "/Auth/Login?ReturnUrl=" + "/Cart/Index";
            document.getElementById("link2").setAttribute("href", strLink);
        });

        // Нажатие на кнопку "Изменить ресторан"
        $('.HIDE-js-cart-offer').on('click', function () {

            @if (restaurant != null) {
                <text>window.location.href = "/Offer/Index"; </text>
            }
            else{
                <text>$(".HIDE-js-error-restaurant").text("Выберите ресторан")</text>
            }

            data_json = {
                "RestaurantID": id
            };

            $.ajax({
                type: 'GET',
                cache: false,
                data: data_json,
                url: "@Url.Action("ChooseRestaurant", "Home")",
                success: function (data) {
                    window.location.reload();
                }
            });
        });

    </script>
}