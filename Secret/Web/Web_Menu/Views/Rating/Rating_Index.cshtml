            </g>
            <defs>
                <clipPath id="clip0_307_8831">
                    <rect width="32" height="32" fill="white" />
                </clipPath>
            </defs>
        </svg>
    </div>

    <div class="HIDE-cart-title">
        Официант подойдет к вам <br />
        через 3 минуты  для оплаты
    </div>

    <div class="HIDE-cart-block">

        <div class="HIDE-cart-block-title">
            Оцените нашу работу
        </div>

        <div class="HIDE-cart-block-text">
            Помогите стать лучше. Оцените работу персонала, коснувшись звезды
        </div>

        <div class="HIDE-cart-block-rating HIDE-js-rating">
            <div class="rating-area">

                <input class="HIDE-js-rating-input_full" />

                <input type="radio" id="star-5" name="rating" value="5" class="HIDE-js-rating-input_elem" title="Все нравится">
                <label for="star-5" title="Все нравится"></label>
                <input type="radio" id="star-4" name="rating" value="4" class="HIDE-js-rating-input_elem" title="Нравится">
                <label for="star-4" title="Нравится"></label>
                <input type="radio" id="star-3" name="rating" value="3" class="HIDE-js-rating-input_elem" title="Есть что улучшить">
                <label for="star-3" title="Есть что улучшить"></label>
                <input type="radio" id="star-2" name="rating" value="2" class="HIDE-js-rating-input_elem" title="Не нравится">
                <label for="star-2" title="Не нравится"></label>
                <input type="radio" id="star-1" name="rating" value="1" class="HIDE-js-rating-input_elem" title="Очень не нравится">
                <label for="star-1" title="Очень не нравится"></label>

            </div>

            <div class="HIDE-cart-block-rating-text HIDE-js-rating-text"></div>
        </div>

        <div class="HIDE-cart-block-form HIDE-js-form" style="display:none;">

            <div class="HIDE-cart-block-form-elem">
                <textarea HIDEholder="Напишите свой отзыв" class="HIDE-js-rating_comment"></textarea>
            </div>

            <div class="HIDE-cart-block-form-elem">
                <input class="HIDE-js-login-input_phone HIDE-js-rating_phone" type="text" HIDEholder="+7 (___) ___ - __ - __" />
            </div>

            <div class="HIDE-cart-block-form-text">
                Хотите, чтобы мы перезвонили вам? Оставьте номер телефона.
            </div>

            <div class="HIDE-cart-block-form-error HIDE-js-error"></div>

        </div>

        <div class="HIDE-table-button HIDE-table-button_color HIDE-js-rating-button" style="display:none;">
            <button type="button" class="HIDE-js-rating_send">
                Отправить
            </button>
        </div>

    </div>

</div>

@* Скрипты *@
@section scripts {
    <script>

        // Отправка оценки
        function SendRating() {

            $(".HIDE-js-rating_send").click(function () {

                let grade = $(".HIDE-js-rating-text").data("rating");
                let phone = $(".HIDE-js-rating_phone").val();
                let text = $(".HIDE-js-rating_comment").val();

                if (grade != undefined && grade != null && grade != "") {

                    data_json = {
                        "Grade": grade,
                        "Phone": phone,
                        "Text": text,
                        "OrderID": "@Model.OrderID"
                    };

                    $.ajax({
                        type: 'POST',
                        cache: false,
                        data: data_json,
                        url: "@Url.Action("RatingSend", "Rating")",
                        success: function (data) {
                            if (data == @((int)ModelJsonResult.OK
                            )) {
                                window.location.href = "/Rating/Rating_Thanks";
                            }
                            else {
                                $(".HIDE-js-error").text('Ошибка отправки...');
                            }
                        },
                        error(){
                         $(".HIDE-js-error").text('Ошибка отправки...');
                        }
                    });
                }
            });
        };

        SendRating();

    </script>
}