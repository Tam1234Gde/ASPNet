                <path fill-rule="evenodd" clip-rule="evenodd" d="M16.0004 2.252L12.5878 4.01956C12.3157 4.16046 12.0224 4.25575 11.7196 4.30166L7.91973 4.87756L6.1978 8.31345C6.06055 8.58733 5.87928 8.83682 5.66123 9.05198L2.92561 11.7514L3.5521 15.5432C3.60204 15.8455 3.60204 16.1538 3.5521 16.4561L2.92561 20.2479L5.66123 22.9473C5.87928 23.1625 6.06055 23.412 6.1978 23.6858L7.91973 27.1217L11.7196 27.6976C12.0225 27.7435 12.3157 27.8388 12.5878 27.9797L16.0004 29.7473L19.413 27.9797C19.6851 27.8388 19.9784 27.7435 20.2812 27.6976L24.0811 27.1217L25.803 23.6858C25.9403 23.412 26.1215 23.1625 26.3396 22.9473L29.0752 20.2479L28.4487 16.4561C28.3988 16.1538 28.3988 15.8455 28.4487 15.5432L29.0752 11.7514L26.3396 9.05198C26.1215 8.83682 25.9403 8.58733 25.803 8.31345L24.0811 4.87756L20.2812 4.30166C19.9784 4.25575 19.6851 4.16045 19.413 4.01956L16.0004 2.252ZM16.3683 0.190217C16.1376 0.070709 15.8632 0.0707091 15.6325 0.190217L11.6679 2.24364C11.5902 2.2839 11.5064 2.31112 11.4199 2.32424L7.00552 2.99328C6.7486 3.03222 6.52661 3.19351 6.41019 3.42581L4.40978 7.41737C4.37056 7.49562 4.31877 7.5669 4.25647 7.62838L1.07844 10.7643C0.89348 10.9468 0.808685 11.2078 0.851043 11.4642L1.57886 15.8692C1.59312 15.9556 1.59312 16.0437 1.57886 16.1301L0.851043 20.5351C0.808685 20.7915 0.89348 21.0524 1.07844 21.235L4.25647 24.3709C4.31877 24.4324 4.37056 24.5037 4.40978 24.5819L6.41019 28.5735C6.52661 28.8058 6.7486 28.9671 7.00552 29.006L11.4199 29.6751C11.5064 29.6882 11.5902 29.7154 11.6679 29.7556L15.6325 31.8091C15.8632 31.9286 16.1376 31.9286 16.3683 31.8091L20.3329 29.7556C20.4106 29.7154 20.4944 29.6882 20.5809 29.6751L24.9953 29.006C25.2522 28.9671 25.4742 28.8058 25.5906 28.5735L27.591 24.5819C27.6302 24.5037 27.682 24.4324 27.7443 24.3709L30.9224 21.235C31.1073 21.0524 31.1921 20.7915 31.1498 20.5351L30.4219 16.1301C30.4077 16.0437 30.4077 15.9556 30.4219 15.8692L31.1498 11.4642C31.1921 11.2078 31.1073 10.9468 30.9224 10.7643L27.7443 7.62838C27.682 7.5669 27.6302 7.4956