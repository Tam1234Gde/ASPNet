                    </svg>

                </button>
                <div class="HIDE-modal-content">

                    <div class="HIDE-modal-content__title">
                        Укажите кол-во гостей
                    </div>

                    <div class="HIDE-modal-content__text">
                        Для правильной сервировки стола
                    </div>

                    <div class="HIDE-modal-content-buttons">
                        <button class="HIDE-modal-content-buttons-gray" type="button" data-dismiss="modal">Закрыть</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>

        // Прибавить
        $(".HIDE-js-cart_plus").on('click', function () {
              let id = $(this).data("id");
                 data_json = {
                "CartItemID": id,
            };

            $.ajax({
                type: 'POST',
                cache: false,
                data: data_json,
                url: "@Url.Action("Cart_Plus", "Cart")",
                success: function (data) {
                    if (data == "+") {
                        $.ajax({
                            type: 'POST',
                            cache: false,
                            url: "@Url.Action("Part_BottomBar", "Home")",
                            success: function (partialView) {
                                $('.HIDE-js-partial_bottombar').html(partialView);
                                window.location.href = "/Cart/Index";
                            }
                        });
                    }
                }
            });

        });


        // Минус
        $(".HIDE-js-cart_minus").on('click', function () {
              let id = $(this).data("id");
                 data_json = {
                "CartItemID": id,
            };

            $.ajax({
                type: 'POST',
                cache: false,
                data: data_json,
                url: "@Url.Action("Cart_Minus", "Cart")",
                success: function (data) {
                    if (data == "+") {
                        $.ajax({
                            type: 'POST',
                            cache: false,
                            url: "@Url.Action("Part_BottomBar", "Home")",
                            success: function (partialView) {
                                $('.HIDE-js-partial_bottombar').html(partialView);
                                window.location.href = "/Cart/Index";
                            }
                        });
                    }
                }
            });

        });


        // Нажатие на кнопку "Удалить с корзины"
        $('.HIDE-js-cart-delete').on('click', function () {
            let id = $(this).data("id");
            let dishid = $(this).data("dishid");
            $('.HIDE-js-cart-delete_modal').attr('data-id', id);
            $('.HIDE-js-cart-delete_modal').attr('data-dishid', dishid);
        });


        // Нажатие на кнопку "Удалить с корзины"
        $('.HIDE-js-cart-delete_modal').on('click', function () {

            let id = $(this).data("id");
            let dishid = $(this).data("dishid");


            data_json = {
                "CartItemID": id,
                "DishID": dishid,
            };

            $.ajax({
                type: 'POST',
                cache: false,
                data: data_json,
                url: "@Url.Action("Cart_Delete", "Cart")",
                success: function (data) {
                    if (data == "+") {
                        $.ajax({
                            type: 'POST',
                            cache: false,
                            url: "@Url.Action("Part_BottomBar", "Home")",
                            success: function (partialView) {
                                $('.HIDE-js-partial_bottombar').html(partialView);
                                window.location.href = "/Cart/Index";
                            }
                        });
                    }
                }
            });
        });


        // Нажатие на кнопку "Оформить заказ"
        $('.HIDE-js-cart-offer').on('click', function () {

            let add = $(".HIDE-js-offer_add").val();
            let remove = $(".HIDE-js-offer_remove").val();
            let numberQuests = $(".HIDE-js-offer_numberQuests").val();

            if(numberQuests != undefined && numberQuests != "")
            {
                data_json = {
                    "AddToOrder": add,
                    "RemoveToOrder": remove,
                    "NumberQuests": numberQuests,
                };

                $.ajax({
                    type: 'POST',
                    cache: false,
                    data: data_json,
                    url: "@Url.Action("Offer", "Cart")",
                    success: function (data) {
                        if(data > 0){
                            window.location.href = "/Order/Order_Done?OrderID=" + data;
                        }
                        else{
                            $("#HIDE-cart-offer-error").modal("show");
                        }
                    }
                });
            }
            else
            {
               $("#HIDE-cart-offer-peoples").modal("show");
            }
        });


        // Удалить все товары с корзины
        function CartClear() {

            $(".HIDE-js-cart_clear").click(function () {
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: "@Url.Action("CartClear", "Cart")",
                    success: function (data) {
                        window.location.reload();
                    }
                });
            });

        };

        CartClear();


        // Обработка поля "Укажите количество гостей"
        const productBtnInput = document.querySelector('.HIDE-js-offer_numberQuests');
        if (productBtnInput != null && productBtnInput != undefined) {
            productBtnInput.addEventListener('input',
                function (e) {
                    this.value = this.value.reHIDE(/[^\d.]/g, '');
                }
            )
        }

    </script>
}