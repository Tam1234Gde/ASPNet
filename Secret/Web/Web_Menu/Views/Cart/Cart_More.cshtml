@using HIDE.RestAndRant.Web_Site_Menu.Models.Cart
@model Model_Cart_More
@{
    // Полное описание блюда в корзине
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE - Блюда";
    ViewData["Sidebar"] = "Cart";

    List<CDish_Ingridient_ForAdmin>? List_Ingredient = Model.Dish?.List_Dish_Ingridients?.Where(p => !p.IngridientGroupID.HasValue).ToList();
    var List_Ingredients_Group = Model.Dish?.List_Dish_Ingridients?.Where(p => p.IngridientGroupID.HasValue).GroupBy(p => p.IngridientGroupID);
}

@* Полное описание блюда в корзине *@
<main>

    <div class="HIDE-common-global">
        <div class="HIDE-menu HIDE-menu_category HIDE-menu_card">

            <div class="HIDE-about-back" style="margin-bottom: 15px;">
                <a asp-controller="Cart" asp-action="Index">

                    <svg width="48" height="49" viewBox="0 0 48 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="48" height="48.1116" rx="8" fill="#30323A" />
                        <path d="M12 24.0516L16.632 28.1116L18.1808 26.7606L16.1888 25.019H36V23.1038H16.184L18.1968 21.3552L16.6528 20L12 24.0516Z" fill="white" />
                    </svg>

                    @*  Вернуться назад *@
                </a>
            </div>
            @* <div class="HIDE-menu-back"><a asp-controller="Cart" asp-action="Index"></a></div> *@

            @* Полное описание блюда *@
            @if (Model != null && Model.Dish != null)
            {
                <div class="HIDE-menu__items">
                    <div class="HIDE-menu__item">

                        @* Название блюда *@
                        @if (!string.IsNullOrWhiteSpace(Model.Dish.Name))
                        {
                            <div class="HIDE-menu__item-title">@Html.Raw(Model.Dish.Name)</div>
                        }

                        @* Изображение блюда *@
                        @if (Model.Dish.Image != null)
                        {
                            <div class="HIDE-menu__item-img">
                                <img src="data:image/png;base64,@Convert.ToBase64String(Model.Dish.Image)">
                            </div>
                        }
                        else
                        {
                            <div class="HIDE-menu__item-img HIDE-menu__item-img__margin HIDE-slimbox">
                                <img src="/_i/no_image.png">
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Dish.Text))
                        {
                            <div class="HIDE-menu__item-text">
                                @Html.Raw(Model.Dish.Text)
                            </div>
                        }

                        @* Количество блюд *@
                        <div class="HIDE-menu__item-count">
                            <button type="button" class="HIDE-js-order_minus" @Html.Raw(Model.Dish.Count > 1 ? "" : "disabled")>
                                -
                            </button>
                            <input class="HIDE-js-order_number" readonly value="@Math.Round(HIDE_Convert.ToDecimal(Model?.Dish_Cart?.Dish_Count), 0)" />
                            <button type="button" class="HIDE-js-order_plus">
                                +
                            </button>
                        </div>

                        @* Цена блюда *@
                        @if (Model?.Dish.Price > 0)
                        {
                            <span class="HIDE-menu__item-price HIDE-js-price" style="display: none;" data-price="@Math.Round(Model.Dish.Price, 0)"></span>
                        }
                        else
                        {
                            if (Model?.Dish.List_Dish_Volumes != null && Model.Dish.List_Dish_Volumes.Count != 0)
                            {
                                <span class="HIDE-menu__item-price HIDE-js-price" style="display: none;" data-price="@Math.Round(Model.Dish.Price, 0)"></span>
                            }
                        }

                        @* Список ингредиентов *@
                        @if (Model?.Dish.List_Dish_Ingridients != null && Model.Dish.List_Dish_Ingridients.Count != 0)
                        {
                            <div class="HIDE-menu__item-list">

                                @* Группы *@
                                @if (List_Ingredients_Group != null)
                                {
                                    @foreach (var key in List_Ingredients_Group)
                                    {
                                        <div class="HIDE-menu__item-list-title">
                                            Добавить ингредиенты
                                        </div>

                                        <div class="HIDE-menu__item-list-block">

                                            @foreach (var dish_ingredient in key)
                                            {
                                                <div class="HIDE-menu__item-list-elem">
                                                    <input type="radio" name="@Html.Raw($"{key.Key}_radio")" id="@dish_ingredient.ID" class="HIDE-js-price_dop"
                                                           value="@Math.Round(dish_ingredient.Price, 0)" data-id="@dish_ingredient.ID"
                                                    @Html.Raw(Model?.Dish_Cart?.Dish_Ingredient_IDs != null && Model.Dish_Cart.Dish_Ingredient_IDs.Count != 0 && Model.Dish_Cart.Dish_Ingredient_IDs.Contains(dish_ingredient.ID) ? "checked=\"checked\"" : "") />
                                                    <label for="@dish_ingredient.ID">

                                                        @* Изображение ингредиента *@
                                                        @if (dish_ingredient.Image != null)
                                                        {
                                                            <span class="HIDE-menu__item-list-elem-img">
                                                                <img src="data:image/png;base64,@Convert.ToBase64String(dish_ingredient.Image)">
                                                            </span>
                                                        }

                                                        @* Название игредиента *@
                                                        @if (!string.IsNullOrWhiteSpace(dish_ingredient.Ingridient))
                                                        {
                                                            <span class="HIDE-menu__item-list-elem-text">@dish_ingredient.Ingridient @dish_ingredient.IngridientGroupID</span>
                                                        }

                                                        @* Стоимость ингредиента *@
                                                        <span class="HIDE-menu__item-list-elem-price">+@Math.Truncate(dish_ingredient.Price) ₽</span>

                                                    </label>

                                                </div>
                                            }

                                        </div>
                                    }
                                }

                                @* Ингредиенты без групп *@
                                @if (List_Ingredient != null && List_Ingredient.Count != 0)
                                {
                                    <div class="HIDE-menu__item-list-title">
                                        Добавить ингредиенты
                                    </div>

                                    <div class="HIDE-menu__item-list-block">

                                        @foreach (CDish_Ingridient_ForAdmin dish_ingredient in List_Ingredient)
                                        {
                                            <div class="HIDE-menu__item-list-elem">
                                                <input type="checkbox" id="@dish_ingredient.ID" value="@Math.Round(dish_ingredient.Price, 0)" class="HIDE-js-price_dop" data-id="@dish_ingredient.ID"
                                                @Html.Raw(Model?.Dish_Cart?.Dish_Ingredient_IDs != null && Model.Dish_Cart.Dish_Ingredient_IDs.Count != 0 && Model.Dish_Cart.Dish_Ingredient_IDs.Contains(dish_ingredient.ID) ? "checked=\"checked\"" : "") />
                                                <label for="@dish_ingredient.ID">

                                                    @* Изображение ингредиента *@
                                                    @if (dish_ingredient.Image != null)
                                                    {
                                                        <span class="HIDE-menu__item-list-elem-img">
                                                            <img src="data:image/png;base64,@Convert.ToBase64String(dish_ingredient.Image)">
                                                        </span>
                                                    }

                                                    @* Название игредиента *@
                                                    @if (!string.IsNullOrWhiteSpace(dish_ingredient.Ingridient))
                                                    {
                                                        <span class="HIDE-menu__item-list-elem-text">@dish_ingredient.Ingridient</span>
                                                    }

                                                    @* Стоимость ингредиента *@
                                                    <span class="HIDE-menu__item-list-elem-price">+@Math.Round(dish_ingredient.Price, 0) ₽</span>

                                                </label>
                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>
            }

        </div>
    </div>
</main>

@* Нижняя плашка с ценой *@
<div class="HIDE-fixed-price">

    @* Список объёмов *@
    @* //TODO: NULLABLE *@
    @if (Model.Dish.List_Dish_Volumes != null && Model.Dish.List_Dish_Volumes.Count != 0)
    {
        <div class="HIDE-fixed-price-volume">
            <div class="HIDE-volume">

                @foreach (CDish_Volume dish_volume in Model.Dish.List_Dish_Volumes)
                {
                    <div class="HIDE-volume-elem">
                        <input type="radio" name="volume" class="HIDE-js-volume" data-id="@dish_volume.ID" id="@dish_volume.ID" @Html.Raw(Model?.Dish_Cart?.Dish_VolumeID == dish_volume.ID ? "checked=\"checked\"" : "") value="@Math.Round(HIDE_Convert.ToDecimal(dish_volume.VolumePrice))" />
                        <label for="@dish_volume.ID">

                            @* Объём блюда *@
                            @if (dish_volume.VolumeValue.HasValue)
                            {
                                <span class="HIDE-volume-elem-top">@Math.Round(HIDE_Convert.ToDecimal(dish_volume.VolumeValue)) ml</span>
                            }

                            @* Стоимость игредиента *@
                            <span class="HIDE-volume-elem-price">
                                @Math.Round(dish_volume.VolumePrice) ₽
                            </span>

                        </label>
                    </div>
                }

            </div>
        </div>
    }

    <div class="HIDE-fixed-price-button">
        <button button type="button" class="HIDE-js-card-add"></button>
    </div>

    <div class="HIDE-fixed-price-block">

        @* Цена блюда *@
        @if (Model?.Dish?.Price > 0)
        {
            <span class="HIDE-fixed-price-block-left HIDE-js-price">@Math.Round(Model.Dish.Price, 0) ₽</span>
        }
        else
        {
            if (Model?.Dish?.List_Dish_Volumes != null && Model.Dish.List_Dish_Volumes.Count != 0)
            {
                <span class="HIDE-fixed-price-block-left HIDE-js-price">@Math.Round(Model.Dish.List_Dish_Volumes.FirstOrDefault()?.VolumePrice ?? 0, 0) ₽</span>
            }
        }

        <div class="HIDE-fixed-price-block-right HIDE-js-count">
            @Math.Round(HIDE_Convert.ToDecimal(Model?.Dish_Cart?.Dish_Count), 0) шт
        </div>

    </div>
</div>

@* Скрипты *@
@section scripts {
    <script>
        $(document).ready(function () {

            var $ButtonOrder_Number = $('.HIDE-js-order_number');
            var $ButtonOrder_Minus = $('.HIDE-js-order_minus');
            var $ButtonOrder_Plus = $('.HIDE-js-order_plus');

            var $Count = $('.HIDE-js-count');

            var $Summ = $('.HIDE-js-price');

            var Price = 0;

            var $Dop = $('.HIDE-js-price_dop');

            var $Volume = $('.HIDE-js-volume');

            var count = Number($ButtonOrder_Number.val());

            //Функция посчитать общую сумму
            function Summ(Price, count) {

                var DopPrice = 0;

                $Dop.each(function () {

                    if ($(this).is(':checked')) {
                        DopPrice = DopPrice + Number($(this).val());
                    }

                })

                var summ = Price * count + DopPrice * count;

                $Summ.text(summ + " ₽")

            }

            if ($Volume !== undefined && $Volume.length > 0) {

                $Volume.each(function () {

                    if ($(this).is(':checked')) {
                        Price = Number($(this).val());
                        Summ(Price, count)
                    }

                })
            }

            else {
                Price = Number($Summ.data('price'));

                Summ(Price, count)
            }

            $Volume.change(function () {

                if ($(this).is(':checked')) {

                    Price = Number($(this).val())
                    Summ(Price, count)
                }

            })

            // Плюс
            $ButtonOrder_Plus.click(function () {

                count = count + 1;



                $ButtonOrder_Number.val(count);
                $Count.text(count + " шт");
                Summ(Price, count);
                     $ButtonOrder_Minus.prop('disabled', false);
            });

            // Минус
            $ButtonOrder_Minus.click(function () {

                if (count > 1) {
                    count = count - 1;
                    $ButtonOrder_Number.val(count);
                    $Count.text(count + " шт");
                    Summ(Price, count);
                                               if(count == 1){
                                                      $(this).prop('disabled', true)
                              }
                }
                     else {
                        $(this).prop('disabled', true)
                    }
            });

            //Выбор допов
            $Dop.change(function () {
                Summ(Price, count)
            })

            // Нажатие на кнопку "Добавить в корзину"
            $('.HIDE-js-card-add').on('click', function () {

                let ingredients = "";
                let volume = "";

                let dish_count = $ButtonOrder_Number.val();

                $Dop.each(function () {
                    if ($(this).is(':checked')) {
                        let atrr_value = $(this).data("id");
                        ingredients += atrr_value + ",";
                    }
                });

                $Volume.each(function () {
                    if ($(this).is(':checked')) {
                        let atrr_value = $(this).data("id");
                        volume += atrr_value;
                    }
                });

                data_json = {
                    "CartItemID": @Model?.Dish_Cart?.ID,
                    "DishID": @Model?.Dish?.ID,
                    "Dish_Count": dish_count,
                    "VolumeID": volume,
                    "Dish_Ingredient_IDs": ingredients,
                };

                $.ajax({
                    type: 'POST',
                    cache: false,
                    data: data_json,
                    url: "@Url.Action("Cart_Edit", "Cart")",
                    success: function (data) {
                        if (data == "+") {

                            data_json = {
                               "Menu": "Cart",
                            };

                            $.ajax({
                                type: 'POST',
                                cache: false,
                                url: "@Url.Action("Part_BottomBar", "Home")",
                                success: function (partialView) {
                                    $('.HIDE-js-partial_bottombar').html(partialView);
                                    window.location.href = "/Cart/Index";
                                },
                                error: {

                                }
                            });
                        }
                        else {

                        }
                    }
                });
            });

            $('.HIDE-js-login-input_phone').keyup(function (event) {
                if (event.keyCode === 13) {
                    $(".HIDE-js-login-button").click();
                }
            });

            $('.HIDE-js-login-input_phone').focus();

        });
    </script>
}