@model List<CDish_Category>
@{
    // Мобильное меню
    Layout = null;

    string url = Context.Request.Path;
}

@* Мобильное меню *@
<div class="HIDE-js-menu_mobile HIDE-menu_mobile">
    <div class="HIDE-js-menu_mobile-bg HIDE-menu_mobile-bg"></div>
    <div class="HIDE-js-menu_mobile-box HIDE-menu_mobile-box">

        <div class="HIDE-menu_mobile-box-title">
            <div class="HIDE-menu_mobile-box-title-logo">
                <a href="/">
                    <img src="/_i/icon-logo.svg" alt="">
                </a>
            </div>
            <div class="HIDE-menu_mobile-box-title-close">
                <img src="/_i/icon-menu_mobile-close.svg" alt="" />
            </div>
        </div>

        <div class="HIDE-js-menu_mobile-box-nav HIDE-menu_mobile-box-nav">
            @if (Model != null)
            {
                <ul style="margin-bottom: 20px;">
                    @foreach (CDish_Category dish_category in Model)
                    {
                        <li class="HIDE-menu_mobile-box-nav-elem">
                            <a class="HIDE-menu_mobile-box-nav-elem-link" asp-controller="Home" asp-action="Dishes" asp-route-Dish_CategoryID="@dish_category.ID">
                                @dish_category.Name
                            </a>
                        </li>
                    }
                </ul>
            }

            <ul>
                <li class="HIDE-menu_mobile-box-nav-elem"><a class="HIDE-menu_mobile-box-nav-elem-link" asp-controller="Home" asp-action="About">О приложении</a></li>
                @if (url != "/")
                {
                    <li class="HIDE-menu_mobile-box-nav-elem"><a class="HIDE-menu_mobile-box-nav-elem-link" href="/#HIDE-map">Контакты кофейни</a></li>
                }
                else
                {
                    <li class="HIDE-menu_mobile-box-nav-elem"><a class="HIDE-menu_mobile-box-nav-elem-link" href="#HIDE-map">Контакты кофейни</a></li>
                }
            </ul>

        </div>

        <div class="HIDE-menu_mobile-box-footer">
            <a href="#HIDE-map">
                Россия, г. Грозный,
                пр-т. В.В. Путина, 34
            </a>
            <p>Разработка сайта <a href="https://HIDEerv.ru/" target="_blank">HIDEerv.ru</a></p>
        </div>

    </div>
</div>