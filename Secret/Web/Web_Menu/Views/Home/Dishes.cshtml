@using HIDE.RestAndRant.Web_Site_Menu.Models.Home
@model Model_Home_Dishes
@{
    // Блюда категории
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE - Блюда";
}

@* Блюда категории *@
@if (Model.List_Dish_Categories != null && Model.List_Dish_Categories.Count != 0)
{
    <div class="HIDE-menu-scroll HIDE-js-menu-fixed">
        <div class="HIDE-menu-scroll-block HIDE-js-menu-scroll">
            @foreach (var dish_category in Model.List_Dish_Categories)
            {
                <div class="HIDE-menu-scroll-block-elem">
                    <a asp-controller="Home" asp-action="Dishes">
                        @dish_category.Name
                    </a>
                </div>
            }
        </div>
    </div>
}

@* Контент *@
<main>
    <div class="HIDE-common-global">
        <div class="HIDE-menu">

            <div class="HIDE-menu-back"><a asp-controller="Home" asp-action="Index"></a></div>

            @* Категория *@
            <div class="HIDE-menu__title">
                @Model.Dish_Category.Name
            </div>

            @* Список блюд *@
            @if (Model.List_Dishes != null && Model.List_Dishes.Count != 0)
            {
                <div class="HIDE-menu__items HIDE-menu__items_preview">
                    @foreach (CDish_ForAdmin dish in Model.List_Dishes)
                    {
                        <a asp-controller="Home" asp-action="Dish_More" asp-route-Dish_ID="@dish.ID" class="HIDE-menu__item">

                            @* Количество блюд в корзине *@
                            @if (Model.List_Dishes_Cart != null && Model.List_Dishes_Cart.Count != 0 && Model.List_Dishes_Cart.Where(p => p.DishID == dish.ID).Select(p => p.Dish_Count).FirstOrDefault() > 0)
                            {
                                <span class="HIDE-menu__items-count">
                                    @Math.Round(Model.List_Dishes_Cart.Where(p => p.DishID == dish.ID).Select(p => p.Dish_Count).Sum(), 0)
                                </span>
                            }

                            @* Название блюда *@
                            @if (!string.IsNullOrWhiteSpace(dish.Name))
                            {
                                <span class="HIDE-menu__description">@Html.Raw(dish.Name)</span>
                            }

                            @* Изображение блюда *@
                            @if (dish.Image != null)
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(dish.Image)" class="HIDE-menu__image">
                            }

                            @* Цена блюда *@
                            @if (dish.Price > 0)
                            {
                                <span class="HIDE-menu__price">@Math.Round(dish.Price, 0) <text>₽</text></span>
                            }
                            else
                            {
                                if (dish.List_Dish_Volumes != null && dish.List_Dish_Volumes.Count != 0)
                                {
                                    <span class="HIDE-menu__price">@Math.Round(dish.List_Dish_Volumes.FirstOrDefault()?.VolumePrice ?? 0, 0) <text>₽</text></span>
                                }
                            }

                            @* Объём *@
                            @if (dish.List_Dish_Volumes != null && dish.List_Dish_Volumes.Count != 0 && dish.Price > 0)
                            {
                                <span class="HIDE-menu__price">@Html.Raw(Math.Round(dish.List_Dish_Volumes.FirstOrDefault()?.VolumeValue ?? 0, 0) / 1000)?.ToString()?.ReHIDE(",", ".")  <text>мл</text></span>
                            }

                        </a>
                    }
                </div>
            }

        </div>
    </div>
</main>