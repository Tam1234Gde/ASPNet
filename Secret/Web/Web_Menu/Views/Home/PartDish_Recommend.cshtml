@using HIDE.RestAndRant.Web_Site_Menu.Models.Home
@model Model_Home_Dish
@{
    // Рекомендованные товары
    Layout = null;
}

@* Рекомендуемые товары *@
@if (Model.List_DishRecommended != null && Model.List_DishRecommended.Count != 0)
{
    <div>
        Рекомендуемые товары
    </div>

    @foreach (var elem in Model.List_DishRecommended)
    {
        <div>
            <div>товар @elem.ID</div>
            @if ((Model.List_Dishes != null && Model.List_Dishes.Count != 0 && !Model.List_Dishes.Select(p => p.DishID).Contains(elem.ID)) || (Model.List_Dishes != null && Model.List_Dishes.Count == 0))
            {
                <button class="HIDE-js-add_cart_recommend" data-id="@elem.ID">Добавить рекомендуемый</button>
            }
        </div>
    }
}