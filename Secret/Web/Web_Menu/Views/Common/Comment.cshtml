@using HIDE.RestAndRant.Common.ENums
@using HIDE.RestAndRant.Web_Site_Menu.Models.Common
@model Model_Comment
@{
    // Комментарий официанту
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "HIDE HIDE";
}

@* Комментарий официанту *@
<div class="HIDE-about HIDE-about-answer">

    <div class="HIDE-about-back">
        <a asp-controller="Home" asp-action="Index">

            <svg width="48" height="49" viewBox="0 0 48 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="48" height="48.1116" rx="8" fill="#30323A" />
                <path d="M12 24.0516L16.632 28.1116L18.1808 26.7606L16.1888 25.019H36V23.1038H16.184L18.1968 21.3552L16.6528 20L12 24.0516Z" fill="white" />
            </svg>

            Вернуться назад
        </a>
    </div>

    <div class="HIDE-about-content">

        <div class="HIDE-about-content_wrapp">
            <div class="HIDE-about-content-title" style="margin-bottom:12px;">
                Напишите официанту
            </div>

            <div class="HIDE-table-bottom-input">
                <input HIDEholder="Ваш комментарий" class="HIDE-js-input-text HIDE-js-comment" type="text" maxlength="100">
            </div>

            <div class="HIDE-table-button HIDE-table-button_color">

                <button type="button" class="HIDE-js-input-text_button HIDE-js-send_telegram" data-id="@ETgTypeMessage.Comment" disabled onclick="ym(99522310,'reachGoal','Write-to-the-waiter'); return true;">
                    <span class="HIDE-icon"></span>
                    <span class="HIDE-text">
                        Отправить
                    </span>
                    <span class="HIDE-text-load">
                        Отправляется
                    </span>
                    <span class="HIDE-text-ok">
                        Отправлено
                    </span>
                    <span class="HIDE-text-error">
                        Ошибка
                    </span>
                </button>

            </div>

        </div>


    </div>

</div>

@section scripts {
    <script>

        $('.HIDE-js-input-text').keyup(function () {

            if ($(this).val().length > 0 && $(this).val() != "") {
                $('.HIDE-js-input-text_button').prop('disabled', false);
            }

            else {
                $('.HIDE-js-input-text_button').prop('disabled', true);
            }

        });

        // Отправить комментарий
        function SendMessage() {

            $(".HIDE-js-send_telegram").click(function () {

                let $this = $(this);
                let id = $this.data("id");

                $this.addClass("HIDE-loader");
                let comment = $(".HIDE-js-comment").val();

                data_json = {
                    "Type": id,
                    "Text": comment
                };

                $.ajax({
                    type: 'POST',
                    cache: false,
                    data: data_json,
                    url: "@Url.Action("TgSend", "Common")",
                    success: function (data) {
                        if (data == @((int)ModelJsonResult.OK)) {
                              setTimeout(function () {
                                    $this.removeClass("HIDE-loader");
                                    $this.addClass("HIDE-ok");
                                    $this.prop('disabled', true);
                              }, 1500);
                        }
                        else {
                            // $("#HIDE-modal-login_code_email").find($(".HIDE-js-feedback_form-info")).addClass('HIDE-feedback_form-info-text_error');
                            // $("#HIDE-modal-login_code_email").find($(".HIDE-js-feedback_form-info")).text('Ошибка отправки');
                        }
                    }
                });
            });

        };

        SendMessage();

    </script>
}