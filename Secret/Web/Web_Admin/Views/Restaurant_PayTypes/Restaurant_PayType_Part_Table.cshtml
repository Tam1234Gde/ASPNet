@using HIDE.RestAndRant.Web_Admin.Models.Restaurant_PayTypes
@model Model_Restaurant_PayTypes_Index
@{
    // Таблица > Доступные типы оплаты в ресторане
    Layout = null;
}

@* Таблица > Доступные типы оплаты в ресторане *@
@if (Model != null && Model.List_Restaurant_PayTypes != null && Model.List_Restaurant_PayTypes.Count != 0)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CRestaurant_PayType().Restaurant)" title="@Html.DisplayNameFor(x => new CRestaurant_PayType().Restaurant)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_PayType().Restaurant)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CRestaurant_PayType().Order_Type)" title="@Html.DisplayNameFor(x => new CRestaurant_PayType().Order_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_PayType().Order_Type)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CRestaurant_PayType().Pay_Type)" title="@Html.DisplayNameFor(x => new CRestaurant_PayType().Pay_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_PayType().Pay_Type)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (CRestaurant_PayType item in Model.List_Restaurant_PayTypes)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Order_Type)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Pay_Type)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Restaurant_PayType_Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Restaurant_PayTypes_Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}