@using HIDE.RestAndRant.Web_Admin.Models.Restaurant_PayTypes
@model Model_Restaurant_PayTypes_CRUD
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Restaurant_PayTypes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить вид оплаты";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление пользователя *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Restaurant_PayType_Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Ресторан *@
                            @if (Model.List_Restaurants != null && Model.List_Restaurants.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="RestaurantID">Ресторан*</label>
                                    <select asp-for="RestaurantID" id="RestaurantID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Restaurants)
                                        {
                                            if (item.ID == Model.RestaurantID)
                                            {
                                                <option selected value="@item.ID">@item.Address</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Address</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="RestaurantID" class="text-danger"></span>
                                </div>
                            }


                            @* Тип заказа(С собой\Поесть в кафе\Доставка) *@
                            @if (Model.List_Order_Types != null && Model.List_Order_Types.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Order_TypeID">Тип заказа(С собой\Поесть в кафе\Доставка)*</label>
                                    <select asp-for="Order_TypeID" id="Order_TypeID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Order_Types)
                                        {
                                            if (item.ID == (int)Model.Order_TypeID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Order_TypeID" class="text-danger"></span>
                                </div>
                            }


                            @* Вид оплаты (картой, нал, ...) *@
                            @if (Model.List_Pay_Types != null && Model.List_Pay_Types.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Pay_TypeID">Вид оплаты (картой, нал, ...)*</label>
                                    <select asp-for="Pay_TypeID" id="Pay_TypeID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Pay_Types)
                                        {
                                            if (item.ID == (int)Model.Pay_TypeID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Pay_TypeID" class="text-danger"></span>
                                </div>
                            }


                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Restaurant_PayType_Index" asp-route-RestaurantID="@Model.RestaurantID">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}