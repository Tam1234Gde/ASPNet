@using HIDE.RestAndRant.Web_Admin.Models.Banners

@model Model_Banner_AddEdit
@{
    Layout = null;
}

@if (Model != null && Model.List_Product != null)
{
    <label asp-for="Product_ID">Ссылка на продукт</label>

    <select asp-for="Product_ID" id="Category_ID" class="custom-select HIDE-custom-select rounded-0">

        <option value="null">-</option>

        @foreach (CDish item in Model.List_Product)
        {
            if (item.ID == Model.Product_ID)
            {
                <option selected value="@item.ID">@item.Name</option>
            }
            else
            {
                <option value="@item.ID">@item.Name</option>
            }
        }
    </select>
 
    <span asp-validation-for="Product_ID" class="text-danger"></span>
}

