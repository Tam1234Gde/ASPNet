@using HIDE.RestAndRant.Web_Admin.Models.Ingridients
@model Model_Ingridients_AddEdit
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать ингридиент";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;

    string id_MediaFile = $"HIDE-js-mediafile-{Guid.NewGuid()}";
}

@* Редактирование ингредиента *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Image" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Категория *@
                            <div class="form-group">
                                <label asp-for="Category_ID" class="control-label">Категория</label>
                                <select asp-for="Category_ID" asp-items="Model.Categories" class="form-control HIDE-js-select2">
                                    <option value="">Без категории</option>
                                </select>
                                <span asp-validation-for="Category_ID" class="text-danger"></span>
                            </div>

                            @* Изображение *@
                            <div class="form-group">
                                <label for="@id_MediaFile">Изображение</label>
                                <div class="clearfix"></div>
                                <input id="@id_MediaFile" style="display:block;" asp-for="@Model.UploadImge" type="file" class="btn btn-warning HIDE-js-common-image_show"
                                       accept=".jpg,.jpeg,.png" />

                                @if (Model != null && !string.IsNullOrWhiteSpace(Model.Image_Url))
                                {
                                    <img style="max-width:250px;max-height:250px;" class="HIDE-js-common-image_show-item" src="@Model.Image_Url" alt="" />
                                    <div class="clearfix"></div>
                                    <a asp-controller="Ingridients" asp-action="Ingridient_DelImage" asp-route-id="@Model.ID" class="btn btn-danger">Удалить изображение</a>
                                }
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}