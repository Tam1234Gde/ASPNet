@using HIDE.RestAndRant.Web_Admin.Models.Ingridients
@model Model_Ingridients_AddEdit
@{
    ViewData["Title"] = "Del";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Удалить ингридиент";
    ViewBag.RazdelNameMobile = "Удалить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;

}

@* Удалить ингридиент *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <form asp-action="Del">

                        <input asp-for="@Model.ID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить ингридиент "@Model.Name"? </label>
                            </div>

                        </div>

                        <div class="card-footer">

                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-controller="Ingridients" asp-action="Index">Назад</a>
                            </div>

                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Удалить" class="btn btn-primary" />
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }