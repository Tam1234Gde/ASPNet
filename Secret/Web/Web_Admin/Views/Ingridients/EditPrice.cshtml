@using HIDE.RestAndRant.Web_Admin.Models.Ingridients
@model Model_Ingredients_PriceChange
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать стоимость ингредиента";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;

    string id_MediaFile = $"HIDE-js-mediafile-{Guid.NewGuid()}";
}

@* Редактирование стоимости ингредиента *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title">@Model.Name</h3>
                    </div>

                    @* Исправленная форма с явным указанием method и action *@
                    <form asp-action="EditPrice" asp-controller="Ingridients" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Name" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Ингредиент *@
                            <div class="form-group">
                                <label class="control-label">Ингредиент</label>
                                <p class="form-control-static"><strong>@Model.Name</strong></p>
                            </div>

                            @* Ресторан *@
                            @if (Model.ListRestaurants != null && Model.ListRestaurants.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="RestaurantID">Ресторан*</label>
                                    <select asp-for="RestaurantID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.ListRestaurants)
                                        {
                                            if (item.ID == Model.RestaurantID)
                                            {
                                                <option value="@item.ID" selected="selected">@item.Address</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Address</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="RestaurantID" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <div class="form-group">
                                    <div class="alert alert-warning">
                                        Нет доступных ресторанов для выбора.
                                    </div>
                                </div>
                            }

                            @* Стоимость *@
                            <div class="form-group">
                                <label asp-for="Price" class="control-label">Стоимость*</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index" asp-controller="Ingridients">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save"></i> Сохранить
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}