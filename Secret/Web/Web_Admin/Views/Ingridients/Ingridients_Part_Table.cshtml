@model List<CIngridient_ForAdmin>
@{
    // Таблица > Ингредиенты
    Layout = null;
}

@* Таблица > Ингредиенты *@
@if (Model != null && Model.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-3.png" alt="Изображение" title="Изображение">
                    <span class="HIDE-jscss-table-head-text">Изображение</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="Наименование" title="Наименование">
                    <span class="HIDE-jscss-table-head-text">Наименование</span>
                </th>
                <th class="search export">
                    <span class="HIDE-jscss-table-head-text">Категория</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // Определяем CSS-класс для строки с удалённой категорией
                string rowClass = item.Category_IsDeleted ? "HIDE-bg-category-deleted" : "";

                <tr class="@rowClass">
                    <td>
                        <img src="@item.Image_Url" alt="" style="max-width: 150px; max-height: 50px;" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @if (item.Category_IsDeleted)
                        {
                            <span class="text-danger">
                                <i class="fas fa-exclamation-triangle"></i>
                                @Html.DisplayFor(modelItem => item.Category_Name)
                                <span class="badge badge-danger">Удалена</span>
                            </span>
                        }
                        else
                        {
                            @Html.DisplayFor(modelItem => item.Category_Name)
                        }
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit"></i></a>
                        @* <a asp-action="EditPrice" asp-route-id="@item.ID" class="btn btn-block bg-gradient-info text-light" style="margin-right: 5px;"><i class="fas fa-code"></i></a> *@
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger" style="margin-top: 0px; margin-right: 0px;"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style="border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}