@using HIDE.RestAndRant.Web_Admin.Models.Volumes
@model Model_Volumes_AddEdit
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Volumes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать объём";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

@* Редактирование категории *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data">

                        <input type="hidden" asp-for="ID" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Объём в ml *@
                            <div class="form-group">
                                <label asp-for="Value" class="control-label">Объём в ml*</label>
                                <input asp-for="Value" type="number" class="form-control" />
                                <span asp-validation-for="Value" class="text-danger"></span>
                            </div>

                            @* Название *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Название</label>
                                <input asp-for="Name" class="form-control" />
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}