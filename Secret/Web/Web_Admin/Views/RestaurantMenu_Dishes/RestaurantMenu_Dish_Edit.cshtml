@using HIDE.RestAndRant.Web_Admin.Models.RestaurantMenu_Dishes
@model Model_RestaurantMenu_Dishes_CRUD
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "RestaurantMenu_Dishes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать меню";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

@* Редактирование ресторана *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="RestaurantMenu_Dish_Edit">

                        <input type="hidden" asp-for="ID" />
                        <input asp-for="@Model.Restaurant_MenuID" type="hidden" />
                        <input asp-for="@Model.DishID" type="hidden" />
                        <input asp-for="@Model.Dish_CategoryID" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Название *@
                            <div class="form-group">
                                <label asp-for="Dish" class="control-label">Название блюда*</label>
                                <input asp-for="Dish" class="form-control" disabled />
                            </div>

                            @* Стоимость *@
                            <div class="form-group">
                                <label asp-for="Price" class="control-label">Стоимость*</label>
                                <input asp-for="Price" class="form-control" type="number" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @* Порядок отображения *@
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                <input asp-for="OrderNum" class="form-control" type="number" />
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                            @* Новинка *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="FlagNew" /> Новинка
                                </label>
                            </div>
                            
                            @* Доступно *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Available" /> Доступно
                                </label>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="RestaurantMenu_Dish_Index" asp-route-RestaurantMenuID="@Model.Restaurant_MenuID"
                                                                                                               asp-route-Dish_CategoryID="@Model.Dish_CategoryID">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}