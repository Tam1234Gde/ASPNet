@using HIDE.RestAndRant.Web_Admin.Models.RestaurantMenu_Dishes
@model Model_RestaurantMenu_Dishes_Index
@{
    // Таблица > Меню ресторана
    Layout = null;
}

@* Таблица > Меню ресторана *@
@if (Model != null && Model.List_CRestaurant_Menu_Dishes != null && Model.List_CRestaurant_Menu_Dishes.Count != 0)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Dish)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Dish)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().Dish)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Price)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().Price)</span>
                </th>
                <th class="export" style="max-width: 100px; width: 100px;">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Restaurant_Menu_Dish_Volumes)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Restaurant_Menu_Dish_Volumes)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().Restaurant_Menu_Dish_Volumes)</span>
                </th>
                <th class="export" style="max-width: 100px; width: 100px;">
                    <img src="/img/icon-fields-dopfield-16.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Restaurant_Menu_Dish_Ingredients)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Restaurant_Menu_Dish_Ingredients)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().Restaurant_Menu_Dish_Ingredients)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Flag_Available)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().Flag_Available)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().Flag_Available)</span>
                </th>
                <th style="max-width: 40px; width: 40px;">
                    <img src="/img/icon-fields-dopfield-22.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().FlagNew)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().FlagNew)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().FlagNew)</span>
                </th>
                <th style="max-width: 40px; width: 40px;">
                    <img src="/img/icon-fields-dopfield-42.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().OrderNum)" title="@Html.DisplayNameFor(x=> new CRestaurant_Menu_Dish().OrderNum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Menu_Dish().OrderNum)</span>
                </th>
                <th data-orderable="false" style="min-width: 90px; width: 90px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (CRestaurant_Menu_Dish item in Model.List_CRestaurant_Menu_Dishes)
            {
                string elem_class = !item.Flag_Available ? "HIDE-bg_noactive" : "";

                <tr class="@elem_class">
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price) р.
                    </td>
                    <td>
                        <a asp-controller="RestaurantMenu_Dish_Volumes" asp-action="RestaurantMenu_Dish_Volume_Index" asp-route-Restaurant_Menu_DishID="@item.ID" asp-route-Dish_CategoryID="@Model.Dish_CategoryID">Список объёмов (@item.Restaurant_Menu_Dish_Volumes?.Count())</a>
                    </td>
                    <td>
                        <a asp-controller="RestaurantMenu_Dish_Ingredients" asp-action="RestaurantMenu_Dish_Ingredient_Index" asp-route-Restaurant_Menu_DishID="@item.ID" asp-route-Dish_CategoryID="@Model.Dish_CategoryID">Список ингридиентов (@item.Restaurant_Menu_Dish_Ingredients?.Count())</a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Flag_Available)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FlagNew)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderNum)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="RestaurantMenu_Dish_Edit" asp-route-id="@item.ID" asp-route-Dish_CategoryID="@Model.Dish_CategoryID" class="btn btn-block bg-gradient-warning" style="margin: 0 5px 0 0;"><i class="fas fa-edit "></i></a>
                        <a asp-action="RestaurantMenu_Dish_Del" asp-route-id="@item.ID" asp-route-Dish_CategoryID="@Model.Dish_CategoryID" asp-route-Flag_Available="@item.Flag_Available" class="btn btn-block bg-gradient-danger" style="margin-top: 0 !important;"><i class="fas fa-retweet" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}