@using HIDE.RestAndRant.Web_Admin.Models.RestaurantMenu_Dishes
@model Model_RestaurantMenu_Dishes_CRUD
@{
    ViewData["Title"] = "Del";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "RestaurantMenu_DishesList";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = Model.Flag_Available ? "Скрыть блюдо" : "Восстановить блюдо";
    ViewBag.RazdelNameMobile = Model.Flag_Available ? "Скрыть" : "Восстановить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;

}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <form asp-action="RestaurantMenu_Dish_Del">

                        <input asp-for="@Model.ID" type="hidden" />
                        <input asp-for="@Model.Restaurant_MenuID" type="hidden" />
                        <input asp-for="@Model.Dish" type="hidden" />
                        <input asp-for="@Model.Flag_Available" type="hidden" />
                        <input asp-for="@Model.Dish_CategoryID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @if (Model.Flag_Available)
                            {
                                <div class="form-group mb-0">
                                    <label>Вы уверены, что хотите скрыть блюдо "@Model.Dish"? </label>
                                </div>
                            }
                            else
                            {
                                <div class="form-group mb-0">
                                    <label>Вы уверены, что хотите восстановить блюдо "@Model.Dish"? </label>
                                </div>
                            }

                        </div>

                        <div class="card-footer">

                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-action="RestaurantMenu_Dish_Index">Назад</a>
                            </div>

                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Продолжить" class="btn btn-primary" />
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }