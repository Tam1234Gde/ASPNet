@using HIDE.RestAndRant.Web_Admin.Models.Cities
@model Model_Cities_CRUD
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Cities_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить город";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление пользователя *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="City_Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Название *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Название*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>  
                            
                            @* Название *@
                            <div class="form-group">
                                <label asp-for="NameDeclension" class="control-label">Название(склонение)*</label>
                                <input asp-for="NameDeclension" class="form-control" />
                                <span asp-validation-for="NameDeclension" class="text-danger"></span>
                            </div>

                            @* Порядок отображения *@
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                <input asp-for="OrderNum" class="form-control" type="number" />
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                            @* Отключен *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Hidden" /> Отключен
                                </label>
                            </div>

                            @* Заголовок в модальном окне при отключенном ресторане *@
                            <div class="form-group">
                                <label asp-for="HiddenTitle" class="control-label">Заголовок в модальном окне при отключенном ресторане </label>
                                <input asp-for="HiddenTitle" class="form-control" />
                            </div>

                            @* Текст в модальном окне при отключенном городе *@
                            <div class="form-group">
                                <label asp-for="HiddenText" class="control-label">Текст в модальном окне при отключенном городе </label>
                                <textarea asp-for="HiddenText" class="form-control"></textarea>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="City_Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}