@using HIDE.RestAndRant.Web_Admin.Models.Users
@model Model_Users_Table
@{
    // Таблица > Пользователи
    Layout = null;
}

@* Таблица > Пользователи *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CUser().Name)" title="@Html.DisplayNameFor(x=> new CUser().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CUser().Name)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-39.png" alt="@Html.DisplayNameFor(x=> new CUser().Login)" title="@Html.DisplayNameFor(x=> new CUser().Login)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CUser().Login)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new CUser().Flag_Root)" title="@Html.DisplayNameFor(x=> new CUser().Flag_Root)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CUser().Flag_Root)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new CUser().Flag_Admin)" title="@Html.DisplayNameFor(x=> new CUser().Flag_Admin)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CUser().Flag_Admin)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-16.png" alt="@Html.DisplayNameFor(x=> new CUser().Flag_Oper)" title="@Html.DisplayNameFor(x=> new CUser().Flag_Oper)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CUser().Flag_Oper)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x=> new CUser().Restaurant)" title="@Html.DisplayNameFor(x=> new CUser().Restaurant)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CUser().Restaurant)</span>
                </th>
                @if (Model.User.Flag_Root)
                {
                    <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (CUser item in Model.List_Users)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Login)
                    </td>
                    <td>
                        @if (item.Flag_Root)
                        {
                            <text>Суперадмин</text>
                        }
                    </td>
                    <td>
                        @if (item.Flag_Admin)
                        {
                            <text>Админ</text>
                        }
                    </td>
                    <td>
                        @if (item.Flag_Oper)
                        {
                            <text>Оператор</text>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant)
                    </td>
                    @if (Model.User.Flag_Root)
                    {
                        <td class="HIDE-button-actions">
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                            <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}