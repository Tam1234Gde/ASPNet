            <!-- admin-lte > Главный JS -->
            <script src="~/HIDE/jquery.maskedinput.js?"></script>
            <script src="~/HIDE/apexcharts.js?"></script>
            <script src="~/HIDE/select2.min.js?"></script>

            <script src="~/HIDE/color.js?"></script>

            @RenderSection("scripts", required: false)

            <script>
                    $(document).ready(function () {

                        /* Инициализация выпадающих списков */
                        $('.HIDE-js-select2').select2({
                            language: "ru",
                            "language": {
                                "noResults": function () {
                                    return "Не найдено";
                                }
                            }
                        });

                        // Select - Multiple - При выборе пунктов меню не закрывается
                        $('.HIDE-js-multiple-select').select2({
                            closeOnSelect: false
                        });

                        //Date and time picker
                        //$('#reservationdatetime').datetimepicker({ icons: { time: 'far fa-clock' } });

                        /* Настройка отображения выбранного изображения */
                        $(".HIDE-js-common-image_show").change(function () {
                            var $this = $(this);
                            var $item = $this.parent().find(".HIDE-js-common-image_show-item");
                            if ($item !== undefined && $item.length > 0) {
                                $item.remove();
                            }

                            $this.parent().find('.HIDE-file-error').remove();

                            if (this.files.length > 0) {

                               if( this.files[0].size  < 10000000){

                                   var reader = new FileReader();
                       
                                   reader.onload = function (e) {
                                           $this.parent().append("<img style=\"max-width:250px;max-height:250px; margin-bottom:12px\" class=\"HIDE-js-common-image_show-item\" src=" + e.target.result + " alt=\"\" />");
                                   };

                                   reader.readAsDataURL(this.files[0]);

                               } else{

                                    $this.val('');
                       
                                    $this.parent().append("<span class='text-danger HIDE-file-error'>Изображение слишком большое (макс. 10 МБ)</span>");
                               }

                            }
                        });

                        /* Настройка отображения выбранного изображения */
                        $(".HIDE-js-common-image_show").change(function () {
                            var $this = $(this);
                            var $item = $this.parent().find(".HIDE-js-common-image_show-item");

                            if (this.files.length > 0) {
                                var reader = new FileReader();
                                reader.onload = function (e) {
                                    $item.attr('src', e.target.result)
                                };
                                reader.readAsDataURL(this.files[0]);
                            }
                        });

                        //Colorpicker
                        $('.my-colorpicker1').colorpicker();

                        $(".HIDE-menu").click(function () {

                            let Submenu = $(this).find('.HIDE-submenu');

                            if (Submenu.is(':visible')) {
                                Submenu.slideUp()
                            }
                            else {
                                Submenu.slideDown();
                            }

                        })

                        /**
                    * Главные элемент
                    * */
                        let $Elem = $('.HIDE-js-select_search');
                        /**
                         * Селектор
                         * */
                        let $ElemSelect = $Elem.find("select");

                        $ElemSelect.select2();

                        // Получение имени пользователя
                        $.ajax({
                            type: "GET",
                            cache: false,
                            contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                            url: "@Url.Action(controller: "Users", action: "Get_UserName")",
                            success: function (data) {
                                if (data !== undefined && data !== null && data !== "") {
                                    $(".@id_FIO").html(data);
                                }
                            },
                            error: function (req, status, error) { }
                        });

                    });

            </script>

        </body>
