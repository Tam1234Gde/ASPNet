@using HIDE.RestAndRant.Web_Admin.Models.Dish_Categories
@model Model_Dish_Categories_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "DishParentCategories_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить родительскую категорию";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление категории *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование категории *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование родительской категории*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Использовать время работы из общих настроек *@
                            <div class="form-group">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Flag_UseDefaultWorkHours" />
                                    <label class="form-check-label" asp-for="Flag_UseDefaultWorkHours">
                                        Использовать время работы из общих настроек
                                    </label>
                                </div>
                                <small class="form-text text-muted">При включении будут использоваться часы работы из общих настроек</small>
                            </div>

                            @* Часы работы *@
                            <div class="form-group" id="work-hours-group">
                                <label class="control-label">Часы работы</label>
                                <div class="row">
                                    @for (int i = 0; i < 24; i++)
                                    {
                                        string displayTime = i.ToString("D2") + ":00";
                                        <div class="col-md-3 col-sm-4 col-xs-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       name="WorkHours" value="@i" id="hour_@i" />
                                                <label class="form-check-label" for="hour_@i">
                                                    @displayTime
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <small class="form-text text-muted">Выберите часы работы категории</small>
                            </div>

                            @* Порядок отображения *@
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                <input asp-for="OrderNum" class="form-control" type="number" value="0" />
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // При загрузке страницы проверяем состояние чекбокса
            toggleWorkHours($('#Flag_UseDefaultWorkHours').is(':checked'));

            // При изменении чекбокса
            $('#Flag_UseDefaultWorkHours').change(function() {
                toggleWorkHours($(this).is(':checked'));
            });

            function toggleWorkHours(useDefault) {
                if (useDefault) {
                    $('#work-hours-group').hide();
                } else {
                    $('#work-hours-group').show();
                }
            }
        });
    </script>
}