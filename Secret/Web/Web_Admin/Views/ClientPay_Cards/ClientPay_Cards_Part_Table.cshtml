@model List<CClientPay_Card_Data>
@{
    // Таблица > Оценка приложения
    Layout = null;
}

@* Таблица > Оценка приложения *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CClientPay_Card_Data().ClientPay_Card_Type)" title="@Html.DisplayNameFor(x=> new CClientPay_Card_Data().ClientPay_Card_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientPay_Card_Data().ClientPay_Card_Type)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CClientPay_Card_Data().CardIdent)" title="@Html.DisplayNameFor(x=> new CClientPay_Card_Data().CardIdent)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientPay_Card_Data().CardIdent)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x=> new CClientPay_Card_Data().CardLastNum)" title="@Html.DisplayNameFor(x=> new CClientPay_Card_Data().CardLastNum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClientPay_Card_Data().CardLastNum)</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ClientPay_Card_Type)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CardIdent)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CardLastNum)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}