@using HIDE.RestAndRant.Web_Admin.Models.Dish_Colors
@model Model_Dish_Colors_List
@{
    // Таблица > Цвета блюда
    Layout = null;
}

@* Таблица > Цвета блюда *@
@if (Model != null && Model.List_Colors != null && Model.List_Colors.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search">
                    <img src="/img/icon-fields-dopfield-42.png" alt="@Html.DisplayNameFor(x=> new CDish_Color().Color)" title="@Html.DisplayNameFor(x=> new CDish_Color().Color)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x=> new CDish_Color().Color)</span>
                </th>

                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Colors)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Color)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}