@using HIDE.RestAndRant.Web_Admin.Models.Dish_Colors
@model Model_Dish_Colors_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Dishes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить цвет";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление категории *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <input type="hidden" asp-for="@Model.DishID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Цвет *@
                            @if (Model.List_Colors != null && Model.List_Colors.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="ColorID">Цвет*</label>
                                    <select asp-for="ColorID" id="ColorID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Colors)
                                        {
                                            if (item.ID == Model.ColorID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ColorID" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                               <p>Цвета для блюд не добавлены - <a asp-controller="Colors" asp-action="Add">Добавить цвет</a></p> 
                            }

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index" asp-route-DishID="@Model.DishID">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }