@model List<CRestaurant_Table>
@{
    // Таблица > Столики в ресторане
    Layout = null;
}

@* Таблица > Столики в ресторане *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().ID)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().ID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().ID)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Name)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Name)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Coordinates)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Flag_IsAvailable)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Flag_IsAvailable)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Flag_IsAvailable)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Flag_IsAvailableApp)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Flag_IsAvailableApp)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Flag_IsAvailableApp)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Restaurant)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Restaurant)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Restaurant)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Restaurant_Table_Type)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Restaurant_Table_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Restaurant_Table_Type)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Restaurant_Hall)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Restaurant_Hall)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Restaurant_Hall)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates_X)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates_X)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Coordinates_X)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates_Y)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates_Y)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Coordinates_Y)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-16.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates_Rotation)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Coordinates_Rotation)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Coordinates_Rotation)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().Dop_Text)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().Dop_Text)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().Dop_Text)</span>
                </th>    
                <th class="export">
                    <img src="/img/icon-fields-dopfield-17.png" alt="@Html.DisplayNameFor(x=> new CRestaurant_Table().QR_Code)" title="@Html.DisplayNameFor(x=> new CRestaurant_Table().QR_Code)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CRestaurant_Table().QR_Code)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Coordinates)
                    </td>
                    <td>
                        @if (item.Flag_IsAvailable)
                        {
                            <input type="checkbox" checked="checked" disabled="">
                            <span style="display: none">+</span>
                        }
                        else
                        {
                            <input type="checkbox" disabled="">
                            <span style="display: none">-</span>
                        }
                    </td>
                    <td>
                        @if (item.Flag_IsAvailableApp)
                        {
                            <input type="checkbox" checked="checked" disabled="">
                            <span style="display: none">+</span>
                        }
                        else
                        {
                            <input type="checkbox" disabled="">
                            <span style="display: none">-</span>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant_Table_Type)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant_Hall)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Coordinates_X)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Coordinates_Y)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Coordinates_Rotation)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dop_Text)
                    </td>      
                    <td>
                        @Html.DisplayFor(modelItem => item.QR_Code)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}