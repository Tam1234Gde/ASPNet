@using HIDE.RestAndRant.Web_Admin.Models.RestaurantTables
@model Model_RestaurantTables_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Restaurant_Tables_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить столик в ресторане";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление столика в ресторане *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Ресторан *@
                            @if (Model.List_Restaurants != null && Model.List_Restaurants.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="RestaurantID">Ресторан*</label>
                                    <select asp-for="RestaurantID" id="RestaurantID" class="custom-select HIDE-custom-select rounded-0">
                                        <option selected="selected" disabled="disabled" value="-1">[Не задано]</option>
                                        @foreach (var item in Model.List_Restaurants)
                                        {
                                            <option value="@item.ID">@item.Address</option>
                                        }
                                    </select>
                                    <span asp-validation-for="RestaurantID" class="text-danger"></span>
                                </div>
                            }

                            @* Тип столика *@
                            @if (Model.List_RestaurantTableTypes != null && Model.List_RestaurantTableTypes.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Restaurant_Table_TypeID">Тип столика*</label>
                                    <select asp-for="Restaurant_Table_TypeID" id="Restaurant_Table_TypeID" class="custom-select HIDE-custom-select rounded-0">
                                        <option selected="selected" disabled="disabled" value="-1">[Не задано]</option>
                                        @foreach (var item in Model.List_RestaurantTableTypes)
                                        {
                                            <option value="@item.ID">@item.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Restaurant_Table_TypeID" class="text-danger"></span>
                                </div>
                            }

                            @* Статус столика *@
                            @if (Model.List_RestaurantTableStatuses != null && Model.List_RestaurantTableStatuses.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Restaurant_Table_StatusID">Статус столика*</label>
                                    <select asp-for="Restaurant_Table_StatusID" id="Restaurant_Table_StatusID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_RestaurantTableStatuses)
                                        {
                                            <option value="@item.ID">@item.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Restaurant_Table_StatusID" class="text-danger"></span>
                                </div>
                            }

                            @* Наименование стола *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование стола*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>        
 
                            @* Координаты *@
                            <div class="form-group">
                                <label asp-for="Coordinates" class="control-label">Координаты стола(для админки)</label>
                                <input asp-for="Coordinates" class="form-control" />
                            </div>

                            @* Координаты - X *@
                            <div class="form-group">
                                <label asp-for="Coordinates_X" class="control-label">Координаты стола - X</label>
                                <input asp-for="Coordinates_X" class="form-control" type="number" />
                            </div>

                            @* Координаты - Y *@
                            <div class="form-group">
                                <label asp-for="Coordinates_Y" class="control-label">Координаты стола - Y</label>
                                <input asp-for="Coordinates_Y" class="form-control" type="number" />
                            </div>

                            @* Координаты - Ротация *@
                            <div class="form-group">
                                <label asp-for="Coordinates_Rotation" class="control-label">Координаты стола - Ротация</label>
                                <input asp-for="Coordinates_Rotation" class="form-control" type="number" />
                            </div>

                            @* Дополнительный текст *@
                            <div class="form-group">
                                <label asp-for="Dop_Text" class="control-label">Дополнительный текст</label>
                                <input asp-for="Dop_Text" class="form-control" />
                            </div>

                            @* Стоимость бронирования *@
                            <div class="form-group">
                                <label asp-for="Price" class="control-label">Стоимость бронирования</label>
                                <input asp-for="Price" class="form-control" type="number" />
                            </div>

                            @* Уникальный код столика для QR-кода *@
                            <div class="form-group">
                                <label asp-for="QR_Code" class="control-label">Уникальный код столика для QR-кода*</label>
                                <input asp-for="QR_Code" class="form-control" />
                            </div>

                            @* Флаг доступности к заказу через приложение *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_IsAvailableApp" /> Флаг доступности к заказу через приложение
                                </label>
                            </div>

                            @* Флаг доступности к заказу через официанта *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_IsAvailable" /> Флаг доступности к заказу через официанта
                                </label>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }