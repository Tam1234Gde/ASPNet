@using HIDE.RestAndRant.Web_Admin.Models.Ingridients
@model Model_Ingridients_AddEdit
@{
    ViewData["Title"] = "Del";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List"; // или "IngridientCategories_List"

    // Добавляем флаги для полного меню
    ViewBag.Flag_ShowMenu = true;
    ViewBag.RestaurantID = null;

    // Заголовки страницы
    ViewBag.RazdelName = "Удалить категорию ингредиентов";
    ViewBag.RazdelNameMobile = "Удалить";

    // Иконки
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <form asp-action="Del" method="post">
                        <input asp-for="@Model.ID" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="card-body">
                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить категорию ингредиентов "@Model.Name"?</label>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="form-group float-left mb-0 pt-1">
                                <a asp-controller="IngridientCategories" asp-action="Index">Назад</a>
                            </div>
                            <div class="form-group float-right mb-0">
                                <input type="submit" value="Удалить" class="btn btn-primary" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}