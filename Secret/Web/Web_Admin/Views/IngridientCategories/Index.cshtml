@model List<CDish_Ingridient_Category?>
@{
    ViewData["Title"] = "Категории ингредиентов";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    ViewBag.RazdelName = "Категории ингредиентов";
    ViewBag.RazdelNameMobile = "Категории";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[1].Value;
}

<section class="content HIDE-table HIDE-table_actions">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header HIDE-card-header">
                        <div class="HIDE-table-title HIDE-card-header_left">
                            <h3 class="card-title">Список категорий</h3>
                        </div>
                        <div class="HIDE-card-options">
                            <div class="HIDE-right-buttons">
                                <div class="HIDE-button-reload" style="margin-right: 15px;">
                                    <label for="HIDE-show-deleted" style="color:#3c8dbc;padding:5px;cursor:pointer;">
                                        Показать удалённые
                                    </label>
                                    <input type="checkbox" id="HIDE-show-deleted" />
                                </div>

                                <div class="HIDE-button-add">
                                    <a asp-action="Add" class="btn btn-block btn-primary"><i class="fas fa-plus"></i> Добавить категорию</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="HIDE-js-partial_table HIDE-partial-table HIDE-partial-table__scroll">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Название</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model)
                                {
                                    <tr class="@(cat?.Flag_Del == true ? "HIDE-bg-deleted" : "")">
                                        <td>@cat?.ID</td>
                                        <td>
                                            @cat?.Name
                                            @if (cat?.Flag_Del == true)
                                            {
                                                <span style="color:red;font-size:12px;">(удалена)</span>
                                            }
                                        </td>
                                        <td>
                                            @if (cat?.Flag_Del == true)
                                            {
                                                <a asp-action="Restore" asp-route-id="@cat?.ID" class="btn btn-sm btn-success">Восстановить</a>
                                            }
                                            else
                                            {
                                                <a asp-action="Edit" asp-route-id="@cat?.ID" class="btn btn-sm btn-warning">Редактировать</a>
                                                <a asp-action="Del" asp-route-ID="@cat?.ID" class="btn btn-sm btn-danger">Удалить</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            // По умолчанию скрываем удалённые
            $('table tbody tr.HIDE-bg-deleted').hide();

            // Переключение чекбокса
            $('#HIDE-show-deleted').change(function() {
                if ($(this).is(':checked')) {
                    $('table tbody tr.HIDE-bg-deleted').show();
                } else {
                    $('table tbody tr.HIDE-bg-deleted').hide();
                }
            });
        });
    </script>
}