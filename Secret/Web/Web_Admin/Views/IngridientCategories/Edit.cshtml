@model CDish_Ingridient_Category?
@{
    ViewData["Title"] = "Редактирование категории";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewBag.RazdelName = "Редактирование категории";
    ViewBag.RazdelNameMobile = "Редактирование";
    ViewBag.Icon = "fas fa-edit";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-warning">
                    <div class="card-header">
                        <h3 class="card-title">Редактирование: @Model?.Name</h3>
                    </div>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model?.ID" />
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label for="name">Название категории</label>
                                <input type="text" id="name" name="name" class="form-control" value="@Model?.Name" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-warning">Обновить</button>
                            <a asp-action="Index" class="btn btn-default">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>