@using HIDE.RestAndRant.Web_Admin.Models.Dish_Ingridients
@model Model_Dish_Ingridients_AddEdit
@{
    ViewData["Title"] = "Del";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Удалить ингридиент";
    ViewBag.RazdelNameMobile = "Удалить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[3].Value;

}

@* Удалить ингридиент *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <form asp-action="Del">

                        <input asp-for="@Model.ID" type="hidden" />
                        <input asp-for="@Model.DishID" type="hidden" />
                        <input asp-for="@Model.IngridientID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить ингредиент "@Model.Ingridient" для блюда "@Model.Dish"? </label>
                            </div>

                            @* Удалить во всех ресторанах *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="FlagForAll" /> Удалить для всех блюд во всех ресторанах
                                </label>
                            </div>

                        </div>

                        <div class="card-footer">

                            <div class="form-group">
                                <input type="submit" value="Удалить" class="btn btn-primary" />
                            </div>

                            <div class="form-group">
                                <a asp-controller="DishIngridients" asp-action="Index" asp-route-DishID="@Model.DishID">Назад</a>
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }