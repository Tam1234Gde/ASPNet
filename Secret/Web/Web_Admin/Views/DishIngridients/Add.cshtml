@using HIDE.RestAndRant.Web_Admin.Models.Dish_Ingridients
@model Model_Dish_Ingridients_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Ingridients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить ингридиент";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление ингридиента *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <input type="hidden" asp-for="@Model.DishID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Ингридиент *@
                            @if (Model.List_Ingridients != null && Model.List_Ingridients.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="IngridientID">Ингридиент*</label>
                                    <select asp-for="IngridientID" id="Dish_CategoryID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Ingridients)
                                        {
                                            if (item.ID == Model.IngridientID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="IngridientID" class="text-danger"></span>
                                </div>
                            }

                            @* Стоимость *@
                            <div class="form-group">
                                <label asp-for="Price" class="control-label">Стоимость*</label>
                                <input asp-for="Price" class="form-control" type="number" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @* Количество минут для приготовления *@
                            <div class="form-group">
                                <label asp-for="Cooking_Minutes" class="control-label">Количество минут для приготовления</label>
                                <input asp-for="Cooking_Minutes" class="form-control" type="number" />
                            </div>

                            @* Ингредиент относится к группе *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input HIDE-js-button-group" asp-for="Flag_IsGroup" /> Ингредиент относится к группе
                                </label>
                            </div>

                            @* Группа *@
                            <div class="form-group HIDE-js-block-group" style="display: none;">
                                <label asp-for="IngridientGroupID" class="control-label">Группа</label>
                                <input asp-for="IngridientGroupID" class="form-control" type="number" />
                                <span asp-validation-for="IngridientGroupID" class="text-danger"></span>
                            </div>

                            @* Вспомогательный класс *@
                            <div class="callout callout-info">
                                <h5>При активированном флажке "Ингредиент относится к группе"</h5>
                                <p>Требуется указать код группы, единый для ингредиентов, для которых доступен выбор только одного состояния</p>
                            </div>

                            @* Добавить во все рестораны *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="FlagForAll" /> Добавить во все рестораны
                                </label>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index" asp-route-DishID="@Model.DishID">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(".HIDE-js-button-group").click(function () {
            $(".HIDE-js-block-group").toggle();
            $(".HIDE-js-block-group input").val("");
        });
    </script>

    }