@using HIDE.RestAndRant.Web_Admin.Models.Dish_Ingridients
@model Model_Dish_Ingridients_List
@{
    // Таблица > Ингридиенты блюда
    Layout = null;
}

@* Таблица > Ингридиенты блюда *@
@if (Model != null && Model.List_Ingridients != null && Model.List_Ingridients.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search">
                    <img src="/img/icon-fields-dopfield-42.png" alt="@Html.DisplayNameFor(x=> new CDish_Ingridient().Ingridient)" title="@Html.DisplayNameFor(x=> new CDish_Ingridient().Ingridient)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x=> new CDish_Ingridient().Ingridient)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CDish_Ingridient().Price)" title="@Html.DisplayNameFor(x=> new CDish_Ingridient().Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x=> new CDish_Ingridient().Price)</span>
                </th>  
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x=> new CDish_Ingridient().Cooking_Minutes)" title="@Html.DisplayNameFor(x=> new CDish_Ingridient().Cooking_Minutes)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_Ingridient().Cooking_Minutes)</span>
                </th> 
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CDish_Ingridient().IngridientGroupID)" title="@Html.DisplayNameFor(x=> new CDish_Ingridient().IngridientGroupID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_Ingridient().IngridientGroupID)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Ingridients)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ingridient)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Cooking_Minutes)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IngridientGroupID)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}