@using HIDE.RestAndRant.Web_Admin.Models.Clients
@model Model_Clients_AddEdit
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Clients_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать клиента";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;

    string id_MediaFile = $"HIDE-js-mediafile-{Guid.NewGuid()}";
}

@* Редактирование клиента *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Image" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Телефон *@
                            <div class="form-group">
                                <label asp-for="Phone" class="control-label">Телефон*</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            @* Имя *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Имя</label>
                                <input asp-for="Name" class="form-control" />
                            </div>

                            @* Адрес доставки *@
                            <div class="form-group">
                                <label asp-for="Delivery_Address" class="control-label">Адрес доставки</label>
                                <input asp-for="Delivery_Address" class="form-control" />
                            </div>

                            @* Квартира *@
                            <div class="form-group">
                                <label asp-for="Delivery_Apartment" class="control-label">Квартира</label>
                                <input asp-for="Delivery_Apartment" class="form-control" />
                            </div>

                            @* Домофон *@
                            <div class="form-group">
                                <label asp-for="Delivery_EntranceCode" class="control-label">Домофон</label>
                                <input asp-for="Delivery_EntranceCode" class="form-control" />
                            </div>

                            @* Номер подъезда *@
                            <div class="form-group">
                                <label asp-for="Delivery_EntranceNumber" class="control-label">Номер подъезда</label>
                                <input asp-for="Delivery_EntranceNumber" class="form-control" />
                            </div>

                            @* Этаж *@
                            <div class="form-group">
                                <label asp-for="Delivery_Floor" class="control-label">Этаж</label>
                                <input asp-for="Delivery_Floor" class="form-control" />
                            </div>

                            @* Имя - Другому человеку *@
                            <div class="form-group">
                                <label asp-for="Name_Another" class="control-label">Имя - Другому человеку</label>
                                <input asp-for="Name_Another" class="form-control" />
                            </div>

                            @* Телефон - Другому человеку *@
                            <div class="form-group">
                                <label asp-for="Phone_Another" class="control-label">Телефон - Другому человеку</label>
                                <input asp-for="Phone_Another" class="form-control" />
                            </div>

                            @* Марка машины *@
                            <div class="form-group">
                                <label asp-for="Car_Brand" class="control-label">Марка машины</label>
                                <input asp-for="Car_Brand" class="form-control" />
                            </div>

                            @* Гос. номера машины *@
                            <div class="form-group">
                                <label asp-for="Car_RegNumber" class="control-label">Гос. номера машины</label>
                                <input asp-for="Car_RegNumber" class="form-control" />
                            </div>

                            @* Цвет машины *@
                            <div class="form-group">
                                <label asp-for="Car_Color" class="control-label">Цвет машины</label>
                                <input asp-for="Car_Color" class="form-control" />
                            </div>

                            @* Дата рождения *@
                            <div class="form-group">
                                <label asp-for="Date_Birth" class="control-label">Дата рождения</label>
                                <input asp-for="Date_Birth" class="form-control" type="date" value="@Model.Date_Birth" />
                            </div>

                            @* Политика принята *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_IsPolicy" /> Политика принята
                                </label>
                            </div>

                            @* Изображение *@
                            <div class="form-group">
                                <label for="@id_MediaFile">Изображение</label>
                                <div class="clearfix"></div>
                                <input id="@id_MediaFile" style="display:block;" asp-for="@Model.UploadImge" type="file" class="btn btn-warning HIDE-js-common-image_show" 
                                                          accept=".jpg,.jpeg,.png" />

                                @if (Model != null && !string.IsNullOrWhiteSpace(Model.Image_Url))
                                {
                                    <img style="max-width:250px;max-height:250px;" class="HIDE-js-common-image_show-item" src="@Model.Image_Url" alt="" />
                                    <div class="clearfix"></div>
                                    <a asp-controller="Clients" asp-action="Client_DelImage" asp-route-id="@Model.ID" class="btn btn-danger">Удалить изображение</a>
                                }
                                <span asp-validation-for="Image_Url" class="text-danger"></span>
                            </div>

                            @* Количество бонусов *@
                            @*<div class="form-group">
                            <label asp-for="Bonuses" class="control-label">Количество бонусов*</label>
                            <input asp-for="Bonuses" class="form-control" type="number" />
                            <span asp-validation-for="Bonuses" class="text-danger"></span>
                            </div>*@

                            @* SMS-code *@
                            @* <div class="form-group">
                            <label asp-for="SmsCode" class="control-label">Смс код*</label>
                            <input asp-for="SmsCode" class="form-control" />
                            </div>*@

                            @* Guid *@
                            @*<div class="form-group">
                            <label asp-for="Guid" class="control-label">Guid*</label>
                            <input asp-for="Guid" class="form-control" />
                            </div>*@

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }