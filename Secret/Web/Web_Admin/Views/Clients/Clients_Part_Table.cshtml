@model List<CClient>
@{
    // Таблица > Клиенты
    Layout = null;
}

@* Таблица > Клиенты *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                @* <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-3.png" alt="Изображение" title="Изображение">
                    <span class="HIDE-jscss-table-head-text">Изображение</span>
                </th> *@
                <th class="" style="max-width: 30px; width: 30px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CClient().Guid)" title="@Html.DisplayNameFor(x => new CClient().Guid)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Guid)</span>
                </th>
                <th class="export" style="max-width: 30px; width: 30px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CClient().ID)" title="@Html.DisplayNameFor(x => new CClient().ID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().ID)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CClient().Name)" title="@Html.DisplayNameFor(x => new CClient().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Name)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-dopfield-39.png" alt="@Html.DisplayNameFor(x => new CClient().Phone)" title="@Html.DisplayNameFor(x => new CClient().Phone)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Phone)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x => new CClient().Date_Registration)" title="@Html.DisplayNameFor(x => new CClient().Date_Registration)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Date_Registration)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="Время регистрации" title="Время регистрации">
                    <span class="HIDE-jscss-table-head-text">Время регистрации</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x => new CClient().Date_Birth)" title="@Html.DisplayNameFor(x => new CClient().Date_Birth)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Date_Birth)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x => new CClient().Date_LastZakaz)" title="@Html.DisplayNameFor(x => new CClient().Date_LastZakaz)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Date_LastZakaz)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-date.png" alt="Время последнего заказа" title="Время последнего заказа">
                    <span class="HIDE-jscss-table-head-text">Время последнего заказа</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-43.png" alt="@Html.DisplayNameFor(x => new CClient().City)" title="@Html.DisplayNameFor(x => new CClient().City)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().City)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-7.png" alt="@Html.DisplayNameFor(x => new CClient().OrdersSum)" title="@Html.DisplayNameFor(x => new CClient().OrdersSum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().OrdersSum)</span>
                </th>
                @*  <th class="export">
                    <img src="/img/icon-fields-dopfield-22.png" alt="@Html.DisplayNameFor(x=> new Model_Client().Bonuses)" title="@Html.DisplayNameFor(x=> new Model_Client().Bonuses)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new Model_Client().Bonuses)</span>
                </th> *@
                @* <th class="export">
                    <img src="/img/icon-fields-dopfield-22.png" alt="@Html.DisplayNameFor(x=> new CClient().Flag_IsPolicy)" title="@Html.DisplayNameFor(x=> new CClient().Flag_IsPolicy)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Flag_IsPolicy)</span>
                </th> *@
                @* <th class="export">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new CClient().Date_LastZakaz)" title="@Html.DisplayNameFor(x=> new CClient().Date_LastZakaz)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CClient().Date_LastZakaz)</span>
                </th> *@
                <th data-orderable="false" style="min-width: 105px; width: 105px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string elem_class = "";
                if (item.Flag_Del)
                {
                    elem_class = "bg-secondary bg-gradient";
                }

                <tr class="@elem_class">
                    @* <td>
                        <img src="@item.Image_Url" alt="" style="max-width: 150px; max-height: 50px;" />
                    </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.Guid)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Phone)
                    </td>
                    <td>
                        @if (item.Date_Registration.HasValue && item.Date_Registration.Value > DateTime.MinValue)
                        {
                            @item.Date_Registration.Value.ToShortDateString()
                        }
                    </td>
                    <td>
                        @if (item.Date_Registration.HasValue && item.Date_Registration.Value > DateTime.MinValue)
                        {
                            @item.Date_Registration.Value.ToShortTimeString()
                        }
                    </td>
                    <td>
                        @Html.Raw(item.Date_Birth.HasValue ? item.Date_Birth.Value.ToShortDateString() : "")
                    </td>
                    <td>
                        @if (item.Date_LastZakaz.HasValue && item.Date_LastZakaz.Value > DateTime.MinValue)
                        {
                            @item.Date_LastZakaz.Value.ToShortDateString()
                        }
                    </td>
                    <td>
                        @if (item.Date_LastZakaz.HasValue && item.Date_LastZakaz.Value > DateTime.MinValue)
                        {
                            @item.Date_LastZakaz.Value.ToShortTimeString()
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.City)
                    </td>
                    <td>
                        @{
                            decimal? sum = item.OrdersSum.HasValue ? item.OrdersSum.Value : 0;
                        }
                        @Html.Raw(sum.Value.ToString("#,#"))
                    </td>
                    @* <td>
                        @Math.Round((decimal)item.Bonuses, 0)
                    </td> *@
                    @* <td>
                        @if (item.Flag_IsPolicy)
                        {
                            <input type="checkbox" checked="checked" disabled="">
                            <span style="display: none">+</span>
                        }
                        else
                        {
                            <input type="checkbox" disabled="">
                            <span style="display: none">-</span>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date_LastZakaz)
                    </td> *@
                    <td class="HIDE-button-actions">
                        <a asp-controller="ClientNotifications" asp-action="Index" asp-route-ClientID="@item.ID" class="btn btn-block bg-gradient-success text-light"><i class="fas fa-eye"></i></a>
                        <a asp-controller="ClientPay_Cards" asp-action="Index" asp-route-ClientID="@item.ID" class="btn btn-block bg-gradient-primary text-light" style="margin-right: 5px;"><i class="fas fa-credit-card"></i></a>
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning" style="margin-right: 5px; margin-top: 0;"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger" style="margin-top: 0; margin-right: 0;"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}