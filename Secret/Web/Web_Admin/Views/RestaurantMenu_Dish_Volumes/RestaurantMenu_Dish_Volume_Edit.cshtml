@using HIDE.RestAndRant.Web_Admin.Models.RestaurantMenu_Dish_Volumes
@model Model_RestaurantMenu_Dish_Volumes_CRUD
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Volumes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Редактировать объёма";
    ViewBag.RazdelNameMobile = "Редактировать";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

@* Редактирование категории *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="RestaurantMenu_Dish_Volume_Edit">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="@Model.Restaurant_Menu_DishID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Объём *@
                            @if (Model.List_Volumes != null && Model.List_Volumes.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="VolumeID">Объём*</label>
                                    <select asp-for="VolumeID" id="VolumeID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Volumes)
                                        {
                                            if (item.ID == Model.VolumeID)
                                            {
                                                <option selected value="@item.ID">@item.Value</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Value</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="VolumeID" class="text-danger"></span>
                                </div>
                            }

                            @* Стоимость *@
                            <div class="form-group">
                                <label asp-for="Price" class="control-label">Стоимость*</label>
                                <input asp-for="Price" class="form-control" type="number" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @* Порядок отображения *@
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                <input asp-for="OrderNum" class="form-control" type="number" />
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="RestaurantMenu_Dish_Volume_Index" asp-route-Restaurant_Menu_DishID="@Model.Restaurant_Menu_DishID">Назад</a>
                                    </div>
                                </div>

                                @* Сохранить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }