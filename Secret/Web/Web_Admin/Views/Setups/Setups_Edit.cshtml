@using HIDE.RestAndRant.Common.Consts
@using HIDE.RestAndRant.Web_Admin.Models.Setups
@model Model_Setups_AddEdit
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Setups_List";

    ViewBag.RazdelName = "Редактирование настройки";
    ViewBag.RazdelNameMobile = "Редактирование";

    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[5].Value;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Setups_Edit">
                        <input type="hidden" asp-for="Key" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">
                            <div class="form-group">
                                <label class="control-label">Ключ</label>
                                <input asp-for="Key" class="form-control" readonly />
                            </div>

                            @* Для часов работы по умолчанию *@
                            @if (Model.Key == Consts.SetupKey_DefaultWorkHours)
                            {
                                <div class="form-group">
                                    <label class="control-label">Часы работы по умолчанию</label>
                                    <div class="row">
                                        @{
                                            string[] selectedHours = Model.Val1?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? new string[0];
                                        }
                                        @for (int i = 0; i < 24; i++)
                                        {
                                            string displayTime = i.ToString("D2") + ":00";
                                            bool isChecked = selectedHours.Contains(i.ToString());
                                            <div class="col-md-3 col-sm-4 col-xs-6">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="SelectedHours" value="@i" id="hour_@i" @(isChecked ? "checked" : "") />
                                                    <label class="form-check-label" for="hour_@i">
                                                        @displayTime
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <small class="form-text text-muted">Выберите часы работы по умолчанию</small>
                                </div>
                            }

                            @* Для часов работы по умолчанию *@
                            @if (Model.Key == Consts.SetupKey_Restaurants_DefaultWorkHours)
                            {
                                <div class="form-group">
                                    <label class="control-label">Часы работы ресторана по умолчанию</label>
                                    <div class="row">
                                        @{
                                            string[] selectedHours = Model.Val1?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? new string[0];
                                        }
                                        @for (int i = 0; i < 24; i++)
                                        {
                                            string displayTime = i.ToString("D2") + ":00";
                                            bool isChecked = selectedHours.Contains(i.ToString());
                                            <div class="col-md-3 col-sm-4 col-xs-6">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="SelectedHours" value="@i" id="hour_@i" @(isChecked ? "checked" : "") />
                                                    <label class="form-check-label" for="hour_@i">
                                                        @displayTime
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <small class="form-text text-muted">Выберите часы работы по умолчанию</small>
                                </div>
                            }

                            @* Для номера телефона *@
                            @if (Model.Key == Consts.SetupKey_DefaultPhoneNumber)
                            {
                                <div class="form-group">
                                    <label class="control-label">Номер телефона</label>
                                    <input asp-for="Val1" class="form-control" HIDEholder="+7 (XXX) XXX-XX-XX" />
                                    <span asp-validation-for="Val1" class="text-danger"></span>
                                    <small class="form-text text-muted">Введите номер телефона в любом формате</small>
                                </div>
                            }

                            @* Для чекбокса "Использовать часы работы по умолчанию" *@
                            @if (Model.Key == Consts.SetupKey_UseDefaultWorkHours)
                            {
                                <div class="form-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="Flag" />
                                        <label class="form-check-label" asp-for="Flag">
                                            Использовать часы работы по умолчанию
                                        </label>
                                    </div>
                                    <small class="form-text text-muted">При включении родительские категории будут использовать часы работы по умолчанию</small>
                                </div>
                            }

                            @* Для чекбокса "Проверка приложения" *@
                            @if (Model.Key == Consts.SetupKey_Dop_CheckApp)
                            {
                                <div class="form-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="Flag" />
                                        <label class="form-check-label" asp-for="Flag">
                                            Проверка приложения
                                        </label>
                                    </div>
                                </div>
                            }

                            @* Для остальных настроек *@
                            @if (Model.Key != Consts.SetupKey_DefaultWorkHours &&
                                 Model.Key != Consts.SetupKey_Restaurants_DefaultWorkHours &&
                                 Model.Key != Consts.SetupKey_DefaultPhoneNumber &&
                                 Model.Key != Consts.SetupKey_UseDefaultWorkHours &&
                                 Model.Key != Consts.SetupKey_Dop_CheckApp)
                            {
                                <div class="form-group">
                                    <label class="control-label">Значение</label>
                                    <input asp-for="Val1" class="form-control" />
                                    <span asp-validation-for="Val1" class="text-danger"></span>
                                </div>
                            }

                            <div class="form-group">
                                <label class="control-label">Комментарий</label>
                                <input asp-for="Val1_Comment" class="form-control" />
                            </div>

                            @* Val2 *@
                            <div class="form-group">
                                <label class="control-label">Значение 2</label>
                                <input asp-for="Val2" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="control-label">Комментарий к значению 2</label>
                                <input asp-for="Val2_Comment" class="form-control" />
                            </div>

                            @* Val3 *@
                            <div class="form-group">
                                <label class="control-label">Значение 3</label>
                                <input asp-for="Val3" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="control-label">Комментарий к значению 3</label>
                                <input asp-for="Val3_Comment" class="form-control" />
                            </div>

                            @* Val4 *@
                            <div class="form-group">
                                <label class="control-label">Значение 4</label>
                                <input asp-for="Val4" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="control-label">Комментарий к значению 4</label>
                                <input asp-for="Val4_Comment" class="form-control" />
                            </div>

                        </div>

                        <div class="card-footer">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Setups_List">Назад</a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Сохранить" class="btn btn-primary" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}