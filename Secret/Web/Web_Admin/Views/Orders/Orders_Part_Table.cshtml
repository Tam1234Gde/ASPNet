@using HIDE.RestAndRant.Web_Admin.Models.Orders
@model Model_Orders_List
@{
    // Таблица > Заказы
    Layout = null;
}

@* Таблица > Заказы *@
@if (Model != null && Model.List_Orders != null && Model.List_Orders.Count() != 0)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().ID)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().ID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().ID)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-3.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Order_Status)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Order_Status)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Order_Status)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Order_FavoriteID)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Order_FavoriteID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Order_FavoriteID)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Client)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Client)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Client)</span>
                </th>
                <th style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_Act)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_Act)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_Act)</span>
                </th>
                <th class="export HIDE-display_none" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_Act)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_Act)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_Act)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Name)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Name)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-41.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Phone)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Phone)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Phone)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-11.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Pay_Type)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Pay_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Pay_Type)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Restaurant)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Restaurant)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Restaurant)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Order_Type)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Order_Type)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Order_Type)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Flag_Payed)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Flag_Payed)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Flag_Payed)</span>
                </th>
                <th style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_To)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_To)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_To)</span>
                </th>
                <th class="export HIDE-display_none" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_To)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Date_To)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_To)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-7.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Sum)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Sum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Sum)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-43.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Car_Brand)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Car_Brand)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Car_Brand)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-43.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Handing)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Handing)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Handing)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-comment.png" alt="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Comment)" title="@Html.DisplayNameFor(x=> new COrder_ForAdmin().Comment)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_ForAdmin().Comment)</span>
                </th>
                <th data-orderable="false" style="min-width: 105px; width: 105px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Orders)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Order_Status)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Order_FavoriteID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client) <br />
                        @Html.DisplayFor(modelItem => item.Client_Phone)
                    </td>
                    <td>
                        <span style="display:none; visibility:hidden">@item.Date_Act.ToBinary()</span>
                        @Html.DisplayFor(modelItem => item.Date_Act)
                    </td>
                    <td class="HIDE-display_none">
                        @Html.DisplayFor(modelItem => item.Date_Act)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Phone)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Pay_Type)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant)
                    </td>
                    <td>

                        @switch ((int)item.Order_TypeID)
                        {
                            case 3:
                                <text>С собой</text>
                                break;

                            case 6:
                                <text>Поесть в кафе</text>
                                <a asp-action="Order_Booking" asp-route-BookingID="@item.BookingID" asp-route-Booking_Price="@Html.Raw(item.Booking_Price.HasValue ? Math.Round(item.Booking_Price.Value, 0) : null)" class="btn btn-block btn-info btn-xs mt-2" style="color:#fff">Подробнее</a>
                                break;

                            case 9:
                                @Html.Raw(item.Delivery_Price > 0 ? "Доставка - " + item.Delivery_Price + "р." : "Доставка - Бесплатно")
                                <a asp-action="Order_Delivery" asp-route-OrderID="@item.ID" class="btn btn-block btn-info btn-xs mt-2" style="color:#fff">Подробнее</a>
                                break;

                            case 12:
                                <text>Вынести к машине</text>
                                break;

                            default:
                                <text>-</text>
                                break;
                        }

                    </td>
                    <td>
                        @if (item.Flag_Payed)
                        {
                            <input type="checkbox" checked="checked" disabled="">
                            <span style="display: none">+</span>
                        }
                        else
                        {
                            <input type="checkbox" disabled="">
                            <span style="display: none">-</span>
                        }
                    </td>
                    <td>
                        @{
                            DateTime UpdatedTime = item.Date_To ?? DateTime.Now;
                        }
                        <span style="display:none; visibility:hidden">@UpdatedTime.ToBinary()</span>
                        @Html.DisplayFor(modelItem => item.Date_To)
                    </td>
                    <td class="HIDE-display_none">
                        @Html.DisplayFor(modelItem => item.Date_To)
                    </td>
                    <td>
                        @{
                            decimal delivery = item.Delivery_Price.HasValue ? item.Delivery_Price.Value : 0;
                            decimal? sum = item.Sum + delivery;
                        }
                        @Html.Raw(sum.HasValue ? Math.Round(sum.Value, 0) : 0)
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.Car_Brand))
                        {
                            @item.Car_Brand <br />
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Car_RegNumber))
                        {
                            @item.Car_RegNumber <br />
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Car_Color))
                        {
                            @item.Car_Color <br />
                        }
                    </td>
                    <td>
                        @if (item.Handing.HasValue)
                        {
                            @Math.Round(item.Handing.Value, 0)
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.Comment_AddToOrder))
                        {
                            <text><b>Добавить к заказу:</b></text> <br />
                            @item.Comment_AddToOrder

                            <br />
                            <br />
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Comment_RemoveFromOrder))
                        {
                            <text><b>Убрать из заказа:</b></text> <br />
                            @item.Comment_RemoveFromOrder
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Comment))
                        {
                            <br />
                            <text><b>Комментарий:</b></text> <br />
                            @item.Comment
                        }
                    </td>
                    <td class="HIDE-button-actions">
                        @*<a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>*@
                        <a asp-action="Edit_Status" asp-route-id="@item.ID" class="btn btn-block bg-gradient-success"><i class="fas fa-edit"></i></a>
                        <a asp-action="Order_Details" asp-route-OrderID="@item.ID" class="btn btn-block bg-gradient-warning" style="margin-right: 4px;"><i class="fas fa-eye"></i></a>

                        @*if (item.Order_StatusID != HIDE.RestAndRant.Common.ENums.EOrder_Status.Cancelled && item.Order_StatusID != HIDE.RestAndRant.Common.ENums.EOrder_Status.Complete &&
                            item.Pay_TypeID == EPayType.CardInApp)
                        {
                           <a action="Order_Refund" route-ID="item.ID" class="btn btn-block bg-gradient-secondary text-light" style="margin-right: 4px; margin-top: 0px;"><i class="fas fa-minus-circle"></i></a>   
                        }*@

                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger" style="margin-top: 0;"><i class="fas fa-times-circle" style="color:#ffffff;"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}