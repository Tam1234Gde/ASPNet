@using HIDE.RestAndRant.Web_Admin.Models.Orders
@model Model_Order_Booking
@{
    // Таблица > Заказы
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";


    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Бронирование";
    ViewBag.RazdelNameMobile = "Бронирование";
}



@* Таблица > Бронирование *@
@if (Model != null)
{
    <div class="content">

        <div class="container-fluid">
            <div class="invoice p-3 mb-3">

                <div class="row">


                    <div class="col-6">
                        <p class="lead"> Адрес ресторана - @Model.Restaurant</p>

                        <div class="table-responsive">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <th style="width:50%">  Тип:</th>
                                        <td>@Model.Restaurant_Table_Type</td>
                                    </tr>
                                    <tr>
                                        <th> Столик:</th>
                                        <td>@Model.Booking?.Restaurant_Table</td>
                                    </tr>
                                    <tr>
                                        <th>Стоимость брони:</th>
                                        <td>@Html.Raw(Model.Booking_Price.HasValue ? Model.Booking_Price.Value.ToString("#,#") : 0)</td>
                                    </tr>  
                                    <tr>
                                        <th>К доплате:</th>
                                        <td><b>@Html.Raw(Model.Booking_Price.HasValue && Model.Booking_Price.Value > 0 ? (Model.Booking_Price.Value - 1000).ToString("#,#") : 0)</b></td>
                                    </tr>
                                    <tr>
                                        <th>Количество гостей:</th>
                                        <td>@Model.Booking?.NumberQuests</td>
                                    </tr>
                                    <tr>
                                        <th>Дата начала брони:</th>
                                        <td>@Model.Booking?.Date_Start</td>
                                    </tr>
                                    <tr>
                                        <th>Дата окончания брони:</th>
                                        <td>@Model.Booking?.Date_End</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>



            </div>
        </div>

    </div>
  
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}