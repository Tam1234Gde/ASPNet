@using HIDE.RestAndRant.Web_Admin.Models.Orders
@model Model_Order_Details_Ingridients
@{
    // Таблица > Заказы
    Layout = null;
}

@* Таблица > Заказы *@
@if (Model != null && Model.List_OrderDataIngridients != null && Model.List_OrderDataIngridients.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="export" style="width: 20px; max-width: 20px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Order_DataID)" title="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Order_DataID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_Ingridient_ForAdmin().Order_DataID)</span>
                </th>
                <th class="search export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient)" title="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_Ingridient_ForAdmin().Ingridient)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient_Price)" title="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient_Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_Ingridient_ForAdmin().Ingridient_Price)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-dopfield-7.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient_Count)" title="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient_Count)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_Ingridient_ForAdmin().Ingridient_Count)</span>
                </th>
                <th class="export" style="width: 150px; max-width: 150px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient_Summ)" title="@Html.DisplayNameFor(x=> new COrder_Data_Ingridient_ForAdmin().Ingridient_Summ)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new COrder_Data_Ingridient_ForAdmin().Ingridient_Summ)</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_OrderDataIngridients)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Order_DataID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ingridient)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ingridient_Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ingridient_Count)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ingridient_Summ)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}