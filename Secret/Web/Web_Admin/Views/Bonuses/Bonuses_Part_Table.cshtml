@model List<CBonus>
@{
    // Таблица > Начисление бонусов
    Layout = null;
}

@* Таблица > Начисление бонусов *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export" style="width: 50px; max-width: 50px;">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x=> new CBonus().ClientID)" title="@Html.DisplayNameFor(x=> new CBonus().ClientID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBonus().ClientID)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-39.png" alt="@Html.DisplayNameFor(x=> new CBonus().Client)" title="@Html.DisplayNameFor(x=> new CBonus().Client)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBonus().Client)</span>
                </th> 
                <th class="export">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x=> new CBonus().OrderID)" title="@Html.DisplayNameFor(x=> new CBonus().OrderID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBonus().OrderID)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x=> new CBonus().Bonuses)" title="@Html.DisplayNameFor(x=> new CBonus().Bonuses)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBonus().Bonuses)</span>
                </th>
                <th>
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new CBonus().Date_Action)" title="@Html.DisplayNameFor(x=> new CBonus().Date_Action)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBonus().Date_Action)</span>
                </th>
                <th class="export HIDE-display_none">
                    <img src="/img/icon-fields-date.png" alt="@Html.DisplayNameFor(x=> new CBonus().Date_Action)" title="@Html.DisplayNameFor(x=> new CBonus().Date_Action)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBonus().Date_Action)</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ClientID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderID)
                    </td> 
                    <td>
                        @Html.DisplayFor(modelItem => item.Bonuses)
                    </td>
                    <td>
                        <span style="display:none; visibility:hidden">@item.Date_Action.ToBinary()</span>
                        @Html.DisplayFor(modelItem => item.Date_Action)
                    </td>
                    <td class="HIDE-display_none">
                        @Html.DisplayFor(modelItem => item.Date_Action)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}