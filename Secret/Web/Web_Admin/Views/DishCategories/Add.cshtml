@using HIDE.RestAndRant.Web_Admin.Models.Dish_Categories
@model Model_Dish_Categories_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "DishCategories_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить категорию";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;
}

@* Добавление категории *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование категории *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование категории*</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Родительская категория *@
                            <div class="form-group">
                                <label asp-for="ParentID" class="control-label">Родительская категория</label>
                                <select asp-for="ParentID" class="form-control">
                                    <option value="">-- Выберите родительскую категорию --</option>
                                    @if (Model.List_ParentCategories != null && Model.List_ParentCategories.Any())
                                    {
                                        foreach (var category in Model.List_ParentCategories)
                                        {
                                            <option value="@category.ID">@category.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="ParentID" class="text-danger"></span>
                            </div>

                            @* Количество минут для приготовления блюда *@
                            <div class="form-group">
                                <label asp-for="Cooking_Minutes" class="control-label">Количество минут для приготовления блюда</label>
                                <input asp-for="Cooking_Minutes" class="form-control" type="number" />
                            </div>

                            <div class="row">

                                <div class="col-md-6">
                                    @* Для товаров разрешены цвета *@
                                    <div class="form-group form-check">
                                        <label class="form-check-label">
                                            <input class="form-check-input" asp-for="Flag_AllowColors" /> Для товаров разрешены цвета
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    @* Порядок отображения *@
                                    <div class="form-group">
                                        <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                        <input asp-for="OrderNum" class="form-control" type="number" value="0" />
                                        <span asp-validation-for="OrderNum" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}