@model List<CDish_Category>
@{
    // Таблица > Категории блюд
    Layout = null;
}

@* Таблица > Категории блюд *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CDish_Category().Name)" title="@Html.DisplayNameFor(x => new CDish_Category().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_Category().Name)</span>
                </th>
                <th class="search export">
                    <span class="HIDE-jscss-table-head-text">Родительская категория</span>
                </th>
                <th class="search export" style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x => new CDish_Category().Cooking_Minutes)" title="@Html.DisplayNameFor(x => new CDish_Category().Cooking_Minutes)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_Category().Cooking_Minutes)</span>
                </th>
                <th style="max-width: 100px; width: 100px;">
                    <img src="/img/icon-fields-dopfield-42.png" alt="@Html.DisplayNameFor(x => new CDish_Category().Flag_AllowColors)" title="@Html.DisplayNameFor(x => new CDish_Category().Flag_AllowColors)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_Category().Flag_AllowColors)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CDish_Category().OrderNum)" title="@Html.DisplayNameFor(x => new CDish_Category().OrderNum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_Category().OrderNum)</span>
                </th>
                <th data-orderable="false" style="min-width: 70px; width: 70px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string rowClass = item.ParentCategory_IsDeleted ? "HIDE-bg-category-deleted" : "";

                <tr class="@rowClass">
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @if (item.ParentCategory_IsDeleted)
                        {
                            <span class="text-danger">
                                <i class="fas fa-exclamation-triangle"></i>
                                @Html.DisplayFor(modelItem => item.ParentCategory_Name)
                                <span class="badge badge-danger">Удалена</span>
                            </span>
                        }
                        else
                        {
                            @Html.DisplayFor(modelItem => item.ParentCategory_Name)
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Cooking_Minutes)
                    </td>
                    <td>
                        @if (item.Flag_AllowColors)
                        {
                            <text>Разрешены цвета</text>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderNum)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}