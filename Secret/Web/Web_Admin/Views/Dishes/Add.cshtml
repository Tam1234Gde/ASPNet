@using HIDE.RestAndRant.Web_Admin.Models.Dishes
@model Model_Dishes_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Dishes_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить блюдо";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    ViewBag.Icon = test[4].Value;

    string id_MediaFile = $"HIDE-js-mediafile-{Guid.NewGuid()}";

}

@* Добавление блюда *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Наименование блюда *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Наименование блюда*</label>
                                <textarea asp-for="Name" id="HIDE-js-summernote-title"></textarea>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* Категория *@
                            @if (Model.List_Categories != null && Model.List_Categories.Any())
                            {
                                <div class="form-group">
                                    <label asp-for="Dish_CategoryID">Категория блюда*</label>
                                    <select asp-for="Dish_CategoryID" id="Dish_CategoryID" class="custom-select HIDE-custom-select rounded-0">
                                        @foreach (var item in Model.List_Categories)
                                        {
                                            if (item.ID == Model.Dish_CategoryID)
                                            {
                                                <option selected value="@item.ID">@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Dish_CategoryID" class="text-danger"></span>
                                </div>
                            }

                            @* Стоимость *@
                            <div class="form-group">
                                <label asp-for="Price" class="control-label">Стоимость*</label>
                                <input asp-for="Price" class="form-control" type="number" value="" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @* Краткое описание блюда *@
                            <div class="form-group">
                                <label asp-for="Teaser" class="control-label">Краткое описание блюда</label>
                                <textarea asp-for="Teaser" id="HIDE-js-summernote-teaser"></textarea>
                            </div>

                            @* Полное описание блюда *@
                            <div class="form-group">
                                <label asp-for="Text" class="control-label">Полное описание блюда</label>
                                <textarea asp-for="Text" id="HIDE-js-summernote"></textarea>
                            </div>

                            @* Количество бонусов, начисляемых за покупку *@
                            <div class="form-group">
                                <label asp-for="Bonuses" class="control-label">Количество бонусов, начисляемых за покупку</label>
                                <input asp-for="Bonuses" class="form-control" type="number" />
                            </div>

                            @* Коды рекомендуемых блюд(через ;) *@
                            <div class="form-group">
                                <label asp-for="RecommendDishIDs" class="control-label">Коды рекомендуемых блюд(через ;)</label>
                                <input asp-for="RecommendDishIDs" class="form-control" type="text" />
                            </div>
                            
                            @* Количество минут для приготовления блюда *@
                            <div class="form-group">
                                <label asp-for="Cooking_Minutes" class="control-label">Количество минут для приготовления блюда</label>
                                <input asp-for="Cooking_Minutes" class="form-control" type="number" />
                            </div>

                            @* Порядок отображения *@
                            <div class="form-group">
                                <label asp-for="OrderNum" class="control-label">Порядок отображения*</label>
                                <input asp-for="OrderNum" class="form-control" type="number" />
                                <span asp-validation-for="OrderNum" class="text-danger"></span>
                            </div>

                            @* Добавить во все рестораны *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="FlagForAll" /> Добавить во все рестораны
                                </label>
                            </div>

                            @* Флаг того, что блюдо новинка *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="FlagNew" /> Флаг того, что блюдо новинка
                                </label>
                            </div>

                            @* Дата окончания новинки *@
                            <div class="form-group">
                                <label asp-for="New_DateFrom" class="control-label">Дата окончания новинки</label>
                                    <input asp-for="New_DateFrom" class="form-control" type="date" />
                                <span asp-validation-for="New_DateFrom" class="text-danger"></span>
                            </div>
                            
                            @* Отключить отображение блюда в основном меню *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="FlagNoActive" /> Отключить отображение блюда в основном меню
                                </label>
                            </div>

                            @* Товар - Кофе *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_AllowColors" /> Кофе
                                </label>
                            </div>

                            @* Флаг того, что блюдо можно купить за бонусы *@
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Flag_Bonus" /> Флаг того, что блюдо можно купить за бонусы
                                </label>
                            </div>

                            @* Изображение *@
                            <div class="form-group">
                                <label for="@id_MediaFile">Изображение</label>
                                <div class="clearfix"></div>
                                <input id="@id_MediaFile" style="display:block;" asp-for="@Model.UploadImge" type="file" class="btn btn-warning HIDE-js-common-image_show" accept=".jpg,.jpeg,.png" />
                            </div>

                        </div>

                        @* Кнопки *@
                        <div class="card-footer">
                            <div class="row">

                                @* Назад *@
                                <div class="col-md-6">
                                    <div class="form-group mb-0 pt-2">
                                        <a class="text-decoration-none" asp-action="Index">Назад</a>
                                    </div>
                                </div>

                                @* Добавить *@
                                <div class="col-md-6">
                                    <div class="form-group text-right mb-0">
                                        <input type="submit" value="Добавить" class="btn btn-primary" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // Инициализация редактора
            $('#HIDE-js-summernote-title').summernote({
                height: 100,
                lang: 'ru-RU',
                toolbar: [
                    ['font', ['bold', 'underline']],
                    ['para', ['ul', 'ol']],
                    ['insert', ['link', 'picture']],
                    ['view', ['codeview']]
                ]
            });

                // Инициализация редактора
                $('#HIDE-js-summernote-teaser').summernote({
                    height: 200,
                    lang: 'ru-RU',
                    toolbar: [
                        ['font', ['bold', 'underline']],
                        ['para', ['ul', 'ol']],
                        ['insert', ['link', 'picture']],
                        ['view', ['codeview']]
                    ]
                });

            // Инициализация редактора
            $('#HIDE-js-summernote').summernote({
                height: 300,
                lang: 'ru-RU',
                toolbar: [
                    ['font', ['bold', 'underline']],
                    ['para', ['ul', 'ol']],
                    ['insert', ['link', 'picture']],
                    ['view', ['codeview']]
                ]
            });

        });
    </script>

    }