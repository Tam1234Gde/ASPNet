@using HIDE.RestAndRant.Web_Admin.Models.Dishes
@model Model_Dishes_List
@{
    // Таблица > Блюда
    Layout = null;
}

@* Таблица > Блюда *@
@if (Model != null && Model.List_Dishes != null && Model.List_Dishes.Any())
{
    <table id="HIDE-users" class="table table-bordered table-striped HIDE-allstate-table HIDE-dish-table">
        <thead>
            <tr>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-3.png" alt="Изображение" title="Изображение">
                    <span class="HIDE-jscss-table-head-text">Изображение</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CDish().ID)" title="@Html.DisplayNameFor(x => new CDish().ID)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().ID)</span>
                </th>
                <th class="search export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CDish().Name)" title="@Html.DisplayNameFor(x => new CDish().Name)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().Name)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-name.png" alt="@Html.DisplayNameFor(x => new CDish().Dish_Category)" title="@Html.DisplayNameFor(x => new CDish().Dish_Category)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().Dish_Category)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-7.png" alt="@Html.DisplayNameFor(x => new CDish().Price)" title="@Html.DisplayNameFor(x => new CDish().Price)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().Price)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-40.png" alt="@Html.DisplayNameFor(x => new CDish().Cooking_Minutes)" title="@Html.DisplayNameFor(x => new CDish().Cooking_Minutes)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().Cooking_Minutes)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-11.png" alt="@Html.DisplayNameFor(x => new CDish().Bonuses)" title="@Html.DisplayNameFor(x => new CDish().Bonuses)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().Bonuses)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-33.png" alt="@Html.DisplayNameFor(x => new CDish().Flag_Bonus)" title="@Html.DisplayNameFor(x => new CDish().Flag_Bonus)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().Flag_Bonus)</span>
                </th>
                <th class="export">
                    <img src="/img/icon-fields-dopfield-14.png" alt="@Html.DisplayNameFor(x => new CDish().List_Dish_Volumes)" title="@Html.DisplayNameFor(x => new CDish().List_Dish_Volumes)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().List_Dish_Volumes)</span>
                </th>
                @* <th class="export">
                    <img src="/img/icon-fields-dopfield-15.png" alt="@Html.DisplayNameFor(x=> new CDish().List_Dish_Colors)" title="@Html.DisplayNameFor(x=> new CDish().List_Dish_Colors)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x=> new CDish().List_Dish_Colors)</span>
                </th> *@
                <th class="export">
                    <img src="/img/icon-fields-dopfield-16.png" alt="@Html.DisplayNameFor(x => new CDish().List_Dish_Ingridients)" title="@Html.DisplayNameFor(x => new CDish().List_Dish_Ingridients)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().List_Dish_Ingridients)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CDish().List_RecommendDishIDs)" title="@Html.DisplayNameFor(x => new CDish().List_RecommendDishIDs)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().List_RecommendDishIDs)</span>
                </th>
                <th style="max-width: 150px; width: 150px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CDish_ForAdmin().Adress_Restoran_Output)" title="@Html.DisplayNameFor(x => new CDish_ForAdmin().Adress_Restoran_Output)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish_ForAdmin().Adress_Restoran_Output)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-22.png" alt="@Html.DisplayNameFor(x => new CDish().FlagNew)" title="@Html.DisplayNameFor(x => new CDish().FlagNew)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().FlagNew)</span>
                </th>
                <!-- Новый столбец: Дата окончания новинки -->
                <th style="max-width: 120px; width: 120px;" class="export">
                    <img src="/img/icon-fields-date.png" alt="Новинка до" title="Дата окончания новинки">
                    <span class="HIDE-jscss-table-head-text">Новинка до</span>
                </th>
                <!-- Конец нового столбца -->
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-dopfield-22.png" alt="@Html.DisplayNameFor(x => new CDish().FlagNoActive)" title="@Html.DisplayNameFor(x => new CDish().FlagNoActive)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().FlagNoActive)</span>
                </th>
                <th style="max-width: 50px; width: 50px;">
                    <img src="/img/icon-fields-code.png" alt="@Html.DisplayNameFor(x => new CDish().OrderNum)" title="@Html.DisplayNameFor(x => new CDish().OrderNum)">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CDish().OrderNum)</span>
                </th>
                <th data-orderable="false" style="min-width: 50px; width: 50px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Dishes)
            {
                <tr>
                    <td>
                        <img src="@item.Image_Url" alt="" style="max-width: 150px; max-height: 50px;" />
                    </td>
                    <td>
                        @Html.Raw(item.ID)
                    </td>
                    <td>
                        @Html.Raw(item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dish_Category)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Cooking_Minutes)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Bonuses)
                    </td>
                    <td>
                        @if (item.Flag_Bonus)
                        {
                            <input type="checkbox" checked="checked" disabled="">
                            <span style="display: none">+</span>
                        }
                        else
                        {
                            <input type="checkbox" disabled="">
                            <span style="display: none">-</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="DishVolumes" asp-action="Index" asp-route-DishID="@item.ID">Список объёмов (@item.List_Dish_Volumes?.Count())</a>
                    </td>
                    @* <td>
                        <a asp-controller="DishColors" asp-action="Index" asp-route-DishID="@item.ID">Список цветов (@item.List_Dish_Colors?.Count())</a>
                    </td> *@
                    <td>
                        <a asp-controller="DishIngridients" asp-action="Index" asp-route-DishID="@item.ID">Список ингредиентов (@item.List_Dish_Ingridients?.Count())</a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RecommendDishIDs)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.List_Adress_Restoran)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FlagNew)
                    </td>
                    <!-- Новая ячейка: Дата окончания новинки -->
                    <td>
                        @if (item.New_DateFrom.HasValue)
                        {
                            var date = item.New_DateFrom.Value;
                            if (date < DateTime.Now)
                            {
                                <span style="color:red;">@date.ToString("dd.MM.yyyy")</span>
                                <span class="badge badge-danger">истекла</span>
                            }
                            else
                            {
                                @date.ToString("dd.MM.yyyy")
                            }
                        }
                        else
                        {
                            <span>Бессрочно</span>
                        }
                    </td>
                    <!-- Конец новой ячейки -->
                    <td>
                        @Html.DisplayFor(modelItem => item.FlagNoActive)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OrderNum)
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-block bg-gradient-warning"><i class="fas fa-edit "></i></a>
                        <a asp-action="Del" asp-route-id="@item.ID" asp-route-Dish_CategoryID="@item.Dish_CategoryID" class="btn btn-block bg-gradient-danger" style="margin: 0 5px 0 0;"><i class="fas fa-times-circle" style="color:#ffffff"></i></a>
                        @*<a asp-controller="DishColors" asp-action="Index" asp-route-DishID="@item.ID" class="btn btn-block bg-gradient-danger"><i class="fas fa-square" style="color:#ffffff"></i></a>*@
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}