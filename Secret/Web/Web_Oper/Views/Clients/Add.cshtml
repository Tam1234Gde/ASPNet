@using HIDE.RestAndRant.Web_Oper.Models.Clients
@model Model_Clients_AddEdit
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить клиента";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    //List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    //ViewBag.Icon = test[5].Value;
}

@* Добавление клиента *@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <div class="card-header">
                        <h3 class="card-title"></h3>
                    </div>

                    <form asp-action="Add">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            @* Телефон *@
                            <div class="form-group">
                                <label asp-for="Phone" class="control-label">Телефон* <span asp-validation-for="Phone" class="text-danger"></span></label>
                                <input asp-for="Phone" class="form-control" />
                            </div>

                            @* Имя *@
                            <div class="form-group">
                                <label asp-for="Name" class="control-label">Имя* <span asp-validation-for="Name" class="text-danger"></span></label>
                                <input asp-for="Name" class="form-control" />
                            </div>

                            @* Количество бонусов *@
                            <div class="form-group">
                                <label asp-for="Bonuses" class="control-label">Количество бонусов* <span asp-validation-for="Bonuses" class="text-danger"></span></label>
                                <input asp-for="Bonuses" class="form-control" type="number" />
                            </div>

                            @* Данные банковской карты *@
                            <div class="form-group">
                                <label asp-for="CardData" class="control-label">Данные банковской карты</label>
                                <input asp-for="CardData" class="form-control" />
                            </div>

                        </div>

                        <div class="card-footer">
                            <div class="form-group mb-0">
                                <input type="submit" value="Добавить" class="btn btn-primary" />
                            </div>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
