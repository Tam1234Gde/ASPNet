    <!-- HIDE >  CSS -->
    <link href="~/HIDE/base_2.css?@s_Salt" rel="stylesheet" />

</head>
<body class="hold-transition sidebar-mini layout-fixed sidebar-collapse">
    <div class="wrapper">

        @* Меню *@
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            @* Меню > Левое *@
            <ul class="navbar-nav">
                <li class="nav-item">
                    @* Вызвать боковое меню *@
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <div class="navbar-nav ml-1">
                <h1 class="m-0 h3">@ViewData["Title"]</h1>
            </div>

            @* Меню > Правое *@
            <ul class="navbar-nav ml-auto">

                @* Список ресторанов *@
                @if (ViewBag.Restaurants != null)
                {
                    <div class="HIDE-select-event HIDE-select-event_label HIDE-js-select_search HIDE-header-accounts ml-auto">
                        <label>Ресторан: </label>
                        <select class="form-control HIDE-js-select2" id="HIDE-js-select-restaurant" style="width:100%;">

                            @if (ViewBag.Restaurants != null && ViewBag.Restaurants.Count > 1)
                            {
                                <option selected="selected" value="-1">Все</option>
                            }

                            @foreach (var elem in ViewBag.Restaurants)
                            {
                                if (ViewBag.RestaurantID != null && ViewBag.RestaurantID == elem.ID)
                                {
                                    <option value="@elem.ID" selected="selected">@elem.Adress</option>
                                }
                                else
                                {
                                    <option value="@elem.ID">@elem.Adress</option>
                                }
                            }
                        </select>
                    </div>
                }

                @* Личные данные и выйти *@
                <li class="nav-item dropdown" style="width: 100%;">
                    <a class="nav-link pt-0 pb-0" data-bs-toggle="dropdown" data-toggle="dropdown" href="#">
                        <img style="height:40px;width:40px;" class="border border-2 rounded-circle" src="/lib/admin-lte/img/avatar2.png" alt="" title="" />
                        <span class="d-none d-sm-inline-block" id="@id_FIO"></span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                        <a asp-controller="Auth" asp-action="Logout" class="dropdown-item">Выйти</a>
                    </div>
                </li>
        
                @* На весь экран *@
                @* <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button"> <i class="fas fa-expand-arrows-alt"></i></a>
                </li> *@
            </ul>

            @* Меню > Правое *@
        </nav>


        @* Боковое меню *@
