        }

        .HIDE-jscss-order-category{
        cursor: pointer;
        }

        .HIDE-jscss-table{
            position: absolute;

            /* text-align: center; */
            cursor: pointer;
        }

        .HIDE-jscss-table:hover  {
           background: #d9dce1;
        }

        .HIDE-table-selected{
            background: #8DD409;
        }

        .HIDE-table-disabled {
            cursor: default;
            background: #ccc;
        }

        .HIDE-table-disabled:hover {
            background: #ccc;
        }

        #HIDE-users tr{
            border-bottom: transparent;
        }

        .dataTables_info{
            padding-left: 10px;
        }

        .dataTables_paginate{
            padding-bottom: 5px;
        }

        .HIDE-js-table-modal thead th {
            border-top: none !important;
            border-bottom: none;
        }

        .HIDE-js-table-modal tbody td {
            border-bottom: none;
        }

        .HIDE-custom-checkbox_order label{
            padding-left: 20px;
            padding-top: 7px;
        }

        .dataTables_wrapper .dataTables_filter {
            float: right;
            text-align: right;
            padding-right: 20px;
        }

        .dataTables_wrapper .dataTables_info {
            clear: both;
            float: left;
            padding-top: 0.755em;
            margin-bottom: 10px;
        }

        .HIDE-custom-checkbox_order .custom-control-label::before {
            position: absolute;
            top: .25rem;
            left: -1.5rem;
            display: block;
            width: 2rem;
            height: 2rem;
            pointer-events: none;
            content: "";
            background-color: #dee2e6;
            border: #adb5bd solid 1px;
            box-shadow: inset 0 0.25rem 0.25rem rgba(0,0,0,.1);
        }

        .HIDE-custom-checkbox_order .custom-control-label::after {
            position: absolute;
            top: .25rem;
            left: -1.5rem;
            display: block;
            width: 2rem;
            height: 2rem;
            content: "";
            background: 50% / 50% 50% no-repeat;
        }

        .HIDE-custom-checkbox_order .custom-control-input {
            position: absolute;
            left: 0;
            z-index: -1;
            width: 2rem;
            height: 2.25rem;
            opacity: 0;
        }

        .HIDE-order_tr-active{
            background: #99bcc3 !important;
        }

        #HIDE-users_wrapper .row:first-child {
            display: none;
        }

        .HIDE-modal-order_dishes .custom-control-label {
            position: relative;
            margin-bottom: 0;
            vertical-align: top;
            padding-left: 10px;
            padding-top: 3px;
        }

        .HIDE-modal-order_dishes .custom-control-input {
            position: absolute;
            left: 0;
            z-index: -1;
            width: 1.5rem;
            height: 1.6rem;
            opacity: 0;
        }

        .HIDE-modal-order_dishes .custom-control-label::before {
            position: absolute;
            top: .25rem;
            left: -1.5rem;
            display: block;
            width: 1.5rem;
            height: 1.5rem;
            pointer-events: none;
            content: "";
            background-color: #dee2e6;
            border: #adb5bd solid 1px;
            box-shadow: inset 0 .25rem .25rem rgba(0, 0, 0, .1);
        }

        .HIDE-modal-order_dishes .custom-control-label::after {
            position: absolute;
            top: .25rem;
            left: -1.5rem;
            display: block;
            width: 1.5rem;
            height: 1.5rem;
            content: "";
            background: 50% / 50% 50% no-repeat;
        }

        .HIDE-image_table {
            max-width: 70px !important;
