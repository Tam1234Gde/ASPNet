                        <li class="nav-item">
                            <a asp-controller="Bookings" asp-action="Index" class="nav-link @(s_sidebar_active == "Bookings_List" ? "active" : "")">
                                <i class="nav-icon fas fa-book"></i>
                                <p>
                                    Бронирование
                                </p>
                            </a>
                        </li>

                        @* Бронирование залов *@
                        @* <li class="nav-item">
                            <a asp-controller="BookingHalls" asp-action="Index" class="nav-link @(s_sidebar_active == "BookingHalls_List" ? "active" : "")">
                                <i class="nav-icon fas fa-building"></i>
                                <p>
                                    Бронирование залов
                                </p>
                            </a>
                        </li> *@

                    </ul>
                </nav>
            </div>
        </aside>

        @RenderBody()

        @* Подвал *@
        <footer class="main-footer">
            <strong>RestAndRant. <a target="_blank" href="https://HIDEerv.ru">Техническая поддержка: HIDEerv.ru</a>.</strong>
           @* @if (User != null)
            {
                <div class="float-right d-none d-sm-inline-block">
                    <b>Версия программы:</b> 1.0
                </div>
            }*@
        </footer>

        @* Модальное окно - Поступил новый заказ *@
        <div class="modal fade" id="modal-default-order">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Поступил новый заказ</h4>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="false">&times;</span>
                        </button>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-default" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary">Save changes</button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @RenderSection("scripts_top", required: false)

    @* JQuery *@
    <script src="~/lib/jquery/jquery.min.js"></script>

    @* JQuery validation *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @* Bootstrap *@
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    @* Выпадающий список *@
    <script src="~/lib/select2/js/select2.full.min.js"></script>

    @* Работа с датами *@
    <script src="~/lib/moment/moment.js"></script>

    @* Выбор даты *@
    <script src="~/lib/datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/lib/datepicker/locales/bootstrap-datepicker.ru.min.js"></script>

    @* Таблица *@
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.select.min.js"></script>

    @* admin-lte > Главный JS *@
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>

    @* Календарь *@
    <script src="~/lib/fullcalendar/main.min.js"></script>
    <script src="~/lib/fullcalendar/locales/ru.js"></script>

    <script>

        // Прикрепить файл
        $(document).ready(function () {

            /*Инициализация выпадающего списка*/
            $('.HIDE-js-select2').select2({
                language: "ru",
                "language": {
                    "noResults": function () {
                        return "Не найдено";
                    }
                }
            });

            /* Выбор даты */
            $('.HIDE-js-datepicker').datepicker({
                format: 'dd.mm.yyyy',
                language: "ru",
                autoclose: true
            });

            /* Настройка отображения выбранного изображения */
            $(".HIDE-js-common-image_show").change(function () {
                var $this = $(this);
                var $item = $this.parent().find(".HIDE-js-common-image_show-item");
                if ($item !== undefined && $item.length > 0) {
                    $item.remove();
                }

                if (this.files.length > 0) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $this.parent().append("<img style=\"max-width:150px;max-height:150px;\" class=\"HIDE-js-common-image_show-item\" src=" + e.target.result + " alt=\"\" />");
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });

            // Проверка заказов по таймеру, раз в 5 секунд
            //setInterval(function () {
            //    $.ajax({
            //        type: 'GET',
            //        cache: false,
            //        url: "@Url.Action(controller:"Orders" , action: "NewOrder")",
            //        success: function (data) {

            //            // Запуск модального окна
            //            $("#modal-default-order").modal('show');

            //        }
            //    });
            //}, 5000);

            $.ajax({
                type: "GET",
                cache: false,
                contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                url: "@Url.Action(controller:"Common" , action: "GetUserName")",
                success: function (data) {
                    if (data !== undefined && data !== null && data !== "") {
                        $("#@id_FIO").html(data);
                    }
                },
                error: function (req, status, error) { }
            });

            $('form').each(function () {
                if ($(this).data('validator'))
                    $(this).data('validator').settings.ignore = ".note-editor *";
            });

        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>