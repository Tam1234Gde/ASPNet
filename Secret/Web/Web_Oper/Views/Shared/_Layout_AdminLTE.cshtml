            @* Боковое меню > Лого *@
            <div class="brand-link" style="opacity: 0;">
                @* <img src="/_i/icon-HIDEerv.png" alt="" class="brand-image img-circle elevation-3 opacity-75" style="opacity: .8; margin-top:1px;"> *@
                <span class="brand-text font-weight-light">RestAndRant</span>
            </div>

            @* Боковое меню > Меню *@
            <div class="sidebar">

                @* Боковое меню > Меню > Содержимое *@
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        @* Заказы *@
                        <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Index" class="nav-link @(s_sidebar_active == "Orders_List" ? "active" : "")">
                                <i class="nav-icon fa fa-shopping-cart"></i>
                                <p>
                                    Заказы из приложения
                                </p>
                            </a>
                        </li>

                        @* Новые заказы *@
                        @* <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Orders_New" class="nav-link @(s_sidebar_active == "Orders_New" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-cart-plus fa-fw">

                                </i>
                                <p>
                                    Новые заказы
                                </p>
                            </a>
                        </li> *@

                        @* Заказы готовятся *@
                        @* <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Orders_Cooking" class="nav-link @(s_sidebar_active == "Orders_Cooking" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-spinner fa-fw">

                                </i>
                                <p>
                                    Заказ готовится
                                </p>
                            </a>
                        </li> *@

                        @* <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Orders_ReadyToClient" class="nav-link @(s_sidebar_active == "Orders_ReadyToClient" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-mug-hot fa-fw">

                                </i>
                                <p>
                                    Готов к выдаче
                                </p>
                            </a>
                        </li> *@

                        @* <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Orders_Delivery" class="nav-link @(s_sidebar_active == "Orders_Delivery" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-truck fa-fw">

                                </i>
                                <p>
                                    Передан в доставку
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Orders_Cancelled" class="nav-link @(s_sidebar_active == "Orders_Cancelled" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-rectangle-xmark fa-fw">

                                </i>
                                <p>
                                    Отмененные заказы
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Orders_Complete" class="nav-link @(s_sidebar_active == "Orders_Complete" ? "active" : "")">
                                <i class="nav-icon fa-solid fa-circle-check fa-fw">

                                </i>
                                <p>
                                    Выполненые заказы
                                </p>
                            </a>
                        </li> *@

                        @* Добавить заказ *@
                        @* <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Add" class="nav-link @(s_sidebar_active == "OrderAdd_List" ? "active" : "")">
                                <i class="nav-icon fas fa-cart-plus"></i>
                                <p>
