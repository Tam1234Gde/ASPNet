            border-color: #d2d6de;
            height: 30px;
            padding: 5px 10px;
            font-size: 12px;
            line-height: 1.5;
            color: #555;
            background-color: #fff;
            background-image: none;
            border: 1px solid #ccc;
        }
        
        #example1_wrapper {
