@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Модальное окно > Подробности заказа
    Layout = null;

    int index_dish = 0;
}

@* Модальное окно > Подробности заказа *@
@if (Model != null && Model.Order_More != null)
{
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document" style="max-width: 100% !important;     width: 100%;     height: 100%;     margin: 0 auto;">
            <div class="modal-content" style="height: auto;
    min-height: 100%;">
                @* <div class="modal-header">
            <h5 class="modal-title pt-2" id="exampleModalLabel"><b>Подробности заказа</b></h5>
            <button style="font-size: 3em;" type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
            </button>
            </div> *@
                <div class="modal-body pb-0">
                    <section class="content">
                        <div class="invoice p-3 mb-3" style="padding-top: 0 !important;
    border: none !important;
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;">

                            <div class="row invoice-info mb-2">

                                <div class="col-sm-3 invoice-col border-end pt-3" style="height: 82vh;">
                                    <h4>
                                        Номер: @Model?.Order_More.Order?.ID
                                    </h4>
                                    <div class="pb-1"></div>

                                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More?.Client))
                                    {
                                        <b>Клиент: <br /> </b> @Model?.Order_More?.Client <br /> <div class="pb-2"></div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More?.Client_Phone))
                                    {
                                        <b>Телефон: <br /> </b> @Model?.Order_More.Client_Phone <br /> <div class="pb-2"></div>
                                        <br />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More?.Order?.Name))
                                    {
                                        <b>Кому: <br /> </b> @Model?.Order_More?.Order?.Name <br /> <div class="pb-2"></div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More?.Order?.Phone))
                                    {
                                        <b>Телефон (кому): <br /> </b> @Model?.Order_More?.Order?.Phone <br /> <div class="pb-2"></div>

                                        <br />
                                    }

                                    <b>Вид оплаты: <br /> </b>
                                    @* //TODO: MAE - NULLABLE *@
                                    @switch ((int)Model?.Order_More.Order?.Pay_TypeID)
                                    {
                                        case (int)EPayType.Money:
                                            <text>Наличные</text>
                                            break;
                                        case (int)EPayType.CardInApp:
                                            <text>Карта</text>
                                            break;

                                        case (int)EPayType.CardByTerminal:
                                            <text>Карта</text>
                                            break;
                                    }

                                    @if (Model.Order_More.Order.Handing != null && Model.Order_More.Order.Handing != 0)
                                    {
                                        <div class="pb-2"></div>
                                        <b>Дать сдачу с : <br /> </b>
                                        @Model.Order_More.Order.Handing
                                    }
                                   
                                    <div class="pb-2"></div>

                                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More.Comment))
                                    {
                                        <b>Комментарий: </b> <br />
                                        <div style="max-height: 72px; overflow-y: scroll;">
                                            @Html.Raw(Model?.Order_More.Comment) <br />
                                        </div>
                                    }
                                    <div class="pb-2"></div>
                                    <b>Целевое время:</b> <br />
                                    @if (Model?.Order_More.Order?.Date_To != null)
                                    {
                                        @Model?.Order_More.Order?.Date_To
                                    }
                                    else
                                    {
                                        <text>Не выполнен</text>
                                    }

                                </div>

                                @* Блюда *@
                                @if (Model != null && Model.Order_More.Order != null && Model?.Order_More.Order?.List_OrderDatas != null && Model?.Order_More.Order?.List_OrderDatas.Count != 0)
                                {
                                    <div class="col-9 table-responsive" style="max-height: 82vh; overflow-y: scroll;">
                                        <table class="table table-striped HIDE-js-table-modal">
                                            <thead>
                                                <tr>
                                                    <th>Позиция</th>
                                                    <th>Блюдо</th>
                                                    <th>Объем</th>
                                                    <th>Количество</th>
                                                    <th>Стоимость</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @* //TODO: NULLABLE *@

                                                @foreach (var elem in Model?.Order_More.Order?.List_OrderDatas)
                                                {
                                                    index_dish++;

                                                    <tr>
                                                        <td><b>@index_dish</b></td>
                                                        <td><b>@elem.Dish_Name</b></td>
                                                        <td><b>@elem.Dish_VolumeValue</b></td>
                                                        <td><b>@elem.Dish_Count</b></td>
                                                        <td><b>@elem.Dish_Summ</b></td>
                                                    </tr>

                                                    @* Добавки *@
                                                    if (elem.List_Dish_Ingridients != null && elem.List_Dish_Ingridients.Count != 0)
                                                    {
                                                        @foreach (var item in elem.List_Dish_Ingridients)
                                                        {
                                                            <tr>
                                                                <td></td>
                                                                <td>@item.Ingridient_Name</td>
                                                                <td></td>
                                                                <td>@elem.Dish_Count</td>
                                                                <td>@item.Ingridient_Summ</td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                            </div>



                        </div>
                    </section>
                </div>

                <div class="modal-footer d-block">

                    @* Оплачено *@
                    @* //TODO: NULLABLE *@
                    @if (@Model.Order_More.Order.Flag_Payed)
                    {
                        <div class="custom-control custom-checkbox mb-1 float-left HIDE-custom-checkbox_order mr-3">
                            <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" disabled="disabled" id="order_pay" checked="checked">
                            <label for="order_pay" class="custom-control-label">Оплачено</label>
                        </div>
                    }
                    else
                    {
                        <div class="custom-control custom-checkbox mb-1 float-left HIDE-custom-checkbox_order mr-3">
                            <input class="custom-control-input custom-control-input-danger" type="checkbox" id="order_pay">
                            <label for="order_pay" class="custom-control-label">Оплачено</label>
                        </div>
                    }

                    @if (Model.Order_More.Order.Order_StatusID != EOrder_Status.Complete)
                    {

                        @* Принять *@
                        @if (Model.Order_More.Order.Order_StatusID == EOrder_Status.New)
                        {
                            <div class="form-group d-inline-block mr-3" style="max-width: 104px; width: 100%;">
                                <button type="button" class="btn btn-primary HIDE-js-order-confirm" style="max-width: 104px; width: 100%;"
                                        data-id="@Model.Order_More.Order.ID" data-status="@EOrder_Status.Cooking">
                                    Принять
                                </button>
                            </div>
                        }

                        @* Готов \ У курьера *@
                        @if (Model.Order_More.Order.Order_StatusID != EOrder_Status.ReadyToClient && Model.Order_More.Order.Order_StatusID != EOrder_Status.Delivery)
                        {
                            @if (Model.Order_More.Order.Order_TypeID == EOrder_Type.Delivery)
                            {
                                <div class="form-group d-inline-block mr-3" style="max-width: 104px; width: 100%;">
                                    <button type="button" class="btn btn-success HIDE-js-order-confirm" style="max-width: 104px; width: 100%;"
                                            data-id="@Model.Order_More.Order.ID" data-status="@EOrder_Status.Delivery">
                                        У курьера
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="form-group d-inline-block mr-3" style="max-width: 104px; width: 100%;">
                                    <button type="button" class="btn btn-success HIDE-js-order-confirm" style="max-width: 104px; width: 100%;"
                                            data-id="@Model.Order_More.Order.ID" data-status="@EOrder_Status.ReadyToClient">
                                        Готов
                                    </button>
                                </div>
                            }
                        }

                        @* Завершить *@
                        @if (Model.Order_More.Order.Order_StatusID == EOrder_Status.ReadyToClient || Model.Order_More.Order.Order_StatusID == EOrder_Status.Delivery)
                        {
                            <div class="form-group d-inline-block mr-3" style="max-width: 104px; width: 100%;">
                                <button type="button" class="btn btn-warning HIDE-js-order-confirm" style="max-width: 104px; width: 100%;"
                                        data-id="@Model.Order_More.Order.ID" data-status="@EOrder_Status.Complete">
                                    Завершить
                                </button>
                            </div>
                        }

                        @* Отменить *@
                        <div class="form-group d-inline-block mr-3" style="max-width: 104px; width: 100%;">
                            <button type="button" class="btn btn-danger HIDE-js-order-confirm" style="max-width: 104px; width: 100%; background: transparent; color: #000; border: 1px solid #ccc;"
                                    data-id="@Model.Order_More.Order.ID" data-status="@EOrder_Status.Cancelled">
                                Отменить
                            </button>
                        </div>
                    }

                    <button type="button" class="btn btn-secondary float-right" data-bs-dismiss="modal">Закрыть</button>
                </div>

            </div>
        </div>
    </div>
}