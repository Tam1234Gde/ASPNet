@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_AddEdit
@{
    // Таблица > Клиенты
    Layout = null;
}

@* Таблица > Клиенты *@
@if (Model != null && Model.List_Dishes != null && Model.List_Dishes.Any())
{
    <div class="box-header">
        <h3 class="box-title">Блюда - @Model.Category</h3>
    </div>

    <div class="row">

        @foreach (var item in Model.List_Dishes)
        {
            <div class="col-lg-4 col-6" @* data-bs-toggle="modal"
                 data-bs-target="#myModal" *@>
                <div class="info-box mb-3 bg-primary HIDE-jscss-order-dish" style="cursor: pointer; flex-direction: column; height: 88%;" data-dish-id="@item.ID">
                    @*<span class="info-box-icon"><i class="fas fa-tag"></i></span>*@
                    <div class="text-center mb-3 fs-5 pt-3">
                        @Html.Raw(item.Name)
                        @* <span class="info-box-number">@item.Price</span> *@
                    </div>
                   @*  <div class="">
                        <div class="">
                            <button type="button" class="btn btn-sm bg-yellow HIDE-js-order_minus mr-1" style="width: 30px;">
                                -
                            </button>
                            <div class="text-center mr-1 HIDE-js-order_number" style="display: inline-block;">1</div>
                            <button type="button" class="btn btn-sm bg-yellow HIDE-js-order_plus" style="width: 30px;">
                                +
                            </button>
                        </div>
                    </div> *@
                </div>
            </div>
        }

    </div>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Выберите категорию
        </h3>
    </div>
}

