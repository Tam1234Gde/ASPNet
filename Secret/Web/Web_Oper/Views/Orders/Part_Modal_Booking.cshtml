@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Модальное окно > Подробности бронирования
    Layout = null;

}

@* Модальное окно > Подробности бронирования *@
@if (Model != null && Model.Order_Booking != null)
{
    <div class="modal fade" id="Booking_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title pt-2" id="exampleModalLabel"><b>Адрес - @Model.Order_Booking.Restaurant</b></h4>

                </div>
                <div class="modal-body p-0">
                    <section class="content">
                        <div class="row invoice-info mb-2">


                            @* Доставка *@
                            @if (Model != null && Model.Order_Booking != null)
                            {
                                <div class="col-12 table-responsive">
                                    <table class="col-12">
                                        <tbody>
                                            <tr class="border-bottom">
                                                <th style="width:50%" class="p-3">  Тип:</th>
                                                <td class="p-3">@Model.Order_Booking.Restaurant_Table_Type</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th style="width:50%" class="p-3">Стоимость брони:</th>
                                                <td class="p-3">@Html.Raw(Model.Order_Booking.Booking_Price.HasValue ? Model.Order_Booking.Booking_Price.Value.ToString("#,#") : 0)</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th style="width:50%" class="p-3">К доплате:</th>
                                                <td class="p-3"><b>@Html.Raw(Model.Order_Booking.Booking_Price.HasValue && Model.Order_Booking.Booking_Price.Value > 0 ? (Model.Order_Booking.Booking_Price.Value - 1000).ToString("#,#") : 0)</b></td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3">Столик:</th>
                                                <td class="p-3">@Model.Order_Booking.Booking?.Restaurant_Table</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3">Количество человек:</th>
                                                <td class="p-3">@Model.Order_Booking.Booking?.NumberQuests</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3">Дата начала брони:</th>
                                                <td class="p-3">@Model.Order_Booking.Booking?.Date_Start</td>
                                            </tr>
                                            <tr>
                                                <th class="p-3">Дата окончания брони:</th>
                                                <td class="p-3">@Model.Order_Booking.Booking?.Date_End</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }

                        </div>
                    </section>
                </div>

                <div class="modal-footer d-block">

                    <button type="button" class="btn btn-secondary float-right" data-bs-dismiss="modal">Закрыть</button>
                </div>

            </div>
        </div>
    </div>
}