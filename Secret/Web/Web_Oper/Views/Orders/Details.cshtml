@using HIDE.RestAndRant.Common.ENums
@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Details
@{
    string s_Title = "Подробности заказа";
    ViewData["Title"] = s_Title;
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Orders_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Подробности заказа";
    ViewBag.RazdelNameMobile = "Подробности заказа";

}

@* Заказы *@
<div class="content-wrapper">

    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Подробности заказа</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">


        <div class="invoice p-3 mb-3">
            <!-- title row -->
            <div class="row">
                <div class="col-12">
                    <h4>
                        <i class="fas fa-globe"></i> Номер заказа - @Model?.Order?.ID
                        <small class="float-right">@Model?.Order?.Date_Act</small>
                    </h4>
                </div>
                <!-- /.col -->
            </div>
            <!-- info row -->
            <div class="row invoice-info mb-2">

                <!-- /.col -->
                <div class="col-sm-12 invoice-col">
                    <b>Клиент: </b> @Model?.Client<br>
                    @* //TODO: NULLABLE *@
                    <b>Телефон: </b> @Html.Raw(!string.IsNullOrWhiteSpace(Model?.Order?.Phone) ? Model?.Order?.Phone : Model?.Client_Phone)<br>
                    <b>Вид оплаты: </b>
                    @switch ((int)Model?.Order?.Pay_TypeID)            //TODO: MAE NULLABLE, вынести в блок кода в начале этого представления
                    {

                        case (int)EPayType.Money:
                            <text>Наличные</text>

                            <br />
                            break;

                        case (int)EPayType.CardInApp:
                            <text>Карта</text>

                            <br />
                            break;

                    }

                    <b>Дата и время к которому приготовить заказ: </b> @Model?.Order?.Date_To
                </div>
                <!-- /.col -->
            </div>
            <!-- /.row -->
            <!-- Table row -->
            @if (Model != null && Model.Order != null && Model?.Order?.List_OrderDatas != null && Model?.Order?.List_OrderDatas.Count != 0)
            {
                <div class="row">
                    <div class="col-12 table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Позиция</th>
                                    <th>Блюдо</th>
                                    <th>Объем</th>
                                    <th>Количество</th>
                                    <th>Стоимость</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* //TODO: NULLABLE *@

                                @foreach (var elem in Model.Order.List_OrderDatas)
                                {
                                    <tr>
                                        <td>@elem.ID</td>
                                        <td>@elem.Dish_Name</td>
                                        <td>@elem.Dish_VolumeValue</td>
                                        <td>@elem.Dish_Count</td>
                                        <td>@elem.Dish_Summ</td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                    <!-- /.col -->
                </div>
                <!-- /.row -->
            }

            <div class="row mb-4">
                <!-- accepted payments column -->
                <div class="col-6">
                    Дата выполнения:
                    @if (Model?.Order?.Date_To != null)
                    {
                        @Model?.Order?.Date_To
                    }

                    else
                    {
                        <text>Не выполнен</text>
                    }
                </div>

            </div>

            <div class="row no-print">
                <div class="col-12">

                    @{
                        var url = "Orders_" + Model?.Order?.Order_StatusID.ToString();
                    }

                    <a asp-controller="Orders" asp-action="@url" class="btn btn-primary">
                        Назад
                    </a>

                </div>
            </div>
        </div>
    </section>

</div>

@section scripts {

    @* Общий js для страницы *@
    <script src="~/js/Views/Orders/OrdersIndex.js"></script>

    <script>

        @* Заказ выполнен *@
                                            var $ButtonOrder_Complete = $('.HIDE-js-order_complete');
        $ButtonOrder_Complete.click(function () {
            $.ajax(
                {
                    url: '/Orders/Details_Complete',
                    type: 'POST',
                    data: { ID: @Model?.Order?.ID },
                    success: function (data) {

                    }
                });
        });

        @* Отмена заказа *@
                                            var $ButtonOrder_Cancel = $('.HIDE-js-order_cancel');
        $ButtonOrder_Cancel.click(function () {
            $.ajax(
                {
                    url: '/Orders/Details_Cancel',
                    type: 'POST',
                    data: { ID: @Model?.Order?.ID },
                    success: function (data) {

                    }
                });
        });

    </script>

}