@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_AddEdit
@{
    ViewData["Title"] = "Добавить заказ";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "OrderAdd_List";
}

@* Добавление заказа *@
<div class="content-wrapper pt-3">
    @* Контент > Содержимое *@
    <section class="content">
        <div class="container-fluid">
            <div class="row">

                <div class="col-md-8">
                    <div class="card card-primary">

                        <div class="card-header">
                            <h3 class="card-title">Основная информация</h3>
                        </div>

                        <div class="card-body">

                            @if (Model != null && Model.List_Categories != null && Model.List_Categories.Any())
                            {
                                <div class="box mb-5">

                                    <div class="box-header">
                                        <h3 class="box-title">Категории</h3>
                                    </div>

                                    <div class="row">

                                        @foreach (var item in Model.List_Categories)
                                        {
                                            <div class="col-lg-4 col-6">
                                                <div class="info-box mb-3 bg-info HIDE-jscss-order-category" data-category-id="@item.ID">
                                                    <span class="info-box-icon"><i class="fas fa-tag"></i></span>
                                                    <div class="info-box-content fs-5">
                                                        <span class="info-box-text">@item.Name</span>
                                                        @*<span class="info-box-number">5,200</span>*@
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </div>

                                </div>
                            }

                            @* Блюда *@
                            <div class="box HIDE-js-order-dishes">
                                <partial name="Add_Part_Table">
                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-primary">

                        <div class="card-header">
                            <h3 class="card-title">Текущий заказ</h3>
                        </div>

                        <form asp-action="Add">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="card-body">

                                @* Клиент *@
                                    @if (Model.List_Clients != null && Model.List_Clients.Any())    @* //TODO: NULLABLE *@
                                {
                                    <div class="form-group">
                                        <label asp-for="ClientID">Клиент</label>
                                        <select asp-for="ClientID" id="ClientID" class="custom-select HIDE-custom-select rounded-0 HIDE-js-select2">
                                            <option selected="selected" value="-1">[Не задано]</option>
                                            @foreach (var item in Model.List_Clients)
                                            {
                                                <option value="@item.ID">@item.Phone</option>
                                            }
                                        </select>
                                        <span asp-validation-for="ClientID" class="text-danger"></span>
                                    </div>
                                }

                                @* Имя *@
                                <div class="form-group">
                                    <label asp-for="Name" class="control-label">Имя(Если клиент отсутствует в базе)</label>
                                    <input asp-for="Name" class="form-control" />
                                </div>

                                @* Телефон *@
                                <div class="form-group">
                                    <label asp-for="Phone" class="control-label">Телефон(Если клиент отсутствует в базе)</label>
                                    <input asp-for="Phone" class="form-control" />
                                </div>

                                @* Данные о заказе *@
                                <div class="box HIDE-js-order-main">
                                    <partial name="ResultOrder_Part_Table">
                                </div>

                            </div>

                            <div class="card-footer">
                                <div class="form-group mb-0 text-right">
                                    <input type="submit" value="Добавить" class="btn btn-primary HIDE-js-offer" />
                                </div>
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>

    </section>
</div>

@* Данные о заказе *@
<div class="HIDE-js-modal-dish">
    <partial name="Modal_Part_Table">
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {

            $('#example1').DataTable({
                'paging': false,
                'lengthChange': false,
                'searching': true,
                'ordering': true,
                'info': true,
                'autoWidth': true,
                select: {
                    style: 'multi'
                }
            })
        })

        // $(".HIDE-js-offer").click(function () {
        //     $.ajax(
        //     {
        //         url: '/Orders/Add',
        //         type: 'POST',
        //         data: { DishID: id_dish, Dish_Count: count, VolumeID: volume, Dish_Ingredients: ingredients, Flag_Delete: false },
        //         success: function (partialView) {
        //             $('#myModal').modal('hide');
        //             $('.HIDE-js-order-main').show();
        //             $('.HIDE-js-order-main').html(partialView);
        //             Delete();
        //         }
        //     });
        // });

        @* Выбор категории *@
            let $ButtonOrder_Category = $('.HIDE-jscss-order-category');
        $ButtonOrder_Category.click(function () {
            let id_category = $(this).data('category-id');
            $.ajax(
                {
                    url: '/Orders/Add_Part_Table',
                    type: 'GET',
                    data: { CategoryID: id_category },
                    success: function (partialView) {
                        $('.HIDE-js-order-dishes').html(partialView);

        @* Выбор блюда *@
                                var $ButtonOrder_Dish = $('.HIDE-jscss-order-dish');
                        $ButtonOrder_Dish.click(function () {
                            let id_dish = $(this).data('dish-id');
                            $.ajax(
                                {
                                    url: '/Orders/Modal_Part_Table',
                                    type: 'GET',
                                    data: { DishID: id_dish },
                                    success: function (partialView) {
                                        $('.HIDE-js-modal-dish').html(partialView);
                                        $('#myModal').modal('show');
                                        let $ButtonOrder_Number = $('.HIDE-js-order_number');
                                        let $ButtonOrder_Minus = $('.HIDE-js-order_minus');
                                        let $ButtonOrder_Plus = $('.HIDE-js-order_plus');

                                        // Минус
                                        $ButtonOrder_Minus.click(function () {
                                            let id_dish = $(this).data('dish-id');
                                            let count = $ButtonOrder_Number.text();
                                            if (count > 1) {
                                                $ButtonOrder_Number.text(Number(count) - 1);
                                            }
                                        });

                                        // Плюс
                                        $ButtonOrder_Plus.click(function () {
                                            let id_dish = $(this).data('dish-id');
                                            let count = $ButtonOrder_Number.text();
                                            $ButtonOrder_Number.text(Number(count) + 1);
                                        });

                                        // Добавить блюдо
                                        $(".HIDE-js-dish_add").click(function () {
                                            let ingredients = "";
                                            let volume = "";
                                            let count = $ButtonOrder_Number.text();

                                            $(".HIDE-js-ingredient").each(function () {
                                                if ($(this).is(':checked')) {
                                                    let atrr_value = $(this).data("attr");
                                                    ingredients += atrr_value + ",";
                                                }
                                            });

                                            $(".HIDE-js-volume").each(function () {
                                                if ($(this).is(':checked')) {
                                                    let atrr_value = $(this).data("attr");
                                                    volume += atrr_value;
                                                }
                                            });

                                            $.ajax(
                                                {
                                                    url: '/Orders/ResultOrder_Part_Table',
                                                    type: 'GET',
                                                    data: { DishID: id_dish, Dish_Count: count, VolumeID: volume, Dish_Ingredients: ingredients, Flag_Delete: false },
                                                    success: function (partialView) {
                                                        $('#myModal').modal('hide');
                                                        $('.HIDE-js-order-main').show();
                                                        $('.HIDE-js-order-main').html(partialView);
                                                        Delete();
                                                    }
                                                });

                                        });
                                    }
                                });
                        });
                    }
                });
        });

        function Delete() {
            let $ButtonOrder_DeleteDish = $('.HIDE-js-delete-dish');
            $ButtonOrder_DeleteDish.click(function () {
                let id = $(this).data('id');
                $.ajax(
                    {
                        url: '/Orders/ResultOrder_Part_Table',
                        type: 'GET',
                        data: { DishID: id, Dish_Count: 1, VolumeID: null, Dish_Ingredients: null, Flag_Delete: true },
                        success: function (partialView) {
                            $('#myModal').modal('hide');
                            $('.HIDE-js-order-main').show();
                            $('.HIDE-js-order-main').html(partialView);
                            Delete();
                        }
                    });
            });
        }

    </script>

}
