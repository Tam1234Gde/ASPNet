@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Модальное окно > Комментарий
    Layout = null;
}

<!-- Modal -->
@if (Model != null && Model.Order_More != null)
{
    <div class="modal fade" id="myModal_Comment" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    @* //TODO: NULLABLE *@
                    <h5 class="modal-title pt-2" id="exampleModalLabel"><b>Комментарий к заказу №@Model.Order_More.Order.ID</b></h5>
                    <button type="button" style="font-size: 3em;" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More.Comment_AddToOrder))
                    {
                        <text><b>Добавить к заказу:</b></text> <br />
                        @Html.Raw(Model?.Order_More.Comment_AddToOrder)

                        <br />
                        <br />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.Order_More.Comment_RemoveFromOrder))
                    {
                        <text><b>Убрать из заказа:</b></text> <br />
                        @Html.Raw(Model?.Order_More.Comment_RemoveFromOrder)
                    }

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}