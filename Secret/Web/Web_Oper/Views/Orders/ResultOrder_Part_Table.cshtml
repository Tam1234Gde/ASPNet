@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_AddEdit
@{
    // Таблица > Клиенты
    Layout = null;
}

@if (Model.List_Dishes2 != null && Model.List_Dishes2.Count != 0)
{
    <div class="box-header border-bottom mb-3">
        <h4 class="box-title">Заказ</h4>
    </div>

    <div class="box-body">
        @if (Model.List_Dishes2 != null && Model.List_Dishes2.Count != 0)
        {
            <ol class="HIDE-js-order-list">
                @foreach (var elem in Model.List_Dishes2)
                {
                    <li>
                        @Html.Raw(elem.Dish_Name) - @Math.Round(elem.Dish_Price * elem.Dish_Count, 0) р. - @elem.Dish_Count.ToString().ReHIDE(",0", "") шт.
                        <button type="button" data-id="@elem.DishID" class="btn HIDE-js-delete-dish">
                            <i class="fas fa-trash"></i>
                        </button>

                        @* Ингредиенты *@
                        @if (elem.List_Dish_Ingridients != null && elem.List_Dish_Ingridients.Count != 0)
                        {
                            <div class="ingredients-list mt-2">
                                @foreach (var item in elem.List_Dish_Ingridients)
                                {
                                    <div class="mb-2">
                                        @Html.Raw(item.Ingridient_Name) - @Math.Round(item.Ingridient_Price * elem.Dish_Count, 0) р. - @elem.Dish_Count.ToString().ReHIDE(",0", "") шт.
                                    </div>
                                }
                            </div>
                        }

                        @* Объём *@
                        @if (elem.Dish_VolumeID > 0)
                        {
                            <div class="mb-2">
                                Объём - @elem.Dish_VolumeValue?.ToString().ReHIDE(",00", "") мл.
                            </div>
                        }
                    </li>
                }
            </ol>
        }
        <p class="border-bottom border-top pt-3 pb-3" style="font-size: 1.3em;"><b>Итого: <span class="">@Math.Round(Model.Sum_Itog, 0)</span> р.</b></p>
    </div>
}
else
{
    <div class="box-header mb-3">
        <h4 class="box-title">Выберите блюда</h4>
    </div>
}