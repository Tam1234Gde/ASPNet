@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_AddEdit
@{
    // Таблица > Клиенты
    Layout = null;

    int index = 0;
    int index_volume = 1000;
}

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">@Html.Raw(Model?.Dish?.Name)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body HIDE-modal-order_dishes">


                @if (Model?.Dish?.List_Dish_Ingridients != null && Model.Dish.List_Dish_Ingridients.Count != 0)
                {
                    <span class="info-box-number d-block mb-2 fs-5 badge bg-primary text-wrap">Выберите добавку</span>

                    @foreach (var elem in Model.Dish.List_Dish_Ingridients)
                    {
                        if (true)
                        {
                            index++;

                            <div class="custom-control custom-checkbox mb-2">
                                <input class="custom-control-input HIDE-js-ingredient" type="checkbox" data-attr="@elem.ID" id="@index" value="@index">
                                <label for="@index" class="custom-control-label">@elem.Ingridient - @elem.Price р.</label>
                            </div>
                        }

                        @*  <div class="custom-control custom-radio">
                <input class="custom-control-input HIDE-js-radio_time" type="radio" id="@index" name="customRadio" data-id="@elem.ID">
                <label for="@index" class="custom-control-label">@elem.Ingridient</label>
                </div> *@
                    }
                }

                @if (Model?.Dish?.List_Dish_Volumes != null && Model.Dish.List_Dish_Volumes.Count != 0)
                {

                    <hr>

                    <span class="info-box-number d-block mb-2 fs-5 badge bg-success text-wrap">Выберите объём</span>

                    @foreach (var elem in Model.Dish.List_Dish_Volumes)
                    {
                        index_volume++;
                        <div class="custom-control custom-radio">
                            <input class="custom-control-input HIDE-js-volume" type="radio" data-attr="@elem.ID" id="@index_volume" name="customRadio2" data-id="@elem.ID" @Html.Raw(index_volume == 1001 ? "checked='checked'" : "")>
                            <label for="@index_volume" class="custom-control-label">@elem.VolumeValue мл - @elem.VolumePrice р.</label>
                        </div>
                    }
                }

                <hr>

                <span class="info-box-number d-block mb-2 fs-5 badge bg-warning text-wrap">Укажите количество</span>
                <div class="">
                    <div class="">
                        <button type="button" class="btn btn-sm bg-yellow HIDE-js-order_minus mr-1" style="width: 30px;">
                            -
                        </button>
                        <div class="text-center mr-1 HIDE-js-order_number" style="display: inline-block;">1</div>
                        <button type="button" class="btn btn-sm bg-yellow HIDE-js-order_plus" style="width: 30px;">
                            +
                        </button>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отменить</button>
                <button type="button" class="btn btn-primary HIDE-js-dish_add">Добавить</button>
            </div>
        </div>
    </div>
</div>