@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Модальное окно > Подтверждение
    Layout = null;
}

@if (Model != null && Model.Order_More != null)
{
    <div class="modal fade" id="myModal_Confirm" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content" style="background-color: #e3e3e3;">
                <div class="modal-header">
                    <h5 class="modal-title pt-2" id="exampleModalLabel"><b>Изменить статус</b></h5>
                    <button type="button" style="font-size: 3em;" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    @* //TODO: NULLABLE *@

                    Вы уверены, что хотите изменить статус заказа "№@Model.Order_More.Order.ID" на "@Model.Order_Status"?
                </div>
                <div class="card-footer">
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group text-left mb-0 pt-2">
                                <form action="/Orders/Edit_Status/@Model.Order_More.Order.ID" method="post" novalidate="novalidate">
                                    <input type="hidden" data-val="true" data-val-required="The ID field is required." id="ID" name="ID" value="@Model.Order_More.Order.ID">
                                    <input id="Order_StatusID" type="hidden" data-val="true" name="Order_StatusID" value="@Model.Order_StatusID">
                                    <input id="Flag_Payed" type="hidden" data-val="true" name="Flag_Payed" value="@Model.Flag_Payed.ToString().ToLower()">
                                    <button type="submit" class="btn btn-primary" data-bs-dismiss="modal">Изменить</button>
                                </form>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-0 pt-2 text-right">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
}