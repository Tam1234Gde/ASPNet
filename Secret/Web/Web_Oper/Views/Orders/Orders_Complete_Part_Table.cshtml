@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Таблица > Выполненные заказы
    Layout = null;
}

@* Таблица > Выполненные заказы *@
@if (Model != null && Model.List_Orders != null && Model.List_Orders.Count != 0)
{
    <table class="table stripe" id="HIDE-users" style="border-color: #dee2e6;">
        <thead>
            <tr>
                <th class="p-2" style="max-width: 70px; width: 70px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().ID)</th>
                <th class="p-2" style="max-width: 90px; width: 90px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Client)</th>
                <th class="p-2" style="max-width: 120px; width: 120px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_Act)</th>
                <th class="p-2" style="max-width: 120px; width: 120px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_To)</th>
                <th class="p-2" style="max-width: 90px; width: 90px;" data-orderable="false">@Html.DisplayNameFor(x => new COrder_ForAdmin().Flag_Payed)</th>
                <th class="p-2">@Html.DisplayNameFor(x => new COrder_ForAdmin().Comment)</th>
                <th class="p-2" data-orderable="false" style="max-width: 200px; width: 200px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Orders)
            {
                <tr>
                    <td class="p-2">
                        <button type="button" class="btn btn-secondary btn-block HIDE-js-order-more" style="background: #edebeb; color: #000; border: 1px solid #cfcfcf;"
                                data-id="@item.ID">
                            @Html.DisplayFor(modelItem => item.ID)
                        </button>
                    </td>
                    <td class="p-2">
                        @Html.DisplayFor(modelItem => item.Client) <br /> <a href="tel:+@Html.DisplayFor(modelItem => item.Client_Phone)">+@Html.DisplayFor(modelItem => item.Client_Phone)</a>
                    </td>
                    <td class="p-2">
                        @string.Format("{0:H:mm:ss}", item.Date_Act) <br />
                        @string.Format("{0:d MMMM}", item.Date_Act)
                    </td>
                    <td class="p-2">
                        @string.Format("{0:H:mm:ss}", item.Date_To) <br />
                        @string.Format("{0:d MMMM}", item.Date_To)
                    </td>
                    <td class="p-2 text-center HIDE-custom-checkbox">
                        @if (item.Flag_Payed)
                        {
                            <i class="icon fas fa-check fs-5 pt-2" style="color: #ff851b;"></i>
                        }
                        else
                        {
                            <i class="icon fas fa-minus fs-5 pt-2" style="color: #535251;"></i>
                        }
                    </td>
                    <td class="p-2">
                        <span class="text-truncate text-decoration-underline d-inline-block HIDE-js-order-comment" data-id="@item.ID"
                              style="max-width: 300px; cursor: pointer;">@Html.DisplayFor(modelItem => item.Comment)</span>
                    </td>
                    <td class="p-2">
                        <button type="button" class="btn btn-success btn-block HIDE-js-order-confirm"
                                data-id="@item.ID" data-status="@EOrder_Status.New">
                            Восстановить
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}