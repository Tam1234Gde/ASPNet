@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Модальное окно > Подробности заказа
    Layout = null;

}

@* Модальное окно > Подробности заказа *@
@if (Model != null && Model.Order_Delivery != null)
{
    <div class="modal fade" id="Delivery_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title pt-2" id="exampleModalLabel"><b>Код заказа - @Model.Order_Delivery.OrderID</b></h4>

                </div>
                <div class="modal-body p-0">
                    <section class="content">
                        <div class="row invoice-info mb-2">


                            @* Доставка *@
                            @if (Model != null)
                            {
                                <div class="col-12 table-responsive">
                                    <table class="col-12">
                                        <tbody>
                                            <tr class="border-bottom">
                                                <th style="" class="p-3">  Адрес доставки:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_Address</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3"> Код подъезда:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_EntranceCode</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3">Номер подъезда:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_EntranceNumber</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3"> Номер этажа:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_Floor</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3"><b>Комментарий к заказу:</b></th>
                                                @if (!string.IsNullOrWhiteSpace(Model.Order_Delivery.Delivery_Comment))
                                                {
                                                    <td class="p-3">

                                                        @if (!string.IsNullOrWhiteSpace(Model.Order_Delivery.Delivery_Comment))
                                                        {
                                                            <text>
                                                                <b>Добавить к заказу:</b>
                                                            </text>
                                                            <br />
                                                            @Model.Order_Delivery.Delivery_Comment
                                                            <br />
                                                            <br />
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(Model.Order_Delivery.Delivery_Comment))
                                                        {
                                                            <text>
                                                                <b>Убрать из заказа:</b>
                                                            </text>
                                                            <br />
                                                            @Model.Order_Delivery.Delivery_Comment_Remove
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3">Сумма заказа:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_Price</td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <th class="p-3">Дать сдачи с:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_Handing</td>
                                            </tr>
                                            <tr>
                                                <th class="p-3">Доставить к:</th>
                                                <td class="p-3">@Model.Order_Delivery.Delivery_To</td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </div>
                            }

                        </div>
                    </section>
                </div>

                <div class="modal-footer d-block">

                    <button type="button" class="btn btn-secondary float-right" data-bs-dismiss="modal">Закрыть</button>
                </div>

            </div>
        </div>
    </div>
}