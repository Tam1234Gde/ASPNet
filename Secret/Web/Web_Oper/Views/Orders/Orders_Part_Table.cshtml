@using HIDE.RestAndRant.Common.ENums
@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    // Таблица > Заказы
    Layout = null;
}

@* Таблица > Заказы *@
@if (Model != null && Model.List_Orders != null && Model.List_Orders.Count != 0)
{
    <table class="table stripe" id="HIDE-users" style="border-color: #dee2e6; font-size: 0.9em;">
        <thead>
            <tr>
                <th class="p-2 search_code" style="max-width: 70px; width: 70px; min-width: 100px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().ID)</th>
                <th class="p-2 search" style="max-width: 50px; width: 50px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Client_Photo)</th>
                <th class="p-2 search" style="max-width: 90px; width: 90px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Client)</th>
                <th class="p-2" style="max-width: 120px; width: 120px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_Act)</th>
                <th class="p-2" style="max-width: 120px; width: 120px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Date_To)</th>
                <th class="p-2" style="max-width: 90px; width: 90px;">Таймер</th>
                <th class="p-2" style="max-width: 120px; width: 120px; min-width: 120px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Order_Type)</th>
                <th class="p-2" style="max-width: 170px; width: 170px; min-width: 170px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Order_Status)</th>
                <th class="p-2" style="max-width: 150px; width: 150px;">@Html.DisplayNameFor(x => new COrder_ForAdmin().Comment)</th>
                <th class="p-2" style="max-width: 125px; width: 125px;" data-orderable="false"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List_Orders)
            {
                string elem_class = "";
                if (item.Order_StatusID == EOrder_Status.New)
                {
                    elem_class = "HIDE-table-background_yellow";
                }
                else
                {
                    elem_class = "HIDE-table-background_green";
                }

                <tr class="HIDE-js-order_tr @elem_class" id="@item.ID">
                    <td class="p-2">
                        <button type="button" class="btn btn-secondary btn-block d-inline-block HIDE-js-order-more" style="width: auto; background: #edebeb; color: #000; border: 1px solid #cfcfcf;"
                                data-id="@item.ID">
                            @Html.DisplayFor(modelItem => item.ID)
                        </button>
                        @if (item.Flag_Payed)
                        {
                            <img class="d-inline-block" src="~/img/icon-order_payed2.svg" style="max-width: 23px;" alt="" />
                        }
                        else
                        {
                            <img class="d-inline-block" src="~/img/icon-order_payed_no2.svg" style="max-width: 23px;" alt="" />
                        }
                    </td>
                    <td class="p-2">
                        @if (item.Client_Photo != null)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(item.Client_Photo)" class="HIDE-image_table">
                        }
                    </td>
                    <td class="p-2">

                        <b>Клиент:</b> <br />
                        @Html.DisplayFor(modelItem => item.Client) <br /> 
                        
                        <a href="tel:+@Html.DisplayFor(modelItem => item.Client_Phone)">+@Html.DisplayFor(modelItem => item.Client_Phone)</a>

                        @if (!string.IsNullOrWhiteSpace(item.Phone))
                        {
                            @if (!string.IsNullOrWhiteSpace(item.Name))
                            {
                                <text>
                                    <br /><b>Кому:</b> <br />
                                </text>
                                @Html.DisplayFor(modelItem => item.Name) <br />
                            }
                            
                            @if (!string.IsNullOrWhiteSpace(item.Name))
                            {
                                <a href="tel:+@Html.DisplayFor(modelItem => item.Phone)">+@Html.DisplayFor(modelItem => item.Phone)</a>
                            }
                            else
                            {
                                 <text>
                                    <br /><b>Кому:</b> <br />
                                </text>
                                <a href="tel:+@Html.DisplayFor(modelItem => item.Phone)">+@Html.DisplayFor(modelItem => item.Phone)</a>
                            }

                        }
                    </td>
                    <td class="p-2">
                        @string.Format("{0:H:mm:ss}", item.Date_Act) <br />
                        @string.Format("{0:dd.MM.yyyy}", item.Date_Act)
                    </td>
                    <td class="p-2">
                        @string.Format("{0:H:mm:ss}", item.Date_To) <br />
                        @string.Format("{0:dd.MM.yyyy}", item.Date_To)
                    </td>
                    <td class="p-2">
                        @{
                            var date = DateTime.Now - item.Date_Act;

                        }

                        @Math.Round(Decimal.Parse(date.TotalMinutes.ToString()), 0) мин.

                    </td>

                    <td class="p-2">
                        @switch ((int)item.Order_TypeID)
                        {
                            case 3:
                                <text>С собой</text>
                                break;

                            case 6:
                                <text>Поесть в кафе</text>
                                <button type="button" class="btn btn-block btn-info btn-xs mt-2 HIDE-js-order-booking"
                                        data-id="@item.BookingID"
                                        data-price="@item.Booking_Price">
                                    Подробнее
                                </button>
                                break;

                            case 9:
                                <text>Доставка - @Html.Raw(item.Delivery_Price.HasValue && item.Delivery_Price.Value > 0 ? item.Delivery_Price.Value.ToString("0.##") + "р." : "Бесплатно") </text>

                                <button type="button" class="btn btn-block btn-info btn-xs mt-2 HIDE-js-order-delivery"
                                        data-id="@item.ID">
                                    Подробнее
                                </button>
                                break;

                            case 12:
                                <text>Вынести к машине</text>
                                @if (!string.IsNullOrWhiteSpace(item.Car_Brand))
                                {
                                    <br />

                                    @item.Car_Brand <br />
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Car_RegNumber))
                                {
                                    @item.Car_RegNumber <br />
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Car_Color))
                                {
                                    @item.Car_Color <br />
                                }
                                break;

                            default:
                                <text>-</text>
                                break;

                        }
                    </td>
                    <td class="p-2">

                        @switch ((int)item.Order_StatusID)
                        {
                            case (int)EOrder_Status.New:
                                <button class="btn btn-app bg-success" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top;">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-spinner"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-mug-hot"></i>
                                </button>
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-truck"></i>
                </button> *@
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-circle-check"></i>
                </button> *@
                                break;

                            case (int)EOrder_Status.Cooking:
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                                <button class="btn btn-app bg-success" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top;">
                                    <i class="fas fa-spinner"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-mug-hot"></i>
                                </button>
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-truck"></i>
                </button> *@
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-circle-check"></i>
                </button> *@
                                break;

                            case (int)EOrder_Status.ReadyToClient:
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-spinner"></i>
                                </button>
                                <button class="btn btn-app bg-success" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top;">
                                    <i class="fas fa-mug-hot"></i>
                                </button>
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-truck"></i>
                </button> *@
                                @*  <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-circle-check"></i>
                </button> *@
                                break;

                            case (int)EOrder_Status.Delivery:
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-spinner"></i>
                                </button>
                                <button class="btn btn-app bg-success" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top;">
                                    <i class="fas fa-mug-hot"></i>
                                </button>
                                @* <button class="btn btn-app bg-success" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-truck"></i>
                </button> *@
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-circle-check"></i>
                </button> *@
                                break;

                            case (int)EOrder_Status.Complete:
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-spinner"></i>
                                </button>
                                <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                                    <i class="fas fa-mug-hot"></i>
                                </button>
                                @* <button class="btn btn-app bg-secondary" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top; background-color: #dbe2e7 !important;">
                <i class="fas fa-truck"></i>
                </button> *@
                                @* <button class="btn btn-app bg-success" style="padding: 10px;min-width: 40px;height: 40px;cursor: default;margin: 0;vertical-align: top;">
                <i class="fas fa-circle-check"></i>
                </button> *@
                                break;
                        }

                    </td>

                    <td class="p-2">
                        <span class="text-truncate text-decoration-underline d-inline-block HIDE-js-order-comment" data-id="@item.ID" style="max-width: 200px; cursor: pointer;">
                            @if (!string.IsNullOrWhiteSpace(item.Comment_AddToOrder))
                            {
                                <text><b>Добавить к заказу:</b></text> <br />
                                @Html.DisplayFor(modelItem => item.Comment_AddToOrder)

                                <br />
                                <br />
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Comment_RemoveFromOrder))
                            {
                                <text><b>Убрать из заказа:</b></text> <br />
                                @Html.DisplayFor(modelItem => item.Comment_RemoveFromOrder)
                            }
                        </span>
                    </td>
                    <td class="p-2">
                        <button type="button" class="btn btn-secondary btn-block d-inline-block HIDE-js-order-more" style="width: auto; background: #edebeb; color: #000; border: 1px solid #cfcfcf;"
                                data-id="@item.ID">
                            Подробнее
                        </button>
                    </td>

                </tr>

            }

        </tbody>
    </table>

}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}