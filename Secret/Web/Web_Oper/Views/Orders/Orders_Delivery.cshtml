@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    string s_Title = "Передан в доставку";
    ViewData["Title"] = s_Title;
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Orders_Delivery";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Передан в доставку";
    ViewBag.RazdelNameMobile = "Передан в доставку";

}

@* Заказы *@
<div class="content-wrapper pt-3">
    @* Контент > Содержимое *@
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card card-success card-outline" style="border-top: 3px solid #007bff;">

                        @* Контент > Содержимое > Таблица > Данные *@
                        <div class="card-body table-responsive p-0 overflow-auto HIDE-js-partial_table">
                            <partial name="Orders_Delivery_Part_Table" model="Model" />
                        </div>

                    </div>

                </div>

            </div>
 
        </div>
    </section>
</div>

@* Модальное окно > Подробности заказа *@
<div class="HIDE-js-partial_modal_more">
    <partial name="Part_Modal_More" model="Model" />
</div>

@* Модальное окно > Комментарий *@
<div class="HIDE-js-partial_modal_comment">
    <partial name="Part_Modal_Comment" model="Model" />
</div>

@* Модальное окно > Подтверждение *@
<div class="HIDE-js-partial_modal_confirm">
    <partial name="Part_Modal_Confirm" model="Model" />
</div>

@section scripts{

    @* Таблица *@
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>

    @* Общий js для страницы *@
    <script src="~/js/Views/Orders/OrdersIndex.js"></script>

    <script>

        // Модальное окно > Подробности заказа
        $(".HIDE-js-order-more").click(function () {
            {
                let id_order = $(this).data('id');
                $.ajax(
                    {
                        url: '/Orders/Part_Modal_More',
                        type: 'GET',
                        data: { ID: id_order },
                        success: function (partialView) {
                            $('.HIDE-js-partial_modal_more').html(partialView);
                            $('#myModal').modal('show');

                        }
                    });
            }
        });

        // Модальное окно > Комментарий
        $(".HIDE-js-order-comment").click(function () {
            {
                let id_order = $(this).data('id');
                $.ajax(
                    {
                        url: '/Orders/Part_Modal_Comment',
                        type: 'GET',
                        data: { ID: id_order },
                        success: function (partialView) {
                            $('.HIDE-js-partial_modal_comment').html(partialView);
                            $('#myModal_Comment').modal('show');

                        }
                    });
            }
        });

        // Модальное окно > Подтверждение
        $(".HIDE-js-order-confirm").click(function () {
            {
                let id_order = $(this).data('id');
                let id_status = $(this).data('status');
                $.ajax(
                    {
                        url: '/Orders/Part_Modal_Confirm',
                        type: 'GET',
                        data: { ID: id_order, Order_StatusID: id_status },
                        success: function (partialView) {
                            $('.HIDE-js-partial_modal_confirm').html(partialView);
                            $('#myModal_Confirm').modal('show');

                        }
                    });
            }
        });

    </script>

}