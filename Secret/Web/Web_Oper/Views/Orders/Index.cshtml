@using HIDE.RestAndRant.Web_Oper.Models.Orders
@model Model_Orders_Common
@{
    string s_Title = "Заказы";
    ViewData["Title"] = s_Title;
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Orders_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Заказы";
    ViewBag.RazdelNameMobile = "Заказы";

}

@* Заказы *@
<div class="content-wrapper pt-3">
    @* Контент > Содержимое *@
    <section class="content">
        <div class="container-fluid p-0">

            <div class="row">
                <div class="col-lg-12">

                    <div class="card card-success card-outline" style="border-top: 3px solid #5a1ee5;">

                        @* Шапка *@
                        <div class="card-header HIDE-card-header">

                            @* <div class="HIDE-table-title HIDE-card-header_left">
                                <h3 class="card-title" style="padding-top:5px">
                                    Список записей
                                </h3>
                            </div> *@

                            <div class="HIDE-card-options">

                                <div class="HIDE-button-search">
                                    <input HIDEholder="Поиск по коду заказа" class="HIDE-js-search-code" />
                                </div>

                                <div class="HIDE-button-search">
                                    <input HIDEholder="Поиск по клиенту" class="HIDE-js-search-client" />
                                </div>

                                @* Добавить заказ *@
                                <div class="HIDE-button-add mb-2">
                                    <a asp-action="Add" asp-controller="Orders" class="btn btn-block btn-primary"><i class="fas fa-plus"></i>Добавить</a>
                                </div>

                            </div>

                        </div>

                        @* Контент > Содержимое > Таблица > Данные *@
                        <div class="card-body table-responsive p-0 overflow-auto HIDE-js-partial_table" @* style=" overflow-x: hidden !important;" *@>
                            <partial name="Orders_Part_Table" model="Model" />
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>
</div>

@* Модальное окно > Подробности заказа *@
<div class="HIDE-js-partial_modal_more">
    <partial name="Part_Modal_More" model="Model" />
</div>

@* Модальное окно > Доставка *@
<div class="HIDE-js-partial_modal_delivery">
    <partial name="Part_Modal_Delivery" model="Model" />
</div>

@* Модальное окно > Бронирование *@
<div class="HIDE-js-partial_modal_booking">
    <partial name="Part_Modal_Booking" model="Model" />
</div>

@* Модальное окно > Комментарий *@
<div class="HIDE-js-partial_modal_comment">
    <partial name="Part_Modal_Comment" model="Model" />
</div>

@* Модальное окно > Подтверждение *@
<div class="HIDE-js-partial_modal_confirm">
    <partial name="Part_Modal_Confirm" model="Model" />
</div>

@section scripts {

    @* Таблицы *@
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.searchBuilder.min.js"></script>

    @* Общий js для страницы *@
    <script src="~/js/Views/Orders/OrdersIndex.js"></script>

    <script>

        function Modal_Delivery() {

            //Модальное коно > Доставка
            $('.HIDE-js-order-delivery').click(function () {
                let id_order = $(this).data('id');

                $.ajax(
                    {
                        url: '/Orders/Part_Modal_Delivery',
                        type: 'GET',
                        data: { ID: id_order },
                        success: function (partialView) {
                            $('.HIDE-js-partial_modal_delivery').html(partialView);
                            $('#Delivery_Modal').modal('show');
                            Modal_Confirm();
                        }
                    });
            })

        };

        function Modal_Booking() {

            //Модальное коно > Бронирование
            $('.HIDE-js-order-booking').click(function () {
                let id_order = $(this).data('id');
                let price_order = $(this).data('price');

                $.ajax(
                    {
                        url: '/Orders/Part_Modal_Booking',
                        type: 'GET',
                        data: { BookingID: id_order, Booking_Price: price_order },
                        success: function (partialView) {
                            $('.HIDE-js-partial_modal_booking').html(partialView);
                            $('#Booking_Modal').modal('show');
                            Modal_Confirm();
                        }
                    });
            })

        };

        function Modal_OrderMore() {

            // Модальное окно > Подробности заказа
            $(".HIDE-js-order-more").click(function () {
                {
                    let id_order = $(this).data('id');

                    $.ajax(
                        {
                            url: '/Orders/Part_Modal_More',
                            type: 'GET',
                            data: { ID: id_order },
                            success: function (partialView) {
                                $('.HIDE-js-partial_modal_more').html(partialView);
                                $('#myModal').modal('show');
                                Modal_Confirm();
                            }
                        });
                }
            });

        };

        function Modal_Comment() {

            // Модальное окно > Комментарий
            $(".HIDE-js-order-comment").click(function () {
                {
                    let id_order = $(this).data('id');

                    $.ajax(
                        {
                            url: '/Orders/Part_Modal_Comment',
                            type: 'GET',
                            data: { ID: id_order },
                            success: function (partialView) {
                                $('.HIDE-js-partial_modal_comment').html(partialView);
                                $('#myModal_Comment').modal('show');
                            }
                        });
                }
            });

        };

        function Modal_Confirm() {

            // Модальное окно > Подтверждение
            let $ButtonConfirm = $('.HIDE-js-order-confirm');
            $ButtonConfirm.click(function () {
                {
                    let id_order = $(this).data('id');
                    let id_status = $(this).data('status');
                    let flag_payed_elem = $("#order_pay");
                    let flag_payed = false;
                    if (flag_payed_elem.is(':checked')) {
                        flag_payed = true;
                    }

                    $.ajax(
                        {
                            url: '/Orders/Part_Modal_Confirm',
                            type: 'GET',
                            data: { ID: id_order, Order_StatusID: id_status, Flag_Payed: flag_payed },
                            success: function (partialView) {
                                $('.HIDE-js-partial_modal_confirm').html(partialView);
                                $('#myModal_Confirm').modal('show');
                            }
                        });
                }
            });

        };

        Modal_Delivery();
        Modal_Booking();
        Modal_OrderMore();
        Modal_Comment();

        // Якорь
        @if (Model.OrderID > 0)
        {
            <text>
                                                    var order_id = @Model.OrderID;
            location.hash = '#' + order_id;

            $(".HIDE-js-order_tr").each(function () {
                var id = $(this)[0].id;
                if (id == @Model.OrderID) {
                    $this_elem = $(this);
                    $(this).addClass("HIDE-order_tr-active");

                    setTimeout(function () {
                        $this_elem.removeClass('HIDE-order_tr-active');
                    }, 10000)
                }
            });
            </text>
        }

                        // Выбор ресторана
                        var select_restaurant = document.getElementById("HIDE-js-select-restaurant");
        if (select_restaurant != null) {
            select_restaurant.onchange = function () {
                var select_restaurant_value = $("#HIDE-js-select-restaurant option:selected").val();

                // Список параметров из url
                let searchString = new URLSearchParams(window.location.search);

                var data_json = {
                    "page": 'RestaurantCookies',
                    "value": select_restaurant_value.toString()
                };

                // Добавление в куки
                $.ajax({
                    type: "GET",
                    cache: false,
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    data: data_json,
                    url: "/Orders/AddRestaurantCookies",
                    success: function (data) {
                        if (data !== undefined && data !== null && data !== "") {
                            window.location.href = searchString;
                        }
                    },
                    error: function (req, status, error) { }
                });
            };
        };

    </script>

}