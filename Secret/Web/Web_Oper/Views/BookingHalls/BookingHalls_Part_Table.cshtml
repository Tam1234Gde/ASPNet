@model List<CBooking>
@{
    // Таблица > Брони
    Layout = null;
}

@* Таблица > Брони *@
@if (Model != null)
{
    <table id="HIDE-users" class="table table-striped table-valign-middle HIDE-allstate-table">
        <thead>
            <tr>
                <th class="search export">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBooking().Client)</span>
                </th>
                <th class="export">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBooking().Phone)</span>
                </th>
                <th class="export">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBooking().Name)</span>
                </th>
                <th class="export">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBooking().Restaurant_Table)</span>
                </th>
                <th class="export">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBooking().Date_Start)</span>
                </th>
                <th class="export">
                    <span class="HIDE-jscss-table-head-text">@Html.DisplayNameFor(x => new CBooking().Date_End)</span>
                </th>
                <th data-orderable="false" style="min-width: 110px; width: 110px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Phone)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Restaurant_Table)
                    </td>
                    <td>
                        @item.Date_Start
                    </td>
                    <td>
                        @item.Date_End
                    </td>
                    <td class="HIDE-button-actions">
                        <a asp-controller="Bookings" asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning btn-sm" title="Изменить">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                        <a asp-controller="Bookings" asp-action="Del" asp-route-id="@item.ID" class="btn btn-danger btn-sm" title="Удалить">
                            <i class="fas fa-times-circle"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card-header" style=" border-bottom:none;">
        <h3 class="card-title" style="text-align:center; float:none; padding-top: 8px; ">
            Записей не обнаружено
        </h3>
    </div>
}