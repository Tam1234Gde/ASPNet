@using HIDE.RestAndRant.Web_Oper.Models.Auth
@model Model_Auth_Login
@{
    // Авторизация
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Вход в систему</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">     <!-- AdminLte:  Google Font -->

    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css"> <!-- HIDE: Подключение AdminLte -->

    <link href="~/lib/iCheck/skins/all.min.css" rel="stylesheet" />

    <script src="~/lib/jquery/jquery.min.js"></script>

    <script src="~/lib/admin-lte/js/adminlte.js"></script>

    <script src="~/lib/iCheck/icheck.js"></script>

    <script>
        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-aero',
                radioClass: 'iradio_square-aero',
                increaseArea: '10%'
            });
        });
    </script>

    <style>
        .HIDE-footer-fixed {
            position: fixed;
            bottom: 0;
            width: 100%;
            font-size: 14px;
            line-height: 20px;
            color: #000;
        }

        .HIDE-content-wrapper__nomargin, .HIDE-main-footer__nomargin {
            margin-left: 0 !important;
        }
    </style>

    <link href="~/lib/font-awesome/css/all.css" rel="stylesheet" />

</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-body">

                <p class="h5 text-center">Вход в систему</p>

                <form asp-action="Login" asp-antiforgery="true" method="post">
                    <input asp-for=@Model.ReturnUrl type="hidden" />

                    <div class="input-group mb-3">
                        <input asp-for=@Model.EMail type="text" class="form-control" HIDEholder="Email">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-envelope"></span>
                            </div>
                        </div>
                    </div>

                    <div class="input-group mb-3">
                        <input asp-for=@Model.Password type="password" class="form-control" HIDEholder="Пароль">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">

                        <div class="col-8">
                            <div class="icheck-primary">
                                <input asp-for="@Model.Flag_Remember" type="checkbox" id="remember">
                                <label asp-for="@Model.Flag_Remember" class="font-weight-normal text-secondary">
                                    Запомнить
                                </label>
                            </div>
                        </div>

                        <div class="col-4">
                            <button type="submit" class="btn btn-primary btn-block">Вход</button>
                        </div>
                        @* Автовход (только в режиме Debug) *@
                        @if (Model.Flag_Debug)
                        {
                            <div style="padding:16px 10px 0 10px;">
                                <a asp-controller="Auth" asp-action="DebugLogin" asp-route-ReturnUrl="@Model.ReturnUrl" class="text-red" style="text-decoration:underline; text-align: center; display: block;">
                                    Автовход (только в режиме Debug)
                                </a>
                            </div>
                        }

                        <div class="text-red" style="padding:16px 10px 0 10px; text-align: center; display: block;">
                            <span asp-validation-for="Info"></span>
                        </div>

                    </div>
                </form>

                @*<p class="mb-1 text-left fs-6 ">
                    <a href="forgot-password.html"><small>Восстановить пароль</small></a>
                </p>*@

            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>

</html>