@using HIDE.RestAndRant.Web_Oper.Models.Bookings
@model Model_Bookings_AddEdit
@{
    ViewData["Title"] = "Изменить бронь";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Bookings_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Изменить бронь";
    ViewBag.RazdelNameMobile = "Изменить";

}

@* Добавление брони *@
<div class="content-wrapper pt-3">
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <div class="card card-primary">

                        <div class="card-header">
                            <h3 class="card-title">Изменить бронь</h3>
                        </div>

                        <form asp-action="Edit">

                            <input type="hidden" asp-for="ID" />
                            <input class="HIDE-js-hidden-table" type="hidden" asp-for="Restaurant_TableID" />
                            <input class="HIDE-js-hidden-start" type="hidden" asp-for="Date_Start" />
                            <input class="HIDE-js-hidden-end" type="hidden" asp-for="Date_End" />

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="card-body">

                                @* Столики в ресторане *@
                                @if (Model.List_Restaurant_Tables != null && Model.List_Restaurant_Tables.Count != 0)
                                {
                                    <div class="form-group" style="position: relative;">
                                        <label>Выберите стол</label>
                                        <img style="display: block;" src="~/img/img_cafe.png" alt="" />

                                        @foreach (var elem in Model.List_Restaurant_Tables)
                                        {
                                            switch (elem.Coordinates)
                                            {
                                                case "1":
                                                    <div class="HIDE-jscss-table" style="width: 26px; height: 26px; top: 109px; left: 175px; border-radius: 20px;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "2":
                                                    <div class="HIDE-jscss-table" style="width: 26px; height: 26px; top: 109px; left: 99px; border-radius: 20px;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "3":
                                                    <div class="HIDE-jscss-table" style="width: 26px; height: 26px; top: 152px; left: 55px; border-radius: 20px;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "4":
                                                    <div class="HIDE-jscss-table" style="width: 26px; height: 26px; top: 187px; left: 132px; border-radius: 20px;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "5":
                                                    <div class="HIDE-jscss-table" style="width: 18px; height: 18px; top: 252px; left: 64px; border-radius: 20px; font-size: 0.8em;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "6":
                                                    <div class="HIDE-jscss-table" style="width: 18px; height: 18px; top: 275px; left: 64px; border-radius: 20px; font-size: 0.8em;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "7":
                                                    <div class="HIDE-jscss-table" style="width: 18px; height: 18px; top: 298px; left: 64px; border-radius: 20px; font-size: 0.8em;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                case "8":
                                                    <div class="HIDE-jscss-table" style="width: 25px; height: 20px; top: 278px; left: 114px; font-size: 0.9em;" data-id="@elem.ID" data-name="@elem.Name">
                                                        @elem.Name
                                                    </div>
                                                    break;
                                                default:

                                                    break;
                                            }
                                        }

                                    </div>
                                }

                                @* Клиент *@
                                @if (Model.List_Clients != null && Model.List_Clients.Any())
                                {
                                    <div class="form-group">
                                        <label asp-for="ClientID">Клиент</label>
                                        <select asp-for="ClientID" id="ClientID" class="custom-select HIDE-custom-select rounded-0 HIDE-js-select2">
                                            <option selected="selected" value="-1">[Не задано]</option>
                                            @foreach (var item in Model.List_Clients)
                                            {
                                                <option value="@item.ID">@item.Phone</option>
                                            }
                                        </select>
                                        <span asp-validation-for="ClientID" class="text-danger"></span>
                                    </div>
                                }

                                @* Имя *@
                                <div class="form-group">
                                    <label asp-for="Name" class="control-label">Имя(Если клиент отсутствует в базе)</label>
                                    <input asp-for="Name" class="form-control" />
                                </div>

                                @* Телефон *@
                                <div class="form-group">
                                    <label asp-for="Phone" class="control-label">Телефон(Если клиент отсутствует в базе)</label>
                                    <input asp-for="Phone" class="form-control" />
                                </div>

                                @* Время *@
                                <div class="HIDE-js-partial_table">
                                    <partial name="Time_Part_Table">
                                        <span asp-validation-for="Date_Start" class="text-danger"></span>
                                </div>

                            </div>

                            <div class="card-footer">
                                <div class="form-group mb-0">
                                    <input type="submit" value="Изменить" class="btn btn-primary" />
                                </div>
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>

    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        @if (Model.Restaurant_TableID > 0)
        {
        <text>
               var data_json = {
                   "Restaurant_TableID": @Model.Restaurant_TableID,
                   "Flag_Edit": true
               };

                $.ajax(
                    {
                        url: '@Url.Action(action: "Time_Part_Table", controller: "Bookings")',
                        data: data_json,
                        type: 'GET',
                        success: function (partialView) {
                            $('.HIDE-js-partial_table').html(partialView);

                            // Выбрать время
                            $(".HIDE-js-radio_time").click(function () {
                                let time_start = $(this).data("start");
                                let time_end = $(this).data("end");
                                $(".HIDE-js-hidden-start").val(time_start);
                                $(".HIDE-js-hidden-end").val(time_end);
                            });

                              @if (!string.IsNullOrWhiteSpace(Model.Date_Start))
                                {
                                    <text>
                                        $(".HIDE-js-radio_time").each(function () {
                                            let table_start = $(this).data("start");
               
                                            if (table_start == "@Html.Raw(Model.Date_Start)") {
                                                $(this).prop("checked", true);
                                            }
                                        });
                                    </text>
                                }

                        }
                    });
        </text>
        }

        @if (Model.Restaurant_TableID > 0) { 
            <text>
                $(".HIDE-jscss-table").each(function () {
                    let table_id = $(this).data("id");
                    if (table_id == @Model.Restaurant_TableID) {
                        $(this).addClass("HIDE-table-selected");
                        $(this).text("✓");
                    }
                });
            </text>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Date_Start))
        {
            <text>
                $(".HIDE-js-radio_time").each(function () {
                    let table_start = $(this).data("start");
               
                    if (table_start == "@Html.Raw(Model.Date_Start)") {
                        $(this).prop("checked", true);
                    }
                });
            </text>
        }

            // Выбрать столик
            $(".HIDE-jscss-table").click(function () {

                if (!$(this).hasClass("HIDE-table-disabled")) {
                    $(".HIDE-jscss-table").each(function () {
                        let table_name = $(this).data("name");
                        $(this).removeClass("HIDE-table-selected");
                        $(this).text(table_name);
                    });

                    let table_id = $(this).data("id");
                    let table_name = $(this).data("name");
                    if ($(this).hasClass("HIDE-table-selected")) {
                        $(this).removeClass("HIDE-table-selected");
                        $(this).text(table_name);
                    }
                    else {
                        $(this).addClass("HIDE-table-selected");
                        $(this).text("✓");
                    }

                    var data_json = {
                        "Restaurant_TableID": table_id,
                        "Flag_Edit": false
                    };

                    $.ajax(
                        {
                            url: '@Url.Action(action: "Time_Part_Table", controller: "Bookings")',
                            data: data_json,
                            type: 'GET',
                            success: function (partialView) {
                                $('.HIDE-js-partial_table').html(partialView);

                                // Выбрать время
                                $(".HIDE-js-radio_time").click(function () {
                                    let time_start = $(this).data("start");
                                    let time_end = $(this).data("end");
                                    $(".HIDE-js-hidden-start").val(time_start);
                                    $(".HIDE-js-hidden-end").val(time_end);
                                });

                                @if (!string.IsNullOrWhiteSpace(Model.Date_Start))
                                {
                                    <text>
                                        $(".HIDE-js-radio_time").each(function () {
                                            let table_start = $(this).data("start");
               
                                            if (table_start == "@Html.Raw(Model.Date_Start)") {
                                                $(this).prop("checked", true);
                                            }
                                        });
                                    </text>
                                }

                            }
                        });

                    $(".HIDE-js-hidden-table").val(table_id);
                }
            });

        // Выбрать время
        $(".HIDE-js-radio_time").click(function () {
            let time_start = $(this).data("start");
            let time_end = $(this).data("end");
            $(".HIDE-js-hidden-start").val(time_start);
            $(".HIDE-js-hidden-end").val(time_end);
        });

    </script>

}