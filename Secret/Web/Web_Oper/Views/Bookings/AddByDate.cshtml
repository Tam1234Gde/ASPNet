@using HIDE.RestAndRant.Web_Oper.Models.Bookings
@model Model_BookingsTime_AddEdit
@{
    ViewData["Title"] = "Добавить бронь";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Bookings_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Добавить бронь";
    ViewBag.RazdelNameMobile = "Добавить";

    // Иконки перед заголовком страницы
    //List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    //ViewBag.Icon = test[5].Value;
}

@* Добавление брони *@
<div class="content-wrapper pt-3">
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <div class="card card-primary card-outline card-outline-tabs">

                        @* Навигация *@
                        @* <div class="card-header p-0">
                            <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
                                <li class="nav-item">
                                    <a asp-controller="Bookings" asp-action="Add" class="nav-link" id="custom-tabs-one-home-tab" data-toggle="pill" role="tab" aria-controls="custom-tabs-one-home" aria-selected="false">По номеру стола</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Bookings" asp-action="AddByDate" class="nav-link active" id="custom-tabs-one-profile-tab" data-toggle="pill" role="tab" aria-controls="custom-tabs-one-profile" aria-selected="true">По времени</a>
                                </li>
                            </ul>
                        </div> *@

                        <form asp-action="AddByDate">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="card-body">

                                <input class="HIDE-js-hidden-table" type="hidden" asp-for="Restaurant_TableID" />
                                <input class="HIDE-js-hidden-type" type="hidden" asp-for="Restaurant_Table_TypeID" />

                                @* Дата брони *@
                                <div class="form-group HIDE-js-choose_date2">
                                    <label asp-for="Date_Start" class="control-label">Время брони*</label>
                                    <input asp-for="Date_Start" class="form-control HIDE-js-choose_date" type="datetime-local" />
                                    <span asp-validation-for="Date_Start" class="text-danger HIDE-js-date_error"></span>
                                </div>

                                @* Столики в ресторане *@
                                @{
                                    int index = 0;
                                }

                                <div class="form-group" style="position: relative;">

                                    @* Тип стола .Where(p => p.Name == "Зал") *@
                                    @if (Model.List_RestaurantTable_Types != null && Model.List_RestaurantTable_Types.Count != 0)
                                    {
                                        <div class="form-group clearfix">
                                            @foreach (CCommon elem in Model.List_RestaurantTable_Types)
                                            {
                                                index++;
                                                <div class="icheck-primary d-inline mr-3">
                                                    <input type="radio" class="HIDE-js-radio_type" data-id="@elem.ID" id="@elem.ID" name="r1" @Html.Raw(index == 1 ? "checked=\"checked\"" : "")>
                                                    <label for="@elem.ID">
                                                        @elem.Name
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @* Столики *@
                                    <div class="HIDE-js-partial_table-tables">
                                        <partial name="Part_TablesByDate">
                                    </div>

                                </div>

                                @* Время *@
                                <div class="HIDE-js-partial_table mb-3">
                                    <partial name="Time_Part_TableByDate">
                                        <span asp-validation-for="Date_Start" class="text-danger"></span>
                                </div>

                                @* Клиент *@
                                @if (Model.List_Clients != null && Model.List_Clients.Any())
                                {
                                    <div class="form-group">
                                        <label asp-for="ClientID">Клиент</label>
                                        <select asp-for="ClientID" id="ClientID" class="custom-select HIDE-custom-select rounded-0 HIDE-js-select2">
                                            <option selected="selected" value="-1">[Не задано]</option>
                                            @foreach (var item in Model.List_Clients)
                                            {
                                                <option value="@item.ID">@item.Phone</option>
                                            }
                                        </select>
                                        <span asp-validation-for="ClientID" class="text-danger"></span>
                                    </div>
                                }

                                @* Имя *@
                                <div class="form-group">
                                    <label asp-for="Name" class="control-label">Имя(Если клиент отсутствует в базе)</label>
                                    <input asp-for="Name" class="form-control" />
                                </div>

                                @* Телефон *@
                                <div class="form-group">
                                    <label asp-for="Phone" class="control-label">Телефон(Если клиент отсутствует в базе)</label>
                                    <input asp-for="Phone" class="form-control" />
                                </div>

                                <div class="callout callout-danger pt-2">
                                    <b>Требуется заполнить "Клиент" или "Имя\Телефон"</b>
                                </div>

                            </div>

                            <div class="card-footer">
                                <div class="form-group mb-0">
                                    <input type="submit" value="Добавить" class="btn btn-primary" />
                                </div>
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>

    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Выбор ресторана
        var select_restaurant = document.getElementById("HIDE-js-select-restaurant");
        if (select_restaurant != null) {
            select_restaurant.onchange = function () {
                var select_restaurant_value = $("#HIDE-js-select-restaurant option:selected").val();

                // Список параметров из url
                let searchString = new URLSearchParams(window.location.search);

                var data_json = {
                    "page": 'RestaurantCookies',
                    "value": select_restaurant_value.toString()
                };

                // Добавление в куки
                $.ajax({
                    type: "GET",
                    cache: false,
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    data: data_json,
                    url: "/Bookings/AddRestaurantCookies",
                    success: function (data) {
                        if (data !== undefined && data !== null && data !== "") {
                            window.location.href = searchString;
                        }
                    },
                    error: function (req, status, error) { }
                });
            };
        };

        // Выбрать столик
        function Choose_Table() {

            // Выбрать столик
            $(".HIDE-jscss-table").click(function () 
            {
                if (!$(this).hasClass("HIDE-table-disabled")) 
                {
                    $(".HIDE-jscss-table").each(function () {
                        let table_name = $(this).data("name");
                        let table_text = $(this).data("text");
                        let table_vip = $(this).data("vip");
                        $(this).removeClass("HIDE-table-selected");
                        if(table_vip == true)
                        {
                            $(this).text(`${table_text}`);
                        }
                        else
                        {
                           $(this).html(`<span style='position: absolute; top: 11px; text-align: center; width: 50px;'>${table_name}</span>`);
                        }
                    });

                    let table_id = $(this).data("id");
                    let table_name = $(this).data("name");
                    let table_vip = $(this).data("vip");
                    let table_text = $(this).data("text");

                    console.log("table_vip: " + table_vip);

                    if ($(this).hasClass("HIDE-table-selected")) 
                    {
                        $(this).removeClass("HIDE-table-selected");
                        if(table_vip == true)
                        {
                           $(this).text(`${table_text}`);
                        }
                        else
                        {
                           $(this).html(`<span style='position: absolute; top: 11px; text-align: center; width: 50px;'>${table_name}</span>`);
                        }
                    }
                    else 
                    {
                        $(this).addClass("HIDE-table-selected");
                        if(table_vip == true)
                        {
                            $(this).text("✓");
                        }
                        else
                        {
                            $(this).html("<span style='position: absolute; top: 11px; text-align: center; width: 50px;'>✓</span>");
                        }
                    }

                    var time_start2 = $(".HIDE-js-choose_date").val();

                    var data_json = {
                        "Restaurant_TableID": table_id,
                        "Flag_Edit": false
                    };

                    $.ajax(
                        {
                            url: '@Url.Action(action: "Time_Part_TableByDate", controller: "Bookings")',
                            data: data_json,
                            type: 'GET',
                            success: function (partialView) {
                                $('.HIDE-js-partial_table').html(partialView);

                                // Выбрать время
                                $(".HIDE-js-radio_time").click(function () {
                                    let time_start = $(this).data("start");
                                    let time_end = $(this).data("end");
                                    $(".HIDE-js-hidden-start").val(time_start);
                                    $(".HIDE-js-hidden-end").val(time_end);
                                });

                                $(".HIDE-js-radio_time_vip").val(time_start2);

                                // Выбрать время
                                $(".HIDE-js-radio_time_vip").blur(function () {
                                    let time_start = $(this).val();
                                    $(".HIDE-js-hidden-start").val(time_start);
                                });

                                // Выбрать время
                                $(".HIDE-js-radio_time_vip").blur(function () {
                                    let time_start = $(this).val();
                                    $(".HIDE-js-hidden-start").val(time_start);
                                    $(".HIDE-js-choose_date").val(time_start);
                                    var data_json = {
                                        "Date_Booking": time_start,
                                        "Restaurant_TableID": table_id,
                                    };

                                    $.ajax(
                                        {
                                            url: '@Url.Action(action: "GetNextBooking", controller: "Bookings")',
                                            data: data_json,
                                            type: 'GET',
                                            success: function (data) {
                                                if (data.date_Next != undefined) {
                                                    var text = 'Бронирование комнаты доступно до ' + data.date_Next;
                                                    $(".HIDE-booking_next-text").html(text);
                                                }
                                                else {
                                                    $(".HIDE-booking_next-text").html("");
                                                }

                                                if (data.flag_Unavailable) {
                                                    $(".HIDE-booking_next-text").html('Столик занят');
                                                }
                                            }
                                        });
                                });
                                $(".HIDE-js-radio_time_vip").blur();
                            }
                        });

                    $(".HIDE-js-hidden-table").val(table_id);
                }

            });

        };

        Choose_Table();

        // Выбрать дату бронирования
        function Choose_Date() {

            // Выбрать дату бронирования
            $(".HIDE-js-choose_date").blur(function () {

                let date = $(".HIDE-js-choose_date").val();
                let type = $(".HIDE-js-hidden-type").val();

                var minutes = date.substr(date.length - 2);

                if (minutes != 30 && minutes != 0) {
                    $(".HIDE-js-date_error").text("Шаг должен быть кратен 30мин для зала/веранды/двора и 1ч для VIP. Пример допустимого времени - 15:00, 15:30, 16:30. Для VIP - 15:00, 16:00, 20:00");
                    $(".HIDE-js-partial_table-tables").hide();
                }
                else {
                    $(".HIDE-js-partial_table-tables").show();
                }

                var data_json = {
                    "Restaurant_Table_TypeID": type,
                    "Date_Booking": date
                };

                $.ajax(
                    {
                        url: '@Url.Action(action: "Part_TablesByDate", controller: "Bookings")',
                        data: data_json,
                        type: 'GET',
                        success: function (partialView) {
                            $('.HIDE-js-partial_table-tables').html(partialView);
                            Choose_Table();

                            // Выбрать время
                            $(".HIDE-js-radio_time").click(function () {
                                let time_start = $(this).data("start");
                                let time_end = $(this).data("end");
                                $(".HIDE-js-hidden-start").val(time_start);
                                $(".HIDE-js-hidden-end").val(time_end);
                            });
                        }
                    });

            });

        };

        Choose_Date();


        // Выбрать на сколько бронь
        function Choose_Hours() {

            // Выбрать на сколько бронь
            $(".HIDE-js-choose_hours").blur(function () {

                let date = $(".HIDE-js-choose_date").val();
                let type = $(".HIDE-js-hidden-type").val();

                var minutes = date.substr(date.length - 2);

                if (minutes != 30 && minutes != 0) {
                    $(".HIDE-js-date_error").text("Шаг должен быть кратен 30мин для зала/веранды/двора и 1ч для VIP. Пример допустимого времени - 15:00, 15:30, 16:30. Для VIP - 15:00, 16:00, 20:00");
                    $(".HIDE-js-partial_table-tables").hide();
                }
                else {
                    $(".HIDE-js-partial_table-tables").show();
                }

                var data_json = {
                    "Restaurant_Table_TypeID": type,
                    "Date_Booking": date
                };

                $.ajax(
                    {
                        url: '@Url.Action(action: "Part_TablesByDate", controller: "Bookings")',
                        data: data_json,
                        type: 'GET',
                        success: function (partialView) {
                            $('.HIDE-js-partial_table-tables').html(partialView);
                            Choose_Table();

                            // Выбрать время
                            $(".HIDE-js-radio_time").click(function () {
                                let time_start = $(this).data("start");
                                let time_end = $(this).data("end");
                                $(".HIDE-js-hidden-start").val(time_start);
                                $(".HIDE-js-hidden-end").val(time_end);
                            });
                        }
                    });

            });

        };

        //Choose_Hours();


        // Выбор типа столика
        $(".HIDE-js-radio_type").click(function () {
            let date = $(".HIDE-js-choose_date").val();
            let id = $(this).data("id");

            var data_json = {
                "Restaurant_Table_TypeID": id,
                "Date_Booking": date
            };

            $.ajax(
                {
                    url: '@Url.Action(action: "Part_TablesByDate", controller: "Bookings")',
                    data: data_json,
                    type: 'GET',
                    success: function (partialView) {
                        $('.HIDE-js-partial_table-tables').html(partialView);
                        Choose_Table();
                        Choose_Date();
                        $(".HIDE-js-hidden-type").val(id);
                    }
                });

            // if (id == @((int)ERestaurant_Table_Type.Ordinary)) {
            //     $(".HIDE-js-type_holl").show();
            //     $(".HIDE-js-type_veranda").hide();
            // }

            // if (id == @((int)ERestaurant_Table_Type.Veranda)) {
            //     $(".HIDE-js-type_holl").hide();
            //     $(".HIDE-js-type_veranda").show();
            // }

        });

        // Выбрать время
        $(".HIDE-js-radio_time").click(function () {
            let time_start = $(this).data("start");
            let time_end = $(this).data("end");
            $(".HIDE-js-hidden-start").val(time_start);
            $(".HIDE-js-hidden-end").val(time_end);
        });

    </script>

}