@using HIDE.RestAndRant.Web_Oper.Models.Bookings
@model List<MBooking>
@{
    string s_Title = "Бронирование";
    ViewData["Title"] = s_Title;
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Bookings_List";

    // Заголовки страницы(Основная и мобильная версия)
    ViewBag.RazdelName = "Бронирование";
    ViewBag.RazdelNameMobile = "Бронирование";

    // Иконки перед заголовком страницы
    //List<KeyValuePair<string, string>> test = Helper_Dictionary.Dictionary_Icons();
    //ViewBag.Icon = test[9].Value;
}

@* Заказы *@
<div class="content-wrapper pt-3">
    @* Контент > Содержимое *@
    <section class="content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-lg-12">

                    <div class="card">

                        @* Контент > Содержимое > Таблица > Заголовок *@
                        <div class="card-header bg-info text-right clearfix">
                            @* <h2 class="float-left d-inline-block mr-3 h3">
                                @s_Title
                            </h2> *@
                            <div class="btn-group">
                                <a asp-controller="Bookings" asp-action="AddByDate" class="btn bg-gradient-primary" title="Добавить"><i class="fas fa-plus"></i></a>
                            </div>
                        </div>

                        @* Контент > Содержимое > Таблица > Данные *@
                        <div class="card-body table-responsive p-0 overflow-auto">
                            <partial name="Bookings_Part_Table" model="Model" />
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>
</div>

@section scripts {

    @* Общий js для страницы *@
    <script src="~/js/Views/Bookings/BookingsIndex.js"></script>

    <script>
        // Выбор ресторана
        var select_restaurant = document.getElementById("HIDE-js-select-restaurant");
        if (select_restaurant != null) {
            select_restaurant.onchange = function () {
                var select_restaurant_value = $("#HIDE-js-select-restaurant option:selected").val();

                // Список параметров из url
                let searchString = new URLSearchParams(window.location.search);

                var data_json = {
                    "page": 'RestaurantCookies',
                    "value": select_restaurant_value.toString()
                };

                // Добавление в куки
                $.ajax({
                    type: "GET",
                    cache: false,
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    data: data_json,
                    url: "/Bookings/AddRestaurantCookies",
                    success: function (data) {
                        if (data !== undefined && data !== null && data !== "") {
                            window.location.href = searchString;
                        }
                    },
                    error: function (req, status, error) { }
                });
            };
        };
    </script>

}