@using HIDE.RestAndRant.Web_Oper.Models.Bookings
@model Model_Bookings_AddEdit
@{
    Layout = null;
    int index = 100;
}

@if (Model.List_Times != null && Model.List_Times.Count != 0)
{
    if (Model.Restaurant_Table_TypeID != ERestaurant_Table_Type.VIP)
    {
        <label>Выберите время</label>
        @foreach (var elem in Model.List_Times)
        {
            index++;
            DateTime end = elem.AddMinutes(30);
            <div>
                <div class="custom-control custom-radio">
                    <input class="custom-control-input HIDE-js-radio_time" type="radio" id="@index" name="customRadio" data-start="@elem" data-end="@end">
                    <label for="@index" class="custom-control-label">@elem.ToString("HH:mm") - @end.ToString("HH:mm")</label>
                </div>
            </div>
        }
    }
    else
    {
        @* Дата начала *@
      @*   <div class="form-group">
            <label asp-for="Date_Start" class="control-label">Дата начала</label>
            <input asp-for="Date_Start" class="form-control HIDE-js-radio_time_vip" type="time" />
            <span class="text-danger HIDE-booking_next-text"></span>
        </div> *@

        @* Укажите на сколько часов арендуете *@
        <div class="form-group">
            <label asp-for="Vip_Time" class="control-label">Укажите на сколько часов арендуете</label>
            <input asp-for="Vip_Time" class="form-control" type="number" />
        </div>
    }
}