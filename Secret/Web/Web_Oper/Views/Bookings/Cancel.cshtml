@using HIDE.RestAndRant.Web_Oper.Models.Bookings
@model Model_Bookings_AddEdit
@{
    ViewData["Title"] = "Отменить бронь";
    Layout = "~/Views/Shared/_Layout_AdminLTE.cshtml";
    ViewData["Sidebar"] = "Bookings_List";
}

<section class="content-wrapper content-wrapper__operator">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">

                    <form asp-action="Del">

                        <input asp-for="@Model.ID" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="card-body">

                            <div class="form-group mb-0">
                                <label>Вы уверены, что хотите удалить бронь для "@Model.Restaurant_Table"? </label>
                            </div>

                        </div>

                        <div class="card-footer">

                            <div class="form-group">
                                <input type="submit" value="Удалить" class="btn btn-primary" />
                            </div>

                            <div class="form-group">
                                <a asp-action="Index">Назад</a>
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}