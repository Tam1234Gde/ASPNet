                                    @elem.Dop_Text
                                </button>
                                break;
                            default:

                                break;
                        }
                        break;
                    case 5:
                        switch (elem.Coordinates)
                        {
                            case "1":
                                <button type="button" class="@elem_class HIDE-jscss-table btn btn-app fs-6 ml-0" style="position: relative;" data-id="@elem.ID" data-name="@elem.Name" data-text="@elem.Dop_Text" data-vip="true">
