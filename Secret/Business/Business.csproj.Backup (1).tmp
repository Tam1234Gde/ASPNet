<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HIDE.RestAndRant.Business</RootNamespace>
    <AssemblyName>HIDE.RestAndRant.Business</AssemblyName>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="EPPlus" Version="8.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Telegram.Bot" Version="22.9.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Business_YooKassa\Business_YooKassa.csproj" />
    <ProjectReference Include="..\Database\Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HIDE.Crypto_Core">
      <HintPath>..\..\HIDE_DLL\HIDE.Crypto_Core\v1\net10.0\HIDE.Crypto_Core.dll</HintPath>
    </Reference>
    <Reference Include="HIDE.SendMails_Core">
      <HintPath>..\..\HIDE_DLL\HIDE.SendMails_Core\v1\net8.0\HIDE.SendMails_Core.dll</HintPath>
    </Reference>
    <Reference Include="HIDE.SmsInt">
      <HintPath>..\..\HIDE_DLL\HIDE.SmsInt_Core\v1\net8.0\HIDE.SmsInt.dll</HintPath>
    </Reference>
    <Reference Include="HIDE.Units_Core">
      <HintPath>..\..\HIDE_DLL\HIDE.Units_Core\net6.0\HIDE.Units_Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
